    maddw.xyzw vf28, vf04, vf00w    sq.xyzw vf27, 1017(vi00)
    mul.xyzw vf25, vf30, vf10       lq.xyzw vf16, 1019(vi00)
    mulax.xyzw ACC, vf05, vf29x     lq.xyzw vf17, 1018(vi00)
    minii.x vf24, vf24, I           lq.xyzw vf20, 1015(vi00)
    madday.xyzw ACC, vf06, vf29y    div Q, vf00w, vf28w
    maddaz.xyzw ACC, vf07, vf29z    sq.xyzw vf15, 1023(vi00)
    maddw.xyzw vf27, vf08, vf00w    sq.xyzw vf18, 1020(vi00)
    maxx.x vf24, vf24, vf00x        sq.xyzw vf31, 1015(vi00)
    ftoi0.xyzw vf25, vf25           sq.xyzw vf16, 1022(vi00)
    nop                             lq.xyzw vf31, 2(vi05)
    nop                             sq.xyzw vf17, 1021(vi00)
