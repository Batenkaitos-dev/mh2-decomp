    nop                             isw.x vi08, -1(vi04)
    nop                             lq.xyzw vf11, 1021(vi00)
    nop                             lq.xyzw vf12, 1022(vi00)
    nop                             lq.xyzw vf13, 1023(vi00)
    nop                             lq.xyzw vf14, 1018(vi00)
    nop                             lq.xyzw vf15, 1019(vi00)
    nop                             lq.xyzw vf16, 1020(vi00)
    nop                             sqi.xyzw vf11, (vi04++)
    nop                             sqi.xyzw vf12, (vi04++)
    nop                             sqi.xyzw vf13, (vi04++)
    nop                             sqi.xyzw vf14, (vi04++)
    nop                             sqi.xyzw vf15, (vi04++)
    nop                             sqi.xyzw vf16, (vi04++)
    nop                             ilw.x vi10, 2(vi05)
    nop                             lq.xyzw vf29, 0(vi05)
    nop                             nop
    nop                             nop
    nop                             lq.xyzw vf11, 0(vi10)
    nop                             lq.xyzw vf12, 1(vi10)
    nop                             lq.xyzw vf13, 2(vi10)
    nop                             lq.xyzw vf14, 3(vi10)
    mulax.xyzw ACC, vf11, vf29x     nop
    madday.xyzw ACC, vf12, vf29y    loi 255.0                            ; I = 255.0
    maddaz.xyzw ACC, vf13, vf29z    nop
    maddw.xyzw vf23, vf14, vf00w    nop
    nop                             nop
    nop                             nop
    nop                             nop
    mulax.xyzw ACC, vf01, vf23x     nop
    madday.xyzw ACC, vf02, vf23y    ilw.x vi10, 6(vi05)
    maddaz.xyzw ACC, vf03, vf23z    nop
    maddw.xyzw vf28, vf04, vf00w    nop
    mulax.xyzw ACC, vf05, vf23x     lq.xyzw vf29, 4(vi05)
    madday.xyzw ACC, vf06, vf23y    lq.xyzw vf11, 0(vi10)
    maddaz.xyzw ACC, vf07, vf23z    lq.xyzw vf12, 1(vi10)
    subw.x vf26, vf10, vf28w        div Q, vf00w, vf28w                  ; Q = 1 / vf28.w
    maddw.xyzw vf25, vf08, vf00w    lq.xyzw vf13, 2(vi10)
    mulax.xyzw ACC, vf11, vf29x     lq.xyzw vf14, 3(vi10)
    madday.xyzw ACC, vf12, vf29y    nop
    muly.x vf26, vf26, vf10y        nop
    maddaz.xyzw ACC, vf13, vf29z    lq.xyzw vf31, 1(vi05)
    ; one vertex per pass, software-pipelined through the delay line
rigid_loop:
