; VU1 microcode, sub_main 0x3E7F80-0x4021C0 (107,072 bytes): the 60 VU1 programs
; of Capcom's model renderer, as 60 DMA packets.
;
; Capcom's own code: the only VU code
; on the disc, in Capcom's overlay, used only by Capcom's descriptors and setups.
;
; Built by tools/vu1as.py, our own assembler (no Sony toolchain), into GNU as
; source; the bytes match the game's, which objdiff checks (unit
; sub_main/vu1_microcode). tools/vu1dis.py prints the block from your copy in
; this syntax, with numbered labels and no comments.
;
; Syntax
; - One instruction pair per line: the upper (FMAC) instruction, the lower, then
;   the upper word's flags: [E] ends the program after the next pair, [D] is a
;   debug break. A lower `loi VALUE` sets the I bit: the lower word is then the
;   float VALUE, which the upper reads as I.
; - vfNN and viNN registers; .xyzw destination fields; vfNNx a broadcast field;
;   ACC, Q, I, P and R as the instruction set names them. A branch's offset
;   counts pairs, and its delay slot (the next pair) always runs.
; - `.program NAME` ... `.endprogram` is one DMA packet; labels are local to it.
;   The packing is computed: a RET tag, a VIF NOP, the code as MPG transfers of up
;   to 256 pairs to micro address 0, the VIF codes written in the program (.base,
;   .offset; for the clippers .stcycl and .unpack), and NOPs to a quadword.
; - The programs are in packet order, which is e->prog order except that 52
;   comes before 51. NAME is a global symbol at the packet (gVu1ProgInfoNN's
;   word 0 holds its address).
;
; How the programs run (Vu1_SelectProgram, the Vu1Pkt_* setups and
; Model_BuildVifPackets)
; - Each model gets a program by its key (the low 24 bits of its word at 0x0C) and
;   format. Before the model's batches its setup sends FLUSHA, STCYCL 4/4, an UNPACK V4-32 of the
;   constants to VU 0 (each header lists them) and MSCALF 0, which runs `init`:
;   the constants into registers, then [E].
; - Then the model's batches: an UNPACK and an MSCNT each. `batch` reads XTOP:
;   VIF alternates BASE and BASE + OFFSET, so the next batch can arrive while one
;   is drawn. Qword 0's x word is the batch's type; qword 1 is a GIF tag whose
;   NLOOP (bits 0-14) counts what follows.
;   - Type 1 (1 and 2 in the skinned programs): NLOOP vertices of a strip. Each is
;     transformed, lit and clip-tested into the output buffer (a fixed number of
;     qwords after the batch: the descriptor's capacity / 16, but in program 45),
;     after the copied GIF tag, whose NLOOP is patched; then XGKICK sends the
;     buffer to the GS.
;   - Any other type: a register block, NLOOP qwords of A+D data, copied through
;     and kicked; with key bit 0x2 a material colour follows it.
;   [E] ends the batch; the next MSCNT continues two pairs later, at `b batch`.
; - The output vertex is ST, RGBAQ and XYZF2 (the REGS of the batch's GIF tag;
;   colours clamped to 128.0, the GS's 1.0). A vertex gets XYZF2's ADC bit
;   (0x8000, made as 0x7FFF + 1) when one of the last three vertices is outside the
;   clip volume (FCAND of the clip flags with 0x03FFFF): the GS draws no triangle
;   ending there. The screen position comes from the setup's first matrix (divided
;   by w, to 12.4 fixed point), the clip test from its second (x gViewportMtx). The clippers clip those triangles instead (below).
; - The delay line: the vertex loops are software-pipelined by hand, and the top
;   six qwords of VU memory (1018-1023) hold the pipeline's stages instead of
;   registers. In the usual arrangement each pass
;   sends the older vertex (1021-1023) to the output, moves the newer one
;   (1018-1020) down and stores the vertex it has just finished; the loop's
;   epilogue sends the two left. So a batch first re-sends the two vertices the
;   line still holds, the previous batch's last two (NLOOP + 2).
; - Families: by the setup's letters, L three directional lights (and an
;   ambient), D fog, V a second colour (gGsColor2F), E rows of gMtxUv, P
;   clipping, S skinning; the selection key's bits 0x200, 0x8000, 0x20000,
;   0x4000 and 0x80, and the skinned formats 0x321135 and 0x221135. Key bit 0x2:
;   no vertex colours (a material colour per register block); bit 0x20: normals
;   without lights.
; - Skinned (Vu1Pkt_S*): world-space matrices and lights, then the 32 bone
;   matrices; type 1 vertices take one bone (qword 3: the VU addresses of its
;   matrices), type 2 blend four (qword 3: the addresses, qword 4: the weights).
; - Clippers (P, 13 programs): clip_triangle clips the triangle of the last
;   three vertices against the six planes (two polygon buffers, one plane per
;   pass: clip_edges, intersect, close_polygon) and sends the polygon left as a
;   fan, with the GIF tag the packet unpacks to VU 0x3A6 (PRIM 0x5D, or 0x7D
;   with fog). A triangle wholly outside one plane is culled. 914-919 carry
;   vertex data from one batch to the next (loaded at `vertices`, stored at the
;   end).

;=======================================================================================
; Vu1Prog00: three lights, material colour, no vertex colours
;
; gVu1ProgInfo00 (bones.c): 116 pairs (928 bytes), batches of up to 3968 bytes;
; Vu1_SelectProgram's key 0x202, rigid models (0x21035, 0x121035).
; Setup Vu1Pkt_L: an UNPACK of 16 qwords to VU 0, then MSCALF 0:
;   0        colour: gGsColorF, RGB scaled by the model's brightness: vf28
;   1-4      gMtxSlots x gMtxView x gMtxProjClip: model to screen (XYZ after the divide by w): vf01-vf04
;   5-8      the matrix above x gViewportMtx: model to the clip test's space: vf05-vf08
;   9-11     light directions (model space, negated): vf09-vf11
;   12-15    light colours (three lights and the ambient): vf24-vf27
; Vertices: gVu1ProgLayouts[0], 3 qwords: position, normal, texture coordinates.
; Batches at VU 0x10 and 0x10 + 0x1f8 (XTOP); the output follows each.
;=======================================================================================
.program Vu1Prog00
.base 0x10
.offset 0x1f8

    ; MSCALF 0: the setup's constants into registers
init:
    nop                             lq.xyzw vf01, 1(vi00)
    nop                             lq.xyzw vf02, 2(vi00)
    nop                             lq.xyzw vf03, 3(vi00)
    nop                             lq.xyzw vf04, 4(vi00)
    nop                             lq.xyzw vf05, 5(vi00)
    nop                             lq.xyzw vf06, 6(vi00)
    nop                             lq.xyzw vf07, 7(vi00)
    nop                             lq.xyzw vf08, 8(vi00)
    nop                             lq.xyzw vf09, 9(vi00)
    nop                             lq.xyzw vf10, 10(vi00)
    nop                             lq.xyzw vf11, 11(vi00)
    nop                             nop                               [E] ; end: constants loaded
    nop                             nop

    ; MSCNT: one batch at XTOP; qword 0's x is its type, qword 1 a GIF tag
batch:
    nop                             xtop vi02                            ; vi02: the batch (BASE, or BASE + OFFSET: double buffer)
    nop                             iaddiu vi05, vi02, 0
    nop                             iaddiu vi03, vi02, 248               ; vi03: the output, 248 qwords after the batch
    nop                             ilwr.x vi06, (vi05)                  ; the batch type (qword 0)
    nop                             iaddiu vi05, vi05, 1
    nop                             ilwr.x vi08, (vi05)                  ; the GIF tag (qword 1): NLOOP, EOP
    nop                             iaddiu vi04, vi03, 0
    nop                             iaddiu vi11, vi00, 32767             ; 0x7FFF: the NLOOP mask
    nop                             lq.xyzw vf31, 0(vi05)
    nop                             iand vi07, vi11, vi08
    nop                             iaddiu vi11, vi00, 1
    nop                             iaddiu vi05, vi05, 1
    nop                             ibeq vi11, vi06, vertices
    nop                             sqi.xyzw vf31, (vi04++)

    ; a register block: the GIF tag and its NLOOP qwords (A+D) go through to the output
copy_regs:
    nop                             lq.xyzw vf30, 0(vi05)
    nop                             iaddi vi07, vi07, -1
    nop                             iaddiu vi05, vi05, 1
    nop                             ibne vi07, vi00, copy_regs
    nop                             sqi.xyzw vf30, (vi04++)
    nop                             lqi.xyzw vf29, (vi05++)
    nop                             lq.xyzw vf24, 12(vi00)
    nop                             lq.xyzw vf25, 13(vi00)
    nop                             lq.xyzw vf26, 14(vi00)
    nop                             lq.xyzw vf27, 15(vi00)
    mul.xyzw vf24, vf29, vf24       lq.xyzw vf28, 0(vi00)
    mul.xyzw vf25, vf29, vf25       lqi.xyzw vf30, (vi05++)
    mul.xyzw vf26, vf29, vf26       nop
    ftoi0.xyzw vf29, vf29           loi 128.0                            ; I = 128.0: the colour clamp (0x80 is 1.0 on the GS)
    add.xyzw vf23, vf27, vf28       nop
    muli.xyzw vf12, vf24, I         nop
    muli.xyzw vf13, vf25, I         nop
    muli.xyzw vf14, vf26, I         mtir vi15, vf29w
    mul.xyzw vf15, vf23, vf30       nop
    minii.xyzw vf12, vf12, I        nop
    minii.xyzw vf13, vf13, I        nop
    minii.xyzw vf14, vf14, I        nop
    minii.xyzw vf15, vf15, I        xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             nop                               [E] ; end: the next MSCNT continues at copy_regs_cont
    nop                             nop

    ; the next MSCNT continues here
copy_regs_cont:
    nop                             b batch                              ; the next batch
    nop                             nop

    ; type 1: a strip of NLOOP vertices
vertices:
    nop                             iaddiu vi08, vi08, 2                 ; NLOOP + 2: the delay line's last vertices go out first
    nop                             isw.x vi08, -1(vi04)
    nop                             loi 128.0                            ; I = 128.0: the colour clamp (0x80 is 1.0 on the GS)
    nop                             lq.xyzw vf30, 1(vi05)
    nop                             ilw.w vi09, 0(vi05)                  ; vi09: the position's w word, XYZF2's w (F, ADC) as the model has it
    nop                             lq.xyzw vf29, 0(vi05)
    nop                             lq.xyzw vf31, 2(vi05)
    nop                             iaddiu vi05, vi05, 3
    mulax.xyzw ACC, vf09, vf30x     lq.xyzw vf16, 1021(vi00)
    madday.xyzw ACC, vf10, vf30y    lq.xyzw vf17, 1022(vi00)
    maddaz.xyzw ACC, vf11, vf30z    lq.xyzw vf18, 1023(vi00)
    maddw.xyzw vf26, vf00, vf00w    lq.xyzw vf19, 1018(vi00)
    ; One vertex per pass, software-pipelined by hand (the other programs work
    ; the same way, with their own attributes). Pass i:
    ; - vf29, vf30, vf31 and vi09 hold vertex i's position, normal, ST and the
    ;   position's w word, loaded by the pass before; vf26 its N.L for the three
    ;   lights (vf09-vf11), begun the pass before and clamped at 0 here;
    ; - vf25 = vf01-vf04 x position, divided by w (Q) and made 12.4 fixed point:
    ;   XYZ. vf23 = vf05-vf08 x position: the clip test. vf28 = ST x Q: STQ.
    ;   vf27 = the light colours (vf12-vf14, scaled by the material) x N.L + vf15,
    ;   clamped to 128 and made integers: RGB, with vi15 (the material's alpha)
    ;   as A;
    ; - the delay line: the older vertex (VU 1021-1023, read into vf16-vf18) goes
    ;   to the output, the newer one (1018-1020) moves to 1021-1023, and vertex i
    ;   goes to 1018 (STQ), 1019 (RGBA) and 1020 (XYZ; the w word vi14 is the
    ;   model's, or 0x8000, ADC, when the triangle is not wholly inside);
    ; - vertex i+1's position, normal and ST are loaded and its N.L begun.
vertices_loop:
    mulax.xyzw ACC, vf01, vf29x     lq.xyzw vf20, 1019(vi00)
    madday.xyzw ACC, vf02, vf29y    lq.xyzw vf21, 1020(vi00)
    maddaz.xyzw ACC, vf03, vf29z    sqi.xyzw vf16, (vi04++)
    maddw.xyzw vf25, vf04, vf00w    sqi.xyzw vf17, (vi04++)
    maxx.xyzw vf26, vf26, vf00x     sqi.xyzw vf18, (vi04++)
    mulax.xyzw ACC, vf05, vf29x     sq.xyzw vf19, 1021(vi00)
    madday.xyzw ACC, vf06, vf29y    sq.xyzw vf20, 1022(vi00)
    maddaz.xyzw ACC, vf07, vf29z    div Q, vf00w, vf25w                  ; Q = 1 / vf25.w
    maddw.xyzw vf23, vf08, vf00w    sq.xyzw vf21, 1023(vi00)
    mulax.xyzw ACC, vf12, vf26x     iaddiu vi14, vi09, 0
    madday.xyzw ACC, vf13, vf26y    lq.xyzw vf30, 1(vi05)
    maddaz.xyzw ACC, vf14, vf26z    ilw.w vi09, 0(vi05)
    maddw.xyzw vf27, vf00, vf26w    lq.xyzw vf29, 0(vi05)
    clipw.xyz vf23, vf23w           iaddiu vi05, vi05, 3                 ; clip flags: vf23.xyz against +-vf23.w
    mulq.xyz vf28, vf31, Q          lq.xyzw vf31, -1(vi05)
    mulq.xyzw vf25, vf25, Q         iaddi vi07, vi07, -1
    add.xyzw vf27, vf27, vf15       isw.w vi15, 1019(vi00)
    mulax.xyzw ACC, vf09, vf30x     fcand vi01, 0x03ffff                 ; vi01 = 1: one of the last three vertices is outside the clip volume
    madday.xyzw ACC, vf10, vf30y    ibeq vi01, vi00, vertices_in_view
    ftoi4.xyzw vf25, vf25           sq.xyzw vf28, 1018(vi00)             ; to 12.4 fixed point (GS XYZ)
    nop                             iaddiu vi14, vi00, 32767             ; ADC: 0x7FFF + 1 = 0x8000, so the GS draws no triangle ending here
    nop                             iaddiu vi14, vi14, 1
    ; the last three vertices are all inside the clip volume
vertices_in_view:
    minii.xyzw vf27, vf27, I        lq.xyzw vf16, 1021(vi00)
    maddaz.xyzw ACC, vf11, vf30z    isw.w vi14, 1020(vi00)
    maddw.xyzw vf26, vf00, vf00w    lq.xyzw vf17, 1022(vi00)
    nop                             sq.xyz vf25, 1020(vi00)
    ftoi0.xyzw vf27, vf27           lq.xyzw vf18, 1023(vi00)
    nop                             lq.xyzw vf19, 1018(vi00)
    nop                             nop
    nop                             ibne vi07, vi00, vertices_loop
    nop                             sq.xyz vf27, 1019(vi00)
    ; the epilogue: the vertices left in the delay line
    nop                             lq.xyzw vf16, 1021(vi00)
    nop                             lq.xyzw vf17, 1022(vi00)
    nop                             lq.xyzw vf18, 1023(vi00)
    nop                             lq.xyzw vf19, 1018(vi00)
    nop                             lq.xyzw vf20, 1019(vi00)
    nop                             lq.xyzw vf21, 1020(vi00)
    nop                             sqi.xyzw vf16, (vi04++)
    nop                             sqi.xyzw vf17, (vi04++)
    nop                             sqi.xyzw vf18, (vi04++)
    nop                             sqi.xyzw vf19, (vi04++)
    nop                             sqi.xyzw vf20, (vi04++)
    nop                             sqi.xyzw vf21, (vi04++)
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             xgkick vi03                       [E] ; end: the next MSCNT continues at vertices_cont
    nop                             nop

    ; the next MSCNT continues here
vertices_cont:
    nop                             b batch                              ; the next batch
    nop                             nop
.endprogram

;=======================================================================================
; Vu1Prog01: skinned, three lights, material colour, no vertex colours
;
; gVu1ProgInfo01 (bones.c): 336 pairs (2688 bytes), batches of up to 3200 bytes;
; Vu1_SelectProgram's key 0x202, skinned models (0x321135, 0x221135).
; Setup Vu1Pkt_SL: an UNPACK of 240 qwords to VU 0, then MSCALF 0:
;   0        colour: gGsColorF, RGB scaled by the model's brightness: vf28
;   1-4      gMtxView x gMtxProjClip: world to screen (XYZ after the divide by w): vf01-vf04
;   5-8      gMtxView x gViewportMtx: world to the clip test's space: vf05-vf08
;   9-11     light directions (world space, negated): vf01-vf03
;   12-15    light colours (three lights and the ambient): vf24-vf27
;   16-143   bone matrices: the 32 gMtxSlots the model's mask (e+0x54) selects
;   144-239  init writes each bone's normal matrix here (its rows normalised), three qwords each
; Vertices: gVu1ProgLayouts[8], 5 qwords: position, normal, texture coordinates, bone indices, bone weights.
; Batches at VU 0xf0 and 0xf0 + 0x185 (XTOP); the output follows each.
;=======================================================================================
.program Vu1Prog01
.base 0xf0
.offset 0x185

    ; MSCALF 0: the setup's constants into registers
init:
    nop                             iaddiu vi10, vi00, 16
    nop                             lq.xyzw vf07, 0(vi10)
    nop                             lq.xyzw vf08, 1(vi10)
    nop                             iaddiu vi07, vi00, 32
    nop                             iaddiu vi11, vi00, 144
    addx.x vf04, vf00, vf07x        nop
    addy.x vf05, vf00, vf07y        nop
    addz.x vf06, vf00, vf07z        lq.xyzw vf09, 2(vi10)
    addx.y vf04, vf00, vf08x        nop
    addy.y vf05, vf00, vf08y        nop
    addz.y vf06, vf00, vf08z        nop
    addx.z vf04, vf00, vf09x        lq.xyzw vf01, 9(vi00)
    addy.z vf05, vf00, vf09y        lq.xyzw vf02, 10(vi00)
    addz.z vf06, vf00, vf09z        lq.xyzw vf03, 11(vi00)
    nop                             nop
    mulax.xyz ACC, vf04, vf01x      nop
    madday.xyz ACC, vf05, vf01y     nop
    maddz.xyz vf27, vf06, vf01z     nop
    mulax.xyz ACC, vf04, vf02x      nop
    madday.xyz ACC, vf05, vf02y     nop
    maddz.xyz vf28, vf06, vf02z     nop
    mul.xyz vf10, vf27, vf27        nop
    mulax.xyz ACC, vf04, vf03x      nop
    madday.xyz ACC, vf05, vf03y     nop
    maddz.xyz vf29, vf06, vf03z     nop
    addy.x vf10, vf10, vf10y        move.xyzw vf21, vf27
init_loop:
    nop                             nop
    mul.xyz vf11, vf28, vf28        move.xyzw vf22, vf28
    mul.xyz vf12, vf29, vf29        move.xyzw vf23, vf29
    nop                             nop
    addz.x vf10, vf10, vf10z        nop
    addy.x vf11, vf11, vf11y        nop
    addy.x vf12, vf12, vf12y        nop
    nop                             nop
    nop                             rsqrt Q, vf00w, vf10x
    addz.x vf11, vf11, vf11z        iaddiu vi11, vi11, 3
    addz.x vf12, vf12, vf12z        iaddiu vi10, vi10, 4
    nop                             iaddi vi07, vi07, -1
    nop                             lq.xyzw vf07, 0(vi10)
    nop                             ersqrt P, vf11x
    nop                             lq.xyzw vf08, 1(vi10)
    nop                             lq.xyzw vf09, 2(vi10)
    addx.x vf04, vf00, vf07x        nop
    addy.x vf05, vf00, vf07y        nop
    addz.x vf06, vf00, vf07z        nop
    addx.y vf04, vf00, vf08x        nop
    addy.y vf05, vf00, vf08y        nop
    mulq.xyz vf21, vf21, Q          rsqrt Q, vf00w, vf12x
    addz.y vf06, vf00, vf08z        nop
    addx.z vf04, vf00, vf09x        nop
    addy.z vf05, vf00, vf09y        nop
    addz.z vf06, vf00, vf09z        nop
    addx.x vf24, vf00, vf21x        nop
    addy.x vf25, vf00, vf21y        nop
    addz.x vf26, vf00, vf21z        nop
    mulax.xyz ACC, vf04, vf01x      nop
    madday.xyz ACC, vf05, vf01y     nop
    maddz.xyz vf27, vf06, vf01z     mfp.x vf11, P
    mulax.xyz ACC, vf04, vf02x      nop
    madday.xyz ACC, vf05, vf02y     nop
    mulq.xyz vf23, vf23, Q          nop
    mulx.xyz vf22, vf22, vf11x      nop
    mul.xyz vf10, vf27, vf27        nop
    maddz.xyz vf28, vf06, vf02z     nop
    addx.z vf24, vf00, vf23x        nop
    addx.y vf24, vf00, vf22x        nop
    addy.z vf25, vf00, vf23y        nop
    addy.y vf25, vf00, vf22y        nop
    addz.z vf26, vf00, vf23z        nop
    addz.y vf26, vf00, vf22z        sq.xyzw vf24, -3(vi11)
    mulax.xyz ACC, vf04, vf03x      move.xyzw vf21, vf27
    madday.xyz ACC, vf05, vf03y     sq.xyzw vf25, -2(vi11)
    maddz.xyz vf29, vf06, vf03z     ibne vi07, vi00, init_loop
    addy.x vf10, vf10, vf10y        sq.xyzw vf26, -1(vi11)
    addx.x vf09, vf00, vf01x        lq.xyzw vf04, 4(vi00)
    addy.x vf10, vf00, vf01y        lq.xyzw vf05, 5(vi00)
    addz.x vf11, vf00, vf01z        lq.xyzw vf01, 1(vi00)
    addx.y vf09, vf00, vf02x        lq.xyzw vf06, 6(vi00)
    addy.y vf10, vf00, vf02y        lq.xyzw vf07, 7(vi00)
    addz.y vf11, vf00, vf02z        lq.xyzw vf02, 2(vi00)
    addx.z vf09, vf00, vf03x        lq.xyzw vf08, 8(vi00)
    addy.z vf10, vf00, vf03y        nop
    addz.z vf11, vf00, vf03z        lq.xyzw vf03, 3(vi00)
    nop                             nop
    nop                             sq.xyzw vf09, 9(vi00)
    nop                             sq.xyzw vf10, 10(vi00)
    nop                             sq.xyzw vf11, 11(vi00)
    nop                             nop                               [E] ; end: constants loaded
    nop                             nop

    ; MSCNT: one batch at XTOP; qword 0's x is its type, qword 1 a GIF tag
batch:
    nop                             xtop vi02                            ; vi02: the batch (BASE, or BASE + OFFSET: double buffer)
    nop                             iaddiu vi05, vi02, 0
    nop                             ilwr.x vi06, (vi05)                  ; the batch type (qword 0)
    nop                             iaddiu vi05, vi05, 1
    nop                             ilwr.x vi08, (vi05)                  ; the GIF tag (qword 1): NLOOP, EOP
    nop                             iaddiu vi03, vi02, 200               ; vi03: the output, 200 qwords after the batch
    nop                             iaddiu vi11, vi00, 32767             ; 0x7FFF: the NLOOP mask
    nop                             lqi.xyzw vf31, (vi05++)
    nop                             iand vi07, vi11, vi08
    nop                             iaddiu vi11, vi00, 1
    nop                             iaddiu vi04, vi03, 0
    nop                             ibeq vi11, vi06, rigid
    nop                             sqi.xyzw vf31, (vi04++)
    nop                             iaddiu vi11, vi00, 2
    nop                             nop
    nop                             ibeq vi11, vi06, blended
    nop                             nop

    ; a register block: the GIF tag and its NLOOP qwords (A+D) go through to the output
copy_regs:
    nop                             lqi.xyzw vf31, (vi05++)
    nop                             iaddi vi07, vi07, -1
    nop                             iaddiu vi04, vi04, 1
    nop                             ibne vi07, vi00, copy_regs
    nop                             sq.xyzw vf31, -1(vi04)
    nop                             lq.xyzw vf28, 0(vi00)
    nop                             lqi.xyzw vf29, (vi05++)
    nop                             lq.xyzw vf24, 12(vi00)
    nop                             lq.xyzw vf25, 13(vi00)
    nop                             lq.xyzw vf26, 14(vi00)
    nop                             lq.xyzw vf27, 15(vi00)
    mul.xyzw vf24, vf29, vf24       lqi.xyzw vf30, (vi05++)
    mul.xyzw vf25, vf29, vf25       nop
    mul.xyzw vf26, vf29, vf26       nop
    add.xyzw vf23, vf27, vf28       nop
    ftoi0.xyzw vf29, vf29           loi 128.0                            ; I = 128.0: the colour clamp (0x80 is 1.0 on the GS)
    muli.xyzw vf12, vf24, I         nop
    muli.xyzw vf13, vf25, I         nop
    muli.xyzw vf14, vf26, I         nop
    mul.xyzw vf15, vf23, vf30       mtir vi15, vf29w
    minii.xyzw vf12, vf12, I        nop
    minii.xyzw vf13, vf13, I        nop
    minii.xyzw vf14, vf14, I        nop
    minii.xyzw vf15, vf15, I        nop
    nop                             xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             nop                               [E] ; end: the next MSCNT continues at copy_regs_cont
    nop                             nop

    ; the next MSCNT continues here
copy_regs_cont:
    nop                             b batch                              ; the next batch
    nop                             nop

    ; type 1: vertices of one bone each (qword 3: the bone's matrix addresses)
rigid:
    nop                             loi 128.0                            ; I = 128.0: the colour clamp (0x80 is 1.0 on the GS)
    nop                             iaddiu vi08, vi08, 2                 ; NLOOP + 2: the delay line's last vertices go out first
    nop                             isw.x vi08, -1(vi04)
    nop                             lq.xyzw vf21, 1021(vi00)
    nop                             lq.xyzw vf20, 1022(vi00)
    nop                             lq.xyzw vf19, 1023(vi00)
    nop                             lq.xyzw vf18, 1018(vi00)
    nop                             lq.xyzw vf17, 1019(vi00)
    nop                             lq.xyzw vf16, 1020(vi00)
    nop                             sqi.xyzw vf21, (vi04++)
    nop                             sqi.xyzw vf20, (vi04++)
    nop                             sqi.xyzw vf19, (vi04++)
    nop                             sqi.xyzw vf18, (vi04++)
    nop                             ilw.x vi10, 3(vi05)
    nop                             ilw.y vi11, 3(vi05)
    nop                             lq.xyzw vf29, 0(vi05)
    nop                             lq.xyzw vf30, 1(vi05)
    nop                             lq.xyzw vf19, 0(vi10)
    nop                             lq.xyzw vf20, 1(vi10)
    nop                             lq.xyzw vf21, 2(vi10)
    nop                             lq.xyzw vf22, 3(vi10)
    mulax.xyzw ACC, vf19, vf29x     lq.xyzw vf23, 0(vi11)
    madday.xyzw ACC, vf20, vf29y    lq.xyzw vf24, 1(vi11)
    maddaz.xyzw ACC, vf21, vf29z    lq.xyzw vf25, 2(vi11)
    maddw.xyzw vf29, vf22, vf00w    sqi.xyzw vf17, (vi04++)
    mulax.xyz ACC, vf23, vf30x      ilw.w vi09, 0(vi05)                  ; vi09: the position's w word, XYZF2's w (F, ADC) as the model has it
    madday.xyz ACC, vf24, vf30y     sqi.xyzw vf16, (vi04++)
    maddz.xyz vf26, vf25, vf30z     lq.xyzw vf31, 2(vi05)
    mulax.xyzw ACC, vf01, vf29x     iaddiu vi05, vi05, 5
    madday.xyzw ACC, vf02, vf29y    iaddiu vi14, vi09, 0
    ; one vertex per pass, software-pipelined through the delay line
rigid_loop:
    maddaz.xyzw ACC, vf03, vf29z    ilw.x vi10, 3(vi05)
    maxx.xyzw vf26, vf26, vf00x     ilw.w vi09, 0(vi05)
    maddw.xyzw vf28, vf04, vf00w    ilw.y vi11, 3(vi05)
    mulax.xyzw ACC, vf05, vf29x     lq.xyzw vf30, 1(vi05)
    madday.xyzw ACC, vf06, vf29y    lq.xyzw vf19, 0(vi10)
    maddaz.xyzw ACC, vf07, vf29z    iaddiu vi04, vi04, 3
    maddw.xyzw vf16, vf08, vf00w    div Q, vf00w, vf28w                  ; Q = 1 / vf28.w
    mulax.xyzw ACC, vf12, vf26x     lq.xyzw vf29, 0(vi05)
    madday.xyzw ACC, vf13, vf26y    lq.xyzw vf20, 1(vi10)
    maddz.xyzw vf26, vf14, vf26z    lq.xyzw vf21, 2(vi10)
    clipw.xyz vf16, vf16w           lq.xyzw vf22, 3(vi10)                ; clip flags: vf16.xyz against +-vf16.w
    mulax.xyzw ACC, vf19, vf29x     lq.xyzw vf23, 0(vi11)
    madday.xyzw ACC, vf20, vf29y    lq.xyzw vf24, 1(vi11)
    add.xyzw vf17, vf26, vf15       lq.xyzw vf25, 2(vi11)
    mulq.xyzw vf28, vf28, Q         fcand vi01, 0x03ffff                 ; vi01 = 1: one of the last three vertices is outside the clip volume
    mulq.xyz vf27, vf31, Q          ibeq vi01, vi00, rigid_in_view
    maddaz.xyzw ACC, vf21, vf29z    lq.xyzw vf31, 2(vi05)
    nop                             iaddiu vi14, vi00, 32767             ; ADC: 0x7FFF + 1 = 0x8000, so the GS draws no triangle ending here
    nop                             iaddiu vi14, vi14, 1
    ; the last three vertices are all inside the clip volume
rigid_in_view:
    minii.xyzw vf17, vf17, I        iaddiu vi05, vi05, 5
    ftoi4.xyzw vf28, vf28           isw.w vi14, -1(vi04)                 ; to 12.4 fixed point (GS XYZ)
    maddw.xyzw vf29, vf22, vf00w    isw.w vi15, -2(vi04)
    mulax.xyz ACC, vf23, vf30x      sq.xyzw vf27, -3(vi04)
    ftoi0.xyz vf17, vf17            iaddi vi07, vi07, -1
    madday.xyz ACC, vf24, vf30y     iaddiu vi14, vi09, 0
    maddz.xyz vf26, vf25, vf30z     sq.xyz vf28, -1(vi04)
    mulax.xyzw ACC, vf01, vf29x     ibne vi07, vi00, rigid_loop
    madday.xyzw ACC, vf02, vf29y    sq.xyz vf17, -2(vi04)
    ; the epilogue: the vertices left in the delay line
    nop                             lqd.xyzw vf16, (--vi04)
    nop                             lqd.xyzw vf17, (--vi04)
    nop                             lqd.xyzw vf18, (--vi04)
    nop                             lqd.xyzw vf19, (--vi04)
    nop                             lqd.xyzw vf20, (--vi04)
    nop                             lqd.xyzw vf21, (--vi04)
    nop                             sq.xyzw vf16, 1020(vi00)
    nop                             sq.xyzw vf17, 1019(vi00)
    nop                             sq.xyzw vf18, 1018(vi00)
    nop                             sq.xyzw vf19, 1023(vi00)
    nop                             sq.xyzw vf20, 1022(vi00)
    nop                             sq.xyzw vf21, 1021(vi00)
    nop                             xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             nop
    nop                             nop                               [E] ; end: the next MSCNT continues at rigid_cont
    nop                             nop

    ; the next MSCNT continues here
rigid_cont:
    nop                             b batch                              ; the next batch
    nop                             nop

    ; type 2: vertices of four bones (qword 3: the matrix addresses, qword 4: the weights)
blended:
    nop                             loi 128.0                            ; I = 128.0: the colour clamp (0x80 is 1.0 on the GS)
    nop                             iaddiu vi08, vi08, 2                 ; NLOOP + 2: the delay line's last vertices go out first
    nop                             isw.x vi08, -1(vi04)
    nop                             lq.xyzw vf16, 1021(vi00)
    nop                             lq.xyzw vf17, 1022(vi00)
    nop                             lq.xyzw vf18, 1023(vi00)
    nop                             lq.xyzw vf19, 1018(vi00)
    nop                             lq.xyzw vf20, 1019(vi00)
    nop                             lq.xyzw vf21, 1020(vi00)
    nop                             sqi.xyzw vf16, (vi04++)
    nop                             sqi.xyzw vf17, (vi04++)
    nop                             sqi.xyzw vf18, (vi04++)
    nop                             sqi.xyzw vf19, (vi04++)
    nop                             sqi.xyzw vf20, (vi04++)
    nop                             sqi.xyzw vf21, (vi04++)
    nop                             lq.xyzw vf31, 4(vi05)
    nop                             ilw.x vi10, 3(vi05)
    nop                             ilw.y vi11, 3(vi05)
    nop                             ilw.z vi12, 3(vi05)
    nop                             ilw.w vi13, 3(vi05)
    nop                             lq.xyzw vf28, 1(vi05)
    nop                             lq.xyzw vf20, 0(vi10)
    nop                             lq.xyzw vf21, 0(vi11)
    nop                             lq.xyzw vf22, 0(vi12)
    nop                             lq.xyzw vf23, 0(vi13)
    mulax.xyzw ACC, vf20, vf31x     lq.xyzw vf20, 1(vi10)
    madday.xyzw ACC, vf21, vf31y    lq.xyzw vf21, 1(vi11)
    maddaz.xyzw ACC, vf22, vf31z    lq.xyzw vf22, 1(vi12)
    maddw.xyzw vf16, vf23, vf31w    lq.xyzw vf23, 1(vi13)
    mulax.xyzw ACC, vf20, vf31x     lq.xyzw vf20, 2(vi10)
    madday.xyzw ACC, vf21, vf31y    lq.xyzw vf21, 2(vi11)
    maddaz.xyzw ACC, vf22, vf31z    lq.xyzw vf22, 2(vi12)
    maddw.xyzw vf17, vf23, vf31w    lq.xyzw vf23, 2(vi13)
    mulax.xyzw ACC, vf20, vf31x     lq.xyzw vf20, 3(vi10)
    madday.xyzw ACC, vf21, vf31y    lq.xyzw vf21, 3(vi11)
    maddaz.xyzw ACC, vf22, vf31z    lq.xyzw vf22, 3(vi12)
    maddw.xyzw vf18, vf23, vf31w    lq.xyzw vf23, 3(vi13)
    nop                             ilw.w vi09, 0(vi05)                  ; vi09: the position's w word, XYZF2's w (F, ADC) as the model has it
    mulax.xyz ACC, vf16, vf28x      lq.xyzw vf30, 2(vi05)
    madday.xyz ACC, vf17, vf28y     lq.xyzw vf27, 0(vi05)
    maddz.xyz vf28, vf18, vf28z     nop
    mulax.xyzw ACC, vf20, vf31x     nop
    madday.xyzw ACC, vf21, vf31y    iaddiu vi14, vi09, 0
    maddaz.xyzw ACC, vf22, vf31z    iaddiu vi05, vi05, 5
    maddw.xyzw vf19, vf23, vf31w    erleng.xyz P, vf28                   ; P = 1 / |vf28.xyz|
    mulax.xyzw ACC, vf16, vf27x     nop
    madday.xyzw ACC, vf17, vf27y    nop
    maddaz.xyzw ACC, vf18, vf27z    nop
    maddw.xyzw vf27, vf19, vf00w    nop
    nop                             nop
    nop                             nop
    ; one vertex per pass, software-pipelined through the delay line
blended_loop:
    nop                             lq.xyzw vf31, 4(vi05)
    mulax.xyzw ACC, vf01, vf27x     ilw.x vi10, 3(vi05)
    madday.xyzw ACC, vf02, vf27y    ilw.y vi11, 3(vi05)
    maddaz.xyzw ACC, vf03, vf27z    ilw.z vi12, 3(vi05)
    maddw.xyzw vf26, vf04, vf00w    ilw.w vi13, 3(vi05)
    mulax.xyzw ACC, vf05, vf27x     lq.xyzw vf20, 0(vi10)
    madday.xyzw ACC, vf06, vf27y    lq.xyzw vf21, 0(vi11)
    maddaz.xyzw ACC, vf07, vf27z    lq.xyzw vf22, 0(vi12)
    maddw.xyzw vf27, vf08, vf00w    lq.xyzw vf23, 0(vi13)
    mulax.xyzw ACC, vf20, vf31x     div Q, vf00w, vf26w                  ; Q = 1 / vf26.w
    madday.xyzw ACC, vf21, vf31y    lq.xyzw vf20, 1(vi10)
    maddaz.xyzw ACC, vf22, vf31z    lq.xyzw vf21, 1(vi11)
    clipw.xyz vf27, vf27w           lq.xyzw vf22, 1(vi12)                ; clip flags: vf27.xyz against +-vf27.w
    maddw.xyzw vf16, vf23, vf31w    lq.xyzw vf23, 1(vi13)
    mulax.xyzw ACC, vf20, vf31x     lq.xyzw vf20, 2(vi10)
    madday.xyzw ACC, vf21, vf31y    lq.xyzw vf21, 2(vi11)
    maddaz.xyzw ACC, vf22, vf31z    lq.xyzw vf22, 2(vi12)
    mulq.xyzw vf26, vf26, Q         mfp.w vf28, P
    mulq.xyz vf30, vf30, Q          fcand vi01, 0x03ffff                 ; vi01 = 1: one of the last three vertices is outside the clip volume
    maddw.xyzw vf17, vf23, vf31w    ibeq vi01, vi00, blended_in_view
    nop                             lq.xyzw vf23, 2(vi13)
    nop                             iaddiu vi14, vi00, 32767             ; ADC: 0x7FFF + 1 = 0x8000, so the GS draws no triangle ending here
    nop                             iaddiu vi14, vi14, 1
    ; the last three vertices are all inside the clip volume
blended_in_view:
    mulw.xyz vf24, vf28, vf28w      lq.xyzw vf28, 1(vi05)
    ftoi4.xyzw vf26, vf26           isw.w vi14, 2(vi04)                  ; to 12.4 fixed point (GS XYZ)
    nop                             ilw.w vi09, 0(vi05)
    nop                             nop
    mulax.xyz ACC, vf09, vf24x      nop
    madday.xyz ACC, vf10, vf24y     sq.xyz vf26, 2(vi04)
    maddz.xyz vf24, vf11, vf24z     lq.xyzw vf27, 0(vi05)
    nop                             sq.xyzw vf30, 0(vi04)
    nop                             iaddi vi07, vi07, -1
    mulax.xyzw ACC, vf20, vf31x     iaddiu vi14, vi09, 0
    maxx.xyzw vf24, vf24, vf00x     lq.xyzw vf20, 3(vi10)
    madday.xyzw ACC, vf21, vf31y    lq.xyzw vf21, 3(vi11)
    maddaz.xyzw ACC, vf22, vf31z    lq.xyzw vf22, 3(vi12)
    maddw.xyzw vf18, vf23, vf31w    lq.xyzw vf23, 3(vi13)
    mulax.xyzw ACC, vf12, vf24x     lq.xyzw vf30, 2(vi05)
    madday.xyzw ACC, vf13, vf24y    nop
    maddz.xyzw vf24, vf14, vf24z    nop
    mulax.xyz ACC, vf16, vf28x      nop
    madday.xyz ACC, vf17, vf28y     nop
    maddz.xyz vf28, vf18, vf28z     nop
    add.xyzw vf24, vf24, vf15       nop
    mulax.xyzw ACC, vf20, vf31x     nop
    madday.xyzw ACC, vf21, vf31y    nop
    maddaz.xyzw ACC, vf22, vf31z    erleng.xyz P, vf28
    minii.xyzw vf24, vf24, I        nop
    maddw.xyzw vf19, vf23, vf31w    nop
    mulax.xyzw ACC, vf16, vf27x     nop
    madday.xyzw ACC, vf17, vf27y    nop
    ftoi0.xyz vf24, vf24            iaddiu vi05, vi05, 5
    maddaz.xyzw ACC, vf18, vf27z    iaddiu vi04, vi04, 3
    maddw.xyzw vf27, vf19, vf00w    isw.w vi15, -2(vi04)
    nop                             ibne vi07, vi00, blended_loop
    nop                             sq.xyz vf24, -2(vi04)
    ; the epilogue: the vertices left in the delay line
    nop                             lqd.xyzw vf16, (--vi04)
    nop                             lqd.xyzw vf17, (--vi04)
    nop                             lqd.xyzw vf18, (--vi04)
    nop                             lqd.xyzw vf19, (--vi04)
    nop                             lqd.xyzw vf20, (--vi04)
    nop                             lqd.xyzw vf21, (--vi04)
    nop                             sq.xyzw vf16, 1020(vi00)
    nop                             sq.xyzw vf17, 1019(vi00)
    nop                             sq.xyzw vf18, 1018(vi00)
    nop                             sq.xyzw vf19, 1023(vi00)
    nop                             sq.xyzw vf20, 1022(vi00)
    nop                             sq.xyzw vf21, 1021(vi00)
    nop                             xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             nop
    nop                             nop                               [E] ; end: the next MSCNT continues at blended_cont
    nop                             nop

    ; the next MSCNT continues here
blended_cont:
    nop                             b batch                              ; the next batch
    nop                             nop
.endprogram

;=======================================================================================
; Vu1Prog02: three lights, material colour, no vertex colours, second colour
;
; gVu1ProgInfo02 (bones.c): 118 pairs (944 bytes), batches of up to 3968 bytes;
; Vu1_SelectProgram's key 0x20202, rigid models (0x21035, 0x121035).
; Setup Vu1Pkt_LV: an UNPACK of 17 qwords to VU 0, then MSCALF 0:
;   0        colour: gGsColorF, RGB scaled by the model's brightness: vf28
;   1        second colour: gGsColor2F: vf16
;   2-5      gMtxSlots x gMtxView x gMtxProjClip: model to screen (XYZ after the divide by w): vf01-vf04
;   6-9      the matrix above x gViewportMtx: model to the clip test's space: vf05-vf08
;   10-12    light directions (model space, negated): vf09-vf11
;   13-16    light colours (three lights and the ambient): vf24-vf27
; Vertices: gVu1ProgLayouts[0], 3 qwords: position, normal, texture coordinates.
; Batches at VU 0x11 and 0x11 + 0x1f4 (XTOP); the output follows each.
;=======================================================================================
.program Vu1Prog02
.base 0x11
.offset 0x1f4

    ; MSCALF 0: the setup's constants into registers
init:
    nop                             lq.xyzw vf01, 2(vi00)
    nop                             lq.xyzw vf02, 3(vi00)
    nop                             lq.xyzw vf03, 4(vi00)
    nop                             lq.xyzw vf04, 5(vi00)
    nop                             lq.xyzw vf05, 6(vi00)
    nop                             lq.xyzw vf06, 7(vi00)
    nop                             lq.xyzw vf07, 8(vi00)
    nop                             lq.xyzw vf08, 9(vi00)
    nop                             lq.xyzw vf09, 10(vi00)
    nop                             lq.xyzw vf10, 11(vi00)
    nop                             lq.xyzw vf11, 12(vi00)
    nop                             lq.xyzw vf16, 1(vi00)
    nop                             nop                               [E] ; end: constants loaded
    nop                             nop

    ; MSCNT: one batch at XTOP; qword 0's x is its type, qword 1 a GIF tag
batch:
    nop                             xtop vi02                            ; vi02: the batch (BASE, or BASE + OFFSET: double buffer)
    nop                             iaddiu vi05, vi02, 0
    nop                             iaddiu vi03, vi02, 248               ; vi03: the output, 248 qwords after the batch
    nop                             ilwr.x vi06, (vi05)                  ; the batch type (qword 0)
    nop                             iaddiu vi05, vi05, 1
    nop                             ilwr.x vi08, (vi05)                  ; the GIF tag (qword 1): NLOOP, EOP
    nop                             iaddiu vi04, vi03, 0
    nop                             iaddiu vi11, vi00, 32767             ; 0x7FFF: the NLOOP mask
    nop                             lq.xyzw vf31, 0(vi05)
    nop                             iand vi07, vi11, vi08
    nop                             iaddiu vi11, vi00, 1
    nop                             iaddiu vi05, vi05, 1
    nop                             ibeq vi11, vi06, vertices
    nop                             sqi.xyzw vf31, (vi04++)

    ; a register block: the GIF tag and its NLOOP qwords (A+D) go through to the output
copy_regs:
    nop                             lq.xyzw vf30, 0(vi05)
    nop                             iaddi vi07, vi07, -1
    nop                             iaddiu vi05, vi05, 1
    nop                             ibne vi07, vi00, copy_regs
    nop                             sqi.xyzw vf30, (vi04++)
    nop                             lqi.xyzw vf29, (vi05++)
    nop                             lq.xyzw vf24, 13(vi00)
    nop                             lq.xyzw vf25, 14(vi00)
    nop                             lq.xyzw vf26, 15(vi00)
    nop                             lq.xyzw vf27, 16(vi00)
    nop                             lq.xyzw vf28, 0(vi00)
    mul.xyzw vf24, vf29, vf24       nop
    mul.xyzw vf25, vf29, vf25       lqi.xyzw vf30, (vi05++)
    mul.xyzw vf26, vf29, vf26       nop
    add.xyzw vf23, vf27, vf28       loi 128.0                            ; I = 128.0: the colour clamp (0x80 is 1.0 on the GS)
    muli.xyzw vf12, vf24, I         nop
    mul.xyzw vf29, vf29, vf16       nop
    muli.xyzw vf13, vf25, I         nop
    muli.xyzw vf14, vf26, I         nop
    mul.xyzw vf15, vf23, vf30       nop
    ftoi0.xyzw vf29, vf29           nop
    minii.xyzw vf12, vf12, I        nop
    minii.xyzw vf13, vf13, I        nop
    minii.xyzw vf14, vf14, I        nop
    minii.xyzw vf15, vf15, I        mtir vi15, vf29w
    nop                             xgkick vi03                       [E] ; end: the next MSCNT continues at copy_regs_cont
    nop                             nop

    ; the next MSCNT continues here
copy_regs_cont:
    nop                             b batch                              ; the next batch
    nop                             nop

    ; type 1: a strip of NLOOP vertices
vertices:
    nop                             loi 128.0                            ; I = 128.0: the colour clamp (0x80 is 1.0 on the GS)
    nop                             iaddiu vi08, vi08, 2                 ; NLOOP + 2: the delay line's last vertices go out first
    nop                             isw.x vi08, -1(vi04)
    nop                             lq.xyzw vf30, 1(vi05)
    nop                             lq.xyzw vf29, 0(vi05)
    nop                             ilw.w vi09, 0(vi05)                  ; vi09: the position's w word, XYZF2's w (F, ADC) as the model has it
    nop                             lq.xyzw vf31, 2(vi05)
    mulax.xyzw ACC, vf09, vf30x     iaddiu vi05, vi05, 3
    madday.xyzw ACC, vf10, vf30y    lq.xyzw vf17, 1021(vi00)
    maddz.xyzw vf26, vf11, vf30z    lq.xyzw vf18, 1022(vi00)
    mulax.xyzw ACC, vf01, vf29x     lq.xyzw vf19, 1023(vi00)
    madday.xyzw ACC, vf02, vf29y    lq.xyzw vf20, 1018(vi00)
    maddaz.xyzw ACC, vf03, vf29z    sqi.xyzw vf17, (vi04++)
    maxx.xyzw vf26, vf26, vf00x     sqi.xyzw vf18, (vi04++)
    nop                             nop
    ; one vertex per pass, software-pipelined through the delay line
vertices_loop:
    nop                             nop
    maddw.xyzw vf25, vf04, vf00w    lq.xyzw vf22, 1020(vi00)
    mulax.xyzw ACC, vf12, vf26x     lq.xyzw vf21, 1019(vi00)
    madday.xyzw ACC, vf13, vf26y    sqi.xyzw vf19, (vi04++)
    maddz.xyzw vf27, vf14, vf26z    sq.xyzw vf20, 1021(vi00)
    mulax.xyzw ACC, vf05, vf29x     div Q, vf00w, vf25w                  ; Q = 1 / vf25.w
    madday.xyzw ACC, vf06, vf29y    sq.xyzw vf22, 1023(vi00)
    maddaz.xyzw ACC, vf07, vf29z    sq.xyzw vf21, 1022(vi00)
    add.xyzw vf27, vf27, vf15       iaddiu vi14, vi09, 0
    maddw.xyzw vf23, vf08, vf00w    lq.xyzw vf30, 1(vi05)
    nop                             lq.xyzw vf29, 0(vi05)
    nop                             ilw.w vi09, 0(vi05)
    minii.xyzw vf27, vf27, I        iaddiu vi05, vi05, 3
    mulq.xyzw vf25, vf25, Q         lq.xyzw vf17, 1021(vi00)
    clipw.xyz vf23, vf23w           lq.xyzw vf18, 1022(vi00)             ; clip flags: vf23.xyz against +-vf23.w
    mulq.xyz vf28, vf31, Q          lq.xyzw vf19, 1023(vi00)
    mul.xyzw vf27, vf27, vf16       iaddi vi07, vi07, -1
    ftoi4.xyzw vf25, vf25           sqi.xyzw vf17, (vi04++)              ; to 12.4 fixed point (GS XYZ)
    mulax.xyzw ACC, vf09, vf30x     sqi.xyzw vf18, (vi04++)
    madday.xyzw ACC, vf10, vf30y    sq.xyzw vf28, 1018(vi00)
    ftoi0.xyzw vf27, vf27           lq.xyzw vf31, -1(vi05)
    maddz.xyzw vf26, vf11, vf30z    sq.xyz vf25, 1020(vi00)
    mulax.xyzw ACC, vf01, vf29x     lq.xyzw vf20, 1018(vi00)
    madday.xyzw ACC, vf02, vf29y    isw.w vi15, 1019(vi00)
    maddaz.xyzw ACC, vf03, vf29z    fcand vi01, 0x03ffff                 ; vi01 = 1: one of the last three vertices is outside the clip volume
    maxx.xyzw vf26, vf26, vf00x     ibeq vi01, vi00, vertices_in_view
    nop                             sq.xyz vf27, 1019(vi00)
    nop                             iaddiu vi14, vi00, 32767             ; ADC: 0x7FFF + 1 = 0x8000, so the GS draws no triangle ending here
    nop                             iaddiu vi14, vi14, 1
    ; the last three vertices are all inside the clip volume
vertices_in_view:
    nop                             ibne vi07, vi00, vertices_loop
    nop                             isw.w vi14, 1020(vi00)
    ; the epilogue: the vertices left in the delay line
    nop                             lq.xyzw vf19, 1023(vi00)
    nop                             lq.xyzw vf20, 1018(vi00)
    nop                             lq.xyzw vf21, 1019(vi00)
    nop                             lq.xyzw vf22, 1020(vi00)
    nop                             sqi.xyzw vf19, (vi04++)
    nop                             sqi.xyzw vf20, (vi04++)
    nop                             sqi.xyzw vf21, (vi04++)
    nop                             sqi.xyzw vf22, (vi04++)
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             xgkick vi03                       [E] ; end: the next MSCNT continues at vertices_cont
    nop                             nop

    ; the next MSCNT continues here
vertices_cont:
    nop                             b batch                              ; the next batch
    nop                             nop
.endprogram

;=======================================================================================
; Vu1Prog03: three lights, normals (key bit 0x20), material colour, no vertex colours
;
; gVu1ProgInfo03 (bones.c): 142 pairs (1136 bytes), batches of up to 3968 bytes;
; Vu1_SelectProgram's key 0x222, rigid models (0x21035, 0x121035).
; Setup Vu1Pkt_L: an UNPACK of 16 qwords to VU 0, then MSCALF 0:
;   0        colour: gGsColorF, RGB scaled by the model's brightness: vf28
;   1-4      gMtxSlots x gMtxView x gMtxProjClip: model to screen (XYZ after the divide by w): vf01-vf04
;   5-8      the matrix above x gViewportMtx: model to the clip test's space: vf05-vf08
;   9-11     light directions (model space, negated): vf09-vf11
;   12-15    light colours (three lights and the ambient): vf24-vf27
; Vertices: gVu1ProgLayouts[0], 3 qwords: position, normal, texture coordinates.
; Batches at VU 0x10 and 0x10 + 0x1f8 (XTOP); the output follows each.
;=======================================================================================
.program Vu1Prog03
.base 0x10
.offset 0x1f8

    ; MSCALF 0: the setup's constants into registers
init:
    nop                             lq.xyzw vf01, 1(vi00)
    nop                             lq.xyzw vf02, 2(vi00)
    nop                             lq.xyzw vf03, 3(vi00)
    nop                             lq.xyzw vf04, 4(vi00)
    nop                             lq.xyzw vf05, 5(vi00)
    nop                             lq.xyzw vf06, 6(vi00)
    nop                             lq.xyzw vf07, 7(vi00)
    nop                             lq.xyzw vf08, 8(vi00)
    nop                             lq.xyzw vf09, 9(vi00)
    nop                             lq.xyzw vf10, 10(vi00)
    nop                             lq.xyzw vf11, 11(vi00)
    nop                             nop                               [E] ; end: constants loaded
    nop                             nop

    ; MSCNT: one batch at XTOP; qword 0's x is its type, qword 1 a GIF tag
batch:
    nop                             xtop vi02                            ; vi02: the batch (BASE, or BASE + OFFSET: double buffer)
    nop                             iaddiu vi05, vi02, 0
    nop                             iaddiu vi03, vi02, 248               ; vi03: the output, 248 qwords after the batch
    nop                             ilwr.x vi06, (vi05)                  ; the batch type (qword 0)
    nop                             iaddiu vi05, vi05, 1
    nop                             ilwr.x vi08, (vi05)                  ; the GIF tag (qword 1): NLOOP, EOP
    nop                             iaddiu vi04, vi03, 0
    nop                             iaddiu vi11, vi00, 32767             ; 0x7FFF: the NLOOP mask
    nop                             lq.xyzw vf31, 0(vi05)
    nop                             iand vi07, vi11, vi08
    nop                             iaddiu vi11, vi00, 1
    nop                             iaddiu vi05, vi05, 1
    nop                             ibeq vi11, vi06, vertices
    nop                             sqi.xyzw vf31, (vi04++)

    ; a register block: the GIF tag and its NLOOP qwords (A+D) go through to the output
copy_regs:
    nop                             lq.xyzw vf31, 0(vi05)
    nop                             iaddi vi07, vi07, -1
    nop                             iaddiu vi05, vi05, 1
    nop                             iaddiu vi04, vi04, 1
    nop                             ibne vi07, vi00, copy_regs
    nop                             sq.xyzw vf31, -1(vi04)
    nop                             lqi.xyzw vf29, (vi05++)
    nop                             lq.xyzw vf24, 12(vi00)
    nop                             lq.xyzw vf25, 13(vi00)
    nop                             lq.xyzw vf26, 14(vi00)
    nop                             lq.xyzw vf27, 15(vi00)
    nop                             lq.xyzw vf28, 0(vi00)
    mul.xyzw vf24, vf29, vf24       nop
    mul.xyzw vf25, vf29, vf25       nop
    mul.xyzw vf26, vf29, vf26       loi 128.0                            ; I = 128.0: the colour clamp (0x80 is 1.0 on the GS)
    add.xyzw vf23, vf27, vf28       nop
    ftoi0.xyzw vf29, vf29           lqi.xyzw vf30, (vi05++)
    muli.xyzw vf12, vf24, I         nop
    muli.xyzw vf13, vf25, I         nop
    muli.xyzw vf14, vf26, I         nop
    mul.xyzw vf15, vf23, vf30       mtir vi15, vf29w
    minii.xyzw vf12, vf12, I        nop
    minii.xyzw vf13, vf13, I        nop
    minii.xyzw vf14, vf14, I        nop
    minii.xyzw vf15, vf15, I        xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             nop                               [E] ; end: the next MSCNT continues at copy_regs_cont
    nop                             nop

    ; the next MSCNT continues here
copy_regs_cont:
    nop                             b batch                              ; the next batch
    nop                             nop

    ; type 1: a strip of NLOOP vertices
vertices:
    nop                             iaddiu vi08, vi08, 2                 ; NLOOP + 2: the delay line's last vertices go out first
    nop                             isw.x vi08, -1(vi04)
    nop                             lq.xyzw vf19, 1021(vi00)
    nop                             lq.xyzw vf20, 1022(vi00)
    nop                             lq.xyzw vf21, 1023(vi00)
    nop                             lq.xyzw vf22, 1018(vi00)
    nop                             lq.xyzw vf23, 1019(vi00)
    nop                             lq.xyzw vf24, 1020(vi00)
    nop                             lq.xyzw vf29, 0(vi05)
    nop                             lq.xyzw vf30, 1(vi05)
    nop                             lq.xyzw vf31, 2(vi05)
    nop                             sqi.xyzw vf19, (vi04++)
    mulax.xyzw ACC, vf01, vf29x     sqi.xyzw vf20, (vi04++)
    madday.xyzw ACC, vf02, vf29y    sqi.xyzw vf21, (vi04++)
    maddaz.xyzw ACC, vf03, vf29z    sqi.xyzw vf22, (vi04++)
    maddw.xyzw vf25, vf04, vf00w    sqi.xyzw vf23, (vi04++)
    mulax.xyzw ACC, vf05, vf29x     sqi.xyzw vf24, (vi04++)
    madday.xyzw ACC, vf06, vf29y    ilw.w vi09, 0(vi05)                  ; vi09: the position's w word, XYZF2's w (F, ADC) as the model has it
    maddaz.xyzw ACC, vf07, vf29z    iaddiu vi05, vi05, 3
    maddw.xyzw vf23, vf08, vf00w    loi 128.0                            ; I = 128.0: the colour clamp (0x80 is 1.0 on the GS)
    mulax.xyzw ACC, vf09, vf30x     div Q, vf00w, vf25w                  ; Q = 1 / vf25.w
    madday.xyzw ACC, vf10, vf30y    iaddiu vi14, vi09, 0
    maddz.xyzw vf22, vf11, vf30z    ilw.w vi09, 0(vi05)
    clipw.xyz vf23, vf23w           lq.xyzw vf29, 0(vi05)                ; clip flags: vf23.xyz against +-vf23.w
    ; one vertex per pass, software-pipelined through the delay line
vertices_loop:
    nop                             nop
    nop                             nop
    maxx.xyzw vf22, vf22, vf00x     nop
    mulq.xyzw vf25, vf25, Q         nop
    nop                             move.xyz vf16, vf17
    mulq.xyz vf24, vf31, Q          move.xyz vf17, vf18
    mulax.xyzw ACC, vf05, vf29x     nop
    madday.xyzw ACC, vf06, vf29y    move.xyz vf18, vf25
    ftoi4.xyzw vf25, vf25           lq.xyzw vf31, 2(vi05)                ; to 12.4 fixed point (GS XYZ)
    nop                             sq.xyzw vf24, 0(vi04)
    sub.xyz vf19, vf17, vf16        fcand vi01, 0x03ffff                 ; vi01 = 1: one of the last three vertices is outside the clip volume
    sub.xyz vf20, vf18, vf16        ibne vi01, vi00, vertices_skip
    maddaz.xyzw ACC, vf07, vf29z    sq.xyz vf25, 2(vi04)
    maddw.xyzw vf23, vf08, vf00w    ibne vi14, vi00, vertices_skip2
    nop                             nop
    opmula.xyz ACC, vf20, vf19      nop
    opmsub.xyz vf20, vf19, vf20     nop
    nop                             nop
    nop                             nop
    nop                             nop
    mulw.z vf20, vf20, vf30w        nop
    nop                             nop
    nop                             nop
    nop                             iaddiu vi01, vi00, 32
    nop                             fmand vi01, vi01
    nop                             ibeq vi01, vi00, vertices_skip2
    nop                             nop
vertices_skip:
    nop                             iaddiu vi14, vi00, 32767             ; ADC: 0x7FFF + 1 = 0x8000, so the GS draws no triangle ending here
    nop                             iaddiu vi14, vi14, 1
vertices_skip2:
    mulax.xyz ACC, vf12, vf22x      isw.w vi14, 2(vi04)
    madday.xyz ACC, vf13, vf22y     iaddi vi07, vi07, -1
    maddaz.xyz ACC, vf14, vf22z     isw.w vi15, 1(vi04)
    maddw.xyz vf21, vf15, vf00w     lq.xyzw vf30, 1(vi05)
    mulax.xyzw ACC, vf01, vf29x     iaddiu vi05, vi05, 3
    madday.xyzw ACC, vf02, vf29y    iaddiu vi14, vi09, 0
    maddaz.xyzw ACC, vf03, vf29z    ilw.w vi09, 0(vi05)
    minii.xyzw vf21, vf21, I        lq.xyzw vf29, 0(vi05)
    maddw.xyzw vf25, vf04, vf00w    nop
    mulax.xyzw ACC, vf09, vf30x     nop
    madday.xyzw ACC, vf10, vf30y    nop
    ftoi0.xyzw vf21, vf21           iaddiu vi04, vi04, 3
    maddz.xyzw vf22, vf11, vf30z    div Q, vf00w, vf25w
    clipw.xyz vf23, vf23w           nop
    nop                             ibne vi07, vi00, vertices_loop
    nop                             sq.xyz vf21, -2(vi04)
    ; the epilogue: the vertices left in the delay line
    nop                             lqd.xyzw vf19, (--vi04)
    nop                             lqd.xyzw vf20, (--vi04)
    nop                             lqd.xyzw vf21, (--vi04)
    nop                             lqd.xyzw vf22, (--vi04)
    nop                             lqd.xyzw vf23, (--vi04)
    nop                             lqd.xyzw vf24, (--vi04)
    nop                             sq.xyzw vf19, 1020(vi00)
    nop                             sq.xyzw vf20, 1019(vi00)
    nop                             sq.xyzw vf21, 1018(vi00)
    nop                             sq.xyzw vf22, 1023(vi00)
    nop                             sq.xyzw vf23, 1022(vi00)
    nop                             sq.xyzw vf24, 1021(vi00)
    nop                             xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             nop                               [E] ; end: the next MSCNT continues at vertices_cont
    nop                             nop

    ; the next MSCNT continues here
vertices_cont:
    nop                             b batch                              ; the next batch
    nop                             nop
.endprogram

;=======================================================================================
; Vu1Prog04: skinned, three lights, normals (key bit 0x20), material colour, no vertex colours
;
; gVu1ProgInfo04 (bones.c): 388 pairs (3104 bytes), batches of up to 3200 bytes;
; Vu1_SelectProgram's key 0x222, skinned models (0x321135, 0x221135).
; Setup Vu1Pkt_SL: an UNPACK of 240 qwords to VU 0, then MSCALF 0:
;   0        colour: gGsColorF, RGB scaled by the model's brightness: vf28
;   1-4      gMtxView x gMtxProjClip: world to screen (XYZ after the divide by w): vf01-vf04
;   5-8      gMtxView x gViewportMtx: world to the clip test's space: vf05-vf08
;   9-11     light directions (world space, negated): vf01-vf03
;   12-15    light colours (three lights and the ambient): vf24-vf27
;   16-143   bone matrices: the 32 gMtxSlots the model's mask (e+0x54) selects
;   144-239  init writes each bone's normal matrix here (its rows normalised), three qwords each
; Vertices: gVu1ProgLayouts[8], 5 qwords: position, normal, texture coordinates, bone indices, bone weights.
; Batches at VU 0xf0 and 0xf0 + 0x185 (XTOP); the output follows each.
;=======================================================================================
.program Vu1Prog04
.base 0xf0
.offset 0x185

    ; MSCALF 0: the setup's constants into registers
init:
    nop                             iaddiu vi10, vi00, 16
    nop                             lq.xyzw vf07, 0(vi10)
    nop                             lq.xyzw vf08, 1(vi10)
    nop                             iaddiu vi07, vi00, 32
    nop                             iaddiu vi11, vi00, 144
    addx.x vf04, vf00, vf07x        nop
    addy.x vf05, vf00, vf07y        nop
    addz.x vf06, vf00, vf07z        lq.xyzw vf09, 2(vi10)
    addx.y vf04, vf00, vf08x        nop
    addy.y vf05, vf00, vf08y        nop
    addz.y vf06, vf00, vf08z        nop
    addx.z vf04, vf00, vf09x        lq.xyzw vf01, 9(vi00)
    addy.z vf05, vf00, vf09y        lq.xyzw vf02, 10(vi00)
    addz.z vf06, vf00, vf09z        lq.xyzw vf03, 11(vi00)
    nop                             nop
    mulax.xyz ACC, vf04, vf01x      nop
    madday.xyz ACC, vf05, vf01y     nop
    maddz.xyz vf27, vf06, vf01z     nop
    mulax.xyz ACC, vf04, vf02x      nop
    madday.xyz ACC, vf05, vf02y     nop
    maddz.xyz vf28, vf06, vf02z     nop
    mul.xyz vf10, vf27, vf27        nop
    mulax.xyz ACC, vf04, vf03x      nop
    madday.xyz ACC, vf05, vf03y     nop
    maddz.xyz vf29, vf06, vf03z     nop
    addy.x vf10, vf10, vf10y        move.xyzw vf21, vf27
init_loop:
    nop                             nop
    mul.xyz vf11, vf28, vf28        move.xyzw vf22, vf28
    mul.xyz vf12, vf29, vf29        move.xyzw vf23, vf29
    nop                             nop
    addz.x vf10, vf10, vf10z        nop
    addy.x vf11, vf11, vf11y        nop
    addy.x vf12, vf12, vf12y        nop
    nop                             nop
    nop                             rsqrt Q, vf00w, vf10x
    addz.x vf11, vf11, vf11z        iaddiu vi11, vi11, 3
    addz.x vf12, vf12, vf12z        iaddiu vi10, vi10, 4
    nop                             iaddi vi07, vi07, -1
    nop                             lq.xyzw vf07, 0(vi10)
    nop                             ersqrt P, vf11x
    nop                             lq.xyzw vf08, 1(vi10)
    nop                             lq.xyzw vf09, 2(vi10)
    addx.x vf04, vf00, vf07x        nop
    addy.x vf05, vf00, vf07y        nop
    addz.x vf06, vf00, vf07z        nop
    addx.y vf04, vf00, vf08x        nop
    addy.y vf05, vf00, vf08y        nop
    mulq.xyz vf21, vf21, Q          rsqrt Q, vf00w, vf12x
    addz.y vf06, vf00, vf08z        nop
    addx.z vf04, vf00, vf09x        nop
    addy.z vf05, vf00, vf09y        nop
    addz.z vf06, vf00, vf09z        nop
    addx.x vf24, vf00, vf21x        nop
    addy.x vf25, vf00, vf21y        nop
    addz.x vf26, vf00, vf21z        nop
    mulax.xyz ACC, vf04, vf01x      nop
    madday.xyz ACC, vf05, vf01y     nop
    maddz.xyz vf27, vf06, vf01z     mfp.x vf11, P
    mulax.xyz ACC, vf04, vf02x      nop
    madday.xyz ACC, vf05, vf02y     nop
    mulq.xyz vf23, vf23, Q          nop
    mulx.xyz vf22, vf22, vf11x      nop
    mul.xyz vf10, vf27, vf27        nop
    maddz.xyz vf28, vf06, vf02z     nop
    addx.z vf24, vf00, vf23x        nop
    addx.y vf24, vf00, vf22x        nop
    addy.z vf25, vf00, vf23y        nop
    addy.y vf25, vf00, vf22y        nop
    addz.z vf26, vf00, vf23z        nop
    addz.y vf26, vf00, vf22z        sq.xyzw vf24, -3(vi11)
    mulax.xyz ACC, vf04, vf03x      move.xyzw vf21, vf27
    madday.xyz ACC, vf05, vf03y     sq.xyzw vf25, -2(vi11)
    maddz.xyz vf29, vf06, vf03z     ibne vi07, vi00, init_loop
    addy.x vf10, vf10, vf10y        sq.xyzw vf26, -1(vi11)
    addx.x vf09, vf00, vf01x        lq.xyzw vf04, 4(vi00)
    addy.x vf10, vf00, vf01y        lq.xyzw vf05, 5(vi00)
    addz.x vf11, vf00, vf01z        lq.xyzw vf01, 1(vi00)
    addx.y vf09, vf00, vf02x        lq.xyzw vf06, 6(vi00)
    addy.y vf10, vf00, vf02y        lq.xyzw vf07, 7(vi00)
    addz.y vf11, vf00, vf02z        lq.xyzw vf02, 2(vi00)
    addx.z vf09, vf00, vf03x        lq.xyzw vf08, 8(vi00)
    addy.z vf10, vf00, vf03y        nop
    addz.z vf11, vf00, vf03z        lq.xyzw vf03, 3(vi00)
    nop                             nop
    nop                             sq.xyzw vf09, 9(vi00)
    nop                             sq.xyzw vf10, 10(vi00)
    nop                             sq.xyzw vf11, 11(vi00)
    nop                             nop                               [E] ; end: constants loaded
    nop                             nop

    ; MSCNT: one batch at XTOP; qword 0's x is its type, qword 1 a GIF tag
batch:
    nop                             xtop vi02                            ; vi02: the batch (BASE, or BASE + OFFSET: double buffer)
    nop                             iaddiu vi05, vi02, 0
    nop                             iaddiu vi03, vi02, 200               ; vi03: the output, 200 qwords after the batch
    nop                             ilwr.x vi06, (vi05)                  ; the batch type (qword 0)
    nop                             iaddiu vi05, vi05, 1
    nop                             ilwr.x vi08, (vi05)                  ; the GIF tag (qword 1): NLOOP, EOP
    nop                             iaddiu vi04, vi03, 0
    nop                             iaddiu vi11, vi00, 32767             ; 0x7FFF: the NLOOP mask
    nop                             lq.xyzw vf31, 0(vi05)
    nop                             iand vi07, vi11, vi08
    nop                             iaddiu vi11, vi00, 1
    nop                             iaddiu vi05, vi05, 1
    nop                             ibeq vi11, vi06, rigid
    nop                             sqi.xyzw vf31, (vi04++)
    nop                             iaddiu vi11, vi00, 2
    nop                             nop
    nop                             ibeq vi11, vi06, blended
    nop                             nop

    ; a register block: the GIF tag and its NLOOP qwords (A+D) go through to the output
copy_regs:
    nop                             lqi.xyzw vf31, (vi05++)
    nop                             iaddi vi07, vi07, -1
    nop                             iaddiu vi04, vi04, 1
    nop                             ibne vi07, vi00, copy_regs
    nop                             sq.xyzw vf31, -1(vi04)
    nop                             lqi.xyzw vf29, (vi05++)
    nop                             lq.xyzw vf24, 12(vi00)
    nop                             lq.xyzw vf25, 13(vi00)
    nop                             lq.xyzw vf26, 14(vi00)
    ftoi0.xyzw vf20, vf29           lq.xyzw vf27, 15(vi00)
    mul.xyzw vf24, vf29, vf24       lq.xyzw vf28, 0(vi00)
    mul.xyzw vf25, vf29, vf25       lqi.xyzw vf30, (vi05++)
    mul.xyzw vf26, vf29, vf26       loi 128.0                            ; I = 128.0: the colour clamp (0x80 is 1.0 on the GS)
    nop                             mtir vi15, vf20w
    add.xyzw vf23, vf27, vf28       nop
    muli.xyzw vf12, vf24, I         nop
    muli.xyzw vf13, vf25, I         nop
    muli.xyzw vf14, vf26, I         nop
    mul.xyzw vf15, vf23, vf30       nop
    minii.xyzw vf12, vf12, I        nop
    minii.xyzw vf13, vf13, I        nop
    minii.xyzw vf14, vf14, I        nop
    minii.xyzw vf15, vf15, I        xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             nop                               [E] ; end: the next MSCNT continues at copy_regs_cont
    nop                             nop

    ; the next MSCNT continues here
copy_regs_cont:
    nop                             b batch                              ; the next batch
    nop                             nop

    ; type 1: vertices of one bone each (qword 3: the bone's matrix addresses)
rigid:
    nop                             iaddiu vi08, vi08, 2                 ; NLOOP + 2: the delay line's last vertices go out first
    nop                             isw.x vi08, -1(vi04)
    nop                             lq.xyzw vf19, 1021(vi00)
    nop                             lq.xyzw vf20, 1022(vi00)
    nop                             lq.xyzw vf21, 1023(vi00)
    nop                             lq.xyzw vf22, 1018(vi00)
    nop                             lq.xyzw vf23, 1019(vi00)
    nop                             lq.xyzw vf24, 1020(vi00)
    nop                             sqi.xyzw vf19, (vi04++)
    nop                             sqi.xyzw vf20, (vi04++)
    nop                             sqi.xyzw vf21, (vi04++)
    nop                             sqi.xyzw vf22, (vi04++)
    nop                             lq.xyzw vf29, 0(vi05)
    nop                             ilw.x vi10, 3(vi05)
    nop                             ilw.y vi11, 3(vi05)
    nop                             sqi.xyzw vf23, (vi04++)
    nop                             sqi.xyzw vf24, (vi04++)
    nop                             lq.xyzw vf19, 0(vi10)
    nop                             lq.xyzw vf20, 1(vi10)
    nop                             lq.xyzw vf21, 2(vi10)
    nop                             lq.xyzw vf22, 3(vi10)
    mulax.xyzw ACC, vf19, vf29x     ilw.w vi09, 0(vi05)                  ; vi09: the position's w word, XYZF2's w (F, ADC) as the model has it
    madday.xyzw ACC, vf20, vf29y    lq.xyzw vf30, 1(vi05)
    maddaz.xyzw ACC, vf21, vf29z    lq.xyzw vf31, 2(vi05)
    maddw.xyzw vf29, vf22, vf00w    iaddiu vi05, vi05, 5
    nop                             lq.xyzw vf23, 0(vi11)
    nop                             lq.xyzw vf24, 1(vi11)
    nop                             lq.xyzw vf25, 2(vi11)
    mulax.xyzw ACC, vf01, vf29x     iaddiu vi14, vi09, 0
    madday.xyzw ACC, vf02, vf29y    ilw.x vi10, 3(vi05)
    maddaz.xyzw ACC, vf03, vf29z    ilw.y vi11, 3(vi05)
    maddw.xyzw vf28, vf04, vf00w    loi 128.0                            ; I = 128.0: the colour clamp (0x80 is 1.0 on the GS)
    ; one vertex per pass, software-pipelined through the delay line
rigid_loop:
    mulax.xyzw ACC, vf05, vf29x     nop
    madday.xyzw ACC, vf06, vf29y    nop
    maddaz.xyzw ACC, vf07, vf29z    nop
    maddw.xyzw vf29, vf08, vf00w    div Q, vf00w, vf28w                  ; Q = 1 / vf28.w
    nop                             nop
    nop                             nop
    nop                             nop
    clipw.xyz vf29, vf29w           lq.xyzw vf29, 0(vi05)                ; clip flags: vf29.xyz against +-vf29.w
    nop                             nop
    nop                             nop
    mulq.xyzw vf28, vf28, Q         nop
    mulq.xyz vf27, vf31, Q          lq.xyzw vf31, 2(vi05)
    nop                             move.xyz vf16, vf17
    nop                             move.xyz vf17, vf18
    nop                             move.xyz vf18, vf28
    ftoi4.xyzw vf28, vf28           sq.xyzw vf27, 0(vi04)                ; to 12.4 fixed point (GS XYZ)
    nop                             nop
    sub.xyz vf19, vf17, vf16        fcand vi01, 0x03ffff                 ; vi01 = 1: one of the last three vertices is outside the clip volume
    sub.xyz vf20, vf18, vf16        ibne vi01, vi00, rigid_skip
    nop                             sq.xyz vf28, 2(vi04)
    nop                             ibne vi14, vi00, rigid_skip2
    nop                             nop
    opmula.xyz ACC, vf20, vf19      nop
    opmsub.xyz vf20, vf19, vf20     nop
    nop                             nop
    nop                             nop
    nop                             nop
    mulw.z vf20, vf20, vf30w        nop
    nop                             nop
    nop                             nop
    nop                             iaddiu vi01, vi00, 32
    nop                             fmand vi01, vi01
    nop                             ibeq vi01, vi00, rigid_skip2
    nop                             nop
rigid_skip:
    nop                             iaddiu vi14, vi00, 32767             ; ADC: 0x7FFF + 1 = 0x8000, so the GS draws no triangle ending here
    nop                             iaddiu vi14, vi14, 1
rigid_skip2:
    mulax.xyz ACC, vf23, vf30x      isw.w vi14, 2(vi04)
    madday.xyz ACC, vf24, vf30y     iaddi vi07, vi07, -1
    maddz.xyz vf26, vf25, vf30z     lq.xyzw vf30, 1(vi05)
    nop                             isw.w vi15, 1(vi04)
    nop                             iaddiu vi04, vi04, 3
    nop                             ilw.w vi09, 0(vi05)
    maxx.xyzw vf26, vf26, vf00x     iaddiu vi05, vi05, 5
    nop                             lq.xyzw vf19, 0(vi10)
    nop                             lq.xyzw vf20, 1(vi10)
    nop                             lq.xyzw vf21, 2(vi10)
    mulax.xyz ACC, vf12, vf26x      lq.xyzw vf22, 3(vi10)
    madday.xyz ACC, vf13, vf26y     lq.xyzw vf23, 0(vi11)
    maddaz.xyz ACC, vf14, vf26z     lq.xyzw vf24, 1(vi11)
    maddw.xyz vf26, vf15, vf00w     lq.xyzw vf25, 2(vi11)
    mulax.xyzw ACC, vf19, vf29x     iaddiu vi14, vi09, 0
    madday.xyzw ACC, vf20, vf29y    ilw.x vi10, 3(vi05)
    maddaz.xyzw ACC, vf21, vf29z    ilw.y vi11, 3(vi05)
    minii.xyzw vf26, vf26, I        nop
    maddw.xyzw vf29, vf22, vf00w    nop
    nop                             nop
    nop                             nop
    ftoi0.xyz vf26, vf26            nop
    mulax.xyzw ACC, vf01, vf29x     nop
    madday.xyzw ACC, vf02, vf29y    nop
    maddaz.xyzw ACC, vf03, vf29z    ibne vi07, vi00, rigid_loop
    maddw.xyzw vf28, vf04, vf00w    sq.xyz vf26, -2(vi04)
    ; the epilogue: the vertices left in the delay line
    nop                             lqd.xyzw vf19, (--vi04)
    nop                             lqd.xyzw vf20, (--vi04)
    nop                             lqd.xyzw vf21, (--vi04)
    nop                             lqd.xyzw vf22, (--vi04)
    nop                             lqd.xyzw vf23, (--vi04)
    nop                             lqd.xyzw vf24, (--vi04)
    nop                             sq.xyzw vf19, 1020(vi00)
    nop                             sq.xyzw vf20, 1019(vi00)
    nop                             sq.xyzw vf21, 1018(vi00)
    nop                             sq.xyzw vf22, 1023(vi00)
    nop                             sq.xyzw vf23, 1022(vi00)
    nop                             sq.xyzw vf24, 1021(vi00)
    nop                             xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             nop                               [E] ; end: the next MSCNT continues at rigid_cont
    nop                             nop

    ; the next MSCNT continues here
rigid_cont:
    nop                             b batch                              ; the next batch
    nop                             nop

    ; type 2: vertices of four bones (qword 3: the matrix addresses, qword 4: the weights)
blended:
    nop                             iaddiu vi08, vi08, 2                 ; NLOOP + 2: the delay line's last vertices go out first
    nop                             isw.x vi08, -1(vi04)
    nop                             lq.xyzw vf19, 1021(vi00)
    nop                             lq.xyzw vf20, 1022(vi00)
    nop                             lq.xyzw vf21, 1023(vi00)
    nop                             lq.xyzw vf22, 1018(vi00)
    nop                             lq.xyzw vf23, 1019(vi00)
    nop                             lq.xyzw vf24, 1020(vi00)
    nop                             sqi.xyzw vf19, (vi04++)
    nop                             sqi.xyzw vf20, (vi04++)
    nop                             sqi.xyzw vf21, (vi04++)
    nop                             sqi.xyzw vf22, (vi04++)
    nop                             sqi.xyzw vf23, (vi04++)
    nop                             sqi.xyzw vf24, (vi04++)
    nop                             ilw.x vi10, 3(vi05)
    nop                             ilw.y vi11, 3(vi05)
    nop                             ilw.z vi12, 3(vi05)
    nop                             ilw.w vi13, 3(vi05)
    nop                             lq.xyzw vf31, 4(vi05)
    nop                             lq.xyzw vf23, 0(vi10)
    nop                             lq.xyzw vf24, 0(vi11)
    nop                             lq.xyzw vf25, 0(vi12)
    nop                             lq.xyzw vf26, 0(vi13)
    mulax.xyzw ACC, vf23, vf31x     lq.xyzw vf23, 1(vi10)
    madday.xyzw ACC, vf24, vf31y    lq.xyzw vf24, 1(vi11)
    maddaz.xyzw ACC, vf25, vf31z    lq.xyzw vf25, 1(vi12)
    maddw.xyzw vf19, vf26, vf31w    lq.xyzw vf26, 1(vi13)
    mulax.xyzw ACC, vf23, vf31x     lq.xyzw vf23, 2(vi10)
    madday.xyzw ACC, vf24, vf31y    lq.xyzw vf24, 2(vi11)
    maddaz.xyzw ACC, vf25, vf31z    lq.xyzw vf25, 2(vi12)
    maddw.xyzw vf20, vf26, vf31w    lq.xyzw vf26, 2(vi13)
    mulax.xyzw ACC, vf23, vf31x     lq.xyzw vf23, 3(vi10)
    madday.xyzw ACC, vf24, vf31y    lq.xyzw vf24, 3(vi11)
    maddaz.xyzw ACC, vf25, vf31z    lq.xyzw vf25, 3(vi12)
    maddw.xyzw vf21, vf26, vf31w    lq.xyzw vf26, 3(vi13)
    mulax.xyzw ACC, vf23, vf31x     lq.xyzw vf27, 0(vi05)
    madday.xyzw ACC, vf24, vf31y    nop
    maddaz.xyzw ACC, vf25, vf31z    nop
    maddw.xyzw vf22, vf26, vf31w    nop
    mulax.xyzw ACC, vf19, vf27x     lq.xyzw vf28, 1(vi05)
    madday.xyzw ACC, vf20, vf27y    loi 128.0                            ; I = 128.0: the colour clamp (0x80 is 1.0 on the GS)
    maddaz.xyzw ACC, vf21, vf27z    ilw.w vi09, 0(vi05)                  ; vi09: the position's w word, XYZF2's w (F, ADC) as the model has it
    maddw.xyzw vf27, vf22, vf00w    lq.xyzw vf30, 2(vi05)
    mulax.xyz ACC, vf19, vf28x      iaddiu vi05, vi05, 5
    ; one vertex per pass, software-pipelined through the delay line
blended_loop:
    madday.xyz ACC, vf20, vf28y     nop
    maddz.xyz vf22, vf21, vf28z     nop
    mulax.xyzw ACC, vf01, vf27x     nop
    madday.xyzw ACC, vf02, vf27y    nop
    maddaz.xyzw ACC, vf03, vf27z    nop
    maddw.xyzw vf26, vf04, vf00w    erleng.xyz P, vf22                   ; P = 1 / |vf22.xyz|
    mulax.xyzw ACC, vf05, vf27x     nop
    madday.xyzw ACC, vf06, vf27y    nop
    maddaz.xyzw ACC, vf07, vf27z    iaddiu vi14, vi09, 0
    maddw.xyzw vf27, vf08, vf00w    div Q, vf00w, vf26w                  ; Q = 1 / vf26.w
    nop                             ilw.w vi09, 0(vi05)
    nop                             ilw.x vi10, 3(vi05)
    nop                             ilw.y vi11, 3(vi05)
    clipw.xyz vf27, vf27w           lq.xyzw vf27, 0(vi05)                ; clip flags: vf27.xyz against +-vf27.w
    nop                             ilw.z vi12, 3(vi05)
    nop                             ilw.w vi13, 3(vi05)
    mulq.xyzw vf26, vf26, Q         lq.xyzw vf31, 4(vi05)
    mulq.xyz vf30, vf30, Q          iaddi vi07, vi07, -1
    nop                             move.xyz vf16, vf17
    nop                             move.xyz vf17, vf18
    nop                             move.xyz vf18, vf26
    ftoi4.xyzw vf26, vf26           sq.xyzw vf30, 0(vi04)                ; to 12.4 fixed point (GS XYZ)
    nop                             lq.xyzw vf30, 2(vi05)
    sub.xyz vf23, vf17, vf16        fcand vi01, 0x03ffff                 ; vi01 = 1: one of the last three vertices is outside the clip volume
    sub.xyz vf24, vf18, vf16        ibne vi01, vi00, blended_skip
    nop                             sq.xyz vf26, 2(vi04)
    nop                             ibne vi14, vi00, blended_skip2
    nop                             nop
    opmula.xyz ACC, vf24, vf23      nop
    opmsub.xyz vf24, vf23, vf24     nop
    nop                             nop
    nop                             nop
    nop                             nop
    mulw.z vf24, vf24, vf28w        nop
    nop                             nop
    nop                             nop
    nop                             iaddiu vi01, vi00, 32
    nop                             fmand vi01, vi01
    nop                             ibeq vi01, vi00, blended_skip2
    nop                             nop
blended_skip:
    nop                             iaddiu vi14, vi00, 32767             ; ADC: 0x7FFF + 1 = 0x8000, so the GS draws no triangle ending here
    nop                             iaddiu vi14, vi14, 1
blended_skip2:
    nop                             lq.xyzw vf23, 0(vi10)
    nop                             lq.xyzw vf24, 0(vi11)
    nop                             lq.xyzw vf25, 0(vi12)
    nop                             mfp.w vf22, P
    mulax.xyzw ACC, vf23, vf31x     lq.xyzw vf26, 0(vi13)
    madday.xyzw ACC, vf24, vf31y    lq.xyzw vf23, 1(vi10)
    maddaz.xyzw ACC, vf25, vf31z    lq.xyzw vf24, 1(vi11)
    mulw.xyz vf29, vf22, vf22w      lq.xyzw vf25, 1(vi12)
    maddw.xyzw vf19, vf26, vf31w    lq.xyzw vf26, 1(vi13)
    nop                             isw.w vi14, 2(vi04)
    nop                             isw.w vi15, 1(vi04)
    mulax.xyz ACC, vf09, vf29x      iaddiu vi04, vi04, 3
    madday.xyz ACC, vf10, vf29y     lq.xyzw vf28, 1(vi05)
    maddz.xyz vf29, vf11, vf29z     iaddiu vi05, vi05, 5
    mulax.xyzw ACC, vf23, vf31x     lq.xyzw vf23, 2(vi10)
    madday.xyzw ACC, vf24, vf31y    lq.xyzw vf24, 2(vi11)
    maddaz.xyzw ACC, vf25, vf31z    lq.xyzw vf25, 2(vi12)
    maxx.xyzw vf29, vf29, vf00x     nop
    maddw.xyzw vf20, vf26, vf31w    lq.xyzw vf26, 2(vi13)
    nop                             nop
    nop                             nop
    mulax.xyzw ACC, vf12, vf29x     nop
    madday.xyzw ACC, vf13, vf29y    nop
    maddz.xyzw vf29, vf14, vf29z    nop
    mulax.xyzw ACC, vf23, vf31x     lq.xyzw vf23, 3(vi10)
    madday.xyzw ACC, vf24, vf31y    lq.xyzw vf24, 3(vi11)
    maddaz.xyzw ACC, vf25, vf31z    lq.xyzw vf25, 3(vi12)
    add.xyzw vf29, vf29, vf15       nop
    maddw.xyzw vf21, vf26, vf31w    lq.xyzw vf26, 3(vi13)
    mulax.xyzw ACC, vf23, vf31x     nop
    madday.xyzw ACC, vf24, vf31y    nop
    minii.xyzw vf29, vf29, I        nop
    maddaz.xyzw ACC, vf25, vf31z    nop
    maddw.xyzw vf22, vf26, vf31w    nop
    mulax.xyzw ACC, vf19, vf27x     nop
    ftoi0.xyz vf29, vf29            nop
    madday.xyzw ACC, vf20, vf27y    nop
    maddaz.xyzw ACC, vf21, vf27z    nop
    maddw.xyzw vf27, vf22, vf00w    ibne vi07, vi00, blended_loop
    mulax.xyz ACC, vf19, vf28x      sq.xyz vf29, -2(vi04)
    ; the epilogue: the vertices left in the delay line
    nop                             lqd.xyzw vf19, (--vi04)
    nop                             lqd.xyzw vf20, (--vi04)
    nop                             lqd.xyzw vf21, (--vi04)
    nop                             lqd.xyzw vf22, (--vi04)
    nop                             lqd.xyzw vf23, (--vi04)
    nop                             lqd.xyzw vf24, (--vi04)
    nop                             sq.xyzw vf19, 1020(vi00)
    nop                             sq.xyzw vf20, 1019(vi00)
    nop                             sq.xyzw vf21, 1018(vi00)
    nop                             sq.xyzw vf22, 1023(vi00)
    nop                             sq.xyzw vf23, 1022(vi00)
    nop                             sq.xyzw vf24, 1021(vi00)
    nop                             xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             nop                               [E] ; end: the next MSCNT continues at blended_cont
    nop                             nop

    ; the next MSCNT continues here
blended_cont:
    nop                             b batch                              ; the next batch
    nop                             nop
.endprogram

;=======================================================================================
; Vu1Prog05: normals (key bit 0x20), second colour
;
; gVu1ProgInfo05 (bones.c): 102 pairs (816 bytes), batches of up to 3200 bytes;
; Vu1_SelectProgram's key 0x20020, rigid models (0x21035, 0x121035).
; Setup Vu1Pkt_V: an UNPACK of 10 qwords to VU 0, then MSCALF 0:
;   0        colour: gGsColorF, RGB scaled by the model's brightness
;   1        second colour: gGsColor2F: vf09
;   2-5      gMtxSlots x gMtxView x gMtxProjClip: model to screen (XYZ after the divide by w): vf01-vf04
;   6-9      the matrix above x gViewportMtx: model to the clip test's space: vf05-vf08
; Vertices: gVu1ProgLayouts[1], 4 qwords: position, normal, colour, texture coordinates.
; Batches at VU 0xa and 0xa + 0x1f8 (XTOP); the output follows each.
;=======================================================================================
.program Vu1Prog05
.base 0xa
.offset 0x1f8

    ; MSCALF 0: the setup's constants into registers
init:
    nop                             lq.xyzw vf01, 2(vi00)
    nop                             lq.xyzw vf02, 3(vi00)
    nop                             lq.xyzw vf03, 4(vi00)
    nop                             lq.xyzw vf04, 5(vi00)
    nop                             lq.xyzw vf05, 6(vi00)
    nop                             lq.xyzw vf06, 7(vi00)
    nop                             lq.xyzw vf07, 8(vi00)
    nop                             lq.xyzw vf08, 9(vi00)
    nop                             lq.xyzw vf09, 1(vi00)
    nop                             nop                               [E] ; end: constants loaded
    nop                             nop

    ; MSCNT: one batch at XTOP; qword 0's x is its type, qword 1 a GIF tag
batch:
    nop                             xtop vi02                            ; vi02: the batch (BASE, or BASE + OFFSET: double buffer)
    nop                             iaddiu vi05, vi02, 0
    nop                             ilwr.x vi06, (vi05)                  ; the batch type (qword 0)
    nop                             iaddiu vi05, vi05, 1
    nop                             ilwr.x vi08, (vi05)                  ; the GIF tag (qword 1): NLOOP, EOP
    nop                             iaddiu vi03, vi02, 200               ; vi03: the output, 200 qwords after the batch
    nop                             iaddiu vi11, vi00, 32767             ; 0x7FFF: the NLOOP mask
    nop                             lqi.xyzw vf31, (vi05++)
    nop                             iand vi07, vi11, vi08
    nop                             iaddiu vi11, vi00, 1
    nop                             iaddiu vi04, vi03, 0
    nop                             ibeq vi11, vi06, vertices
    nop                             sqi.xyzw vf31, (vi04++)

    ; a register block: the GIF tag and its NLOOP qwords (A+D) go through to the output
copy_regs:
    nop                             lqi.xyzw vf31, (vi05++)
    nop                             iaddi vi07, vi07, -1
    nop                             iaddiu vi04, vi04, 1
    nop                             ibne vi07, vi00, copy_regs
    nop                             sq.xyzw vf31, -1(vi04)
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             nop                               [E] ; end: the next MSCNT continues at copy_regs_cont
    nop                             nop

    ; the next MSCNT continues here
copy_regs_cont:
    nop                             b batch                              ; the next batch
    nop                             nop

    ; type 1: a strip of NLOOP vertices
vertices:
    nop                             iaddiu vi08, vi08, 2                 ; NLOOP + 2: the delay line's last vertices go out first
    nop                             isw.x vi08, -1(vi04)
    nop                             lq.xyzw vf28, 0(vi05)
    nop                             lq.xyzw vf30, 2(vi05)
    nop                             lq.xyzw vf29, 1(vi05)
    nop                             lq.xyzw vf31, 3(vi05)
    mulax.xyzw ACC, vf01, vf28x     lq.xyzw vf13, 1021(vi00)
    madday.xyzw ACC, vf02, vf28y    lq.xyzw vf14, 1022(vi00)
    maddaz.xyzw ACC, vf03, vf28z    lq.xyzw vf15, 1023(vi00)
    maddw.xyzw vf27, vf04, vf00w    lq.xyzw vf16, 1018(vi00)
    mul.xyzw vf25, vf30, vf09       lq.xyzw vf17, 1019(vi00)
    mulax.xyzw ACC, vf05, vf28x     lq.xyzw vf18, 1020(vi00)
    madday.xyzw ACC, vf06, vf28y    sqi.xyzw vf13, (vi04++)
    maddaz.xyzw ACC, vf07, vf28z    div Q, vf00w, vf27w                  ; Q = 1 / vf27.w
    ftoi0.xyzw vf25, vf25           sqi.xyzw vf14, (vi04++)
    maddw.xyzw vf26, vf08, vf00w    sqi.xyzw vf15, (vi04++)
    nop                             lq.xyzw vf28, 4(vi05)
    nop                             sqi.xyzw vf16, (vi04++)
    nop                             sqi.xyzw vf17, (vi04++)
    nop                             sqi.xyzw vf18, (vi04++)
    ; one vertex per pass, software-pipelined through the delay line
vertices_loop:
    mulq.xyzw vf27, vf27, Q         lq.xyzw vf30, 6(vi05)
    mulq.xyz vf24, vf31, Q          ilw.w vi09, 0(vi05)                  ; vi09: the position's w word, XYZF2's w (F, ADC) as the model has it
    mulax.xyzw ACC, vf01, vf28x     move.xyz vf10, vf11
    madday.xyzw ACC, vf02, vf28y    move.xyz vf11, vf12
    maddaz.xyzw ACC, vf03, vf28z    move.xyz vf12, vf27
    ftoi4.xyzw vf31, vf27           sq.xyzw vf24, 0(vi04)                ; to 12.4 fixed point (GS XYZ)
    maddw.xyzw vf27, vf04, vf00w    sq.xyzw vf25, 1(vi04)
    sub.xyz vf13, vf11, vf10        iaddiu vi05, vi05, 4
    sub.xyz vf14, vf12, vf10        nop
    mul.xyzw vf25, vf30, vf09       sq.xyz vf31, 2(vi04)
    clipw.xyz vf26, vf26w           div Q, vf00w, vf27w                  ; clip flags: vf26.xyz against +-vf26.w
    nop                             iaddiu vi04, vi04, 3
    opmula.xyz ACC, vf14, vf13      iaddi vi07, vi07, -1
    opmsub.xyz vf14, vf13, vf14     lq.xyzw vf31, 3(vi05)
    mulax.xyzw ACC, vf05, vf28x     fcand vi01, 0x03ffff                 ; vi01 = 1: one of the last three vertices is outside the clip volume
    madday.xyzw ACC, vf06, vf28y    nop
    maddaz.xyzw ACC, vf07, vf28z    lq.xyzw vf28, 4(vi05)
    mulw.z vf14, vf14, vf29w        ibne vi01, vi00, vertices_skip
    nop                             lq.xyzw vf29, 1(vi05)
    nop                             ibne vi09, vi00, vertices_skip2
    nop                             iaddiu vi01, vi00, 32
    nop                             fmand vi01, vi01
    nop                             ibeq vi01, vi00, vertices_skip2
    nop                             nop
vertices_skip:
    nop                             iaddiu vi09, vi00, 32767
    nop                             iaddiu vi09, vi09, 1
vertices_skip2:
    maddw.xyzw vf26, vf08, vf00w    ibne vi07, vi00, vertices_loop
    ftoi0.xyzw vf25, vf25           isw.w vi09, -1(vi04)
    ; the epilogue: the vertices left in the delay line
    nop                             lqd.xyzw vf13, (--vi04)
    nop                             lqd.xyzw vf14, (--vi04)
    nop                             lqd.xyzw vf15, (--vi04)
    nop                             lqd.xyzw vf16, (--vi04)
    nop                             lqd.xyzw vf17, (--vi04)
    nop                             lqd.xyzw vf18, (--vi04)
    nop                             sq.xyzw vf13, 1020(vi00)
    nop                             sq.xyzw vf14, 1019(vi00)
    nop                             sq.xyzw vf15, 1018(vi00)
    nop                             sq.xyzw vf16, 1023(vi00)
    nop                             sq.xyzw vf17, 1022(vi00)
    nop                             sq.xyzw vf18, 1021(vi00)
    nop                             xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             nop                               [E] ; end: the next MSCNT continues at vertices_cont
    nop                             nop

    ; the next MSCNT continues here
vertices_cont:
    nop                             b batch                              ; the next batch
    nop                             nop
.endprogram

;=======================================================================================
; Vu1Prog06: clipped
;
; gVu1ProgInfo06 (bones.c): 408 pairs (3264 bytes), batches of up to 3200 bytes;
; Vu1_SelectProgram's key 0x80, rigid models (0x21035, 0x121035).
; Setup Vu1Pkt_P: an UNPACK of 13 qwords to VU 0, then MSCALF 0:
;   0        colour: gGsColorF, RGB scaled by the model's brightness
;   1-4      gMtxSlots x gMtxView x gMtxProjClip: model to screen (XYZ after the divide by w): vf01-vf04
;   5-8      the matrix above x gViewportMtx: model to the clip test's space: vf05-vf08
;   9-12     gMtxProj, the projection matrix: vf27-vf30
; Vertices: gVu1ProgLayouts[5], 3 qwords: position, colour, texture coordinates.
; Batches at VU 0xd and 0xd + 0x1c2 (XTOP); the output follows each.
;=======================================================================================
.program Vu1Prog06
.base 0xd
.offset 0x1c2
.stcycl 4, 4
.unpack 0x3a6, 0x00008000, 0x302ec000, 0x00000412, 0x00000000   ; GIF tag template: EOP, PRIM 0x5d, REGS ST RGBAQ XYZF2

    ; MSCALF 0: the setup's constants into registers
init:
    nop                             lq.xyzw vf01, 1(vi00)
    nop                             lq.xyzw vf02, 2(vi00)
    nop                             lq.xyzw vf03, 3(vi00)
    nop                             lq.xyzw vf04, 4(vi00)
    nop                             lq.xyzw vf05, 5(vi00)
    nop                             lq.xyzw vf06, 6(vi00)
    nop                             lq.xyzw vf07, 7(vi00)
    nop                             lq.xyzw vf08, 8(vi00)
    nop                             nop                               [E] ; end: constants loaded
    nop                             nop

    ; MSCNT: one batch at XTOP; qword 0's x is its type, qword 1 a GIF tag
batch:
    nop                             xtop vi02                            ; vi02: the batch (BASE, or BASE + OFFSET: double buffer)
    nop                             iaddiu vi05, vi02, 0
    nop                             iaddiu vi03, vi02, 200               ; vi03: the output, 200 qwords after the batch
    nop                             ilwr.x vi06, (vi05)                  ; the batch type (qword 0)
    nop                             iaddiu vi05, vi05, 1
    nop                             ilwr.x vi08, (vi05)                  ; the GIF tag (qword 1): NLOOP, EOP
    nop                             iaddiu vi04, vi03, 0
    nop                             iaddiu vi11, vi00, 32767             ; 0x7FFF: the NLOOP mask
    nop                             lq.xyzw vf31, 0(vi05)
    nop                             iand vi07, vi11, vi08
    nop                             iaddiu vi11, vi00, 1
    nop                             iaddiu vi05, vi05, 1
    nop                             ibeq vi11, vi06, vertices
    nop                             sqi.xyzw vf31, (vi04++)

    ; a register block: the GIF tag and its NLOOP qwords (A+D) go through to the output
copy_regs:
    nop                             lq.xyzw vf31, 0(vi05)
    nop                             iaddi vi07, vi07, -1
    nop                             iaddiu vi05, vi05, 1
    nop                             iaddiu vi04, vi04, 1
    nop                             ibne vi07, vi00, copy_regs
    nop                             sq.xyzw vf31, -1(vi04)
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             nop                               [E] ; end: the next MSCNT continues at copy_regs_cont
    nop                             nop

    ; the next MSCNT continues here
copy_regs_cont:
    nop                             b batch                              ; the next batch
    nop                             nop

    ; type 1: a strip of NLOOP vertices
vertices:
    nop                             iaddiu vi08, vi08, 2                 ; NLOOP + 2: the delay line's last vertices go out first
    nop                             isw.x vi08, -1(vi04)
    nop                             lq.xyzw vf09, 917(vi00)
    nop                             lq.xyzw vf10, 918(vi00)
    nop                             lq.xyzw vf11, 919(vi00)
    nop                             lq.xyzw vf12, 914(vi00)
    nop                             lq.xyzw vf13, 915(vi00)
    nop                             lq.xyzw vf14, 916(vi00)
    nop                             sqi.xyzw vf09, (vi04++)
    nop                             sqi.xyzw vf10, (vi04++)
    nop                             sqi.xyzw vf11, (vi04++)
    nop                             sqi.xyzw vf12, (vi04++)
    nop                             sqi.xyzw vf13, (vi04++)
    nop                             sqi.xyzw vf14, (vi04++)
    nop                             lq.xyzw vf29, 0(vi05)
    ; one vertex per pass, software-pipelined through the delay line
vertices_loop:
    nop                             lq.xyzw vf30, 1(vi05)
    nop                             lq.xyzw vf31, 2(vi05)
    nop                             lq.xyzw vf09, 1020(vi00)
    mulax.xyzw ACC, vf01, vf29x     lq.xyzw vf10, 1017(vi00)
    madday.xyzw ACC, vf02, vf29y    lq.xyzw vf11, 1019(vi00)
    maddaz.xyzw ACC, vf03, vf29z    lq.xyzw vf12, 1016(vi00)
    maddw.xyzw vf28, vf04, vf00w    lq.xyzw vf13, 1018(vi00)
    mulax.xyzw ACC, vf05, vf29x     lq.xyzw vf14, 1015(vi00)
    madday.xyzw ACC, vf06, vf29y    sq.xyzw vf09, 1023(vi00)
    maddaz.xyzw ACC, vf07, vf29z    sq.xyzw vf10, 1020(vi00)
    maddw.xyzw vf27, vf08, vf00w    div Q, vf00w, vf28w                  ; Q = 1 / vf28.w
    clipw.xyz vf09, vf09w           sq.xyzw vf11, 1022(vi00)             ; clip flags: vf09.xyz against +-vf09.w
    clipw.xyz vf10, vf10w           sq.xyzw vf12, 1019(vi00)
    ftoi0.xyzw vf30, vf30           sq.xyzw vf13, 1021(vi00)
    clipw.xyz vf27, vf27w           sq.xyzw vf14, 1018(vi00)
    nop                             sq.xyzw vf31, 1015(vi00)
    nop                             ilw.w vi09, 0(vi05)                  ; vi09: the position's w word, XYZF2's w (F, ADC) as the model has it
    mulq.xyzw vf28, vf28, Q         iaddiu vi05, vi05, 3
    mulq.xyz vf26, vf31, Q          lq.xyzw vf29, 0(vi05)
    nop                             sq.xyzw vf30, 1016(vi00)
    nop                             sq.xyzw vf30, 1(vi04)
    ftoi4.xyzw vf28, vf28           sq.xyzw vf27, 1017(vi00)             ; to 12.4 fixed point (GS XYZ)
    nop                             sq.xyzw vf26, 0(vi04)
    nop                             iaddi vi07, vi07, -1
    nop                             ibne vi09, vi00, vertices_in_view
    nop                             sq.xyz vf28, 2(vi04)
    nop                             fcand vi01, 0x03ffff                 ; vi01 = 1: one of the last three vertices is outside the clip volume
    nop                             ibeq vi01, vi00, vertices_in_view
    nop                             nop
    nop                             ibne vi09, vi00, vertices_in_view
    nop                             fcor vi01, 0xfdf7df
    nop                             ibne vi01, vi00, vertices_culled
    nop                             fcor vi01, 0xfefbef
    nop                             ibne vi01, vi00, vertices_culled
    nop                             fcor vi01, 0xff7df7
    nop                             ibne vi01, vi00, vertices_culled
    nop                             fcor vi01, 0xffbefb
    nop                             ibne vi01, vi00, vertices_culled
    nop                             fcor vi01, 0xffdf7d
    nop                             ibne vi01, vi00, vertices_culled
    nop                             fcor vi01, 0xffefbe
    nop                             ibne vi01, vi00, vertices_culled
    nop                             nop
    nop                             bal vi15, clip_triangle
    nop                             nop
    ; the triangle is wholly outside one plane: culled
vertices_culled:
    nop                             iaddiu vi09, vi00, 32767
    nop                             iaddiu vi09, vi09, 1
    ; the last three vertices are all inside the clip volume
vertices_in_view:
    nop                             isw.w vi09, 2(vi04)
    nop                             ibne vi07, vi00, vertices_loop
    nop                             iaddiu vi04, vi04, 3
    ; the epilogue: the vertices left in the delay line
    nop                             lqd.xyzw vf09, (--vi04)
    nop                             lqd.xyzw vf10, (--vi04)
    nop                             lqd.xyzw vf11, (--vi04)
    nop                             lqd.xyzw vf12, (--vi04)
    nop                             lqd.xyzw vf13, (--vi04)
    nop                             lqd.xyzw vf14, (--vi04)
    nop                             sq.xyzw vf09, 916(vi00)
    nop                             sq.xyzw vf10, 915(vi00)
    nop                             sq.xyzw vf11, 914(vi00)
    nop                             sq.xyzw vf12, 919(vi00)
    nop                             sq.xyzw vf13, 918(vi00)
    nop                             sq.xyzw vf14, 917(vi00)
    nop                             xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             nop                               [E] ; end: the next MSCNT continues at vertices_cont
    nop                             nop

    ; the next MSCNT continues here
vertices_cont:
    nop                             b batch                              ; the next batch
    nop                             nop

    ; clip the last three vertices' triangle against the six planes of the clip volume and
    ; send what is left as a fan (the GIF tag template at VU 0x3A6)
clip_triangle:
    nop                             iaddiu vi14, vi00, 934
    nop                             sqd.xyzw vf21, (--vi14)
    nop                             sqd.xyzw vf22, (--vi14)
    nop                             sqd.xyzw vf23, (--vi14)
    nop                             sqd.xyzw vf24, (--vi14)
    nop                             sqd.xyzw vf25, (--vi14)
    nop                             sqd.xyzw vf26, (--vi14)
    nop                             sqd.xyzw vf27, (--vi14)
    nop                             sqd.xyzw vf28, (--vi14)
    nop                             sqd.xyzw vf29, (--vi14)
    nop                             sqd.xyzw vf30, (--vi14)
    nop                             sqd.xyzw vf31, (--vi14)
    nop                             isubiu vi14, vi14, 1
    nop                             iswr.x vi02, (vi14)
    nop                             iswr.y vi03, (vi14)
    nop                             iswr.z vi04, (vi14)
    nop                             iswr.w vi05, (vi14)
    nop                             isubiu vi14, vi14, 1
    nop                             iswr.x vi06, (vi14)
    nop                             iswr.y vi07, (vi14)
    nop                             iswr.z vi08, (vi14)
    nop                             iswr.w vi09, (vi14)
    nop                             isubiu vi14, vi14, 1
    nop                             iswr.x vi10, (vi14)
    nop                             iswr.y vi11, (vi14)
    nop                             iswr.z vi12, (vi14)
    nop                             iswr.w vi13, (vi14)
    nop                             iaddiu vi08, vi00, 0
    nop                             iaddiu vi09, vi00, 935
    nop                             iaddiu vi10, vi00, 975
    nop                             lq.xyzw vf23, 1022(vi00)
    nop                             lq.xyzw vf24, 1019(vi00)
    nop                             lq.xyzw vf25, 1016(vi00)
    nop                             lq.xyzw vf26, 1021(vi00)
    itof0.xyzw vf23, vf23           lq.xyzw vf27, 1018(vi00)
    itof0.xyzw vf24, vf24           lq.xyzw vf28, 1015(vi00)
    itof0.xyzw vf25, vf25           lq.xyzw vf29, 1023(vi00)
    nop                             lq.xyzw vf30, 1020(vi00)
    nop                             lq.xyzw vf31, 1017(vi00)
    nop                             sq.xyzw vf23, 1(vi09)
    nop                             sq.xyzw vf24, 4(vi09)
    nop                             sq.xyzw vf25, 7(vi09)
    nop                             sq.xyzw vf23, 10(vi09)
    nop                             sq.xyzw vf26, 2(vi09)
    nop                             sq.xyzw vf27, 5(vi09)
    nop                             sq.xyzw vf28, 8(vi09)
    nop                             sq.xyzw vf26, 11(vi09)
    nop                             sq.xyzw vf29, 0(vi09)
    nop                             sq.xyzw vf30, 3(vi09)
    nop                             sq.xyzw vf31, 6(vi09)
    nop                             sq.xyzw vf29, 9(vi09)
    nop                             iaddiu vi09, vi00, 935
    nop                             iaddiu vi10, vi00, 975
    nop                             iaddiu vi05, vi00, 2048
    nop                             iaddiu vi06, vi00, 32
    subw.x vf31, vf00, vf00w        bal vi13, first_vertex
    nop                             iaddiu vi07, vi00, 2
    nop                             iaddiu vi04, vi00, 3
    nop                             iaddiu vi11, vi00, 0
    nop                             bal vi13, clip_edges
    nop                             nop
    nop                             bal vi13, close_polygon
    nop                             iaddiu vi09, vi00, 975
    nop                             iaddiu vi09, vi00, 975
    nop                             iaddiu vi10, vi00, 935
    nop                             iaddiu vi05, vi00, 1024
    nop                             iaddiu vi06, vi00, 16
    addw.x vf31, vf00, vf00w        bal vi13, pass_start
    nop                             iaddiu vi07, vi00, 2
    nop                             bal vi13, clip_edges
    nop                             nop
    nop                             bal vi13, close_polygon
    nop                             iaddiu vi09, vi00, 935
    nop                             iaddiu vi05, vi00, 128
    nop                             iaddiu vi06, vi00, 2
    subw.x vf31, vf00, vf00w        bal vi13, pass_a_to_b
    nop                             iaddiu vi07, vi00, 0
    nop                             bal vi13, clip_edges
    nop                             nop
    nop                             bal vi13, close_polygon
    nop                             iaddiu vi09, vi00, 975
    nop                             iaddiu vi05, vi00, 64
    nop                             iaddiu vi06, vi00, 1
    addw.x vf31, vf00, vf00w        bal vi13, pass_b_to_a
    nop                             iaddiu vi07, vi00, 0
    nop                             bal vi13, clip_edges
    nop                             nop
    nop                             bal vi13, close_polygon
    nop                             iaddiu vi09, vi00, 935
    nop                             iaddiu vi05, vi00, 512
    nop                             iaddiu vi06, vi00, 8
    subw.x vf31, vf00, vf00w        bal vi13, pass_a_to_b
    nop                             iaddiu vi07, vi00, 1
    nop                             bal vi13, clip_edges
    nop                             nop
    nop                             bal vi13, close_polygon
    nop                             iaddiu vi09, vi00, 975
    nop                             iaddiu vi05, vi00, 256
    nop                             iaddiu vi06, vi00, 4
    addw.x vf31, vf00, vf00w        bal vi13, pass_b_to_a
    nop                             iaddiu vi07, vi00, 1
    nop                             bal vi13, clip_edges
    nop                             nop
    nop                             bal vi13, close_polygon
    nop                             iaddiu vi09, vi00, 935
    nop                             iaddiu vi09, vi00, 935
    nop                             iaddiu vi10, vi00, 975
    nop                             iadd vi04, vi00, vi11
    nop                             iaddiu vi11, vi00, 0
    nop                             ilw.x vi12, 934(vi00)
    nop                             ilwr.y vi06, (vi02)
    nop                             lq.xyzw vf31, 934(vi00)
    nop                             lq.xyzw vf27, 9(vi00)
    nop                             lq.xyzw vf28, 10(vi00)
    nop                             iadd vi12, vi12, vi04
    nop                             iadd vi06, vi06, vi03
    nop                             iaddiu vi02, vi06, 0
    nop                             sqi.xyzw vf31, (vi06++)
    nop                             lq.xyzw vf29, 11(vi00)
    nop                             lq.xyzw vf30, 12(vi00)
    nop                             xgkick vi02                          ; send the output to the GS (PATH1)
    nop                             nop
    nop                             isw.x vi12, -1(vi06)
clip_triangle_loop:
    nop                             lqi.xyzw vf24, (vi09++)
    nop                             lqi.xyzw vf25, (vi09++)
    nop                             lqi.xyzw vf26, (vi09++)
    nop                             nop
    mulax.xyzw ACC, vf27, vf24x     nop
    madday.xyzw ACC, vf28, vf24y    nop
    maddaz.xyzw ACC, vf29, vf24z    nop
    maddw.xyzw vf23, vf30, vf24w    loi 128.0                            ; I = 128.0: the colour clamp (0x80 is 1.0 on the GS)
    minii.xyz vf25, vf25, I         nop
    nop                             nop
    nop                             nop
    nop                             div Q, vf00w, vf23w                  ; Q = 1 / vf23.w
    ftoi0.xyzw vf25, vf25           waitq
    mulq.xyzw vf23, vf23, Q         nop
    mulq.xyz vf26, vf26, Q          nop
    nop                             nop
    nop                             iaddi vi04, vi04, -1
    ftoi4.xyzw vf23, vf23           iaddiu vi06, vi06, 3                 ; to 12.4 fixed point (GS XYZ)
    nop                             sq.xyzw vf26, -3(vi06)
    nop                             sq.xyzw vf25, -2(vi06)
    nop                             ibne vi04, vi00, clip_triangle_loop
    nop                             sq.xyzw vf23, -1(vi06)
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             xgkick vi02                          ; send the output to the GS (PATH1)
clip_triangle_exit:
    nop                             ilwr.x vi10, (vi14)
    nop                             ilwr.y vi11, (vi14)
    nop                             ilwr.z vi12, (vi14)
    nop                             ilwr.w vi13, (vi14)
    nop                             iaddiu vi14, vi14, 1
    nop                             ilwr.x vi06, (vi14)
    nop                             ilwr.y vi07, (vi14)
    nop                             ilwr.z vi08, (vi14)
    nop                             ilwr.w vi09, (vi14)
    nop                             iaddiu vi14, vi14, 1
    nop                             ilwr.x vi02, (vi14)
    nop                             ilwr.y vi03, (vi14)
    nop                             ilwr.z vi04, (vi14)
    nop                             ilwr.w vi05, (vi14)
    nop                             iaddiu vi14, vi14, 1
    nop                             lqi.xyzw vf31, (vi14++)
    nop                             lqi.xyzw vf30, (vi14++)
    nop                             lqi.xyzw vf29, (vi14++)
    nop                             lqi.xyzw vf28, (vi14++)
    nop                             lqi.xyzw vf27, (vi14++)
    nop                             lqi.xyzw vf26, (vi14++)
    nop                             lqi.xyzw vf25, (vi14++)
    nop                             lqi.xyzw vf24, (vi14++)
    nop                             lqi.xyzw vf23, (vi14++)
    nop                             lqi.xyzw vf22, (vi14++)
    nop                             lqi.xyzw vf21, (vi14++)
    nop                             jr vi15
    nop                             nop

    ; after a plane: repeat the first output vertex after the last; an empty polygon leaves
    ; (clip_triangle_exit)
close_polygon:
    nop                             lqi.xyzw vf29, (vi09++)
    nop                             lqi.xyzw vf30, (vi09++)
    nop                             lqi.xyzw vf31, (vi09++)
    nop                             nop
    nop                             sqi.xyzw vf29, (vi10++)
    nop                             sqi.xyzw vf30, (vi10++)
    nop                             ibeq vi11, vi00, clip_triangle_exit
    nop                             sqi.xyzw vf31, (vi10++)
    nop                             jr vi13
    nop                             nop

    ; the next plane reads the polygon at VU 935.. and writes the one at 975.. (as set at
    ; clip_triangle)
pass_a_to_b:
    nop                             iaddiu vi09, vi00, 935
    nop                             b pass_start
    nop                             iaddiu vi10, vi00, 975

    ; the next plane reads the second polygon buffer and writes the first
pass_b_to_a:
    nop                             iaddiu vi09, vi00, 975
    nop                             iaddiu vi10, vi00, 935

    ; vi04: the vertices to clip; vi11: none written yet
pass_start:
    nop                             iadd vi04, vi00, vi11
    nop                             iaddiu vi11, vi00, 0

    ; load the polygon's first vertex (three qwords)
first_vertex:
    nop                             lqi.xyzw vf21, (vi09++)
    nop                             lqi.xyzw vf22, (vi09++)
    nop                             jr vi13
    nop                             lqi.xyzw vf23, (vi09++)

    ; clip the polygon's edges against one plane (vi05, vi06: its clip-flag bits; vf31.x its
    ; sign)
clip_edges:
    mulw.xyzw vf24, vf21, vf00w     lqi.xyzw vf21, (vi09++)
    mulw.xyzw vf25, vf22, vf00w     lqi.xyzw vf22, (vi09++)
    mulw.xyzw vf26, vf23, vf00w     lqi.xyzw vf23, (vi09++)
    nop                             nop
    clipw.xyz vf24, vf24w           nop                                  ; clip flags: vf24.xyz against +-vf24.w
    clipw.xyz vf21, vf21w           nop
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             fcget vi01
    nop                             nop
    nop                             iand vi12, vi01, vi05
    nop                             nop
    nop                             ibeq vi12, vi00, clip_edges_skip
    nop                             nop
    nop                             iand vi12, vi01, vi06
    nop                             nop
    nop                             ibne vi12, vi00, clip_edges_skip3
    nop                             nop
    nop                             bal vi01, intersect
    nop                             nop
    nop                             sqi.xyzw vf28, (vi10++)
    nop                             sqi.xyzw vf29, (vi10++)
    nop                             sqi.xyzw vf30, (vi10++)
    nop                             b clip_edges_skip3
    nop                             iaddiu vi11, vi11, 1
clip_edges_skip:
    nop                             iand vi12, vi01, vi06
    nop                             nop
    nop                             ibeq vi12, vi00, clip_edges_skip2
    nop                             nop
    nop                             bal vi01, intersect
    nop                             nop
    nop                             sqi.xyzw vf24, (vi10++)
    nop                             sqi.xyzw vf25, (vi10++)
    nop                             sqi.xyzw vf26, (vi10++)
    nop                             sqi.xyzw vf28, (vi10++)
    nop                             sqi.xyzw vf29, (vi10++)
    nop                             sqi.xyzw vf30, (vi10++)
    nop                             b clip_edges_skip3
    nop                             iaddiu vi11, vi11, 2
clip_edges_skip2:
    nop                             sqi.xyzw vf24, (vi10++)
    nop                             sqi.xyzw vf25, (vi10++)
    nop                             sqi.xyzw vf26, (vi10++)
    nop                             iaddiu vi11, vi11, 1
clip_edges_skip3:
    nop                             isubiu vi04, vi04, 1
    nop                             nop
    nop                             ibne vi04, vi00, clip_edges
    nop                             nop
    nop                             jr vi13
    nop                             nop

    ; an edge crosses the plane: write the intersection (position and attributes interpolated)
intersect:
    mulx.w vf28, vf24, vf31x        nop
    mulx.w vf29, vf21, vf31x        nop
    nop                             nop
    nop                             nop
    subw.xyzw vf28, vf24, vf28w     nop
    subw.xyzw vf29, vf21, vf29w     nop
    nop                             iadd vi12, vi00, vi07
    nop                             nop
intersect_loop:
    nop                             ibeq vi12, vi00, intersect_skip
    nop                             nop
    nop                             mr32.xyzw vf28, vf28
    nop                             mr32.xyzw vf29, vf29
    nop                             isubiu vi12, vi12, 1
    nop                             nop
    nop                             b intersect_loop
    nop                             nop
intersect_skip:
    sub.xyz vf30, vf29, vf28        nop
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             div Q, vf28x, vf30x
    nop                             waitq
    addq.x vf27, vf00, Q            nop
    sub.xyzw vf28, vf21, vf24       nop
    sub.xyzw vf29, vf22, vf25       nop
    sub.xyzw vf30, vf23, vf26       nop
    abs.x vf27, vf27                nop
    nop                             nop
    nop                             nop
    nop                             nop
    mulx.xyzw vf28, vf28, vf27x     nop
    mulx.xyzw vf29, vf29, vf27x     nop
    mulx.xyzw vf30, vf30, vf27x     nop
    nop                             nop
    add.xyzw vf28, vf28, vf24       nop
    add.xyzw vf29, vf29, vf25       nop
    add.xyzw vf30, vf30, vf26       nop
    nop                             nop
    nop                             jr vi01
    nop                             nop
.endprogram

;=======================================================================================
; Vu1Prog07: second colour, clipped
;
; gVu1ProgInfo07 (bones.c): 408 pairs (3264 bytes), batches of up to 3200 bytes;
; Vu1_SelectProgram's key 0x20080, rigid models (0x21035, 0x121035).
; Setup Vu1Pkt_VP: an UNPACK of 14 qwords to VU 0, then MSCALF 0:
;   0        colour: gGsColorF, RGB scaled by the model's brightness
;   1        second colour: gGsColor2F: vf09
;   2-5      gMtxSlots x gMtxView x gMtxProjClip: model to screen (XYZ after the divide by w): vf01-vf04
;   6-9      the matrix above x gViewportMtx: model to the clip test's space: vf05-vf08
;   10-13    gMtxProj, the projection matrix: vf27-vf30
; Vertices: gVu1ProgLayouts[5], 3 qwords: position, colour, texture coordinates.
; Batches at VU 0xe and 0xe + 0x1c2 (XTOP); the output follows each.
;=======================================================================================
.program Vu1Prog07
.base 0xe
.offset 0x1c2
.stcycl 4, 4
.unpack 0x3a6, 0x00008000, 0x302ec000, 0x00000412, 0x00000000   ; GIF tag template: EOP, PRIM 0x5d, REGS ST RGBAQ XYZF2

    ; MSCALF 0: the setup's constants into registers
init:
    nop                             lq.xyzw vf01, 2(vi00)
    nop                             lq.xyzw vf02, 3(vi00)
    nop                             lq.xyzw vf03, 4(vi00)
    nop                             lq.xyzw vf04, 5(vi00)
    nop                             lq.xyzw vf05, 6(vi00)
    nop                             lq.xyzw vf06, 7(vi00)
    nop                             lq.xyzw vf07, 8(vi00)
    nop                             lq.xyzw vf08, 9(vi00)
    nop                             lq.xyzw vf09, 1(vi00)
    nop                             nop                               [E] ; end: constants loaded
    nop                             nop

    ; MSCNT: one batch at XTOP; qword 0's x is its type, qword 1 a GIF tag
batch:
    nop                             xtop vi02                            ; vi02: the batch (BASE, or BASE + OFFSET: double buffer)
    nop                             iaddiu vi05, vi02, 0
    nop                             iaddiu vi03, vi02, 200               ; vi03: the output, 200 qwords after the batch
    nop                             ilwr.x vi06, (vi05)                  ; the batch type (qword 0)
    nop                             iaddiu vi05, vi05, 1
    nop                             ilwr.x vi08, (vi05)                  ; the GIF tag (qword 1): NLOOP, EOP
    nop                             iaddiu vi04, vi03, 0
    nop                             iaddiu vi11, vi00, 32767             ; 0x7FFF: the NLOOP mask
    nop                             lq.xyzw vf31, 0(vi05)
    nop                             iand vi07, vi11, vi08
    nop                             iaddiu vi11, vi00, 1
    nop                             iaddiu vi05, vi05, 1
    nop                             ibeq vi11, vi06, vertices
    nop                             sqi.xyzw vf31, (vi04++)

    ; a register block: the GIF tag and its NLOOP qwords (A+D) go through to the output
copy_regs:
    nop                             lq.xyzw vf31, 0(vi05)
    nop                             iaddi vi07, vi07, -1
    nop                             iaddiu vi05, vi05, 1
    nop                             iaddiu vi04, vi04, 1
    nop                             ibne vi07, vi00, copy_regs
    nop                             sq.xyzw vf31, -1(vi04)
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             nop                               [E] ; end: the next MSCNT continues at copy_regs_cont
    nop                             nop

    ; the next MSCNT continues here
copy_regs_cont:
    nop                             b batch                              ; the next batch
    nop                             nop

    ; type 1: a strip of NLOOP vertices
vertices:
    nop                             iaddiu vi08, vi08, 2                 ; NLOOP + 2: the delay line's last vertices go out first
    nop                             isw.x vi08, -1(vi04)
    nop                             lq.xyzw vf10, 917(vi00)
    nop                             lq.xyzw vf11, 918(vi00)
    nop                             lq.xyzw vf12, 919(vi00)
    nop                             lq.xyzw vf13, 914(vi00)
    nop                             lq.xyzw vf14, 915(vi00)
    nop                             lq.xyzw vf15, 916(vi00)
    nop                             sqi.xyzw vf10, (vi04++)
    nop                             sqi.xyzw vf11, (vi04++)
    nop                             sqi.xyzw vf12, (vi04++)
    nop                             sqi.xyzw vf13, (vi04++)
    nop                             sqi.xyzw vf14, (vi04++)
    nop                             sqi.xyzw vf15, (vi04++)
    ; one vertex per pass, software-pipelined through the delay line
vertices_loop:
    nop                             lq.xyzw vf29, 0(vi05)
    nop                             lq.xyzw vf30, 1(vi05)
    nop                             lq.xyzw vf31, 2(vi05)
    nop                             ilw.w vi09, 0(vi05)                  ; vi09: the position's w word, XYZF2's w (F, ADC) as the model has it
    mulax.xyzw ACC, vf01, vf29x     lq.xyzw vf10, 1020(vi00)
    madday.xyzw ACC, vf02, vf29y    lq.xyzw vf11, 1017(vi00)
    maddaz.xyzw ACC, vf03, vf29z    lq.xyzw vf12, 1019(vi00)
    maddw.xyzw vf28, vf04, vf00w    lq.xyzw vf13, 1016(vi00)
    mul.xyzw vf30, vf30, vf09       lq.xyzw vf14, 1018(vi00)
    mulax.xyzw ACC, vf05, vf29x     lq.xyzw vf15, 1015(vi00)
    madday.xyzw ACC, vf06, vf29y    sq.xyzw vf10, 1023(vi00)
    maddaz.xyzw ACC, vf07, vf29z    div Q, vf00w, vf28w                  ; Q = 1 / vf28.w
    ftoi0.xyzw vf30, vf30           sq.xyzw vf11, 1020(vi00)
    maddw.xyzw vf27, vf08, vf00w    sq.xyzw vf12, 1022(vi00)
    clipw.xyz vf10, vf10w           sq.xyzw vf13, 1019(vi00)             ; clip flags: vf10.xyz against +-vf10.w
    clipw.xyz vf11, vf11w           sq.xyzw vf14, 1021(vi00)
    nop                             sq.xyzw vf30, 1(vi04)
    clipw.xyz vf27, vf27w           sq.xyzw vf30, 1016(vi00)
    mulq.xyzw vf28, vf28, Q         sq.xyzw vf27, 1017(vi00)
    mulq.xyz vf26, vf31, Q          sq.xyzw vf15, 1018(vi00)
    nop                             sq.xyzw vf31, 1015(vi00)
    nop                             iaddiu vi04, vi04, 3
    ftoi4.xyzw vf28, vf28           iaddiu vi05, vi05, 3                 ; to 12.4 fixed point (GS XYZ)
    nop                             sq.xyzw vf26, -3(vi04)
    nop                             iaddi vi07, vi07, -1
    nop                             ibne vi09, vi00, vertices_in_view
    nop                             sq.xyz vf28, -1(vi04)
    nop                             fcand vi01, 0x03ffff                 ; vi01 = 1: one of the last three vertices is outside the clip volume
    nop                             ibeq vi01, vi00, vertices_in_view
    nop                             nop
    nop                             ibne vi09, vi00, vertices_in_view
    nop                             fcor vi01, 0xfdf7df
    nop                             ibne vi01, vi00, vertices_culled
    nop                             fcor vi01, 0xfefbef
    nop                             ibne vi01, vi00, vertices_culled
    nop                             fcor vi01, 0xff7df7
    nop                             ibne vi01, vi00, vertices_culled
    nop                             fcor vi01, 0xffbefb
    nop                             ibne vi01, vi00, vertices_culled
    nop                             fcor vi01, 0xffdf7d
    nop                             ibne vi01, vi00, vertices_culled
    nop                             fcor vi01, 0xffefbe
    nop                             ibne vi01, vi00, vertices_culled
    nop                             nop
    nop                             bal vi15, clip_triangle
    nop                             nop
    ; the triangle is wholly outside one plane: culled
vertices_culled:
    nop                             iaddiu vi09, vi00, 32767
    nop                             iaddiu vi09, vi09, 1
    ; the last three vertices are all inside the clip volume
vertices_in_view:
    nop                             ibne vi07, vi00, vertices_loop
    nop                             isw.w vi09, -1(vi04)
    ; the epilogue: the vertices left in the delay line
    nop                             lqd.xyzw vf10, (--vi04)
    nop                             lqd.xyzw vf11, (--vi04)
    nop                             lqd.xyzw vf12, (--vi04)
    nop                             lqd.xyzw vf13, (--vi04)
    nop                             lqd.xyzw vf14, (--vi04)
    nop                             lqd.xyzw vf15, (--vi04)
    nop                             sq.xyzw vf10, 916(vi00)
    nop                             sq.xyzw vf11, 915(vi00)
    nop                             sq.xyzw vf12, 914(vi00)
    nop                             sq.xyzw vf13, 919(vi00)
    nop                             sq.xyzw vf14, 918(vi00)
    nop                             sq.xyzw vf15, 917(vi00)
    nop                             xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             nop                               [E] ; end: the next MSCNT continues at vertices_cont
    nop                             nop

    ; the next MSCNT continues here
vertices_cont:
    nop                             b batch                              ; the next batch
    nop                             nop

    ; clip the last three vertices' triangle against the six planes of the clip volume and
    ; send what is left as a fan (the GIF tag template at VU 0x3A6)
clip_triangle:
    nop                             iaddiu vi14, vi00, 934
    nop                             sqd.xyzw vf21, (--vi14)
    nop                             sqd.xyzw vf22, (--vi14)
    nop                             sqd.xyzw vf23, (--vi14)
    nop                             sqd.xyzw vf24, (--vi14)
    nop                             sqd.xyzw vf25, (--vi14)
    nop                             sqd.xyzw vf26, (--vi14)
    nop                             sqd.xyzw vf27, (--vi14)
    nop                             sqd.xyzw vf28, (--vi14)
    nop                             sqd.xyzw vf29, (--vi14)
    nop                             sqd.xyzw vf30, (--vi14)
    nop                             sqd.xyzw vf31, (--vi14)
    nop                             isubiu vi14, vi14, 1
    nop                             iswr.x vi02, (vi14)
    nop                             iswr.y vi03, (vi14)
    nop                             iswr.z vi04, (vi14)
    nop                             iswr.w vi05, (vi14)
    nop                             isubiu vi14, vi14, 1
    nop                             iswr.x vi06, (vi14)
    nop                             iswr.y vi07, (vi14)
    nop                             iswr.z vi08, (vi14)
    nop                             iswr.w vi09, (vi14)
    nop                             isubiu vi14, vi14, 1
    nop                             iswr.x vi10, (vi14)
    nop                             iswr.y vi11, (vi14)
    nop                             iswr.z vi12, (vi14)
    nop                             iswr.w vi13, (vi14)
    nop                             iaddiu vi08, vi00, 0
    nop                             iaddiu vi09, vi00, 935
    nop                             iaddiu vi10, vi00, 975
    nop                             lq.xyzw vf23, 1022(vi00)
    nop                             lq.xyzw vf24, 1019(vi00)
    nop                             lq.xyzw vf25, 1016(vi00)
    nop                             lq.xyzw vf26, 1021(vi00)
    itof0.xyzw vf23, vf23           lq.xyzw vf27, 1018(vi00)
    itof0.xyzw vf24, vf24           lq.xyzw vf28, 1015(vi00)
    itof0.xyzw vf25, vf25           lq.xyzw vf29, 1023(vi00)
    nop                             lq.xyzw vf30, 1020(vi00)
    nop                             lq.xyzw vf31, 1017(vi00)
    nop                             sq.xyzw vf23, 1(vi09)
    nop                             sq.xyzw vf24, 4(vi09)
    nop                             sq.xyzw vf25, 7(vi09)
    nop                             sq.xyzw vf23, 10(vi09)
    nop                             sq.xyzw vf26, 2(vi09)
    nop                             sq.xyzw vf27, 5(vi09)
    nop                             sq.xyzw vf28, 8(vi09)
    nop                             sq.xyzw vf26, 11(vi09)
    nop                             sq.xyzw vf29, 0(vi09)
    nop                             sq.xyzw vf30, 3(vi09)
    nop                             sq.xyzw vf31, 6(vi09)
    nop                             sq.xyzw vf29, 9(vi09)
    nop                             iaddiu vi09, vi00, 935
    nop                             iaddiu vi10, vi00, 975
    nop                             iaddiu vi05, vi00, 2048
    nop                             iaddiu vi06, vi00, 32
    subw.x vf31, vf00, vf00w        bal vi13, first_vertex
    nop                             iaddiu vi07, vi00, 2
    nop                             iaddiu vi04, vi00, 3
    nop                             iaddiu vi11, vi00, 0
    nop                             bal vi13, clip_edges
    nop                             nop
    nop                             bal vi13, close_polygon
    nop                             iaddiu vi09, vi00, 975
    nop                             iaddiu vi09, vi00, 975
    nop                             iaddiu vi10, vi00, 935
    nop                             iaddiu vi05, vi00, 1024
    nop                             iaddiu vi06, vi00, 16
    addw.x vf31, vf00, vf00w        bal vi13, pass_start
    nop                             iaddiu vi07, vi00, 2
    nop                             bal vi13, clip_edges
    nop                             nop
    nop                             bal vi13, close_polygon
    nop                             iaddiu vi09, vi00, 935
    nop                             iaddiu vi05, vi00, 128
    nop                             iaddiu vi06, vi00, 2
    subw.x vf31, vf00, vf00w        bal vi13, pass_a_to_b
    nop                             iaddiu vi07, vi00, 0
    nop                             bal vi13, clip_edges
    nop                             nop
    nop                             bal vi13, close_polygon
    nop                             iaddiu vi09, vi00, 975
    nop                             iaddiu vi05, vi00, 64
    nop                             iaddiu vi06, vi00, 1
    addw.x vf31, vf00, vf00w        bal vi13, pass_b_to_a
    nop                             iaddiu vi07, vi00, 0
    nop                             bal vi13, clip_edges
    nop                             nop
    nop                             bal vi13, close_polygon
    nop                             iaddiu vi09, vi00, 935
    nop                             iaddiu vi05, vi00, 512
    nop                             iaddiu vi06, vi00, 8
    subw.x vf31, vf00, vf00w        bal vi13, pass_a_to_b
    nop                             iaddiu vi07, vi00, 1
    nop                             bal vi13, clip_edges
    nop                             nop
    nop                             bal vi13, close_polygon
    nop                             iaddiu vi09, vi00, 975
    nop                             iaddiu vi05, vi00, 256
    nop                             iaddiu vi06, vi00, 4
    addw.x vf31, vf00, vf00w        bal vi13, pass_b_to_a
    nop                             iaddiu vi07, vi00, 1
    nop                             bal vi13, clip_edges
    nop                             nop
    nop                             bal vi13, close_polygon
    nop                             iaddiu vi09, vi00, 935
    nop                             iaddiu vi09, vi00, 935
    nop                             iaddiu vi10, vi00, 975
    nop                             iadd vi04, vi00, vi11
    nop                             iaddiu vi11, vi00, 0
    nop                             ilw.x vi12, 934(vi00)
    nop                             ilwr.y vi06, (vi02)
    nop                             lq.xyzw vf31, 934(vi00)
    nop                             lq.xyzw vf27, 10(vi00)
    nop                             lq.xyzw vf28, 11(vi00)
    nop                             iadd vi12, vi12, vi04
    nop                             iadd vi06, vi06, vi03
    nop                             iaddiu vi02, vi06, 0
    nop                             sqi.xyzw vf31, (vi06++)
    nop                             lq.xyzw vf29, 12(vi00)
    nop                             lq.xyzw vf30, 13(vi00)
    nop                             xgkick vi02                          ; send the output to the GS (PATH1)
    nop                             nop
    nop                             isw.x vi12, -1(vi06)
clip_triangle_loop:
    nop                             lqi.xyzw vf24, (vi09++)
    nop                             lqi.xyzw vf25, (vi09++)
    nop                             lqi.xyzw vf26, (vi09++)
    nop                             nop
    mulax.xyzw ACC, vf27, vf24x     nop
    madday.xyzw ACC, vf28, vf24y    nop
    maddaz.xyzw ACC, vf29, vf24z    nop
    maddw.xyzw vf23, vf30, vf24w    loi 128.0                            ; I = 128.0: the colour clamp (0x80 is 1.0 on the GS)
    minii.xyz vf25, vf25, I         nop
    nop                             nop
    nop                             nop
    nop                             div Q, vf00w, vf23w                  ; Q = 1 / vf23.w
    ftoi0.xyzw vf25, vf25           waitq
    mulq.xyzw vf23, vf23, Q         nop
    mulq.xyz vf26, vf26, Q          nop
    nop                             nop
    nop                             iaddi vi04, vi04, -1
    ftoi4.xyzw vf23, vf23           iaddiu vi06, vi06, 3                 ; to 12.4 fixed point (GS XYZ)
    nop                             sq.xyzw vf26, -3(vi06)
    nop                             sq.xyzw vf25, -2(vi06)
    nop                             ibne vi04, vi00, clip_triangle_loop
    nop                             sq.xyzw vf23, -1(vi06)
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             xgkick vi02                          ; send the output to the GS (PATH1)
clip_triangle_exit:
    nop                             ilwr.x vi10, (vi14)
    nop                             ilwr.y vi11, (vi14)
    nop                             ilwr.z vi12, (vi14)
    nop                             ilwr.w vi13, (vi14)
    nop                             iaddiu vi14, vi14, 1
    nop                             ilwr.x vi06, (vi14)
    nop                             ilwr.y vi07, (vi14)
    nop                             ilwr.z vi08, (vi14)
    nop                             ilwr.w vi09, (vi14)
    nop                             iaddiu vi14, vi14, 1
    nop                             ilwr.x vi02, (vi14)
    nop                             ilwr.y vi03, (vi14)
    nop                             ilwr.z vi04, (vi14)
    nop                             ilwr.w vi05, (vi14)
    nop                             iaddiu vi14, vi14, 1
    nop                             lqi.xyzw vf31, (vi14++)
    nop                             lqi.xyzw vf30, (vi14++)
    nop                             lqi.xyzw vf29, (vi14++)
    nop                             lqi.xyzw vf28, (vi14++)
    nop                             lqi.xyzw vf27, (vi14++)
    nop                             lqi.xyzw vf26, (vi14++)
    nop                             lqi.xyzw vf25, (vi14++)
    nop                             lqi.xyzw vf24, (vi14++)
    nop                             lqi.xyzw vf23, (vi14++)
    nop                             lqi.xyzw vf22, (vi14++)
    nop                             lqi.xyzw vf21, (vi14++)
    nop                             jr vi15
    nop                             nop

    ; after a plane: repeat the first output vertex after the last; an empty polygon leaves
    ; (clip_triangle_exit)
close_polygon:
    nop                             lqi.xyzw vf29, (vi09++)
    nop                             lqi.xyzw vf30, (vi09++)
    nop                             lqi.xyzw vf31, (vi09++)
    nop                             nop
    nop                             sqi.xyzw vf29, (vi10++)
    nop                             sqi.xyzw vf30, (vi10++)
    nop                             ibeq vi11, vi00, clip_triangle_exit
    nop                             sqi.xyzw vf31, (vi10++)
    nop                             jr vi13
    nop                             nop

    ; the next plane reads the polygon at VU 935.. and writes the one at 975.. (as set at
    ; clip_triangle)
pass_a_to_b:
    nop                             iaddiu vi09, vi00, 935
    nop                             b pass_start
    nop                             iaddiu vi10, vi00, 975

    ; the next plane reads the second polygon buffer and writes the first
pass_b_to_a:
    nop                             iaddiu vi09, vi00, 975
    nop                             iaddiu vi10, vi00, 935

    ; vi04: the vertices to clip; vi11: none written yet
pass_start:
    nop                             iadd vi04, vi00, vi11
    nop                             iaddiu vi11, vi00, 0

    ; load the polygon's first vertex (three qwords)
first_vertex:
    nop                             lqi.xyzw vf21, (vi09++)
    nop                             lqi.xyzw vf22, (vi09++)
    nop                             jr vi13
    nop                             lqi.xyzw vf23, (vi09++)

    ; clip the polygon's edges against one plane (vi05, vi06: its clip-flag bits; vf31.x its
    ; sign)
clip_edges:
    mulw.xyzw vf24, vf21, vf00w     lqi.xyzw vf21, (vi09++)
    mulw.xyzw vf25, vf22, vf00w     lqi.xyzw vf22, (vi09++)
    mulw.xyzw vf26, vf23, vf00w     lqi.xyzw vf23, (vi09++)
    nop                             nop
    clipw.xyz vf24, vf24w           nop                                  ; clip flags: vf24.xyz against +-vf24.w
    clipw.xyz vf21, vf21w           nop
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             fcget vi01
    nop                             nop
    nop                             iand vi12, vi01, vi05
    nop                             nop
    nop                             ibeq vi12, vi00, clip_edges_skip
    nop                             nop
    nop                             iand vi12, vi01, vi06
    nop                             nop
    nop                             ibne vi12, vi00, clip_edges_skip3
    nop                             nop
    nop                             bal vi01, intersect
    nop                             nop
    nop                             sqi.xyzw vf28, (vi10++)
    nop                             sqi.xyzw vf29, (vi10++)
    nop                             sqi.xyzw vf30, (vi10++)
    nop                             b clip_edges_skip3
    nop                             iaddiu vi11, vi11, 1
clip_edges_skip:
    nop                             iand vi12, vi01, vi06
    nop                             nop
    nop                             ibeq vi12, vi00, clip_edges_skip2
    nop                             nop
    nop                             bal vi01, intersect
    nop                             nop
    nop                             sqi.xyzw vf24, (vi10++)
    nop                             sqi.xyzw vf25, (vi10++)
    nop                             sqi.xyzw vf26, (vi10++)
    nop                             sqi.xyzw vf28, (vi10++)
    nop                             sqi.xyzw vf29, (vi10++)
    nop                             sqi.xyzw vf30, (vi10++)
    nop                             b clip_edges_skip3
    nop                             iaddiu vi11, vi11, 2
clip_edges_skip2:
    nop                             sqi.xyzw vf24, (vi10++)
    nop                             sqi.xyzw vf25, (vi10++)
    nop                             sqi.xyzw vf26, (vi10++)
    nop                             iaddiu vi11, vi11, 1
clip_edges_skip3:
    nop                             isubiu vi04, vi04, 1
    nop                             nop
    nop                             ibne vi04, vi00, clip_edges
    nop                             nop
    nop                             jr vi13
    nop                             nop

    ; an edge crosses the plane: write the intersection (position and attributes interpolated)
intersect:
    mulx.w vf28, vf24, vf31x        nop
    mulx.w vf29, vf21, vf31x        nop
    nop                             nop
    nop                             nop
    subw.xyzw vf28, vf24, vf28w     nop
    subw.xyzw vf29, vf21, vf29w     nop
    nop                             iadd vi12, vi00, vi07
    nop                             nop
intersect_loop:
    nop                             ibeq vi12, vi00, intersect_skip
    nop                             nop
    nop                             mr32.xyzw vf28, vf28
    nop                             mr32.xyzw vf29, vf29
    nop                             isubiu vi12, vi12, 1
    nop                             nop
    nop                             b intersect_loop
    nop                             nop
intersect_skip:
    sub.xyz vf30, vf29, vf28        nop
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             div Q, vf28x, vf30x
    nop                             waitq
    addq.x vf27, vf00, Q            nop
    sub.xyzw vf28, vf21, vf24       nop
    sub.xyzw vf29, vf22, vf25       nop
    sub.xyzw vf30, vf23, vf26       nop
    abs.x vf27, vf27                nop
    nop                             nop
    nop                             nop
    nop                             nop
    mulx.xyzw vf28, vf28, vf27x     nop
    mulx.xyzw vf29, vf29, vf27x     nop
    mulx.xyzw vf30, vf30, vf27x     nop
    nop                             nop
    add.xyzw vf28, vf28, vf24       nop
    add.xyzw vf29, vf29, vf25       nop
    add.xyzw vf30, vf30, vf26       nop
    nop                             nop
    nop                             jr vi01
    nop                             nop
.endprogram

;=======================================================================================
; Vu1Prog08: three lights
;
; gVu1ProgInfo08 (bones.c): 110 pairs (880 bytes), batches of up to 4080 bytes;
; Vu1_SelectProgram's key 0x200, rigid models (0x21035, 0x121035).
; Setup Vu1Pkt_L: an UNPACK of 16 qwords to VU 0, then MSCALF 0:
;   0        colour: gGsColorF, RGB scaled by the model's brightness: vf16
;   1-4      gMtxSlots x gMtxView x gMtxProjClip: model to screen (XYZ after the divide by w): vf01-vf04
;   5-8      the matrix above x gViewportMtx: model to the clip test's space: vf05-vf08
;   9-11     light directions (model space, negated): vf09-vf11
;   12-15    light colours (three lights and the ambient): vf12-vf15
; Vertices: gVu1ProgLayouts[1], 4 qwords: position, normal, colour, texture coordinates.
; Batches at VU 0x10 and 0x10 + 0x1f8 (XTOP); the output follows each.
;=======================================================================================
.program Vu1Prog08
.base 0x10
.offset 0x1f8

    ; MSCALF 0: the setup's constants into registers
init:
    nop                             lq.xyzw vf10, 10(vi00)
    nop                             lq.xyzw vf11, 11(vi00)
    nop                             lq.xyzw vf12, 12(vi00)
    nop                             lq.xyzw vf13, 13(vi00)
    nop                             lq.xyzw vf14, 14(vi00)
    nop                             lq.xyzw vf15, 15(vi00)
    nop                             lq.xyzw vf16, 0(vi00)
    nop                             lq.xyzw vf01, 1(vi00)
    nop                             lq.xyzw vf02, 2(vi00)
    nop                             loi 128.0                            ; I = 128.0: the colour clamp (0x80 is 1.0 on the GS)
    muli.xyzw vf12, vf12, I         lq.xyzw vf03, 3(vi00)
    muli.xyzw vf13, vf13, I         lq.xyzw vf04, 4(vi00)
    muli.xyzw vf14, vf14, I         lq.xyzw vf05, 5(vi00)
    nop                             lq.xyzw vf06, 6(vi00)
    minii.xyzw vf12, vf12, I        lq.xyzw vf07, 7(vi00)
    minii.xyzw vf13, vf13, I        lq.xyzw vf08, 8(vi00)
    minii.xyzw vf14, vf14, I        lq.xyzw vf09, 9(vi00)
    nop                             nop                               [E] ; end: constants loaded
    nop                             nop

    ; MSCNT: one batch at XTOP; qword 0's x is its type, qword 1 a GIF tag
batch:
    nop                             xtop vi02                            ; vi02: the batch (BASE, or BASE + OFFSET: double buffer)
    nop                             iaddiu vi05, vi02, 0
    nop                             iaddiu vi03, vi02, 255               ; vi03: the output, 255 qwords after the batch
    nop                             ilwr.x vi06, (vi05)                  ; the batch type (qword 0)
    nop                             iaddiu vi05, vi05, 1
    nop                             ilwr.x vi08, (vi05)                  ; the GIF tag (qword 1): NLOOP, EOP
    nop                             iaddiu vi04, vi03, 0
    nop                             iaddiu vi11, vi00, 32767             ; 0x7FFF: the NLOOP mask
    nop                             lq.xyzw vf31, 0(vi05)
    nop                             iand vi07, vi11, vi08
    nop                             iaddiu vi11, vi00, 1
    nop                             iaddiu vi05, vi05, 1
    nop                             ibeq vi11, vi06, vertices
    nop                             sqi.xyzw vf31, (vi04++)

    ; a register block: the GIF tag and its NLOOP qwords (A+D) go through to the output
copy_regs:
    nop                             lq.xyzw vf31, 0(vi05)
    nop                             iaddi vi07, vi07, -1
    nop                             iaddiu vi05, vi05, 1
    nop                             iaddiu vi04, vi04, 1
    nop                             ibne vi07, vi00, copy_regs
    nop                             sq.xyzw vf31, -1(vi04)
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             nop                               [E] ; end: the next MSCNT continues at copy_regs_cont
    nop                             nop

    ; the next MSCNT continues here
copy_regs_cont:
    nop                             b batch                              ; the next batch
    nop                             nop

    ; type 1: a strip of NLOOP vertices
vertices:
    nop                             lq.xyzw vf28, 0(vi05)
    nop                             iaddiu vi08, vi08, 2                 ; NLOOP + 2: the delay line's last vertices go out first
    nop                             isw.x vi08, -1(vi04)
    nop                             lq.xyzw vf17, 1021(vi00)
    mulax.xyzw ACC, vf01, vf28x     lq.xyzw vf18, 1022(vi00)
    madday.xyzw ACC, vf02, vf28y    lq.xyzw vf19, 1023(vi00)
    maddaz.xyzw ACC, vf03, vf28z    lq.xyzw vf20, 1018(vi00)
    maddw.xyzw vf27, vf04, vf00w    lq.xyzw vf21, 1019(vi00)
    mulax.xyzw ACC, vf05, vf28x     lq.xyzw vf29, 1(vi05)
    madday.xyzw ACC, vf06, vf28y    lq.xyzw vf22, 1020(vi00)
    maddaz.xyzw ACC, vf07, vf28z    sqi.xyzw vf17, (vi04++)
    maddw.xyzw vf26, vf08, vf00w    div Q, vf00w, vf27w                  ; Q = 1 / vf27.w
    mulax.xyzw ACC, vf09, vf29x     sqi.xyzw vf18, (vi04++)
    madday.xyzw ACC, vf10, vf29y    sqi.xyzw vf19, (vi04++)
    maddz.xyzw vf25, vf11, vf29z    sqi.xyzw vf20, (vi04++)
    nop                             sqi.xyzw vf21, (vi04++)
    nop                             lq.xyzw vf31, 3(vi05)
    nop                             sqi.xyzw vf22, (vi04++)
    ; one vertex per pass, software-pipelined through the delay line
vertices_loop:
    maxx.xyzw vf25, vf25, vf00x     nop
    mulq.xyzw vf27, vf27, Q         ilw.w vi09, 0(vi05)                  ; vi09: the position's w word, XYZF2's w (F, ADC) as the model has it
    mulq.xyz vf24, vf31, Q          lq.xyzw vf28, 4(vi05)
    clipw.xyz vf26, vf26w           nop                                  ; clip flags: vf26.xyz against +-vf26.w
    mulax.xyz ACC, vf12, vf25x      lq.xyzw vf30, 2(vi05)
    ftoi4.xyzw vf27, vf27           iaddiu vi05, vi05, 4                 ; to 12.4 fixed point (GS XYZ)
    madday.xyz ACC, vf13, vf25y     sq.xyzw vf24, 0(vi04)
    maddaz.xyz ACC, vf14, vf25z     fcand vi01, 0x03ffff                 ; vi01 = 1: one of the last three vertices is outside the clip volume
    madda.xyz ACC, vf15, vf30       nop
    madd.xyz vf30, vf16, vf30       sq.xyz vf27, 2(vi04)
    mulax.xyzw ACC, vf01, vf28x     iaddi vi07, vi07, -1
    madday.xyzw ACC, vf02, vf28y    iaddiu vi04, vi04, 3
    maddaz.xyzw ACC, vf03, vf28z    lq.xyzw vf31, 3(vi05)
    minii.xyzw vf30, vf30, I        loi 128.0                            ; I = 128.0: the colour clamp (0x80 is 1.0 on the GS)
    maddw.xyzw vf27, vf04, vf00w    nop
    mulax.xyzw ACC, vf05, vf28x     lq.xyzw vf29, 1(vi05)
    madday.xyzw ACC, vf06, vf28y    nop
    ftoi0.xyzw vf30, vf30           nop
    maddaz.xyzw ACC, vf07, vf28z    div Q, vf00w, vf27w
    maddw.xyzw vf26, vf08, vf00w    nop
    mulax.xyzw ACC, vf09, vf29x     ibeq vi01, vi00, vertices_skip
    madday.xyzw ACC, vf10, vf29y    sq.xyzw vf30, -2(vi04)
    nop                             iaddiu vi09, vi00, 32767
    nop                             iaddiu vi09, vi09, 1
vertices_skip:
    maddz.xyzw vf25, vf11, vf29z    nop
    nop                             nop
    nop                             ibne vi07, vi00, vertices_loop
    nop                             isw.w vi09, -1(vi04)
    ; the epilogue: the vertices left in the delay line
    nop                             lqd.xyzw vf17, (--vi04)
    nop                             lqd.xyzw vf18, (--vi04)
    nop                             lqd.xyzw vf19, (--vi04)
    nop                             lqd.xyzw vf20, (--vi04)
    nop                             lqd.xyzw vf21, (--vi04)
    nop                             lqd.xyzw vf22, (--vi04)
    nop                             sq.xyzw vf17, 1020(vi00)
    nop                             sq.xyzw vf18, 1019(vi00)
    nop                             sq.xyzw vf19, 1018(vi00)
    nop                             sq.xyzw vf20, 1023(vi00)
    nop                             sq.xyzw vf21, 1022(vi00)
    nop                             sq.xyzw vf22, 1021(vi00)
    nop                             xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             nop                               [E] ; end: the next MSCNT continues at vertices_cont
    nop                             nop

    ; the next MSCNT continues here
vertices_cont:
    nop                             b batch                              ; the next batch
    nop                             nop
.endprogram

;=======================================================================================
; Vu1Prog09: three lights, second colour
;
; gVu1ProgInfo09 (bones.c): 111 pairs (888 bytes), batches of up to 4080 bytes;
; Vu1_SelectProgram's key 0x20200, rigid models (0x21035, 0x121035).
; Setup Vu1Pkt_LV: an UNPACK of 17 qwords to VU 0, then MSCALF 0:
;   0        colour: gGsColorF, RGB scaled by the model's brightness: vf17
;   1        second colour: gGsColor2F: vf16
;   2-5      gMtxSlots x gMtxView x gMtxProjClip: model to screen (XYZ after the divide by w): vf01-vf04
;   6-9      the matrix above x gViewportMtx: model to the clip test's space: vf05-vf08
;   10-12    light directions (model space, negated): vf09-vf11
;   13-16    light colours (three lights and the ambient): vf12-vf15
; Vertices: gVu1ProgLayouts[1], 4 qwords: position, normal, colour, texture coordinates.
; Batches at VU 0x11 and 0x11 + 0x1f4 (XTOP); the output follows each.
;=======================================================================================
.program Vu1Prog09
.base 0x11
.offset 0x1f4

    ; MSCALF 0: the setup's constants into registers
init:
    nop                             lq.xyzw vf10, 11(vi00)
    nop                             lq.xyzw vf11, 12(vi00)
    nop                             lq.xyzw vf12, 13(vi00)
    nop                             lq.xyzw vf13, 14(vi00)
    nop                             lq.xyzw vf14, 15(vi00)
    nop                             lq.xyzw vf15, 16(vi00)
    nop                             lq.xyzw vf16, 1(vi00)
    nop                             lq.xyzw vf17, 0(vi00)
    nop                             lq.xyzw vf01, 2(vi00)
    nop                             lq.xyzw vf02, 3(vi00)
    nop                             loi 128.0                            ; I = 128.0: the colour clamp (0x80 is 1.0 on the GS)
    muli.xyzw vf12, vf12, I         lq.xyzw vf03, 4(vi00)
    muli.xyzw vf13, vf13, I         lq.xyzw vf04, 5(vi00)
    muli.xyzw vf14, vf14, I         lq.xyzw vf05, 6(vi00)
    nop                             lq.xyzw vf06, 7(vi00)
    minii.xyzw vf12, vf12, I        lq.xyzw vf07, 8(vi00)
    minii.xyzw vf13, vf13, I        lq.xyzw vf08, 9(vi00)
    minii.xyzw vf14, vf14, I        lq.xyzw vf09, 10(vi00)
    nop                             nop                               [E] ; end: constants loaded
    nop                             nop

    ; MSCNT: one batch at XTOP; qword 0's x is its type, qword 1 a GIF tag
batch:
    nop                             xtop vi02                            ; vi02: the batch (BASE, or BASE + OFFSET: double buffer)
    nop                             iaddiu vi05, vi02, 0
    nop                             iaddiu vi03, vi02, 255               ; vi03: the output, 255 qwords after the batch
    nop                             ilwr.x vi06, (vi05)                  ; the batch type (qword 0)
    nop                             iaddiu vi05, vi05, 1
    nop                             ilwr.x vi08, (vi05)                  ; the GIF tag (qword 1): NLOOP, EOP
    nop                             iaddiu vi04, vi03, 0
    nop                             iaddiu vi11, vi00, 32767             ; 0x7FFF: the NLOOP mask
    nop                             lq.xyzw vf31, 0(vi05)
    nop                             iand vi07, vi11, vi08
    nop                             iaddiu vi11, vi00, 1
    nop                             iaddiu vi05, vi05, 1
    nop                             ibeq vi11, vi06, vertices
    nop                             sqi.xyzw vf31, (vi04++)

    ; a register block: the GIF tag and its NLOOP qwords (A+D) go through to the output
copy_regs:
    nop                             lq.xyzw vf31, 0(vi05)
    nop                             iaddi vi07, vi07, -1
    nop                             iaddiu vi05, vi05, 1
    nop                             iaddiu vi04, vi04, 1
    nop                             ibne vi07, vi00, copy_regs
    nop                             sq.xyzw vf31, -1(vi04)
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             nop                               [E] ; end: the next MSCNT continues at copy_regs_cont
    nop                             nop

    ; the next MSCNT continues here
copy_regs_cont:
    nop                             b batch                              ; the next batch
    nop                             nop

    ; type 1: a strip of NLOOP vertices
vertices:
    nop                             iaddiu vi08, vi08, 2                 ; NLOOP + 2: the delay line's last vertices go out first
    nop                             isw.x vi08, -1(vi04)
    nop                             lq.xyzw vf18, 1021(vi00)
    nop                             lq.xyzw vf28, 0(vi05)
    nop                             lq.xyzw vf19, 1022(vi00)
    nop                             lq.xyzw vf20, 1023(vi00)
    nop                             lq.xyzw vf21, 1018(vi00)
    mulax.xyzw ACC, vf01, vf28x     lq.xyzw vf29, 1(vi05)
    madday.xyzw ACC, vf02, vf28y    lq.xyzw vf22, 1019(vi00)
    maddaz.xyzw ACC, vf03, vf28z    lq.xyzw vf23, 1020(vi00)
    maddw.xyzw vf27, vf04, vf00w    sqi.xyzw vf18, (vi04++)
    mulax.xyzw ACC, vf09, vf29x     sqi.xyzw vf19, (vi04++)
    madday.xyzw ACC, vf10, vf29y    sqi.xyzw vf20, (vi04++)
    maddz.xyzw vf25, vf11, vf29z    sqi.xyzw vf21, (vi04++)
    mulax.xyzw ACC, vf05, vf28x     div Q, vf00w, vf27w                  ; Q = 1 / vf27.w
    madday.xyzw ACC, vf06, vf28y    sqi.xyzw vf22, (vi04++)
    maddaz.xyzw ACC, vf07, vf28z    sqi.xyzw vf23, (vi04++)
    maxx.xyzw vf25, vf25, vf00x     loi 128.0                            ; I = 128.0: the colour clamp (0x80 is 1.0 on the GS)
    ; one vertex per pass, software-pipelined through the delay line
vertices_loop:
    maddw.xyzw vf26, vf08, vf00w    nop
    nop                             nop
    nop                             lq.xyzw vf30, 2(vi05)
    mulax.xyz ACC, vf12, vf25x      ilw.w vi09, 0(vi05)                  ; vi09: the position's w word, XYZF2's w (F, ADC) as the model has it
    madday.xyz ACC, vf13, vf25y     nop
    maddaz.xyz ACC, vf14, vf25z     lq.xyzw vf31, 3(vi05)
    madda.xyz ACC, vf15, vf30       iaddiu vi05, vi05, 4
    madd.xyz vf30, vf17, vf30       lq.xyzw vf28, 0(vi05)
    mulq.xyzw vf27, vf27, Q         lq.xyzw vf29, 1(vi05)
    mulq.xyz vf24, vf31, Q          iaddiu vi14, vi09, 0
    clipw.xyz vf26, vf26w           nop                                  ; clip flags: vf26.xyz against +-vf26.w
    minii.xyzw vf25, vf30, I        nop
    ftoi4.xyzw vf27, vf27           nop                                  ; to 12.4 fixed point (GS XYZ)
    mulax.xyzw ACC, vf01, vf28x     sq.xyzw vf24, 0(vi04)
    madday.xyzw ACC, vf02, vf28y    nop
    mul.xyzw vf24, vf25, vf16       nop
    maddaz.xyzw ACC, vf03, vf28z    sq.xyz vf27, 2(vi04)
    maddw.xyzw vf27, vf04, vf00w    iaddiu vi04, vi04, 3
    mulax.xyzw ACC, vf09, vf29x     iaddi vi07, vi07, -1
    ftoi0.xyzw vf24, vf24           nop
    madday.xyzw ACC, vf10, vf29y    fcand vi01, 0x03ffff                 ; vi01 = 1: one of the last three vertices is outside the clip volume
    maddz.xyzw vf25, vf11, vf29z    div Q, vf00w, vf27w
    mulax.xyzw ACC, vf05, vf28x     ibeq vi01, vi00, vertices_in_view
    madday.xyzw ACC, vf06, vf28y    sq.xyzw vf24, -2(vi04)
    nop                             iaddiu vi14, vi00, 32767             ; ADC: 0x7FFF + 1 = 0x8000, so the GS draws no triangle ending here
    nop                             iaddiu vi14, vi14, 1
    ; the last three vertices are all inside the clip volume
vertices_in_view:
    maddaz.xyzw ACC, vf07, vf28z    ibne vi07, vi00, vertices_loop
    maxx.xyzw vf25, vf25, vf00x     isw.w vi14, -1(vi04)
    ; the epilogue: the vertices left in the delay line
    nop                             lqd.xyzw vf18, (--vi04)
    nop                             lqd.xyzw vf19, (--vi04)
    nop                             lqd.xyzw vf20, (--vi04)
    nop                             lqd.xyzw vf21, (--vi04)
    nop                             lqd.xyzw vf22, (--vi04)
    nop                             lqd.xyzw vf23, (--vi04)
    nop                             sq.xyzw vf18, 1020(vi00)
    nop                             sq.xyzw vf19, 1019(vi00)
    nop                             sq.xyzw vf20, 1018(vi00)
    nop                             sq.xyzw vf21, 1023(vi00)
    nop                             sq.xyzw vf22, 1022(vi00)
    nop                             sq.xyzw vf23, 1021(vi00)
    nop                             xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             nop                               [E] ; end: the next MSCNT continues at vertices_cont
    nop                             nop

    ; the next MSCNT continues here
vertices_cont:
    nop                             b batch                              ; the next batch
    nop                             nop
.endprogram

;=======================================================================================
; Vu1Prog10: unlit, vertex colours
;
; gVu1ProgInfo10 (bones.c): 88 pairs (704 bytes), batches of up to 3968 bytes;
; Vu1_SelectProgram's key 0x0, rigid models (0x21035, 0x121035).
; Setup Vu1Pkt_Plain: an UNPACK of 9 qwords to VU 0, then MSCALF 0:
;   0        colour: gGsColorF, RGB scaled by the model's brightness
;   1-4      gMtxSlots x gMtxView x gMtxProjClip: model to screen (XYZ after the divide by w): vf01-vf04
;   5-8      the matrix above x gViewportMtx: model to the clip test's space: vf05-vf08
; Vertices: gVu1ProgLayouts[5], 3 qwords: position, colour, texture coordinates.
; Batches at VU 0x9 and 0x9 + 0x1f8 (XTOP); the output follows each.
;=======================================================================================
.program Vu1Prog10
.base 0x9
.offset 0x1f8

    ; MSCALF 0: the setup's constants into registers
init:
    nop                             lq.xyzw vf01, 1(vi00)
    nop                             lq.xyzw vf02, 2(vi00)
    nop                             lq.xyzw vf03, 3(vi00)
    nop                             lq.xyzw vf04, 4(vi00)
    nop                             lq.xyzw vf05, 5(vi00)
    nop                             lq.xyzw vf06, 6(vi00)
    nop                             lq.xyzw vf07, 7(vi00)
    nop                             lq.xyzw vf08, 8(vi00)
    nop                             nop                               [E] ; end: constants loaded
    nop                             nop

    ; MSCNT: one batch at XTOP; qword 0's x is its type, qword 1 a GIF tag
batch:
    nop                             xtop vi02                            ; vi02: the batch (BASE, or BASE + OFFSET: double buffer)
    nop                             iaddiu vi05, vi02, 0
    nop                             iaddiu vi03, vi02, 248               ; vi03: the output, 248 qwords after the batch
    nop                             ilwr.x vi06, (vi05)                  ; the batch type (qword 0)
    nop                             iaddiu vi05, vi05, 1
    nop                             ilwr.x vi08, (vi05)                  ; the GIF tag (qword 1): NLOOP, EOP
    nop                             iaddiu vi04, vi03, 0
    nop                             iaddiu vi11, vi00, 32767             ; 0x7FFF: the NLOOP mask
    nop                             lq.xyzw vf31, 0(vi05)
    nop                             iand vi07, vi11, vi08
    nop                             iaddiu vi11, vi00, 1
    nop                             iaddiu vi05, vi05, 1
    nop                             ibeq vi11, vi06, vertices
    nop                             sqi.xyzw vf31, (vi04++)

    ; a register block: the GIF tag and its NLOOP qwords (A+D) go through to the output
copy_regs:
    nop                             lqi.xyzw vf30, (vi05++)
    nop                             iaddi vi07, vi07, -1
    nop                             iaddiu vi04, vi04, 1
    nop                             ibne vi07, vi00, copy_regs
    nop                             sq.xyzw vf30, -1(vi04)
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             nop                               [E] ; end: the next MSCNT continues at copy_regs_cont
    nop                             nop

    ; the next MSCNT continues here
copy_regs_cont:
    nop                             b batch                              ; the next batch
    nop                             nop

    ; type 1: a strip of NLOOP vertices
vertices:
    nop                             iaddiu vi08, vi08, 2                 ; NLOOP + 2: the delay line's last vertices go out first
    nop                             isw.x vi08, -1(vi04)
    ; one vertex per pass, software-pipelined through the delay line
vertices_loop:
    nop                             lq.xyzw vf28, 0(vi05)
    nop                             ilw.w vi09, 0(vi05)                  ; vi09: the position's w word, XYZF2's w (F, ADC) as the model has it
    nop                             lq.xyzw vf30, 1(vi05)
    nop                             lq.xyzw vf31, 2(vi05)
    nop                             iaddiu vi05, vi05, 3
    mulax.xyzw ACC, vf01, vf28x     nop
    madday.xyzw ACC, vf02, vf28y    nop
    maddaz.xyzw ACC, vf03, vf28z    lq.xyzw vf17, 1021(vi00)
    maddw.xyzw vf27, vf04, vf00w    lq.xyzw vf18, 1022(vi00)
    mulax.xyzw ACC, vf05, vf28x     lq.xyzw vf19, 1023(vi00)
    madday.xyzw ACC, vf06, vf28y    lq.xyzw vf20, 1018(vi00)
    maddaz.xyzw ACC, vf07, vf28z    lq.xyzw vf21, 1019(vi00)
    maddw.xyzw vf26, vf08, vf00w    div Q, vf00w, vf27w                  ; Q = 1 / vf27.w
    ftoi0.xyzw vf30, vf30           lq.xyzw vf22, 1020(vi00)
    nop                             sqi.xyzw vf17, (vi04++)
    nop                             sqi.xyzw vf18, (vi04++)
    clipw.xyz vf26, vf26w           sqi.xyzw vf19, (vi04++)              ; clip flags: vf26.xyz against +-vf26.w
    nop                             sq.xyzw vf30, 1019(vi00)
    nop                             sq.xyzw vf20, 1021(vi00)
    mulq.xyzw vf27, vf27, Q         sq.xyzw vf21, 1022(vi00)
    mulq.xyz vf24, vf31, Q          fcand vi01, 0x03ffff                 ; vi01 = 1: one of the last three vertices is outside the clip volume
    nop                             ibeq vi01, vi00, vertices_in_view
    nop                             iaddi vi07, vi07, -1
    nop                             iaddiu vi09, vi00, 32767
    nop                             iaddiu vi09, vi09, 1
    ; the last three vertices are all inside the clip volume
vertices_in_view:
    ftoi4.xyzw vf27, vf27           sq.xyzw vf22, 1023(vi00)             ; to 12.4 fixed point (GS XYZ)
    nop                             sq.xyzw vf24, 1018(vi00)
    nop                             isw.w vi09, 1020(vi00)
    nop                             ibne vi07, vi00, vertices_loop
    nop                             sq.xyz vf27, 1020(vi00)
    ; the epilogue: the vertices left in the delay line
    nop                             lq.xyzw vf17, 1021(vi00)
    nop                             lq.xyzw vf18, 1022(vi00)
    nop                             lq.xyzw vf19, 1023(vi00)
    nop                             lq.xyzw vf20, 1018(vi00)
    nop                             lq.xyzw vf21, 1019(vi00)
    nop                             lq.xyzw vf22, 1020(vi00)
    nop                             sqi.xyzw vf17, (vi04++)
    nop                             sqi.xyzw vf18, (vi04++)
    nop                             sqi.xyzw vf19, (vi04++)
    nop                             sqi.xyzw vf20, (vi04++)
    nop                             sqi.xyzw vf21, (vi04++)
    nop                             sqi.xyzw vf22, (vi04++)
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             xgkick vi03                       [E] ; end: the next MSCNT continues at vertices_cont
    nop                             nop

    ; the next MSCNT continues here
vertices_cont:
    nop                             b batch                              ; the next batch
    nop                             nop
.endprogram

;=======================================================================================
; Vu1Prog11: material colour, no vertex colours
;
; gVu1ProgInfo11 (bones.c): 97 pairs (776 bytes), batches of up to 3200 bytes;
; Vu1_SelectProgram's key 0x2, rigid models (0x21035, 0x121035).
; Setup Vu1Pkt_Plain: an UNPACK of 9 qwords to VU 0, then MSCALF 0:
;   0        colour: gGsColorF, RGB scaled by the model's brightness
;   1-4      gMtxSlots x gMtxView x gMtxProjClip: model to screen (XYZ after the divide by w): vf01-vf04
;   5-8      the matrix above x gViewportMtx: model to the clip test's space: vf05-vf08
; Vertices: gVu1ProgLayouts[4], 2 qwords: position, texture coordinates.
; Batches at VU 0x9 and 0x9 + 0x1f8 (XTOP); the output follows each.
;=======================================================================================
.program Vu1Prog11
.base 0x9
.offset 0x1f8

    ; MSCALF 0: the setup's constants into registers
init:
    nop                             lq.xyzw vf01, 1(vi00)
    nop                             lq.xyzw vf02, 2(vi00)
    nop                             lq.xyzw vf03, 3(vi00)
    nop                             lq.xyzw vf04, 4(vi00)
    nop                             lq.xyzw vf05, 5(vi00)
    nop                             lq.xyzw vf06, 6(vi00)
    nop                             lq.xyzw vf07, 7(vi00)
    nop                             lq.xyzw vf08, 8(vi00)
    nop                             nop                               [E] ; end: constants loaded
    nop                             nop

    ; MSCNT: one batch at XTOP; qword 0's x is its type, qword 1 a GIF tag
batch:
    nop                             xtop vi02                            ; vi02: the batch (BASE, or BASE + OFFSET: double buffer)
    nop                             iaddiu vi05, vi02, 0
    nop                             iaddiu vi03, vi02, 200               ; vi03: the output, 200 qwords after the batch
    nop                             ilwr.x vi06, (vi05)                  ; the batch type (qword 0)
    nop                             iaddiu vi05, vi05, 1
    nop                             ilwr.x vi08, (vi05)                  ; the GIF tag (qword 1): NLOOP, EOP
    nop                             iaddiu vi04, vi03, 0
    nop                             iaddiu vi11, vi00, 32767             ; 0x7FFF: the NLOOP mask
    nop                             lq.xyzw vf31, 0(vi05)
    nop                             iand vi07, vi11, vi08
    nop                             iaddiu vi11, vi00, 1
    nop                             iaddiu vi05, vi05, 1
    nop                             ibeq vi11, vi06, vertices
    nop                             sqi.xyzw vf31, (vi04++)

    ; a register block: the GIF tag and its NLOOP qwords (A+D) go through to the output
copy_regs:
    nop                             lqi.xyzw vf30, (vi05++)
    nop                             iaddi vi07, vi07, -1
    nop                             iaddiu vi04, vi04, 1
    nop                             ibne vi07, vi00, copy_regs
    nop                             sq.xyzw vf30, -1(vi04)
    nop                             lq.xyzw vf27, 0(vi05)
    nop                             nop
    nop                             nop
    nop                             loi 128.0                            ; I = 128.0: the colour clamp (0x80 is 1.0 on the GS)
    ftoi0.xyzw vf29, vf27           nop
    muli.xyzw vf27, vf27, I         nop
    nop                             nop
    nop                             nop
    nop                             mtir vi15, vf29w
    minii.xyzw vf27, vf27, I        nop
    nop                             nop
    nop                             nop
    nop                             nop
    ftoi0.xyzw vf27, vf27           xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             nop                               [E] ; end: the next MSCNT continues at copy_regs_cont
    nop                             nop

    ; the next MSCNT continues here
copy_regs_cont:
    nop                             b batch                              ; the next batch
    nop                             nop

    ; type 1: a strip of NLOOP vertices
vertices:
    nop                             iaddiu vi08, vi08, 2                 ; NLOOP + 2: the delay line's last vertices go out first
    nop                             isw.x vi08, -1(vi04)
    ; one vertex per pass, software-pipelined through the delay line
vertices_loop:
    nop                             lq.xyzw vf29, 0(vi05)
    nop                             ilw.w vi09, 0(vi05)                  ; vi09: the position's w word, XYZF2's w (F, ADC) as the model has it
    nop                             lq.xyzw vf31, 1(vi05)
    nop                             iaddiu vi05, vi05, 2
    mulax.xyzw ACC, vf01, vf29x     lq.xyzw vf16, 1021(vi00)
    madday.xyzw ACC, vf02, vf29y    lq.xyzw vf17, 1022(vi00)
    maddaz.xyzw ACC, vf03, vf29z    lq.xyzw vf18, 1023(vi00)
    maddw.xyzw vf25, vf04, vf00w    lq.xyzw vf19, 1018(vi00)
    mulax.xyzw ACC, vf05, vf29x     lq.xyzw vf20, 1019(vi00)
    madday.xyzw ACC, vf06, vf29y    iaddi vi07, vi07, -1
    maddaz.xyzw ACC, vf07, vf29z    nop
    maddw.xyzw vf23, vf08, vf00w    div Q, vf00w, vf25w                  ; Q = 1 / vf25.w
    nop                             lq.xyzw vf21, 1020(vi00)
    nop                             sqi.xyzw vf16, (vi04++)
    nop                             sqi.xyzw vf17, (vi04++)
    clipw.xyz vf23, vf23w           sqi.xyzw vf18, (vi04++)              ; clip flags: vf23.xyz against +-vf23.w
    nop                             sq.xyzw vf19, 1021(vi00)
    nop                             isw.w vi15, 1019(vi00)
    mulq.xyzw vf25, vf25, Q         sq.xyz vf27, 1019(vi00)
    mulq.xyz vf28, vf31, Q          fcand vi01, 0x03ffff                 ; vi01 = 1: one of the last three vertices is outside the clip volume
    nop                             ibeq vi01, vi00, vertices_in_view
    nop                             sq.xyzw vf20, 1022(vi00)
    nop                             iaddiu vi09, vi00, 32767
    nop                             iaddiu vi09, vi09, 1
    ; the last three vertices are all inside the clip volume
vertices_in_view:
    ftoi4.xyzw vf25, vf25           sq.xyzw vf21, 1023(vi00)             ; to 12.4 fixed point (GS XYZ)
    nop                             sq.xyzw vf28, 1018(vi00)
    nop                             isw.w vi09, 1020(vi00)
    nop                             ibne vi07, vi00, vertices_loop
    nop                             sq.xyz vf25, 1020(vi00)
    ; the epilogue: the vertices left in the delay line
    nop                             lq.xyzw vf16, 1021(vi00)
    nop                             lq.xyzw vf17, 1022(vi00)
    nop                             lq.xyzw vf18, 1023(vi00)
    nop                             lq.xyzw vf19, 1018(vi00)
    nop                             lq.xyzw vf20, 1019(vi00)
    nop                             lq.xyzw vf21, 1020(vi00)
    nop                             sqi.xyzw vf16, (vi04++)
    nop                             sqi.xyzw vf17, (vi04++)
    nop                             sqi.xyzw vf18, (vi04++)
    nop                             sqi.xyzw vf19, (vi04++)
    nop                             sqi.xyzw vf20, (vi04++)
    nop                             sqi.xyzw vf21, (vi04++)
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             xgkick vi03                       [E] ; end: the next MSCNT continues at vertices_cont
    nop                             nop

    ; the next MSCNT continues here
vertices_cont:
    nop                             b batch                              ; the next batch
    nop                             nop
.endprogram

;=======================================================================================
; Vu1Prog12: second colour
;
; gVu1ProgInfo12 (bones.c): 90 pairs (720 bytes), batches of up to 3968 bytes;
; Vu1_SelectProgram's key 0x20000, rigid models (0x21035, 0x121035).
; Setup Vu1Pkt_V: an UNPACK of 10 qwords to VU 0, then MSCALF 0:
;   0        colour: gGsColorF, RGB scaled by the model's brightness
;   1        second colour: gGsColor2F: vf09
;   2-5      gMtxSlots x gMtxView x gMtxProjClip: model to screen (XYZ after the divide by w): vf01-vf04
;   6-9      the matrix above x gViewportMtx: model to the clip test's space: vf05-vf08
; Vertices: gVu1ProgLayouts[5], 3 qwords: position, colour, texture coordinates.
; Batches at VU 0xa and 0xa + 0x1f8 (XTOP); the output follows each.
;=======================================================================================
.program Vu1Prog12
.base 0xa
.offset 0x1f8

    ; MSCALF 0: the setup's constants into registers
init:
    nop                             lq.xyzw vf01, 2(vi00)
    nop                             lq.xyzw vf02, 3(vi00)
    nop                             lq.xyzw vf03, 4(vi00)
    nop                             lq.xyzw vf04, 5(vi00)
    nop                             lq.xyzw vf05, 6(vi00)
    nop                             lq.xyzw vf06, 7(vi00)
    nop                             lq.xyzw vf07, 8(vi00)
    nop                             lq.xyzw vf08, 9(vi00)
    nop                             lq.xyzw vf09, 1(vi00)
    nop                             nop                               [E] ; end: constants loaded
    nop                             nop

    ; MSCNT: one batch at XTOP; qword 0's x is its type, qword 1 a GIF tag
batch:
    nop                             xtop vi02                            ; vi02: the batch (BASE, or BASE + OFFSET: double buffer)
    nop                             iaddiu vi05, vi02, 0
    nop                             iaddiu vi03, vi02, 248               ; vi03: the output, 248 qwords after the batch
    nop                             ilwr.x vi06, (vi05)                  ; the batch type (qword 0)
    nop                             iaddiu vi05, vi05, 1
    nop                             ilwr.x vi08, (vi05)                  ; the GIF tag (qword 1): NLOOP, EOP
    nop                             iaddiu vi04, vi03, 0
    nop                             iaddiu vi11, vi00, 32767             ; 0x7FFF: the NLOOP mask
    nop                             lq.xyzw vf31, 0(vi05)
    nop                             iand vi07, vi11, vi08
    nop                             iaddiu vi11, vi00, 1
    nop                             iaddiu vi05, vi05, 1
    nop                             ibeq vi11, vi06, vertices
    nop                             sqi.xyzw vf31, (vi04++)

    ; a register block: the GIF tag and its NLOOP qwords (A+D) go through to the output
copy_regs:
    nop                             lq.xyzw vf31, 0(vi05)
    nop                             iaddi vi07, vi07, -1
    nop                             iaddiu vi05, vi05, 1
    nop                             iaddiu vi04, vi04, 1
    nop                             ibne vi07, vi00, copy_regs
    nop                             sq.xyzw vf31, -1(vi04)
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             nop                               [E] ; end: the next MSCNT continues at copy_regs_cont
    nop                             nop

    ; the next MSCNT continues here
copy_regs_cont:
    nop                             b batch                              ; the next batch
    nop                             nop

    ; type 1: a strip of NLOOP vertices
vertices:
    nop                             iaddiu vi08, vi08, 2                 ; NLOOP + 2: the delay line's last vertices go out first
    nop                             isw.x vi08, -1(vi04)
    ; one vertex per pass, software-pipelined through the delay line
vertices_loop:
    nop                             lq.xyzw vf28, 0(vi05)
    nop                             nop
    nop                             lq.xyzw vf30, 1(vi05)
    nop                             ilw.w vi09, 0(vi05)                  ; vi09: the position's w word, XYZF2's w (F, ADC) as the model has it
    mulax.xyzw ACC, vf01, vf28x     lq.xyzw vf31, 2(vi05)
    madday.xyzw ACC, vf02, vf28y    iaddiu vi05, vi05, 3
    maddaz.xyzw ACC, vf03, vf28z    lq.xyzw vf17, 1021(vi00)
    maddw.xyzw vf27, vf04, vf00w    lq.xyzw vf18, 1022(vi00)
    mulax.xyzw ACC, vf05, vf28x     lq.xyzw vf19, 1023(vi00)
    madday.xyzw ACC, vf06, vf28y    lq.xyzw vf20, 1018(vi00)
    maddaz.xyzw ACC, vf07, vf28z    lq.xyzw vf21, 1019(vi00)
    maddw.xyzw vf26, vf08, vf00w    div Q, vf00w, vf27w                  ; Q = 1 / vf27.w
    mul.xyzw vf30, vf30, vf09       lq.xyzw vf22, 1020(vi00)
    nop                             sqi.xyzw vf17, (vi04++)
    nop                             sqi.xyzw vf18, (vi04++)
    clipw.xyz vf26, vf26w           sqi.xyzw vf19, (vi04++)              ; clip flags: vf26.xyz against +-vf26.w
    ftoi0.xyzw vf30, vf30           sq.xyzw vf20, 1021(vi00)
    nop                             sq.xyzw vf21, 1022(vi00)
    mulq.xyzw vf27, vf27, Q         sq.xyzw vf22, 1023(vi00)
    mulq.xyz vf24, vf31, Q          fcand vi01, 0x03ffff                 ; vi01 = 1: one of the last three vertices is outside the clip volume
    nop                             ibeq vi01, vi00, vertices_in_view
    nop                             iaddi vi07, vi07, -1
    nop                             iaddiu vi09, vi00, 32767
    nop                             iaddiu vi09, vi09, 1
    ; the last three vertices are all inside the clip volume
vertices_in_view:
    ftoi4.xyzw vf27, vf27           sq.xyzw vf30, 1019(vi00)             ; to 12.4 fixed point (GS XYZ)
    nop                             sq.xyzw vf24, 1018(vi00)
    nop                             isw.w vi09, 1020(vi00)
    nop                             ibne vi07, vi00, vertices_loop
    nop                             sq.xyz vf27, 1020(vi00)
    ; the epilogue: the vertices left in the delay line
    nop                             lq.xyzw vf17, 1021(vi00)
    nop                             lq.xyzw vf18, 1022(vi00)
    nop                             lq.xyzw vf19, 1023(vi00)
    nop                             lq.xyzw vf20, 1018(vi00)
    nop                             lq.xyzw vf21, 1019(vi00)
    nop                             lq.xyzw vf22, 1020(vi00)
    nop                             sqi.xyzw vf17, (vi04++)
    nop                             sqi.xyzw vf18, (vi04++)
    nop                             sqi.xyzw vf19, (vi04++)
    nop                             sqi.xyzw vf20, (vi04++)
    nop                             sqi.xyzw vf21, (vi04++)
    nop                             sqi.xyzw vf22, (vi04++)
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             nop                               [E] ; end: the next MSCNT continues at vertices_cont
    nop                             nop

    ; the next MSCNT continues here
vertices_cont:
    nop                             b batch                              ; the next batch
    nop                             nop
.endprogram

