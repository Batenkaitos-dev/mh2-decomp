    nop                             lq.xyzw vf07, 0(vi10)
    nop                             ersqrt P, vf11x
    nop                             lq.xyzw vf08, 1(vi10)
    nop                             lq.xyzw vf09, 2(vi10)
    addx.x vf04, vf00, vf07x        nop
    addy.x vf05, vf00, vf07y        nop
    addz.x vf06, vf00, vf07z        nop
    addx.y vf04, vf00, vf08x        nop
    addy.y vf05, vf00, vf08y        nop
    mulq.xyz vf21, vf21, Q          rsqrt Q, vf00w, vf12x
    addz.y vf06, vf00, vf08z        nop
    addx.z vf04, vf00, vf09x        nop
    addy.z vf05, vf00, vf09y        nop
    addz.z vf06, vf00, vf09z        nop
    addx.x vf24, vf00, vf21x        nop
    addy.x vf25, vf00, vf21y        nop
    addz.x vf26, vf00, vf21z        nop
    mulax.xyz ACC, vf04, vf01x      nop
    madday.xyz ACC, vf05, vf01y     nop
    maddz.xyz vf27, vf06, vf01z     mfp.x vf11, P
    mulax.xyz ACC, vf04, vf02x      nop
    madday.xyz ACC, vf05, vf02y     nop
    mulq.xyz vf23, vf23, Q          nop
    mulx.xyz vf22, vf22, vf11x      nop
    mul.xyz vf10, vf27, vf27        nop
    maddz.xyz vf28, vf06, vf02z     nop
    addx.z vf24, vf00, vf23x        nop
    addx.y vf24, vf00, vf22x        nop
    addy.z vf25, vf00, vf23y        nop
    addy.y vf25, vf00, vf22y        nop
    addz.z vf26, vf00, vf23z        nop
    addz.y vf26, vf00, vf22z        sq.xyzw vf24, -3(vi11)
    mulax.xyz ACC, vf04, vf03x      move.xyzw vf21, vf27
    madday.xyz ACC, vf05, vf03y     sq.xyzw vf25, -2(vi11)
    maddz.xyz vf29, vf06, vf03z     ibne vi07, vi00, init_loop
    addy.x vf10, vf10, vf10y        sq.xyzw vf26, -1(vi11)
    addx.x vf09, vf00, vf01x        lq.xyzw vf04, 4(vi00)
    addy.x vf10, vf00, vf01y        lq.xyzw vf05, 5(vi00)
    addz.x vf11, vf00, vf01z        lq.xyzw vf01, 1(vi00)
    addx.y vf09, vf00, vf02x        lq.xyzw vf06, 6(vi00)
    addy.y vf10, vf00, vf02y        lq.xyzw vf07, 7(vi00)
    addz.y vf11, vf00, vf02z        lq.xyzw vf02, 2(vi00)
    addx.z vf09, vf00, vf03x        lq.xyzw vf08, 8(vi00)
    addy.z vf10, vf00, vf03y        nop
    addz.z vf11, vf00, vf03z        lq.xyzw vf03, 3(vi00)
    nop                             nop
    nop                             sq.xyzw vf09, 9(vi00)
    nop                             sq.xyzw vf10, 10(vi00)
    nop                             sq.xyzw vf11, 11(vi00)
    nop                             nop                               [E] ; end: constants loaded
    nop                             nop

    ; MSCNT: one batch at XTOP; qword 0's x is its type, qword 1 a GIF tag
batch:
    nop                             xtop vi02                            ; vi02: the batch (BASE, or BASE + OFFSET: double buffer)
    nop                             iaddiu vi05, vi02, 0
    nop                             iaddiu vi03, vi02, 200               ; vi03: the output, 200 qwords after the batch
    nop                             ilwr.x vi06, (vi05)                  ; the batch type (qword 0)
    nop                             iaddiu vi05, vi05, 1
    nop                             ilwr.x vi08, (vi05)                  ; the GIF tag (qword 1): NLOOP, EOP
    nop                             iaddiu vi04, vi03, 0
    nop                             iaddiu vi11, vi00, 32767             ; 0x7FFF: the NLOOP mask
    nop                             lq.xyzw vf31, 0(vi05)
    nop                             iand vi07, vi11, vi08
    nop                             iaddiu vi05, vi05, 1
    nop                             iaddiu vi11, vi00, 1
    nop                             sqi.xyzw vf31, (vi04++)
    nop                             ibeq vi11, vi06, rigid
    nop                             iaddiu vi11, vi00, 2
    nop                             nop
    nop                             ibeq vi11, vi06, blended
    nop                             nop

    ; a register block: the GIF tag and its NLOOP qwords (A+D) go through to the output
copy_regs:
    nop                             lqi.xyzw vf31, (vi05++)
    nop                             iaddi vi07, vi07, -1
    nop                             iaddiu vi04, vi04, 1
    nop                             ibne vi07, vi00, copy_regs
    nop                             sq.xyzw vf31, -1(vi04)
    nop                             lqi.xyzw vf29, (vi05++)
    nop                             lq.xyzw vf24, 12(vi00)
    nop                             lq.xyzw vf25, 13(vi00)
    nop                             lq.xyzw vf26, 14(vi00)
    nop                             lq.xyzw vf27, 15(vi00)
    nop                             lq.xyzw vf28, 0(vi00)
    mul.xyzw vf24, vf29, vf24       lqi.xyzw vf30, (vi05++)
    mul.xyzw vf25, vf29, vf25       nop
    mul.xyzw vf26, vf29, vf26       nop
    add.xyzw vf23, vf27, vf28       nop
    ftoi0.xyzw vf29, vf29           nop
    muli.xyzw vf09, vf24, I         nop
    muli.xyzw vf10, vf25, I         nop
    muli.xyzw vf11, vf26, I         nop
    mul.xyzw vf12, vf23, vf30       mtir vi15, vf29w
    minii.xyzw vf09, vf09, I        nop
    minii.xyzw vf10, vf10, I        nop
    minii.xyzw vf11, vf11, I        nop
    minii.xyzw vf12, vf12, I        xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             nop                               [E] ; end: the next MSCNT continues at copy_regs_cont
    nop                             nop

    ; the next MSCNT continues here
copy_regs_cont:
    nop                             b batch                              ; the next batch
    nop                             nop

    ; type 1: vertices of one bone each (qword 3: the bone's matrix addresses)
rigid:
    nop                             iaddiu vi08, vi08, 2                 ; NLOOP + 2: the delay line's last vertices go out first
    nop                             isw.x vi08, -1(vi04)
    nop                             lq.xyzw vf16, 1021(vi00)
    nop                             lq.xyzw vf17, 1022(vi00)
    nop                             lq.xyzw vf18, 1023(vi00)
    nop                             lq.xyzw vf19, 1018(vi00)
    nop                             lq.xyzw vf20, 1019(vi00)
    nop                             lq.xyzw vf21, 1020(vi00)
    nop                             sqi.xyzw vf16, (vi04++)
    nop                             sqi.xyzw vf17, (vi04++)
    nop                             sqi.xyzw vf18, (vi04++)
    nop                             sqi.xyzw vf19, (vi04++)
    nop                             sqi.xyzw vf20, (vi04++)
    nop                             ilw.x vi10, 3(vi05)
    nop                             ilw.y vi11, 3(vi05)
    nop                             lq.xyzw vf29, 0(vi05)
    nop                             lq.xyzw vf30, 1(vi05)
    nop                             lq.xyzw vf16, 0(vi10)
    nop                             lq.xyzw vf17, 1(vi10)
    nop                             lq.xyzw vf18, 2(vi10)
    nop                             lq.xyzw vf19, 3(vi10)
    mulax.xyzw ACC, vf16, vf29x     lq.xyzw vf16, 0(vi11)
    madday.xyzw ACC, vf17, vf29y    lq.xyzw vf17, 1(vi11)
    maddaz.xyzw ACC, vf18, vf29z    lq.xyzw vf18, 2(vi11)
    maddw.xyzw vf29, vf19, vf00w    sqi.xyzw vf21, (vi04++)
    ; one vertex per pass, software-pipelined through the delay line
rigid_loop:
    mulax.xyz ACC, vf16, vf30x      lq.xyzw vf16, 16(vi00)
    madday.xyz ACC, vf17, vf30y     lq.xyzw vf17, 17(vi00)
    maddz.xyz vf28, vf18, vf30z     lq.xyzw vf18, 18(vi00)
    mulax.xyzw ACC, vf01, vf29x     move.xyzw vf25, vf29
    madday.xyzw ACC, vf02, vf29y    lq.xyzw vf31, 2(vi05)
    maddaz.xyzw ACC, vf03, vf29z    move.xyz vf13, vf14
    maddw.xyzw vf27, vf04, vf00w    move.xyz vf14, vf15
    maxx.xyzw vf28, vf28, vf00x     ilw.w vi09, 0(vi05)                  ; vi09: the position's w word, XYZF2's w (F, ADC) as the model has it
    mulax.xy ACC, vf16, vf31x       move.xyzw vf21, vf30
    madday.xy ACC, vf17, vf31y      iaddiu vi05, vi05, 5
    maddw.xy vf31, vf18, vf00w      div Q, vf00w, vf27w                  ; Q = 1 / vf27.w
    mulax.xyz ACC, vf09, vf28x      ilw.x vi10, 3(vi05)
    madday.xyz ACC, vf10, vf28y     ilw.y vi11, 3(vi05)
    maddaz.xyz ACC, vf11, vf28z     lq.xyzw vf29, 0(vi05)
    maddw.xyz vf28, vf12, vf00w     lq.xyzw vf30, 1(vi05)
    mulax.xyzw ACC, vf05, vf25x     iaddi vi07, vi07, -1
    madday.xyzw ACC, vf06, vf25y    lq.xyzw vf16, 0(vi10)
    mulq.xyzw vf27, vf27, Q         lq.xyzw vf17, 1(vi10)
    minii.xyzw vf28, vf28, I        lq.xyzw vf18, 2(vi10)
    mulq.xyz vf26, vf31, Q          lq.xyzw vf19, 3(vi10)
    maddaz.xyzw ACC, vf07, vf25z    iaddiu vi04, vi04, 3
    maddw.xyzw vf25, vf08, vf00w    move.xyz vf15, vf27
    sub.xyz vf22, vf14, vf13        nop
    sub.xyz vf23, vf27, vf13        isw.w vi15, -2(vi04)
    ftoi4.xyzw vf27, vf27           nop                                  ; to 12.4 fixed point (GS XYZ)
    ftoi0.xyz vf28, vf28            sq.xyzw vf26, -3(vi04)
    clipw.xyz vf25, vf25w           nop                                  ; clip flags: vf25.xyz against +-vf25.w
    opmula.xyz ACC, vf23, vf22      iaddiu vi10, vi00, 32
    opmsub.xyz vf23, vf22, vf23     sq.xyz vf27, -1(vi04)
    mulax.xyzw ACC, vf16, vf29x     sq.xyz vf28, -2(vi04)
    madday.xyzw ACC, vf17, vf29y    lq.xyzw vf16, 0(vi11)
    maddaz.xyzw ACC, vf18, vf29z    lq.xyzw vf17, 1(vi11)
    mulw.z vf23, vf23, vf21w        fcand vi01, 0x03ffff                 ; vi01 = 1: one of the last three vertices is outside the clip volume
    nop                             ibne vi01, vi00, rigid_skip
    nop                             lq.xyzw vf18, 2(vi11)
    nop                             ibne vi09, vi00, rigid_skip2
    nop                             fmand vi01, vi10
    nop                             ibeq vi01, vi00, rigid_skip2
    nop                             nop
rigid_skip:
    nop                             iaddiu vi09, vi00, 32767
    nop                             iaddiu vi09, vi09, 1
rigid_skip2:
    maddw.xyzw vf29, vf19, vf00w    ibne vi07, vi00, rigid_loop
    nop                             isw.w vi09, -1(vi04)
    ; the epilogue: the vertices left in the delay line
    nop                             lqd.xyzw vf16, (--vi04)
    nop                             lqd.xyzw vf17, (--vi04)
    nop                             lqd.xyzw vf18, (--vi04)
    nop                             lqd.xyzw vf19, (--vi04)
    nop                             lqd.xyzw vf20, (--vi04)
    nop                             lqd.xyzw vf21, (--vi04)
    nop                             sq.xyzw vf16, 1020(vi00)
    nop                             sq.xyzw vf17, 1019(vi00)
    nop                             sq.xyzw vf18, 1018(vi00)
    nop                             sq.xyzw vf19, 1023(vi00)
    nop                             sq.xyzw vf20, 1022(vi00)
    nop                             sq.xyzw vf21, 1021(vi00)
    nop                             xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             nop                               [E] ; end: the next MSCNT continues at rigid_cont
    nop                             nop

    ; the next MSCNT continues here
rigid_cont:
    nop                             b batch                              ; the next batch
    nop                             nop

    ; type 2: vertices of four bones (qword 3: the matrix addresses, qword 4: the weights)
blended:
    nop                             iaddiu vi08, vi08, 2                 ; NLOOP + 2: the delay line's last vertices go out first
    nop                             isw.x vi08, -1(vi04)
    nop                             lq.xyzw vf16, 1021(vi00)
    nop                             lq.xyzw vf17, 1022(vi00)
    nop                             lq.xyzw vf18, 1023(vi00)
    nop                             lq.xyzw vf25, 1018(vi00)
    nop                             lq.xyzw vf26, 1019(vi00)
    nop                             lq.xyzw vf27, 1020(vi00)
    nop                             sqi.xyzw vf16, (vi04++)
    nop                             sqi.xyzw vf17, (vi04++)
    nop                             sqi.xyzw vf18, (vi04++)
    nop                             lq.xyzw vf29, 1(vi05)
    nop                             ilw.x vi10, 3(vi05)
    nop                             ilw.y vi11, 3(vi05)
    nop                             ilw.z vi12, 3(vi05)
    nop                             ilw.w vi13, 3(vi05)
    nop                             lq.xyzw vf31, 4(vi05)
    nop                             lq.xyzw vf20, 0(vi10)
    nop                             lq.xyzw vf21, 0(vi11)
    nop                             lq.xyzw vf22, 0(vi12)
    nop                             lq.xyzw vf23, 0(vi13)
    mulax.xyzw ACC, vf20, vf31x     lq.xyzw vf20, 1(vi10)
    madday.xyzw ACC, vf21, vf31y    lq.xyzw vf21, 1(vi11)
    maddaz.xyzw ACC, vf22, vf31z    lq.xyzw vf22, 1(vi12)
    maddw.xyzw vf16, vf23, vf31w    lq.xyzw vf23, 1(vi13)
    mulax.xyzw ACC, vf20, vf31x     lq.xyzw vf20, 2(vi10)
    madday.xyzw ACC, vf21, vf31y    lq.xyzw vf21, 2(vi11)
    maddaz.xyzw ACC, vf22, vf31z    lq.xyzw vf22, 2(vi12)
    maddw.xyzw vf17, vf23, vf31w    lq.xyzw vf23, 2(vi13)
    mulax.xyzw ACC, vf20, vf31x     lq.xyzw vf20, 3(vi10)
    madday.xyzw ACC, vf21, vf31y    lq.xyzw vf21, 3(vi11)
    maddaz.xyzw ACC, vf22, vf31z    lq.xyzw vf22, 3(vi12)
    maddw.xyzw vf18, vf23, vf31w    lq.xyzw vf23, 3(vi13)
    nop                             sqi.xyzw vf25, (vi04++)
    mulax.xyz ACC, vf16, vf29x      sqi.xyzw vf26, (vi04++)
    madday.xyz ACC, vf17, vf29y     sqi.xyzw vf27, (vi04++)
    maddz.xyz vf27, vf18, vf29z     lq.xyzw vf28, 0(vi05)
    mulax.xyzw ACC, vf20, vf31x     lq.xyzw vf20, 16(vi00)
    madday.xyzw ACC, vf21, vf31y    lq.xyzw vf21, 17(vi00)
    maddaz.xyzw ACC, vf22, vf31z    lq.xyzw vf22, 18(vi00)
    maddw.xyzw vf19, vf23, vf31w    erleng.xyz P, vf27                   ; P = 1 / |vf27.xyz|
    ; one vertex per pass, software-pipelined through the delay line
blended_loop:
    mulax.xyzw ACC, vf16, vf28x     lq.xyzw vf30, 2(vi05)
    madday.xyzw ACC, vf17, vf28y    ilw.w vi09, 0(vi05)                  ; vi09: the position's w word, XYZF2's w (F, ADC) as the model has it
    maddaz.xyzw ACC, vf18, vf28z    iaddiu vi05, vi05, 5
    maddw.xyzw vf28, vf19, vf00w    ilw.x vi10, 3(vi05)
    mulax.xy ACC, vf20, vf30x       ilw.y vi11, 3(vi05)
    madday.xy ACC, vf21, vf30y      ilw.z vi12, 3(vi05)
    maddw.xy vf30, vf22, vf00w      ilw.w vi13, 3(vi05)
    mulax.xyzw ACC, vf01, vf28x     lq.xyzw vf31, 4(vi05)
    madday.xyzw ACC, vf02, vf28y    lq.xyzw vf20, 0(vi10)
    maddaz.xyzw ACC, vf03, vf28z    lq.xyzw vf22, 0(vi12)
    maddw.xyzw vf26, vf04, vf00w    lq.xyzw vf21, 0(vi11)
    mulax.xyzw ACC, vf05, vf28x     lq.xyzw vf23, 0(vi13)
    madday.xyzw ACC, vf06, vf28y    nop
    maddaz.xyzw ACC, vf07, vf28z    nop
    maddw.xyzw vf28, vf08, vf00w    div Q, vf00w, vf26w                  ; Q = 1 / vf26.w
    mulax.xyzw ACC, vf20, vf31x     lq.xyzw vf20, 1(vi10)
    madday.xyzw ACC, vf21, vf31y    lq.xyzw vf21, 1(vi11)
    maddaz.xyzw ACC, vf22, vf31z    lq.xyzw vf22, 1(vi12)
    maddw.xyzw vf16, vf23, vf31w    lq.xyzw vf23, 1(vi13)
    mulax.xyzw ACC, vf20, vf31x     nop
    madday.xyzw ACC, vf21, vf31y    nop
    mulq.xyzw vf26, vf26, Q         nop
    mulq.xyz vf30, vf30, Q          move.xyz vf13, vf14
    maddaz.xyzw ACC, vf22, vf31z    mfp.w vf27, P
    maddw.xyzw vf17, vf23, vf31w    move.xyz vf14, vf15
    nop                             move.xyz vf15, vf26
    ftoi4.xyzw vf26, vf26           sq.xyzw vf30, 0(vi04)                ; to 12.4 fixed point (GS XYZ)
    mulw.xyz vf27, vf27, vf27w      lq.xyzw vf20, 9(vi00)
    clipw.xyz vf28, vf28w           lq.xyzw vf21, 10(vi00)               ; clip flags: vf28.xyz against +-vf28.w
    nop                             lq.xyzw vf22, 11(vi00)
    nop                             sq.xyz vf26, 2(vi04)
    mulax.xyz ACC, vf20, vf27x      lq.xyzw vf20, 2(vi10)
    madday.xyz ACC, vf21, vf27y     lq.xyzw vf21, 2(vi11)
    maddz.xyz vf27, vf22, vf27z     lq.xyzw vf22, 2(vi12)
    sub.xyz vf26, vf14, vf13        lq.xyzw vf23, 2(vi13)
    sub.xyz vf28, vf15, vf13        move.xyzw vf30, vf29
    mulax.xyzw ACC, vf20, vf31x     lq.xyzw vf20, 3(vi10)
    maxx.xyzw vf25, vf27, vf00x     nop
    madday.xyzw ACC, vf21, vf31y    lq.xyzw vf21, 3(vi11)
    maddaz.xyzw ACC, vf22, vf31z    lq.xyzw vf22, 3(vi12)
    maddw.xyzw vf18, vf23, vf31w    lq.xyzw vf23, 3(vi13)
    mulax.xyz ACC, vf09, vf25x      lq.xyzw vf29, 1(vi05)
    madday.xyz ACC, vf10, vf25y     isw.w vi15, 1(vi04)
    maddaz.xyz ACC, vf11, vf25z     nop
    maddw.xyz vf25, vf12, vf00w     nop
    mulax.xyz ACC, vf16, vf29x      nop
    madday.xyz ACC, vf17, vf29y     nop
    maddz.xyz vf27, vf18, vf29z     nop
    minii.xyzw vf25, vf25, I        nop
    opmula.xyz ACC, vf28, vf26      fcand vi01, 0x03ffff                 ; vi01 = 1: one of the last three vertices is outside the clip volume
    opmsub.xyz vf28, vf26, vf28     iaddi vi07, vi07, -1
    mulax.xyzw ACC, vf20, vf31x     lq.xyzw vf20, 16(vi00)
    ftoi0.xyz vf25, vf25            iaddiu vi04, vi04, 3
    madday.xyzw ACC, vf21, vf31y    lq.xyzw vf21, 17(vi00)
    maddaz.xyzw ACC, vf22, vf31z    lq.xyzw vf22, 18(vi00)
    maddw.xyzw vf19, vf23, vf31w    erleng.xyz P, vf27
    mulw.z vf26, vf28, vf30w        sq.xyz vf25, -2(vi04)
    nop                             ibne vi01, vi00, blended_skip
    nop                             lq.xyzw vf28, 0(vi05)
    nop                             ibne vi09, vi00, blended_skip2
    nop                             iaddiu vi01, vi00, 32
    nop                             fmand vi01, vi01
    nop                             ibeq vi01, vi00, blended_skip2
    nop                             nop
blended_skip:
    nop                             iaddiu vi09, vi00, 32767
    nop                             iaddiu vi09, vi09, 1
blended_skip2:
    nop                             ibne vi07, vi00, blended_loop
    nop                             isw.w vi09, -1(vi04)
    ; the epilogue: the vertices left in the delay line
    nop                             lqd.xyzw vf16, (--vi04)
    nop                             lqd.xyzw vf17, (--vi04)
    nop                             lqd.xyzw vf18, (--vi04)
    nop                             lqd.xyzw vf19, (--vi04)
    nop                             lqd.xyzw vf20, (--vi04)
    nop                             lqd.xyzw vf21, (--vi04)
    nop                             sq.xyzw vf16, 1020(vi00)
    nop                             sq.xyzw vf17, 1019(vi00)
    nop                             sq.xyzw vf18, 1018(vi00)
    nop                             sq.xyzw vf19, 1023(vi00)
    nop                             sq.xyzw vf20, 1022(vi00)
    nop                             sq.xyzw vf21, 1021(vi00)
    nop                             xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             nop                               [E] ; end: the next MSCNT continues at blended_cont
    nop                             nop

    ; the next MSCNT continues here
blended_cont:
    nop                             b batch                              ; the next batch
    nop                             nop
.endprogram

;=======================================================================================
; Vu1Prog52: skinned, normals (key bit 0x20), second colour, gMtxUv rows
;
; gVu1ProgInfo52 (bones.c): 229 pairs (1832 bytes), batches of up to 3200 bytes;
; Vu1_SelectProgram's key 0x24020, skinned models (0x321135, 0x221135).
; Setup Vu1Pkt_SVE: an UNPACK of 141 qwords to VU 0, then MSCALF 0:
;   0        colour: gGsColorF, RGB scaled by the model's brightness
;   1        second colour: gGsColor2F: vf09
;   2-5      gMtxView x gMtxProjClip: world to screen (XYZ after the divide by w): vf01-vf04
;   6-9      gMtxView x gViewportMtx: world to the clip test's space: vf05-vf08
;   10-12    rows 0, 1 and 3 of gMtxUv (Vu1_PutUvMatrix): vf10-vf12
;   13-140   bone matrices: the 32 gMtxSlots the model's mask (e+0x54) selects
; Vertices: gVu1ProgLayouts[9], 6 qwords: position, normal, colour, texture coordinates, bone indices, bone weights.
; Batches at VU 0x8d and 0x8d + 0x1b6 (XTOP); the output follows each.
;=======================================================================================
.program Vu1Prog52
.base 0x8d
.offset 0x1b6

    ; MSCALF 0: the setup's constants into registers
init:
    nop                             lq.xyzw vf01, 2(vi00)
    nop                             lq.xyzw vf02, 3(vi00)
    nop                             lq.xyzw vf03, 4(vi00)
    nop                             lq.xyzw vf04, 5(vi00)
    nop                             lq.xyzw vf05, 6(vi00)
    nop                             lq.xyzw vf06, 7(vi00)
    nop                             lq.xyzw vf07, 8(vi00)
    nop                             lq.xyzw vf08, 9(vi00)
    nop                             lq.xyzw vf09, 1(vi00)
    nop                             lq.xyzw vf10, 10(vi00)
    nop                             lq.xyzw vf11, 11(vi00)
    nop                             lq.xyzw vf12, 12(vi00)
    nop                             nop                               [E] ; end: constants loaded
    nop                             nop

    ; MSCNT: one batch at XTOP; qword 0's x is its type, qword 1 a GIF tag
batch:
    nop                             xtop vi02                            ; vi02: the batch (BASE, or BASE + OFFSET: double buffer)
    nop                             iaddiu vi05, vi02, 0
    nop                             iaddiu vi03, vi02, 200               ; vi03: the output, 200 qwords after the batch
    nop                             ilwr.x vi06, (vi05)                  ; the batch type (qword 0)
    nop                             iaddiu vi05, vi05, 1
    nop                             ilwr.x vi08, (vi05)                  ; the GIF tag (qword 1): NLOOP, EOP
    nop                             iaddiu vi04, vi03, 0
    nop                             iaddiu vi11, vi00, 32767             ; 0x7FFF: the NLOOP mask
    nop                             lq.xyzw vf31, 0(vi05)
    nop                             iand vi07, vi11, vi08
    nop                             iaddiu vi05, vi05, 1
    nop                             iaddiu vi11, vi00, 1
    nop                             sqi.xyzw vf31, (vi04++)
    nop                             ibeq vi11, vi06, rigid
    nop                             iaddiu vi11, vi00, 2
    nop                             nop
    nop                             ibeq vi11, vi06, blended
    nop                             nop

    ; a register block: the GIF tag and its NLOOP qwords (A+D) go through to the output
copy_regs:
    nop                             lqi.xyzw vf31, (vi05++)
    nop                             iaddi vi07, vi07, -1
    nop                             iaddiu vi04, vi04, 1
    nop                             ibne vi07, vi00, copy_regs
    nop                             sq.xyzw vf31, -1(vi04)
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             nop                               [E] ; end: the next MSCNT continues at copy_regs_cont
    nop                             nop

    ; the next MSCNT continues here
copy_regs_cont:
    nop                             b batch                              ; the next batch
    nop                             nop

    ; type 1: vertices of one bone each (qword 3: the bone's matrix addresses)
rigid:
    nop                             iaddiu vi08, vi08, 2                 ; NLOOP + 2: the delay line's last vertices go out first
    nop                             isw.x vi08, -1(vi04)
    nop                             lq.xyzw vf20, 1021(vi00)
    nop                             lq.xyzw vf21, 1022(vi00)
    nop                             lq.xyzw vf22, 1023(vi00)
    nop                             lq.xyzw vf23, 1018(vi00)
    nop                             lq.xyzw vf24, 1019(vi00)
    nop                             lq.xyzw vf25, 1020(vi00)
    nop                             ilw.x vi10, 4(vi05)
    nop                             sqi.xyzw vf20, (vi04++)
    nop                             sqi.xyzw vf21, (vi04++)
    nop                             lq.xyzw vf28, 0(vi05)
    nop                             lq.xyzw vf16, 0(vi10)
    nop                             lq.xyzw vf17, 1(vi10)
    nop                             lq.xyzw vf18, 2(vi10)
    nop                             lq.xyzw vf19, 3(vi10)
    mulax.xyzw ACC, vf16, vf28x     lq.xyzw vf31, 3(vi05)
    madday.xyzw ACC, vf17, vf28y    sqi.xyzw vf22, (vi04++)
    maddaz.xyzw ACC, vf18, vf28z    sqi.xyzw vf23, (vi04++)
    maddw.xyzw vf28, vf19, vf00w    sqi.xyzw vf24, (vi04++)
    mulax.xy ACC, vf10, vf31x       sqi.xyzw vf25, (vi04++)
    madday.xy ACC, vf11, vf31y      lq.xyzw vf30, 2(vi05)
    maddw.xy vf31, vf12, vf00w      lq.xyzw vf29, 1(vi05)
    mulax.xyzw ACC, vf01, vf28x     move.xyzw vf20, vf28
    madday.xyzw ACC, vf02, vf28y    ilw.x vi10, 4(vi05)
    maddaz.xyzw ACC, vf03, vf28z    ilw.w vi09, 0(vi05)                  ; vi09: the position's w word, XYZF2's w (F, ADC) as the model has it
    maddw.xyzw vf26, vf04, vf00w    iaddiu vi05, vi05, 6
    ; one vertex per pass, software-pipelined through the delay line
rigid_loop:
    mul.xyzw vf27, vf30, vf09       lq.xyzw vf28, 0(vi05)
    mulax.xyzw ACC, vf05, vf20x     lq.xyzw vf16, 0(vi10)
    madday.xyzw ACC, vf06, vf20y    lq.xyzw vf17, 1(vi10)
    maddaz.xyzw ACC, vf07, vf20z    div Q, vf00w, vf26w                  ; Q = 1 / vf26.w
    ftoi0.xyzw vf27, vf27           lq.xyzw vf18, 2(vi10)
    maddw.xyzw vf24, vf08, vf00w    lq.xyzw vf19, 3(vi10)
    mulax.xyzw ACC, vf16, vf28x     move.xyz vf13, vf14
    madday.xyzw ACC, vf17, vf28y    move.xyz vf14, vf15
    maddaz.xyzw ACC, vf18, vf28z    sq.xyzw vf27, 1(vi04)
    clipw.xyz vf24, vf24w           lq.xyzw vf30, 2(vi05)                ; clip flags: vf24.xyz against +-vf24.w
    mulq.xyzw vf26, vf26, Q         iaddiu vi04, vi04, 3
    mulq.xyz vf25, vf31, Q          lq.xyzw vf31, 3(vi05)
    maddw.xyzw vf28, vf19, vf00w    iaddiu vi05, vi05, 6
    sub.xyz vf21, vf14, vf13        iaddi vi07, vi07, -1
    sub.xyz vf22, vf26, vf13        move.xyz vf15, vf26
    ftoi4.xyzw vf26, vf26           nop                                  ; to 12.4 fixed point (GS XYZ)
    mulax.xy ACC, vf10, vf31x       sq.xyzw vf25, -3(vi04)
    madday.xy ACC, vf11, vf31y      nop
    maddw.xy vf31, vf12, vf00w      nop
    opmula.xyz ACC, vf22, vf21      nop
    opmsub.xyz vf22, vf21, vf22     sq.xyz vf26, -1(vi04)
    mulax.xyzw ACC, vf01, vf28x     move.xyzw vf20, vf28
    madday.xyzw ACC, vf02, vf28y    ilw.x vi10, 4(vi05)
    maddaz.xyzw ACC, vf03, vf28z    fcand vi01, 0x03ffff                 ; vi01 = 1: one of the last three vertices is outside the clip volume
    maddw.xyzw vf26, vf04, vf00w    ibne vi01, vi00, rigid_skip
    mulw.z vf22, vf22, vf29w        lq.xyzw vf29, -5(vi05)
    nop                             ibne vi09, vi00, rigid_skip2
    nop                             nop
    nop                             iaddiu vi01, vi00, 32
    nop                             fmand vi01, vi01
    nop                             ibeq vi01, vi00, rigid_skip2
    nop                             nop
rigid_skip:
    nop                             iaddiu vi09, vi00, 32767
    nop                             iaddiu vi09, vi09, 1
rigid_skip2:
    nop                             isw.w vi09, -1(vi04)
    nop                             ibne vi07, vi00, rigid_loop
    nop                             ilw.w vi09, -6(vi05)
    ; the epilogue: the vertices left in the delay line
    nop                             lqd.xyzw vf16, (--vi04)
    nop                             lqd.xyzw vf17, (--vi04)
    nop                             lqd.xyzw vf18, (--vi04)
    nop                             lqd.xyzw vf19, (--vi04)
    nop                             lqd.xyzw vf20, (--vi04)
    nop                             lqd.xyzw vf21, (--vi04)
    nop                             sq.xyzw vf16, 1020(vi00)
    nop                             sq.xyzw vf17, 1019(vi00)
    nop                             sq.xyzw vf18, 1018(vi00)
    nop                             sq.xyzw vf19, 1023(vi00)
    nop                             sq.xyzw vf20, 1022(vi00)
    nop                             sq.xyzw vf21, 1021(vi00)
    nop                             xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             nop                               [E] ; end: the next MSCNT continues at rigid_cont
    nop                             nop

    ; the next MSCNT continues here
rigid_cont:
    nop                             b batch                              ; the next batch
    nop                             nop

    ; type 2: vertices of four bones (qword 3: the matrix addresses, qword 4: the weights)
blended:
    nop                             iaddiu vi08, vi08, 2                 ; NLOOP + 2: the delay line's last vertices go out first
    nop                             isw.x vi08, -1(vi04)
    nop                             lq.xyzw vf16, 1021(vi00)
    nop                             lq.xyzw vf17, 1022(vi00)
    nop                             lq.xyzw vf18, 1023(vi00)
    nop                             lq.xyzw vf19, 1018(vi00)
    nop                             lq.xyzw vf20, 1019(vi00)
    nop                             lq.xyzw vf21, 1020(vi00)
    nop                             sqi.xyzw vf16, (vi04++)
    nop                             sqi.xyzw vf17, (vi04++)
    nop                             sqi.xyzw vf18, (vi04++)
    nop                             sqi.xyzw vf19, (vi04++)
    nop                             sqi.xyzw vf20, (vi04++)
    nop                             sqi.xyzw vf21, (vi04++)
    nop                             ilw.x vi10, 4(vi05)
    nop                             ilw.y vi11, 4(vi05)
    nop                             ilw.z vi12, 4(vi05)
    nop                             ilw.w vi13, 4(vi05)
    nop                             lq.xyzw vf31, 5(vi05)
    nop                             lq.xyzw vf20, 0(vi10)
    nop                             lq.xyzw vf21, 0(vi11)
    nop                             lq.xyzw vf22, 0(vi12)
    nop                             lq.xyzw vf23, 0(vi13)
    mulax.xyzw ACC, vf20, vf31x     lq.xyzw vf20, 1(vi10)
    madday.xyzw ACC, vf21, vf31y    lq.xyzw vf21, 1(vi11)
    maddaz.xyzw ACC, vf22, vf31z    lq.xyzw vf22, 1(vi12)
    maddw.xyzw vf16, vf23, vf31w    lq.xyzw vf23, 1(vi13)
    mulax.xyzw ACC, vf20, vf31x     lq.xyzw vf20, 2(vi10)
    madday.xyzw ACC, vf21, vf31y    lq.xyzw vf21, 2(vi11)
    maddaz.xyzw ACC, vf22, vf31z    lq.xyzw vf22, 2(vi12)
    maddw.xyzw vf17, vf23, vf31w    lq.xyzw vf23, 2(vi13)
    mulax.xyzw ACC, vf20, vf31x     lq.xyzw vf20, 3(vi10)
    madday.xyzw ACC, vf21, vf31y    lq.xyzw vf21, 3(vi11)
    maddaz.xyzw ACC, vf22, vf31z    lq.xyzw vf22, 3(vi12)
    maddw.xyzw vf18, vf23, vf31w    lq.xyzw vf23, 3(vi13)
    ; one vertex per pass, software-pipelined through the delay line
blended_loop:
    mulax.xyzw ACC, vf20, vf31x     lq.xyzw vf27, 0(vi05)
    madday.xyzw ACC, vf21, vf31y    lq.xyzw vf28, 1(vi05)
    maddaz.xyzw ACC, vf22, vf31z    lq.xyzw vf29, 2(vi05)
    maddw.xyzw vf19, vf23, vf31w    lq.xyzw vf30, 3(vi05)
    mulax.xyzw ACC, vf16, vf27x     ilw.w vi09, 0(vi05)                  ; vi09: the position's w word, XYZF2's w (F, ADC) as the model has it
    madday.xyzw ACC, vf17, vf27y    iaddiu vi05, vi05, 6
    maddaz.xyzw ACC, vf18, vf27z    ilw.x vi10, 4(vi05)
    maddw.xyzw vf27, vf19, vf00w    ilw.y vi11, 4(vi05)
    mulax.xy ACC, vf10, vf30x       ilw.z vi12, 4(vi05)
    madday.xy ACC, vf11, vf30y      ilw.w vi13, 4(vi05)
    maddw.xy vf30, vf12, vf00w      lq.xyzw vf20, 0(vi10)
    mulax.xyzw ACC, vf01, vf27x     lq.xyzw vf21, 0(vi11)
    madday.xyzw ACC, vf02, vf27y    lq.xyzw vf22, 0(vi12)
    maddaz.xyzw ACC, vf03, vf27z    lq.xyzw vf23, 0(vi13)
    maddw.xyzw vf25, vf04, vf00w    lq.xyzw vf31, 5(vi05)
    mul.xyzw vf26, vf29, vf09       isw.w vi09, 2(vi04)
    mulax.xyzw ACC, vf05, vf27x     nop
    madday.xyzw ACC, vf06, vf27y    nop
    maddaz.xyzw ACC, vf07, vf27z    div Q, vf00w, vf25w                  ; Q = 1 / vf25.w
    ftoi0.xyzw vf26, vf26           nop
    maddw.xyzw vf19, vf08, vf00w    nop
    mulax.xyzw ACC, vf20, vf31x     move.xyz vf13, vf14
    madday.xyzw ACC, vf21, vf31y    move.xyz vf14, vf15
    maddaz.xyzw ACC, vf22, vf31z    sq.xyzw vf26, 1(vi04)
    clipw.xyz vf19, vf19w           lq.xyzw vf20, 1(vi10)                ; clip flags: vf19.xyz against +-vf19.w
    mulq.xyzw vf25, vf25, Q         lq.xyzw vf21, 1(vi11)
    mulq.xyz vf24, vf30, Q          lq.xyzw vf22, 1(vi12)
    maddw.xyzw vf16, vf23, vf31w    lq.xyzw vf23, 1(vi13)
    sub.xyz vf27, vf14, vf13        fcand vi01, 0x03ffff                 ; vi01 = 1: one of the last three vertices is outside the clip volume
    sub.xyz vf30, vf25, vf13        move.xyz vf15, vf25
    mulax.xyzw ACC, vf20, vf31x     lq.xyzw vf20, 2(vi10)
    madday.xyzw ACC, vf21, vf31y    sq.xyzw vf24, 0(vi04)
    maddaz.xyzw ACC, vf22, vf31z    lq.xyzw vf21, 2(vi11)
    maddw.xyzw vf17, vf23, vf31w    lq.xyzw vf22, 2(vi12)
    opmula.xyz ACC, vf30, vf27      lq.xyzw vf23, 2(vi13)
    opmsub.xyz vf30, vf27, vf30     iaddiu vi04, vi04, 3
    ftoi4.xyzw vf25, vf25           iaddi vi07, vi07, -1                 ; to 12.4 fixed point (GS XYZ)
    mulax.xyzw ACC, vf20, vf31x     lq.xyzw vf20, 3(vi10)
    madday.xyzw ACC, vf21, vf31y    lq.xyzw vf21, 3(vi11)
    maddaz.xyzw ACC, vf22, vf31z    lq.xyzw vf22, 3(vi12)
    mulw.z vf30, vf30, vf28w        ibne vi01, vi00, blended_skip
    nop                             sq.xyz vf25, -1(vi04)
    nop                             ibne vi09, vi00, blended_skip2
    nop                             iaddiu vi01, vi00, 32
    nop                             fmand vi01, vi01
    nop                             ibeq vi01, vi00, blended_skip2
blended_skip:
    nop                             iaddiu vi09, vi00, 32767
    nop                             iaddiu vi09, vi09, 1
    nop                             isw.w vi09, -1(vi04)
blended_skip2:
    maddw.xyzw vf18, vf23, vf31w    ibne vi07, vi00, blended_loop
    nop                             lq.xyzw vf23, 3(vi13)
    ; the epilogue: the vertices left in the delay line
    nop                             lqd.xyzw vf16, (--vi04)
    nop                             lqd.xyzw vf17, (--vi04)
    nop                             lqd.xyzw vf18, (--vi04)
    nop                             lqd.xyzw vf19, (--vi04)
    nop                             lqd.xyzw vf20, (--vi04)
    nop                             lqd.xyzw vf21, (--vi04)
    nop                             sq.xyzw vf16, 1020(vi00)
    nop                             sq.xyzw vf17, 1019(vi00)
    nop                             sq.xyzw vf18, 1018(vi00)
    nop                             sq.xyzw vf19, 1023(vi00)
    nop                             sq.xyzw vf20, 1022(vi00)
    nop                             sq.xyzw vf21, 1021(vi00)
    nop                             xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             nop                               [E] ; end: the next MSCNT continues at blended_cont
    nop                             nop

    ; the next MSCNT continues here
blended_cont:
    nop                             b batch                              ; the next batch
    nop                             nop
.endprogram

;=======================================================================================
; Vu1Prog51: normals (key bit 0x20), second colour, gMtxUv rows
;
; gVu1ProgInfo51 (bones.c): 110 pairs (880 bytes), batches of up to 3200 bytes;
; Vu1_SelectProgram's key 0x24020, rigid models (0x21035, 0x121035).
; Setup Vu1Pkt_VE: an UNPACK of 13 qwords to VU 0, then MSCALF 0:
;   0        colour: gGsColorF, RGB scaled by the model's brightness
;   1        second colour: gGsColor2F: vf09
;   2-5      gMtxSlots x gMtxView x gMtxProjClip: model to screen (XYZ after the divide by w): vf01-vf04
;   6-9      the matrix above x gViewportMtx: model to the clip test's space: vf05-vf08
;   10-12    rows 0, 1 and 3 of gMtxUv (Vu1_PutUvMatrix): vf10-vf12
; Vertices: gVu1ProgLayouts[1], 4 qwords: position, normal, colour, texture coordinates.
; Batches at VU 0xd and 0xd + 0x1f6 (XTOP); the output follows each.
;=======================================================================================
.program Vu1Prog51
.base 0xd
.offset 0x1f6

    ; MSCALF 0: the setup's constants into registers
init:
    nop                             lq.xyzw vf01, 2(vi00)
    nop                             lq.xyzw vf02, 3(vi00)
    nop                             lq.xyzw vf03, 4(vi00)
    nop                             lq.xyzw vf04, 5(vi00)
    nop                             lq.xyzw vf05, 6(vi00)
    nop                             lq.xyzw vf06, 7(vi00)
    nop                             lq.xyzw vf07, 8(vi00)
    nop                             lq.xyzw vf08, 9(vi00)
    nop                             lq.xyzw vf09, 1(vi00)
    nop                             lq.xyzw vf10, 10(vi00)
    nop                             lq.xyzw vf11, 11(vi00)
    nop                             lq.xyzw vf12, 12(vi00)
    nop                             nop                               [E] ; end: constants loaded
    nop                             nop

    ; MSCNT: one batch at XTOP; qword 0's x is its type, qword 1 a GIF tag
batch:
    nop                             xtop vi02                            ; vi02: the batch (BASE, or BASE + OFFSET: double buffer)
    nop                             iaddiu vi05, vi02, 0
    nop                             iaddiu vi03, vi02, 200               ; vi03: the output, 200 qwords after the batch
    nop                             ilwr.x vi06, (vi05)                  ; the batch type (qword 0)
    nop                             iaddiu vi05, vi05, 1
    nop                             ilwr.x vi08, (vi05)                  ; the GIF tag (qword 1): NLOOP, EOP
    nop                             iaddiu vi04, vi03, 0
    nop                             iaddiu vi11, vi00, 32767             ; 0x7FFF: the NLOOP mask
    nop                             lq.xyzw vf31, 0(vi05)
    nop                             iand vi07, vi11, vi08
    nop                             iaddiu vi11, vi00, 1
    nop                             iaddiu vi05, vi05, 1
    nop                             ibeq vi11, vi06, vertices
    nop                             sqi.xyzw vf31, (vi04++)

    ; a register block: the GIF tag and its NLOOP qwords (A+D) go through to the output
copy_regs:
    nop                             lqi.xyzw vf31, (vi05++)
    nop                             iaddi vi07, vi07, -1
    nop                             iaddiu vi04, vi04, 1
    nop                             ibne vi07, vi00, copy_regs
    nop                             sq.xyzw vf31, -1(vi04)
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             nop                               [E] ; end: the next MSCNT continues at copy_regs_cont
    nop                             nop

    ; the next MSCNT continues here
copy_regs_cont:
    nop                             b batch                              ; the next batch
    nop                             nop

    ; type 1: a strip of NLOOP vertices
vertices:
    nop                             iaddiu vi08, vi08, 2                 ; NLOOP + 2: the delay line's last vertices go out first
    nop                             isw.x vi08, -1(vi04)
    nop                             lq.xyzw vf16, 1021(vi00)
    nop                             lq.xyzw vf17, 1022(vi00)
    nop                             lq.xyzw vf18, 1023(vi00)
    nop                             lq.xyzw vf31, 3(vi05)
    nop                             lq.xyzw vf19, 1018(vi00)
    nop                             lq.xyzw vf30, 2(vi05)
    nop                             lq.xyzw vf20, 1019(vi00)
    mulax.xy ACC, vf10, vf31x       lq.xyzw vf28, 0(vi05)
    madday.xy ACC, vf11, vf31y      lq.xyzw vf21, 1020(vi00)
    maddw.xy vf31, vf12, vf00w      sqi.xyzw vf16, (vi04++)
    mul.xyzw vf27, vf30, vf09       sqi.xyzw vf17, (vi04++)
    mulax.xyzw ACC, vf01, vf28x     sqi.xyzw vf18, (vi04++)
    madday.xyzw ACC, vf02, vf28y    sqi.xyzw vf19, (vi04++)
    maddaz.xyzw ACC, vf03, vf28z    move.xyzw vf18, vf31
    maddw.xyzw vf26, vf04, vf00w    sqi.xyzw vf20, (vi04++)
    ftoi0.xyzw vf27, vf27           sqi.xyzw vf21, (vi04++)
    mulax.xyzw ACC, vf05, vf28x     lq.xyzw vf31, 7(vi05)
    madday.xyzw ACC, vf06, vf28y    lq.xyzw vf30, 6(vi05)
    maddaz.xyzw ACC, vf07, vf28z    div Q, vf00w, vf26w                  ; Q = 1 / vf26.w
    maddw.xyzw vf24, vf08, vf00w    move.xyz vf13, vf14
    ; one vertex per pass, software-pipelined through the delay line
vertices_loop:
    mulax.xy ACC, vf10, vf31x       sq.xyzw vf27, 1(vi04)
    madday.xy ACC, vf11, vf31y      move.xyz vf14, vf15
    maddw.xy vf31, vf12, vf00w      lq.xyzw vf28, 4(vi05)
    clipw.xyz vf24, vf24w           iaddi vi07, vi07, -1                 ; clip flags: vf24.xyz against +-vf24.w
    mul.xyzw vf27, vf30, vf09       lq.xyzw vf29, 1(vi05)
    mulq.xyzw vf26, vf26, Q         nop
    mulq.xyz vf25, vf18, Q          nop
    mulax.xyzw ACC, vf01, vf28x     fcand vi01, 0x03ffff                 ; vi01 = 1: one of the last three vertices is outside the clip volume
    sub.xyz vf16, vf14, vf13        move.xyzw vf18, vf31
    sub.xyz vf17, vf26, vf13        move.xyz vf15, vf26
    ftoi4.xyzw vf19, vf26           nop                                  ; to 12.4 fixed point (GS XYZ)
    madday.xyzw ACC, vf02, vf28y    sq.xyzw vf25, 0(vi04)
    maddaz.xyzw ACC, vf03, vf28z    iaddiu vi04, vi04, 3
    maddw.xyzw vf26, vf04, vf00w    ilw.w vi09, 0(vi05)                  ; vi09: the position's w word, XYZF2's w (F, ADC) as the model has it
    opmula.xyz ACC, vf17, vf16      iaddiu vi05, vi05, 4
    opmsub.xyz vf17, vf16, vf17     sq.xyz vf19, -1(vi04)
    ftoi0.xyzw vf27, vf27           lq.xyzw vf31, 7(vi05)
    mulax.xyzw ACC, vf05, vf28x     lq.xyzw vf30, 6(vi05)
    madday.xyzw ACC, vf06, vf28y    div Q, vf00w, vf26w
    mulw.z vf17, vf17, vf29w        ibne vi01, vi00, vertices_skip
    nop                             move.xyz vf13, vf14
    nop                             ibne vi09, vi00, vertices_skip2
    nop                             iaddiu vi01, vi00, 32
    nop                             fmand vi01, vi01
    nop                             ibeq vi01, vi00, vertices_skip2
    nop                             nop
vertices_skip:
    nop                             iaddiu vi09, vi00, 32767
    nop                             iaddiu vi09, vi09, 1
vertices_skip2:
    maddaz.xyzw ACC, vf07, vf28z    ibne vi07, vi00, vertices_loop
    maddw.xyzw vf24, vf08, vf00w    isw.w vi09, -1(vi04)
    ; the epilogue: the vertices left in the delay line
    nop                             lqd.xyzw vf16, (--vi04)
    nop                             lqd.xyzw vf17, (--vi04)
    nop                             lqd.xyzw vf18, (--vi04)
    nop                             lqd.xyzw vf19, (--vi04)
    nop                             lqd.xyzw vf20, (--vi04)
    nop                             lqd.xyzw vf21, (--vi04)
    nop                             sq.xyzw vf16, 1020(vi00)
    nop                             sq.xyzw vf17, 1019(vi00)
    nop                             sq.xyzw vf18, 1018(vi00)
    nop                             sq.xyzw vf19, 1023(vi00)
    nop                             sq.xyzw vf20, 1022(vi00)
    nop                             sq.xyzw vf21, 1021(vi00)
    nop                             xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             nop                               [E] ; end: the next MSCNT continues at vertices_cont
    nop                             nop

    ; the next MSCNT continues here
vertices_cont:
    nop                             b batch                              ; the next batch
    nop                             nop
.endprogram

;=======================================================================================
; Vu1Prog53: normals (key bit 0x20), second colour, clipped
;
; gVu1ProgInfo53 (bones.c): 458 pairs (3664 bytes), batches of up to 3200 bytes;
; Vu1_SelectProgram's key 0x200a0, rigid models (0x21035, 0x121035).
; Setup Vu1Pkt_VP: an UNPACK of 14 qwords to VU 0, then MSCALF 0:
;   0        colour: gGsColorF, RGB scaled by the model's brightness
;   1        second colour: gGsColor2F: vf09
;   2-5      gMtxSlots x gMtxView x gMtxProjClip: model to screen (XYZ after the divide by w): vf01-vf04
;   6-9      the matrix above x gViewportMtx: model to the clip test's space: vf05-vf08
;   10-13    gMtxProj, the projection matrix: vf27-vf30
; Vertices: gVu1ProgLayouts[1], 4 qwords: position, normal, colour, texture coordinates.
; Batches at VU 0xe and 0xe + 0x1c2 (XTOP); the output follows each.
;=======================================================================================
.program Vu1Prog53
.base 0xe
.offset 0x1c2
.stcycl 4, 4
.unpack 0x3a6, 0x00008000, 0x302ec000, 0x00000412, 0x00000000   ; GIF tag template: EOP, PRIM 0x5d, REGS ST RGBAQ XYZF2

    ; MSCALF 0: the setup's constants into registers
init:
    nop                             lq.xyzw vf01, 2(vi00)
    nop                             lq.xyzw vf02, 3(vi00)
    nop                             lq.xyzw vf03, 4(vi00)
    nop                             lq.xyzw vf04, 5(vi00)
    nop                             lq.xyzw vf05, 6(vi00)
    nop                             lq.xyzw vf06, 7(vi00)
    nop                             lq.xyzw vf07, 8(vi00)
    nop                             lq.xyzw vf08, 9(vi00)
    nop                             lq.xyzw vf09, 1(vi00)
    nop                             nop                               [E] ; end: constants loaded
    nop                             nop

    ; MSCNT: one batch at XTOP; qword 0's x is its type, qword 1 a GIF tag
batch:
    nop                             xtop vi02                            ; vi02: the batch (BASE, or BASE + OFFSET: double buffer)
    nop                             iaddiu vi05, vi02, 0
    nop                             iaddiu vi03, vi02, 200               ; vi03: the output, 200 qwords after the batch
    nop                             iaddiu vi04, vi03, 0
    nop                             ilwr.x vi06, (vi05)                  ; the batch type (qword 0)
    nop                             iaddiu vi05, vi05, 1
    nop                             ilwr.x vi08, (vi05)                  ; the GIF tag (qword 1): NLOOP, EOP
    nop                             iaddiu vi11, vi00, 32767             ; 0x7FFF: the NLOOP mask
    nop                             lq.xyzw vf31, 0(vi05)
    nop                             iaddiu vi05, vi05, 1
    nop                             iaddiu vi01, vi00, 1
    nop                             iand vi07, vi11, vi08
    nop                             ibeq vi01, vi06, vertices
    nop                             sqi.xyzw vf31, (vi04++)

    ; a register block: the GIF tag and its NLOOP qwords (A+D) go through to the output
copy_regs:
    nop                             lq.xyzw vf31, 0(vi05)
    nop                             iaddi vi07, vi07, -1
    nop                             iaddiu vi05, vi05, 1
    nop                             iaddiu vi04, vi04, 1
    nop                             ibne vi07, vi00, copy_regs
    nop                             sq.xyzw vf31, -1(vi04)
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             nop                               [E] ; end: the next MSCNT continues at copy_regs_cont
    nop                             nop

    ; the next MSCNT continues here
copy_regs_cont:
    nop                             b batch                              ; the next batch
    nop                             nop

    ; type 1: a strip of NLOOP vertices
vertices:
    nop                             iaddiu vi08, vi08, 2                 ; NLOOP + 2: the delay line's last vertices go out first
    nop                             isw.x vi08, -1(vi04)
    nop                             lq.xyzw vf13, 917(vi00)
    nop                             lq.xyzw vf14, 918(vi00)
    nop                             lq.xyzw vf15, 919(vi00)
    nop                             lq.xyzw vf16, 914(vi00)
    nop                             lq.xyzw vf17, 915(vi00)
    nop                             lq.xyzw vf18, 916(vi00)
    nop                             sqi.xyzw vf13, (vi04++)
    nop                             sqi.xyzw vf14, (vi04++)
    nop                             sqi.xyzw vf15, (vi04++)
    nop                             sqi.xyzw vf16, (vi04++)
    nop                             sqi.xyzw vf17, (vi04++)
    nop                             sqi.xyzw vf18, (vi04++)
    ; one vertex per pass, software-pipelined through the delay line
vertices_loop:
    nop                             lq.xyzw vf28, 0(vi05)
    nop                             ilw.w vi09, 0(vi05)                  ; vi09: the position's w word, XYZF2's w (F, ADC) as the model has it
    nop                             lq.xyzw vf29, 1(vi05)
    nop                             lq.xyzw vf30, 2(vi05)
    nop                             lq.xyzw vf31, 3(vi05)
    nop                             iaddiu vi05, vi05, 4
    mulax.xyzw ACC, vf01, vf28x     lq.xyzw vf13, 1020(vi00)
    madday.xyzw ACC, vf02, vf28y    lq.xyzw vf14, 1017(vi00)
    maddaz.xyzw ACC, vf03, vf28z    lq.xyzw vf15, 1019(vi00)
    maddw.xyzw vf26, vf04, vf00w    lq.xyzw vf16, 1016(vi00)
    mulax.xyzw ACC, vf05, vf28x     lq.xyzw vf17, 1018(vi00)
    madday.xyzw ACC, vf06, vf28y    lq.xyzw vf18, 1015(vi00)
    maddaz.xyzw ACC, vf07, vf28z    sq.xyzw vf13, 1023(vi00)
    maddw.xyzw vf24, vf08, vf00w    div Q, vf00w, vf26w                  ; Q = 1 / vf26.w
    mul.xyzw vf27, vf30, vf09       sq.xyzw vf14, 1020(vi00)
    clipw.xyz vf13, vf13w           sq.xyzw vf15, 1022(vi00)             ; clip flags: vf13.xyz against +-vf13.w
    clipw.xyz vf14, vf14w           sq.xyzw vf16, 1019(vi00)
    clipw.xyz vf24, vf24w           sq.xyzw vf24, 1017(vi00)
    ftoi0.xyzw vf27, vf27           sq.xyzw vf17, 1021(vi00)
    nop                             sq.xyzw vf18, 1018(vi00)
    nop                             sq.xyzw vf31, 1015(vi00)
    mulq.xyzw vf26, vf26, Q         move.xyz vf10, vf11
    mulq.xyz vf25, vf31, Q          sq.xyzw vf27, 1(vi04)
    nop                             sq.xyzw vf27, 1016(vi00)
    nop                             move.xyz vf11, vf12
    ftoi4.xyzw vf26, vf26           move.xyz vf12, vf26                  ; to 12.4 fixed point (GS XYZ)
    nop                             sq.xyzw vf25, 0(vi04)
    nop                             fcand vi01, 0x03ffff                 ; vi01 = 1: one of the last three vertices is outside the clip volume
    sub.xyz vf13, vf11, vf10        ibne vi09, vi00, vertices_skip
    sub.xyz vf14, vf12, vf10        sq.xyz vf26, 2(vi04)
    nop                             ibeq vi01, vi00, vertices_in_view
    nop                             nop
    nop                             fcor vi01, 0xfdf7df
    nop                             ibne vi01, vi00, vertices_culled
    nop                             nop
    nop                             fcor vi01, 0xfefbef
    nop                             ibne vi01, vi00, vertices_culled
    nop                             nop
    nop                             fcor vi01, 0xff7df7
    nop                             ibne vi01, vi00, vertices_culled
    nop                             nop
    nop                             fcor vi01, 0xffbefb
    nop                             ibne vi01, vi00, vertices_culled
    nop                             nop
    nop                             fcor vi01, 0xffdf7d
    nop                             ibne vi01, vi00, vertices_culled
    nop                             nop
    nop                             fcor vi01, 0xffefbe
    nop                             ibne vi01, vi00, vertices_culled
    nop                             sq.xyzw vf29, 919(vi00)
    nop                             b clip_triangle
    nop                             iaddiu vi15, vi00, 118
    ; the last three vertices are all inside the clip volume
vertices_in_view:
    nop                             nop
    opmula.xyz ACC, vf14, vf13      nop
    opmsub.xyz vf14, vf13, vf14     nop
    nop                             nop
    nop                             nop
    nop                             nop
    mulw.z vf14, vf14, vf29w        nop
    nop                             nop
    nop                             nop
    nop                             iaddiu vi01, vi00, 32
    nop                             fmand vi01, vi01
    nop                             ibeq vi01, vi00, vertices_skip
    nop                             nop
    ; the triangle is wholly outside one plane: culled
vertices_culled:
    nop                             iaddiu vi09, vi00, 32767
    nop                             iaddiu vi09, vi09, 1
vertices_skip:
    nop                             iaddi vi07, vi07, -1
    nop                             isw.w vi09, 2(vi04)
    nop                             ibne vi07, vi00, vertices_loop
    nop                             iaddiu vi04, vi04, 3
    ; the epilogue: the vertices left in the delay line
    nop                             lqd.xyzw vf13, (--vi04)
    nop                             lqd.xyzw vf14, (--vi04)
    nop                             lqd.xyzw vf15, (--vi04)
    nop                             lqd.xyzw vf16, (--vi04)
    nop                             lqd.xyzw vf17, (--vi04)
    nop                             lqd.xyzw vf18, (--vi04)
    nop                             sq.xyzw vf13, 916(vi00)
    nop                             sq.xyzw vf14, 915(vi00)
    nop                             sq.xyzw vf15, 914(vi00)
    nop                             sq.xyzw vf16, 919(vi00)
    nop                             sq.xyzw vf17, 918(vi00)
    nop                             sq.xyzw vf18, 917(vi00)
    nop                             xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             nop                               [E] ; end: the next MSCNT continues at vertices_cont
    nop                             nop

    ; the next MSCNT continues here
vertices_cont:
    nop                             b batch                              ; the next batch
    nop                             nop

    ; clip the last three vertices' triangle against the six planes of the clip volume and
    ; send what is left as a fan (the GIF tag template at VU 0x3A6)
clip_triangle:
    nop                             iaddiu vi14, vi00, 934
    nop                             sqd.xyzw vf21, (--vi14)
    nop                             sqd.xyzw vf22, (--vi14)
    nop                             sqd.xyzw vf23, (--vi14)
    nop                             sqd.xyzw vf24, (--vi14)
    nop                             sqd.xyzw vf25, (--vi14)
    nop                             sqd.xyzw vf26, (--vi14)
    nop                             sqd.xyzw vf27, (--vi14)
    nop                             sqd.xyzw vf28, (--vi14)
    nop                             sqd.xyzw vf29, (--vi14)
    nop                             sqd.xyzw vf30, (--vi14)
    nop                             sqd.xyzw vf31, (--vi14)
    nop                             isubiu vi14, vi14, 1
    nop                             iswr.x vi02, (vi14)
    nop                             iswr.y vi03, (vi14)
    nop                             iswr.z vi04, (vi14)
    nop                             iswr.w vi05, (vi14)
    nop                             isubiu vi14, vi14, 1
    nop                             iswr.x vi06, (vi14)
    nop                             iswr.y vi07, (vi14)
    nop                             iswr.z vi08, (vi14)
    nop                             iswr.w vi09, (vi14)
    nop                             isubiu vi14, vi14, 1
    nop                             iswr.x vi10, (vi14)
    nop                             iswr.y vi11, (vi14)
    nop                             iswr.z vi12, (vi14)
    nop                             iswr.w vi13, (vi14)
    nop                             iaddiu vi08, vi00, 0
    nop                             iaddiu vi09, vi00, 935
    nop                             iaddiu vi10, vi00, 975
    nop                             lq.xyzw vf23, 1022(vi00)
    nop                             lq.xyzw vf24, 1019(vi00)
    nop                             lq.xyzw vf25, 1016(vi00)
    nop                             lq.xyzw vf26, 1021(vi00)
    itof0.xyzw vf23, vf23           lq.xyzw vf27, 1018(vi00)
    itof0.xyzw vf24, vf24           lq.xyzw vf28, 1015(vi00)
    itof0.xyzw vf25, vf25           lq.xyzw vf29, 1023(vi00)
    nop                             lq.xyzw vf30, 1020(vi00)
    nop                             lq.xyzw vf31, 1017(vi00)
    nop                             sq.xyzw vf23, 1(vi09)
    nop                             sq.xyzw vf24, 4(vi09)
    nop                             sq.xyzw vf25, 7(vi09)
    nop                             sq.xyzw vf23, 10(vi09)
    nop                             sq.xyzw vf26, 2(vi09)
    nop                             sq.xyzw vf27, 5(vi09)
    nop                             sq.xyzw vf28, 8(vi09)
    nop                             sq.xyzw vf26, 11(vi09)
    nop                             sq.xyzw vf29, 0(vi09)
    nop                             sq.xyzw vf30, 3(vi09)
    nop                             sq.xyzw vf31, 6(vi09)
    nop                             sq.xyzw vf29, 9(vi09)
    nop                             iaddiu vi09, vi00, 935
    nop                             iaddiu vi10, vi00, 975
    nop                             iaddiu vi05, vi00, 2048
    nop                             iaddiu vi06, vi00, 32
    subw.x vf31, vf00, vf00w        bal vi13, first_vertex
    nop                             iaddiu vi07, vi00, 2
    nop                             iaddiu vi04, vi00, 3
    nop                             iaddiu vi11, vi00, 0
    nop                             bal vi13, clip_edges
    nop                             nop
    nop                             bal vi13, close_polygon
    nop                             iaddiu vi09, vi00, 975
    nop                             iaddiu vi09, vi00, 975
    nop                             iaddiu vi10, vi00, 935
    nop                             iaddiu vi05, vi00, 1024
    nop                             iaddiu vi06, vi00, 16
    addw.x vf31, vf00, vf00w        bal vi13, pass_start
    nop                             iaddiu vi07, vi00, 2
    nop                             bal vi13, clip_edges
    nop                             nop
    nop                             bal vi13, close_polygon
    nop                             iaddiu vi09, vi00, 935
    nop                             iaddiu vi05, vi00, 128
    nop                             iaddiu vi06, vi00, 2
    subw.x vf31, vf00, vf00w        bal vi13, pass_a_to_b
    nop                             iaddiu vi07, vi00, 0
    nop                             bal vi13, clip_edges
    nop                             nop
    nop                             bal vi13, close_polygon
    nop                             iaddiu vi09, vi00, 975
    nop                             iaddiu vi05, vi00, 64
    nop                             iaddiu vi06, vi00, 1
    addw.x vf31, vf00, vf00w        bal vi13, pass_b_to_a
    nop                             iaddiu vi07, vi00, 0
    nop                             bal vi13, clip_edges
    nop                             nop
    nop                             bal vi13, close_polygon
    nop                             iaddiu vi09, vi00, 935
    nop                             iaddiu vi05, vi00, 512
    nop                             iaddiu vi06, vi00, 8
    subw.x vf31, vf00, vf00w        bal vi13, pass_a_to_b
    nop                             iaddiu vi07, vi00, 1
    nop                             bal vi13, clip_edges
    nop                             nop
    nop                             bal vi13, close_polygon
    nop                             iaddiu vi09, vi00, 975
    nop                             iaddiu vi05, vi00, 256
    nop                             iaddiu vi06, vi00, 4
    addw.x vf31, vf00, vf00w        bal vi13, pass_b_to_a
    nop                             iaddiu vi07, vi00, 1
    nop                             bal vi13, clip_edges
    nop                             nop
    nop                             bal vi13, close_polygon
    nop                             iaddiu vi09, vi00, 935
    nop                             iaddiu vi09, vi00, 935
    nop                             iaddiu vi10, vi00, 975
    nop                             iadd vi04, vi00, vi11
    nop                             iaddiu vi11, vi00, 0
    nop                             ilwr.y vi06, (vi02)
    nop                             ilw.x vi12, 934(vi00)
    nop                             lq.xyzw vf31, 934(vi00)
    nop                             lq.xyzw vf27, 10(vi00)
    nop                             lq.xyzw vf28, 11(vi00)
    nop                             iadd vi12, vi12, vi04
    nop                             iadd vi06, vi06, vi03
    nop                             iaddiu vi02, vi06, 0
    nop                             sqi.xyzw vf31, (vi06++)
    nop                             lq.xyzw vf29, 12(vi00)
    nop                             lq.xyzw vf30, 13(vi00)
    nop                             lq.xyzw vf31, 919(vi00)
    nop                             xgkick vi02                          ; send the output to the GS (PATH1)
    nop                             nop
    nop                             nop
    nop                             iaddiu vi08, vi00, 2
    nop                             isw.x vi12, -1(vi06)
clip_triangle_loop:
    nop                             lqi.xyzw vf24, (vi09++)
    nop                             lqi.xyzw vf25, (vi09++)
    nop                             lqi.xyzw vf26, (vi09++)
    nop                             nop
    mulax.xyzw ACC, vf27, vf24x     nop
    madday.xyzw ACC, vf28, vf24y    nop
    maddaz.xyzw ACC, vf29, vf24z    nop
    maddw.xyzw vf23, vf30, vf24w    loi 128.0                            ; I = 128.0: the colour clamp (0x80 is 1.0 on the GS)
    minii.xyz vf25, vf25, I         nop
    nop                             nop
    nop                             nop
    nop                             div Q, vf00w, vf23w                  ; Q = 1 / vf23.w
    ftoi0.xyzw vf25, vf25           nop
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             sq.xyzw vf25, 1(vi06)
    nop                             iaddiu vi08, vi08, 32767             ; NLOOP + 32767: the delay line's last vertices go out first
    nop                             nop
    mulq.xyzw vf23, vf23, Q         nop
    mulq.xyz vf26, vf26, Q          iblez vi08, clip_triangle_skip
    nop                             nop
    sub.xyz vf24, vf22, vf21        nop
    sub.xyz vf25, vf23, vf21        nop
    nop                             nop
    nop                             nop
    nop                             nop
    opmula.xyz ACC, vf25, vf24      nop
    opmsub.xyz vf25, vf24, vf25     nop
    nop                             nop
    nop                             nop
    nop                             nop
    mulw.z vf25, vf25, vf31w        nop
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             iaddiu vi01, vi00, 32
    nop                             fmand vi01, vi01
    nop                             ibne vi01, vi00, clip_triangle_loop2
    nop                             nop
clip_triangle_skip:
    nop                             move.xyz vf21, vf22
    nop                             move.xyz vf22, vf23
    ftoi4.xyzw vf23, vf23           nop                                  ; to 12.4 fixed point (GS XYZ)
    nop                             nop
    nop                             sq.xyzw vf26, 0(vi06)
    nop                             iaddi vi04, vi04, -1
    nop                             sq.xyzw vf23, 2(vi06)
    nop                             ibne vi04, vi00, clip_triangle_loop
    nop                             iaddiu vi06, vi06, 3
    nop                             nop
    nop                             xgkick vi02                          ; send the output to the GS (PATH1)
    nop                             nop
clip_triangle_loop2:
    nop                             ilwr.x vi10, (vi14)
    nop                             ilwr.y vi11, (vi14)
    nop                             ilwr.z vi12, (vi14)
    nop                             ilwr.w vi13, (vi14)
    nop                             iaddiu vi14, vi14, 1
    nop                             ilwr.x vi06, (vi14)
    nop                             ilwr.y vi07, (vi14)
    nop                             ilwr.z vi08, (vi14)
    nop                             ilwr.w vi09, (vi14)
    nop                             iaddiu vi14, vi14, 1
    nop                             ilwr.x vi02, (vi14)
    nop                             ilwr.y vi03, (vi14)
    nop                             ilwr.z vi04, (vi14)
    nop                             ilwr.w vi05, (vi14)
    nop                             iaddiu vi14, vi14, 1
    nop                             lqi.xyzw vf31, (vi14++)
    nop                             lqi.xyzw vf30, (vi14++)
    nop                             lqi.xyzw vf29, (vi14++)
    nop                             lqi.xyzw vf28, (vi14++)
    nop                             lqi.xyzw vf27, (vi14++)
    nop                             lqi.xyzw vf26, (vi14++)
    nop                             lqi.xyzw vf25, (vi14++)
    nop                             lqi.xyzw vf24, (vi14++)
    nop                             lqi.xyzw vf23, (vi14++)
    nop                             lqi.xyzw vf22, (vi14++)
    nop                             lqi.xyzw vf21, (vi14++)
    nop                             jr vi15
    nop                             nop

    ; after a plane: repeat the first output vertex after the last; an empty polygon leaves
    ; (clip_triangle_exit)
close_polygon:
    nop                             lqi.xyzw vf29, (vi09++)
    nop                             lqi.xyzw vf30, (vi09++)
    nop                             lqi.xyzw vf31, (vi09++)
    nop                             nop
    nop                             sqi.xyzw vf29, (vi10++)
    nop                             sqi.xyzw vf30, (vi10++)
    nop                             ibeq vi11, vi00, clip_triangle_loop2
    nop                             sqi.xyzw vf31, (vi10++)
    nop                             jr vi13
    nop                             nop

    ; the next plane reads the polygon at VU 935.. and writes the one at 975.. (as set at
    ; clip_triangle)
pass_a_to_b:
    nop                             iaddiu vi09, vi00, 935
    nop                             b pass_start
    nop                             iaddiu vi10, vi00, 975

    ; the next plane reads the second polygon buffer and writes the first
pass_b_to_a:
    nop                             iaddiu vi09, vi00, 975
    nop                             iaddiu vi10, vi00, 935

    ; vi04: the vertices to clip; vi11: none written yet
pass_start:
    nop                             iadd vi04, vi00, vi11
    nop                             iaddiu vi11, vi00, 0

    ; load the polygon's first vertex (three qwords)
first_vertex:
    nop                             lqi.xyzw vf21, (vi09++)
    nop                             lqi.xyzw vf22, (vi09++)
    nop                             jr vi13
    nop                             lqi.xyzw vf23, (vi09++)

    ; clip the polygon's edges against one plane (vi05, vi06: its clip-flag bits; vf31.x its
    ; sign)
clip_edges:
    mulw.xyzw vf24, vf21, vf00w     lqi.xyzw vf21, (vi09++)
    mulw.xyzw vf25, vf22, vf00w     lqi.xyzw vf22, (vi09++)
    mulw.xyzw vf26, vf23, vf00w     lqi.xyzw vf23, (vi09++)
    nop                             nop
    clipw.xyz vf24, vf24w           nop                                  ; clip flags: vf24.xyz against +-vf24.w
    clipw.xyz vf21, vf21w           nop
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             fcget vi01
    nop                             nop
    nop                             iand vi12, vi01, vi05
    nop                             nop
    nop                             ibeq vi12, vi00, clip_edges_skip
    nop                             nop
    nop                             iand vi12, vi01, vi06
    nop                             nop
    nop                             ibne vi12, vi00, clip_edges_skip3
    nop                             nop
    nop                             bal vi01, intersect
    nop                             nop
    nop                             sqi.xyzw vf28, (vi10++)
    nop                             sqi.xyzw vf29, (vi10++)
    nop                             sqi.xyzw vf30, (vi10++)
    nop                             b clip_edges_skip3
    nop                             iaddiu vi11, vi11, 1
clip_edges_skip:
    nop                             iand vi12, vi01, vi06
    nop                             nop
    nop                             ibeq vi12, vi00, clip_edges_skip2
    nop                             nop
    nop                             bal vi01, intersect
    nop                             nop
    nop                             sqi.xyzw vf24, (vi10++)
    nop                             sqi.xyzw vf25, (vi10++)
    nop                             sqi.xyzw vf26, (vi10++)
    nop                             sqi.xyzw vf28, (vi10++)
    nop                             sqi.xyzw vf29, (vi10++)
    nop                             sqi.xyzw vf30, (vi10++)
    nop                             b clip_edges_skip3
    nop                             iaddiu vi11, vi11, 2
clip_edges_skip2:
    nop                             sqi.xyzw vf24, (vi10++)
    nop                             sqi.xyzw vf25, (vi10++)
    nop                             sqi.xyzw vf26, (vi10++)
    nop                             iaddiu vi11, vi11, 1
clip_edges_skip3:
    nop                             isubiu vi04, vi04, 1
    nop                             nop
    nop                             ibne vi04, vi00, clip_edges
    nop                             nop
    nop                             jr vi13
    nop                             nop

    ; an edge crosses the plane: write the intersection (position and attributes interpolated)
intersect:
    mulx.w vf28, vf24, vf31x        nop
    mulx.w vf29, vf21, vf31x        nop
    nop                             nop
    nop                             nop
    subw.xyzw vf28, vf24, vf28w     nop
    subw.xyzw vf29, vf21, vf29w     nop
    nop                             iadd vi12, vi00, vi07
    nop                             nop
intersect_loop:
    nop                             ibeq vi12, vi00, intersect_skip
    nop                             nop
    nop                             mr32.xyzw vf28, vf28
    nop                             mr32.xyzw vf29, vf29
    nop                             isubiu vi12, vi12, 1
    nop                             nop
    nop                             b intersect_loop
    nop                             nop
intersect_skip:
    sub.xyz vf30, vf29, vf28        nop
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             div Q, vf28x, vf30x
    nop                             waitq
    addq.x vf27, vf00, Q            nop
    sub.xyzw vf28, vf21, vf24       nop
    sub.xyzw vf29, vf22, vf25       nop
    sub.xyzw vf30, vf23, vf26       nop
    abs.x vf27, vf27                nop
    nop                             nop
    nop                             nop
    nop                             nop
    mulx.xyzw vf28, vf28, vf27x     nop
    mulx.xyzw vf29, vf29, vf27x     nop
    mulx.xyzw vf30, vf30, vf27x     nop
    nop                             nop
    add.xyzw vf28, vf28, vf24       nop
    add.xyzw vf29, vf29, vf25       nop
    add.xyzw vf30, vf30, vf26       nop
    nop                             nop
    nop                             jr vi01
    nop                             nop
.endprogram

;=======================================================================================
; Vu1Prog54: normals (key bit 0x20), fog, second colour
;
; gVu1ProgInfo54 (bones.c): 136 pairs (1088 bytes), batches of up to 3200 bytes;
; Vu1_SelectProgram's key 0x28020, rigid models (0x21035, 0x121035).
; Setup Vu1Pkt_DV: an UNPACK of 11 qwords to VU 0, then MSCALF 0:
;   0        colour: gGsColorF, RGB scaled by the model's brightness
;   1        second colour: gGsColor2F: vf09
;   2-5      gMtxSlots x gMtxView x gMtxProjClip: model to screen (XYZ after the divide by w): vf01-vf04
;   6-9      the matrix above x gViewportMtx: model to the clip test's space: vf05-vf08
;   10       fog range: gGsFogFar and the word after it: vf10
; Vertices: gVu1ProgLayouts[1], 4 qwords: position, normal, colour, texture coordinates.
; Batches at VU 0xb and 0xb + 0x1f7 (XTOP); the output follows each.
;=======================================================================================
.program Vu1Prog54
.base 0xb
.offset 0x1f7

    ; MSCALF 0: the setup's constants into registers
init:
    nop                             lq.xyzw vf01, 2(vi00)
    nop                             lq.xyzw vf02, 3(vi00)
    nop                             lq.xyzw vf03, 4(vi00)
    nop                             lq.xyzw vf04, 5(vi00)
    nop                             lq.xyzw vf05, 6(vi00)
    nop                             lq.xyzw vf06, 7(vi00)
    nop                             lq.xyzw vf07, 8(vi00)
    nop                             lq.xyzw vf08, 9(vi00)
    nop                             lq.xyzw vf09, 1(vi00)
    nop                             lq.xyzw vf10, 10(vi00)
    nop                             nop                               [E] ; end: constants loaded
    nop                             nop

    ; MSCNT: one batch at XTOP; qword 0's x is its type, qword 1 a GIF tag
batch:
    nop                             xtop vi02                            ; vi02: the batch (BASE, or BASE + OFFSET: double buffer)
    nop                             iaddiu vi05, vi02, 0
    nop                             iaddiu vi03, vi02, 200               ; vi03: the output, 200 qwords after the batch
    nop                             ilwr.x vi06, (vi05)                  ; the batch type (qword 0)
    nop                             iaddiu vi05, vi05, 1
    nop                             ilwr.x vi08, (vi05)                  ; the GIF tag (qword 1): NLOOP, EOP
    nop                             iaddiu vi04, vi03, 0
    nop                             iaddiu vi11, vi00, 32767             ; 0x7FFF: the NLOOP mask
    nop                             lq.xyzw vf31, 0(vi05)
    nop                             iand vi07, vi11, vi08
    nop                             iaddiu vi11, vi00, 1
    nop                             iaddiu vi05, vi05, 1
    nop                             ibeq vi11, vi06, vertices
    nop                             sqi.xyzw vf31, (vi04++)

    ; a register block: the GIF tag and its NLOOP qwords (A+D) go through to the output
copy_regs:
    nop                             lq.xyzw vf31, 0(vi05)
    nop                             iaddi vi07, vi07, -1
    nop                             iaddiu vi05, vi05, 1
    nop                             iaddiu vi04, vi04, 1
    nop                             ibne vi07, vi00, copy_regs
    nop                             sq.xyzw vf31, -1(vi04)
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             nop                               [E] ; end: the next MSCNT continues at copy_regs_cont
    nop                             nop

    ; the next MSCNT continues here
copy_regs_cont:
    nop                             b batch                              ; the next batch
    nop                             nop

    ; type 1: a strip of NLOOP vertices
vertices:
    nop                             iaddiu vi08, vi08, 2                 ; NLOOP + 2: the delay line's last vertices go out first
    nop                             isw.x vi08, -1(vi04)
    nop                             lq.xyzw vf14, 1021(vi00)
    nop                             lq.xyzw vf15, 1022(vi00)
    nop                             lq.xyzw vf28, 0(vi05)
    nop                             lq.xyzw vf16, 1023(vi00)
    nop                             lq.xyzw vf17, 1018(vi00)
    nop                             lq.xyzw vf18, 1019(vi00)
    mulax.xyzw ACC, vf01, vf28x     lq.xyzw vf30, 2(vi05)
    madday.xyzw ACC, vf02, vf28y    lq.xyzw vf19, 1020(vi00)
    maddaz.xyzw ACC, vf03, vf28z    sqi.xyzw vf14, (vi04++)
    maddw.xyzw vf26, vf04, vf00w    sqi.xyzw vf15, (vi04++)
    mul.xyzw vf27, vf30, vf09       sqi.xyzw vf16, (vi04++)
    mulax.xyzw ACC, vf05, vf28x     sqi.xyzw vf17, (vi04++)
    madday.xyzw ACC, vf06, vf28y    sqi.xyzw vf18, (vi04++)
    maddaz.xyzw ACC, vf07, vf28z    div Q, vf00w, vf26w                  ; Q = 1 / vf26.w
    ftoi0.xyzw vf27, vf27           sqi.xyzw vf19, (vi04++)
    maddw.xyzw vf24, vf08, vf00w    loi 255.0                            ; I = 255.0
    nop                             ilw.w vi09, 0(vi05)                  ; vi09: the position's w word, XYZF2's w (F, ADC) as the model has it
    nop                             lq.xyzw vf31, 3(vi05)
    nop                             sq.xyzw vf27, 1(vi04)
    clipw.xyz vf24, vf24w           lq.xyzw vf29, 1(vi05)                ; clip flags: vf24.xyz against +-vf24.w
    mulq.xyz vf26, vf26, Q          iaddiu vi05, vi05, 4
    mulq.xyz vf25, vf31, Q          iaddiu vi14, vi09, 0
    ; one vertex per pass, software-pipelined through the delay line
vertices_loop:
    nop                             move.xyz vf11, vf12
    nop                             move.xyz vf12, vf13
    nop                             move.xyz vf13, vf26
    ftoi4.xyz vf26, vf26            sq.xyzw vf25, 0(vi04)
    nop                             nop
    sub.xyz vf14, vf12, vf11        fcand vi01, 0x03ffff                 ; vi01 = 1: one of the last three vertices is outside the clip volume
    sub.xyz vf15, vf13, vf11        ibne vi01, vi00, vertices_skip
    nop                             sq.xyz vf26, 2(vi04)
    nop                             ibne vi14, vi00, vertices_skip2
    nop                             nop
    opmula.xyz ACC, vf15, vf14      nop
    opmsub.xyz vf15, vf14, vf15     nop
    nop                             nop
    nop                             nop
    nop                             nop
    mulw.z vf15, vf15, vf29w        nop
    nop                             nop
    nop                             nop
    nop                             iaddiu vi01, vi00, 32
    nop                             fmand vi01, vi01
    nop                             ibeq vi01, vi00, vertices_skip2
    nop                             nop
vertices_skip:
    nop                             iaddiu vi14, vi00, 32767             ; ADC: 0x7FFF + 1 = 0x8000, so the GS draws no triangle ending here
    nop                             iaddiu vi14, vi14, 1
vertices_skip2:
    subw.x vf23, vf10, vf26w        lq.xyzw vf28, 0(vi05)
    nop                             ilw.w vi09, 0(vi05)
    nop                             lq.xyzw vf29, 1(vi05)
    nop                             lq.xyzw vf30, 2(vi05)
    muly.x vf23, vf23, vf10y        lq.xyzw vf31, 3(vi05)
    mulax.xyzw ACC, vf01, vf28x     iaddiu vi05, vi05, 4
    madday.xyzw ACC, vf02, vf28y    iaddiu vi12, vi14, 0
    mul.xyzw vf27, vf30, vf09       iaddiu vi14, vi09, 0
    muli.x vf23, vf23, I            nop
    maddaz.xyzw ACC, vf03, vf28z    nop
    maddw.xyzw vf26, vf04, vf00w    nop
    ftoi0.xyzw vf27, vf27           nop
    minii.x vf23, vf23, I           nop
    mulax.xyzw ACC, vf05, vf28x     nop
    madday.xyzw ACC, vf06, vf28y    div Q, vf00w, vf26w
    maddaz.xyzw ACC, vf07, vf28z    nop
    maxx.x vf23, vf23, vf00x        nop
    maddw.xyzw vf24, vf08, vf00w    nop
    nop                             nop
    nop                             nop
    ftoi4.x vf23, vf23              nop
    mulq.xyz vf26, vf26, Q          sq.xyzw vf27, 4(vi04)
    mulq.xyz vf25, vf31, Q          nop
    clipw.xyz vf24, vf24w           nop
    nop                             mtir vi13, vf23x
    nop                             nop
    nop                             iaddiu vi04, vi04, 3
    nop                             iaddi vi07, vi07, -1
    nop                             iadd vi12, vi12, vi13
    nop                             ibne vi07, vi00, vertices_loop
    nop                             isw.w vi12, -1(vi04)
    ; the epilogue: the vertices left in the delay line
    nop                             lqd.xyzw vf14, (--vi04)
    nop                             lqd.xyzw vf15, (--vi04)
    nop                             lqd.xyzw vf16, (--vi04)
    nop                             lqd.xyzw vf17, (--vi04)
    nop                             lqd.xyzw vf18, (--vi04)
    nop                             lqd.xyzw vf19, (--vi04)
    nop                             sq.xyzw vf14, 1020(vi00)
    nop                             sq.xyzw vf15, 1019(vi00)
    nop                             sq.xyzw vf16, 1018(vi00)
    nop                             sq.xyzw vf17, 1023(vi00)
    nop                             sq.xyzw vf18, 1022(vi00)
    nop                             sq.xyzw vf19, 1021(vi00)
    nop                             xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             nop                               [E] ; end: the next MSCNT continues at vertices_cont
    nop                             nop

    ; the next MSCNT continues here
vertices_cont:
    nop                             b batch                              ; the next batch
    nop                             nop
.endprogram

;=======================================================================================
; Vu1Prog55: fog, clipped
;
; gVu1ProgInfo55 (bones.c): 465 pairs (3720 bytes), batches of up to 3200 bytes;
; Vu1_SelectProgram's key 0x8080, rigid models (0x21035, 0x121035).
; Setup Vu1Pkt_DP: an UNPACK of 14 qwords to VU 0, then MSCALF 0:
;   0        colour: gGsColorF, RGB scaled by the model's brightness
;   1        fog range: gGsFogFar and the word after it: vf09, vf26
;   2-5      gMtxSlots x gMtxView x gMtxProjClip: model to screen (XYZ after the divide by w): vf01-vf04
;   6-9      the matrix above x gViewportMtx: model to the clip test's space: vf05-vf08
;   10-13    gMtxProj, the projection matrix: vf27-vf30
; Vertices: gVu1ProgLayouts[5], 3 qwords: position, colour, texture coordinates.
; Batches at VU 0xe and 0xe + 0x1c2 (XTOP); the output follows each.
;=======================================================================================
.program Vu1Prog55
.base 0xe
.offset 0x1c2
.stcycl 4, 4
.unpack 0x3a6, 0x00008000, 0x303ec000, 0x00000412, 0x00000000   ; GIF tag template: EOP, PRIM 0x7d, REGS ST RGBAQ XYZF2

    ; MSCALF 0: the setup's constants into registers
init:
    nop                             lq.xyzw vf01, 2(vi00)
    nop                             lq.xyzw vf02, 3(vi00)
    nop                             lq.xyzw vf03, 4(vi00)
    nop                             lq.xyzw vf04, 5(vi00)
    nop                             lq.xyzw vf05, 6(vi00)
    nop                             lq.xyzw vf06, 7(vi00)
    nop                             lq.xyzw vf07, 8(vi00)
    nop                             lq.xyzw vf08, 9(vi00)
    nop                             lq.xyzw vf09, 1(vi00)
    nop                             nop                               [E] ; end: constants loaded
    nop                             nop

    ; MSCNT: one batch at XTOP; qword 0's x is its type, qword 1 a GIF tag
batch:
    nop                             xtop vi02                            ; vi02: the batch (BASE, or BASE + OFFSET: double buffer)
    nop                             iaddiu vi05, vi02, 0
    nop                             iaddiu vi03, vi02, 200               ; vi03: the output, 200 qwords after the batch
    nop                             ilwr.x vi06, (vi05)                  ; the batch type (qword 0)
    nop                             iaddiu vi05, vi05, 1
    nop                             ilwr.x vi08, (vi05)                  ; the GIF tag (qword 1): NLOOP, EOP
    nop                             iaddiu vi04, vi03, 0
    nop                             iaddiu vi11, vi00, 32767             ; 0x7FFF: the NLOOP mask
    nop                             lq.xyzw vf31, 0(vi05)
    nop                             iand vi07, vi11, vi08
    nop                             iaddiu vi11, vi00, 1
    nop                             iaddiu vi05, vi05, 1
    nop                             ibeq vi11, vi06, vertices
    nop                             sqi.xyzw vf31, (vi04++)

    ; a register block: the GIF tag and its NLOOP qwords (A+D) go through to the output
copy_regs:
    nop                             lq.xyzw vf31, 0(vi05)
    nop                             iaddi vi07, vi07, -1
    nop                             iaddiu vi05, vi05, 1
    nop                             iaddiu vi04, vi04, 1
    nop                             ibne vi07, vi00, copy_regs
    nop                             sq.xyzw vf31, -1(vi04)
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             nop                               [E] ; end: the next MSCNT continues at copy_regs_cont
    nop                             nop

    ; the next MSCNT continues here
copy_regs_cont:
    nop                             b batch                              ; the next batch
    nop                             nop

    ; type 1: a strip of NLOOP vertices
vertices:
    nop                             lq.xyzw vf29, 0(vi05)
    nop                             ilw.w vi09, 0(vi05)                  ; vi09: the position's w word, XYZF2's w (F, ADC) as the model has it
    nop                             loi 255.0                            ; I = 255.0
    nop                             iaddiu vi08, vi08, 2                 ; NLOOP + 2: the delay line's last vertices go out first
    mulax.xyzw ACC, vf01, vf29x     isw.x vi08, -1(vi04)
    madday.xyzw ACC, vf02, vf29y    lq.xyzw vf10, 917(vi00)
    maddaz.xyzw ACC, vf03, vf29z    lq.xyzw vf11, 918(vi00)
    maddw.xyzw vf28, vf04, vf00w    lq.xyzw vf12, 919(vi00)
    mulax.xyzw ACC, vf05, vf29x     lq.xyzw vf13, 914(vi00)
    madday.xyzw ACC, vf06, vf29y    lq.xyzw vf14, 915(vi00)
    maddaz.xyzw ACC, vf07, vf29z    lq.xyzw vf15, 916(vi00)
    maddw.xyzw vf27, vf08, vf00w    div Q, vf00w, vf28w                  ; Q = 1 / vf28.w
    nop                             nop
    nop                             sqi.xyzw vf10, (vi04++)
    nop                             lq.xyzw vf31, 2(vi05)
    clipw.xyz vf27, vf27w           sqi.xyzw vf11, (vi04++)              ; clip flags: vf27.xyz against +-vf27.w
    nop                             sqi.xyzw vf12, (vi04++)
    nop                             sqi.xyzw vf13, (vi04++)
    mulq.xyz vf26, vf31, Q          sqi.xyzw vf14, (vi04++)
    mulq.xyz vf28, vf28, Q          sqi.xyzw vf15, (vi04++)
    nop                             lq.xyzw vf30, 1(vi05)
    nop                             iaddiu vi14, vi09, 0
    nop                             sq.xyzw vf26, 0(vi04)
    ftoi4.xyz vf28, vf28            iaddiu vi05, vi05, 3
    ftoi0.xyzw vf26, vf30           ilw.w vi09, 0(vi05)
    ; one vertex per pass, software-pipelined through the delay line
vertices_loop:
    nop                             lq.xyzw vf10, 1020(vi00)
    nop                             lq.xyzw vf11, 1017(vi00)
    subw.x vf25, vf09, vf28w        lq.xyzw vf12, 1019(vi00)
    nop                             lq.xyzw vf13, 1016(vi00)
    clipw.xyz vf10, vf10w           lq.xyzw vf14, 1018(vi00)
    clipw.xyz vf11, vf11w           lq.xyzw vf15, 1015(vi00)
    nop                             sq.xyzw vf10, 1023(vi00)
    nop                             sq.xyzw vf11, 1020(vi00)
    nop                             sq.xyzw vf12, 1022(vi00)
    nop                             sq.xyzw vf27, 1017(vi00)
    nop                             sq.xyzw vf13, 1019(vi00)
    nop                             sq.xyzw vf14, 1021(vi00)
    nop                             sq.xyzw vf15, 1018(vi00)
    nop                             sq.xyzw vf31, 1015(vi00)
    nop                             lq.xyzw vf29, 0(vi05)
    nop                             ibne vi14, vi00, vertices_in_view
    nop                             sq.xyzw vf26, 1016(vi00)
    nop                             fcand vi01, 0x03ffff                 ; vi01 = 1: one of the last three vertices is outside the clip volume
    nop                             ibeq vi01, vi00, vertices_in_view
    nop                             nop
    nop                             ibne vi14, vi00, vertices_in_view
    nop                             fcor vi01, 0xfdf7df
    nop                             ibne vi01, vi00, vertices_culled
    nop                             fcor vi01, 0xfefbef
    nop                             ibne vi01, vi00, vertices_culled
    nop                             fcor vi01, 0xff7df7
    nop                             ibne vi01, vi00, vertices_culled
    nop                             fcor vi01, 0xffbefb
    nop                             ibne vi01, vi00, vertices_culled
    nop                             fcor vi01, 0xffdf7d
    nop                             ibne vi01, vi00, vertices_culled
    nop                             fcor vi01, 0xffefbe
    nop                             ibne vi01, vi00, vertices_culled
    nop                             nop
    nop                             bal vi15, clip_triangle
    nop                             nop
    ; the triangle is wholly outside one plane: culled
vertices_culled:
    nop                             iaddiu vi14, vi00, 32767             ; ADC: 0x7FFF + 1 = 0x8000, so the GS draws no triangle ending here
    nop                             iaddiu vi14, vi14, 1
    ; the last three vertices are all inside the clip volume
vertices_in_view:
    muly.x vf25, vf25, vf09y        sq.xyz vf28, 2(vi04)
    mulax.xyzw ACC, vf01, vf29x     nop
    madday.xyzw ACC, vf02, vf29y    nop
    maddaz.xyzw ACC, vf03, vf29z    nop
    muli.x vf25, vf25, I            nop
    maddw.xyzw vf28, vf04, vf00w    nop
    mulax.xyzw ACC, vf05, vf29x     nop
    madday.xyzw ACC, vf06, vf29y    nop
    minii.x vf25, vf25, I           nop
    maddaz.xyzw ACC, vf07, vf29z    div Q, vf00w, vf28w
    maddw.xyzw vf27, vf08, vf00w    nop
    nop                             nop
    maxx.x vf25, vf25, vf00x        nop
    nop                             lq.xyzw vf31, 2(vi05)
    clipw.xyz vf27, vf27w           lq.xyzw vf30, 1(vi05)
    nop                             iaddiu vi05, vi05, 3
    ftoi4.x vf25, vf25              sq.xyzw vf26, 1(vi04)
    mulq.xyz vf26, vf31, Q          iaddi vi07, vi07, -1
    mulq.xyz vf28, vf28, Q          iaddiu vi04, vi04, 3
    nop                             iaddiu vi12, vi14, 0
    nop                             mtir vi13, vf25x
    nop                             sq.xyzw vf26, 0(vi04)
    ftoi4.xyz vf28, vf28            iaddiu vi14, vi09, 0
    ftoi0.xyzw vf26, vf30           ilw.w vi09, 0(vi05)
    nop                             iadd vi12, vi12, vi13
    nop                             ibne vi07, vi00, vertices_loop
    nop                             isw.w vi12, -1(vi04)
    ; the epilogue: the vertices left in the delay line
    nop                             lqd.xyzw vf10, (--vi04)
    nop                             lqd.xyzw vf11, (--vi04)
    nop                             lqd.xyzw vf12, (--vi04)
    nop                             lqd.xyzw vf13, (--vi04)
    nop                             lqd.xyzw vf14, (--vi04)
    nop                             lqd.xyzw vf15, (--vi04)
    nop                             sq.xyzw vf10, 916(vi00)
    nop                             sq.xyzw vf11, 915(vi00)
    nop                             sq.xyzw vf12, 914(vi00)
    nop                             sq.xyzw vf13, 919(vi00)
    nop                             sq.xyzw vf14, 918(vi00)
    nop                             sq.xyzw vf15, 917(vi00)
    nop                             xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             nop                               [E] ; end: the next MSCNT continues at vertices_cont
    nop                             nop

    ; the next MSCNT continues here
vertices_cont:
    nop                             b batch                              ; the next batch
    nop                             nop

    ; clip the last three vertices' triangle against the six planes of the clip volume and
    ; send what is left as a fan (the GIF tag template at VU 0x3A6)
clip_triangle:
    nop                             iaddiu vi14, vi00, 934
    nop                             sqd.xyzw vf21, (--vi14)
    nop                             sqd.xyzw vf22, (--vi14)
    nop                             sqd.xyzw vf23, (--vi14)
    nop                             sqd.xyzw vf24, (--vi14)
    nop                             sqd.xyzw vf25, (--vi14)
    nop                             sqd.xyzw vf26, (--vi14)
    nop                             sqd.xyzw vf27, (--vi14)
    nop                             sqd.xyzw vf28, (--vi14)
    nop                             sqd.xyzw vf29, (--vi14)
    nop                             sqd.xyzw vf30, (--vi14)
    nop                             sqd.xyzw vf31, (--vi14)
    nop                             isubiu vi14, vi14, 1
    nop                             iswr.x vi02, (vi14)
    nop                             iswr.y vi03, (vi14)
    nop                             iswr.z vi04, (vi14)
    nop                             iswr.w vi05, (vi14)
    nop                             isubiu vi14, vi14, 1
    nop                             iswr.x vi06, (vi14)
    nop                             iswr.y vi07, (vi14)
    nop                             iswr.z vi08, (vi14)
    nop                             iswr.w vi09, (vi14)
    nop                             isubiu vi14, vi14, 1
    nop                             iswr.x vi10, (vi14)
    nop                             iswr.y vi11, (vi14)
    nop                             iswr.z vi12, (vi14)
    nop                             iswr.w vi13, (vi14)
    nop                             iaddiu vi08, vi00, 0
    nop                             iaddiu vi09, vi00, 935
    nop                             iaddiu vi10, vi00, 975
    nop                             lq.xyzw vf23, 1022(vi00)
    nop                             lq.xyzw vf24, 1019(vi00)
    nop                             lq.xyzw vf25, 1016(vi00)
    nop                             lq.xyzw vf26, 1021(vi00)
    itof0.xyzw vf23, vf23           lq.xyzw vf27, 1018(vi00)
    itof0.xyzw vf24, vf24           lq.xyzw vf28, 1015(vi00)
    itof0.xyzw vf25, vf25           lq.xyzw vf29, 1023(vi00)
    nop                             lq.xyzw vf30, 1020(vi00)
    nop                             lq.xyzw vf31, 1017(vi00)
    nop                             sq.xyzw vf23, 1(vi09)
    nop                             sq.xyzw vf24, 4(vi09)
    nop                             sq.xyzw vf25, 7(vi09)
    nop                             sq.xyzw vf23, 10(vi09)
    nop                             sq.xyzw vf26, 2(vi09)
    nop                             sq.xyzw vf27, 5(vi09)
    nop                             sq.xyzw vf28, 8(vi09)
    nop                             sq.xyzw vf26, 11(vi09)
    nop                             sq.xyzw vf29, 0(vi09)
    nop                             sq.xyzw vf30, 3(vi09)
    nop                             sq.xyzw vf31, 6(vi09)
    nop                             sq.xyzw vf29, 9(vi09)
    nop                             iaddiu vi09, vi00, 935
    nop                             iaddiu vi10, vi00, 975
    nop                             iaddiu vi05, vi00, 2048
    nop                             iaddiu vi06, vi00, 32
    subw.x vf31, vf00, vf00w        bal vi13, first_vertex
    nop                             iaddiu vi07, vi00, 2
    nop                             iaddiu vi04, vi00, 3
    nop                             iaddiu vi11, vi00, 0
    nop                             bal vi13, clip_edges
    nop                             nop
    nop                             bal vi13, close_polygon
    nop                             iaddiu vi09, vi00, 975
    nop                             iaddiu vi09, vi00, 975
    nop                             iaddiu vi10, vi00, 935
    nop                             iaddiu vi05, vi00, 1024
    nop                             iaddiu vi06, vi00, 16
    addw.x vf31, vf00, vf00w        bal vi13, pass_start
    nop                             iaddiu vi07, vi00, 2
    nop                             bal vi13, clip_edges
    nop                             nop
    nop                             bal vi13, close_polygon
    nop                             iaddiu vi09, vi00, 935
    nop                             iaddiu vi05, vi00, 128
    nop                             iaddiu vi06, vi00, 2
    subw.x vf31, vf00, vf00w        bal vi13, pass_a_to_b
    nop                             iaddiu vi07, vi00, 0
    nop                             bal vi13, clip_edges
    nop                             nop
    nop                             bal vi13, close_polygon
    nop                             iaddiu vi09, vi00, 975
    nop                             iaddiu vi05, vi00, 64
    nop                             iaddiu vi06, vi00, 1
    addw.x vf31, vf00, vf00w        bal vi13, pass_b_to_a
    nop                             iaddiu vi07, vi00, 0
    nop                             bal vi13, clip_edges
    nop                             nop
    nop                             bal vi13, close_polygon
    nop                             iaddiu vi09, vi00, 935
    nop                             iaddiu vi05, vi00, 512
    nop                             iaddiu vi06, vi00, 8
    subw.x vf31, vf00, vf00w        bal vi13, pass_a_to_b
    nop                             iaddiu vi07, vi00, 1
    nop                             bal vi13, clip_edges
    nop                             nop
    nop                             bal vi13, close_polygon
    nop                             iaddiu vi09, vi00, 975
    nop                             iaddiu vi05, vi00, 256
    nop                             iaddiu vi06, vi00, 4
    addw.x vf31, vf00, vf00w        bal vi13, pass_b_to_a
    nop                             iaddiu vi07, vi00, 1
    nop                             bal vi13, clip_edges
    nop                             nop
    nop                             bal vi13, close_polygon
    nop                             iaddiu vi09, vi00, 935
    nop                             iaddiu vi09, vi00, 935
    nop                             iaddiu vi10, vi00, 975
    nop                             iadd vi04, vi00, vi11
    nop                             iaddiu vi11, vi00, 0
    nop                             ilwr.y vi06, (vi02)
    nop                             lq.xyzw vf31, 934(vi00)
    nop                             lq.xyzw vf26, 1(vi00)
    nop                             lq.xyzw vf27, 10(vi00)
    nop                             ilw.x vi12, 934(vi00)
    nop                             iadd vi06, vi06, vi03
    nop                             iaddiu vi02, vi06, 0
    nop                             sqi.xyzw vf31, (vi06++)
    nop                             iadd vi12, vi12, vi04
    nop                             lq.xyzw vf28, 11(vi00)
    nop                             lq.xyzw vf29, 12(vi00)
    nop                             lq.xyzw vf30, 13(vi00)
    nop                             xgkick vi02                          ; send the output to the GS (PATH1)
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             isw.x vi12, -1(vi06)
    nop                             nop
clip_triangle_loop:
    nop                             lqi.xyzw vf23, (vi09++)
    nop                             lqi.xyzw vf24, (vi09++)
    nop                             lqi.xyzw vf25, (vi09++)
    nop                             nop
    mulax.xyzw ACC, vf27, vf23x     nop
    madday.xyzw ACC, vf28, vf23y    nop
    maddaz.xyzw ACC, vf29, vf23z    nop
    maddw.xyzw vf23, vf30, vf23w    loi 128.0                            ; I = 128.0: the colour clamp (0x80 is 1.0 on the GS)
    minii.xyz vf24, vf24, I         nop
    nop                             nop
    nop                             nop
    nop                             div Q, vf00w, vf23w                  ; Q = 1 / vf23.w
    ftoi0.xyzw vf24, vf24           waitq
    mulq.xyz vf23, vf23, Q          nop
    mulq.xyz vf25, vf25, Q          nop
    nop                             nop
    nop                             sq.xyzw vf24, 1(vi06)
    ftoi4.xyz vf23, vf23            nop
    nop                             sq.xyzw vf25, 0(vi06)
    nop                             nop
    nop                             nop
    nop                             sq.xyz vf23, 2(vi06)
    subw.x vf23, vf26, vf23w        nop
    nop                             nop
    nop                             nop
    nop                             nop
    muly.x vf23, vf23, vf26y        nop
    nop                             nop
    nop                             nop
    nop                             loi 255.0                            ; I = 255.0
    muli.x vf23, vf23, I            nop
    nop                             nop
    nop                             nop
    nop                             nop
    minii.x vf23, vf23, I           nop
    nop                             nop
    nop                             nop
    nop                             nop
    maxx.x vf23, vf23, vf00x        nop
    nop                             nop
    nop                             nop
    nop                             nop
    ftoi4.x vf23, vf23              nop
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             mtir vi13, vf23x
    nop                             iaddi vi04, vi04, -1
    nop                             iaddiu vi06, vi06, 3
    nop                             ibne vi04, vi00, clip_triangle_loop
    nop                             isw.w vi13, -1(vi06)
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             xgkick vi02                          ; send the output to the GS (PATH1)
    nop                             nop
clip_triangle_exit:
    nop                             ilwr.x vi10, (vi14)
    nop                             ilwr.y vi11, (vi14)
    nop                             ilwr.z vi12, (vi14)
    nop                             ilwr.w vi13, (vi14)
    nop                             iaddiu vi14, vi14, 1
    nop                             ilwr.x vi06, (vi14)
    nop                             ilwr.y vi07, (vi14)
    nop                             ilwr.z vi08, (vi14)
    nop                             ilwr.w vi09, (vi14)
    nop                             iaddiu vi14, vi14, 1
    nop                             ilwr.x vi02, (vi14)
    nop                             ilwr.y vi03, (vi14)
    nop                             ilwr.z vi04, (vi14)
    nop                             ilwr.w vi05, (vi14)
    nop                             iaddiu vi14, vi14, 1
    nop                             lqi.xyzw vf31, (vi14++)
    nop                             lqi.xyzw vf30, (vi14++)
    nop                             lqi.xyzw vf29, (vi14++)
    nop                             lqi.xyzw vf28, (vi14++)
    nop                             lqi.xyzw vf27, (vi14++)
    nop                             lqi.xyzw vf26, (vi14++)
    nop                             lqi.xyzw vf25, (vi14++)
    nop                             lqi.xyzw vf24, (vi14++)
    nop                             lqi.xyzw vf23, (vi14++)
    nop                             lqi.xyzw vf22, (vi14++)
    nop                             jr vi15
    nop                             lqi.xyzw vf21, (vi14++)

    ; after a plane: repeat the first output vertex after the last; an empty polygon leaves
    ; (clip_triangle_exit)
close_polygon:
    nop                             lqi.xyzw vf29, (vi09++)
    nop                             lqi.xyzw vf30, (vi09++)
    nop                             lqi.xyzw vf31, (vi09++)
    nop                             nop
    nop                             sqi.xyzw vf29, (vi10++)
    nop                             sqi.xyzw vf30, (vi10++)
    nop                             ibeq vi11, vi00, clip_triangle_exit
    nop                             sqi.xyzw vf31, (vi10++)
    nop                             jr vi13
    nop                             nop

    ; the next plane reads the polygon at VU 935.. and writes the one at 975.. (as set at
    ; clip_triangle)
pass_a_to_b:
    nop                             iaddiu vi09, vi00, 935
    nop                             b pass_start
    nop                             iaddiu vi10, vi00, 975

    ; the next plane reads the second polygon buffer and writes the first
pass_b_to_a:
    nop                             iaddiu vi09, vi00, 975
    nop                             iaddiu vi10, vi00, 935

    ; vi04: the vertices to clip; vi11: none written yet
pass_start:
    nop                             iadd vi04, vi00, vi11
    nop                             iaddiu vi11, vi00, 0

    ; load the polygon's first vertex (three qwords)
first_vertex:
    nop                             lqi.xyzw vf21, (vi09++)
    nop                             lqi.xyzw vf22, (vi09++)
    nop                             jr vi13
    nop                             lqi.xyzw vf23, (vi09++)

    ; clip the polygon's edges against one plane (vi05, vi06: its clip-flag bits; vf31.x its
    ; sign)
clip_edges:
    mulw.xyzw vf24, vf21, vf00w     lqi.xyzw vf21, (vi09++)
    mulw.xyzw vf25, vf22, vf00w     lqi.xyzw vf22, (vi09++)
    mulw.xyzw vf26, vf23, vf00w     lqi.xyzw vf23, (vi09++)
    nop                             nop
    clipw.xyz vf24, vf24w           nop                                  ; clip flags: vf24.xyz against +-vf24.w
    clipw.xyz vf21, vf21w           nop
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             fcget vi01
    nop                             nop
    nop                             iand vi12, vi01, vi05
    nop                             nop
    nop                             ibeq vi12, vi00, clip_edges_skip
    nop                             nop
    nop                             iand vi12, vi01, vi06
    nop                             nop
    nop                             ibne vi12, vi00, clip_edges_skip3
    nop                             nop
    nop                             bal vi01, intersect
    nop                             nop
    nop                             sqi.xyzw vf28, (vi10++)
    nop                             sqi.xyzw vf29, (vi10++)
    nop                             sqi.xyzw vf30, (vi10++)
    nop                             b clip_edges_skip3
    nop                             iaddiu vi11, vi11, 1
clip_edges_skip:
    nop                             iand vi12, vi01, vi06
    nop                             nop
    nop                             ibeq vi12, vi00, clip_edges_skip2
    nop                             nop
    nop                             bal vi01, intersect
    nop                             nop
    nop                             sqi.xyzw vf24, (vi10++)
    nop                             sqi.xyzw vf25, (vi10++)
    nop                             sqi.xyzw vf26, (vi10++)
    nop                             sqi.xyzw vf28, (vi10++)
    nop                             sqi.xyzw vf29, (vi10++)
    nop                             sqi.xyzw vf30, (vi10++)
    nop                             b clip_edges_skip3
    nop                             iaddiu vi11, vi11, 2
clip_edges_skip2:
    nop                             sqi.xyzw vf24, (vi10++)
    nop                             sqi.xyzw vf25, (vi10++)
    nop                             sqi.xyzw vf26, (vi10++)
    nop                             iaddiu vi11, vi11, 1
clip_edges_skip3:
    nop                             isubiu vi04, vi04, 1
    nop                             nop
    nop                             ibne vi04, vi00, clip_edges
    nop                             nop
    nop                             jr vi13
    nop                             nop

    ; an edge crosses the plane: write the intersection (position and attributes interpolated)
intersect:
    mulx.w vf28, vf24, vf31x        nop
    mulx.w vf29, vf21, vf31x        nop
    nop                             nop
    nop                             nop
    subw.xyzw vf28, vf24, vf28w     nop
    subw.xyzw vf29, vf21, vf29w     nop
    nop                             iadd vi12, vi00, vi07
    nop                             nop
intersect_loop:
    nop                             ibeq vi12, vi00, intersect_skip
    nop                             nop
    nop                             mr32.xyzw vf28, vf28
    nop                             mr32.xyzw vf29, vf29
    nop                             isubiu vi12, vi12, 1
    nop                             nop
    nop                             b intersect_loop
    nop                             nop
intersect_skip:
    sub.xyz vf30, vf29, vf28        nop
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             div Q, vf28x, vf30x
    nop                             waitq
    addq.x vf27, vf00, Q            nop
    sub.xyzw vf28, vf21, vf24       nop
    sub.xyzw vf29, vf22, vf25       nop
    sub.xyzw vf30, vf23, vf26       nop
    abs.x vf27, vf27                nop
    nop                             nop
    nop                             nop
    nop                             nop
    mulx.xyzw vf28, vf28, vf27x     nop
    mulx.xyzw vf29, vf29, vf27x     nop
    mulx.xyzw vf30, vf30, vf27x     nop
    nop                             nop
    add.xyzw vf28, vf28, vf24       nop
    add.xyzw vf29, vf29, vf25       nop
    add.xyzw vf30, vf30, vf26       jr vi01
    nop                             nop
.endprogram

;=======================================================================================
; Vu1Prog56: gMtxUv rows, clipped
;
; gVu1ProgInfo56 (bones.c): 411 pairs (3288 bytes), batches of up to 3200 bytes;
; Vu1_SelectProgram's key 0x4080, rigid models (0x21035, 0x121035).
; Setup Vu1Pkt_EP: an UNPACK of 16 qwords to VU 0, then MSCALF 0:
;   0        colour: gGsColorF, RGB scaled by the model's brightness
;   1-4      gMtxSlots x gMtxView x gMtxProjClip: model to screen (XYZ after the divide by w): vf01-vf04
;   5-8      the matrix above x gViewportMtx: model to the clip test's space: vf05-vf08
;   9-11     rows 0, 1 and 3 of gMtxUv (Vu1_PutUvMatrix): vf09-vf11
;   12-15    gMtxProj, the projection matrix: vf27-vf30
; Vertices: gVu1ProgLayouts[5], 3 qwords: position, colour, texture coordinates.
; Batches at VU 0x10 and 0x10 + 0x1c0 (XTOP); the output follows each.
;=======================================================================================
.program Vu1Prog56
.base 0x10
.offset 0x1c0
.stcycl 4, 4
.unpack 0x3a6, 0x00008000, 0x302ec000, 0x00000412, 0x00000000   ; GIF tag template: EOP, PRIM 0x5d, REGS ST RGBAQ XYZF2

    ; MSCALF 0: the setup's constants into registers
init:
    nop                             lq.xyzw vf01, 1(vi00)
    nop                             lq.xyzw vf02, 2(vi00)
    nop                             lq.xyzw vf03, 3(vi00)
    nop                             lq.xyzw vf04, 4(vi00)
    nop                             lq.xyzw vf05, 5(vi00)
    nop                             lq.xyzw vf06, 6(vi00)
    nop                             lq.xyzw vf07, 7(vi00)
    nop                             lq.xyzw vf08, 8(vi00)
    nop                             lq.xyzw vf09, 9(vi00)
    nop                             lq.xyzw vf10, 10(vi00)
    nop                             lq.xyzw vf11, 11(vi00)
    nop                             nop                               [E] ; end: constants loaded
    nop                             nop

    ; MSCNT: one batch at XTOP; qword 0's x is its type, qword 1 a GIF tag
batch:
    nop                             xtop vi02                            ; vi02: the batch (BASE, or BASE + OFFSET: double buffer)
    nop                             iaddiu vi05, vi02, 0
    nop                             iaddiu vi03, vi02, 200               ; vi03: the output, 200 qwords after the batch
    nop                             ilwr.x vi06, (vi05)                  ; the batch type (qword 0)
    nop                             iaddiu vi05, vi05, 1
    nop                             ilwr.x vi08, (vi05)                  ; the GIF tag (qword 1): NLOOP, EOP
    nop                             iaddiu vi04, vi03, 0
    nop                             iaddiu vi11, vi00, 32767             ; 0x7FFF: the NLOOP mask
    nop                             lq.xyzw vf31, 0(vi05)
    nop                             iand vi07, vi11, vi08
    nop                             iaddiu vi11, vi00, 1
    nop                             iaddiu vi05, vi05, 1
    nop                             ibeq vi11, vi06, vertices
    nop                             sqi.xyzw vf31, (vi04++)

    ; a register block: the GIF tag and its NLOOP qwords (A+D) go through to the output
copy_regs:
    nop                             lq.xyzw vf31, 0(vi05)
    nop                             iaddi vi07, vi07, -1
    nop                             iaddiu vi05, vi05, 1
    nop                             iaddiu vi04, vi04, 1
    nop                             ibne vi07, vi00, copy_regs
    nop                             sq.xyzw vf31, -1(vi04)
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             nop                               [E] ; end: the next MSCNT continues at copy_regs_cont
    nop                             nop

    ; the next MSCNT continues here
copy_regs_cont:
    nop                             b batch                              ; the next batch
    nop                             nop

    ; type 1: a strip of NLOOP vertices
vertices:
    nop                             iaddiu vi08, vi08, 2                 ; NLOOP + 2: the delay line's last vertices go out first
    nop                             isw.x vi08, -1(vi04)
    nop                             lq.xyzw vf12, 917(vi00)
    nop                             lq.xyzw vf13, 918(vi00)
    nop                             lq.xyzw vf14, 919(vi00)
    nop                             lq.xyzw vf15, 914(vi00)
    nop                             lq.xyzw vf16, 915(vi00)
    nop                             lq.xyzw vf17, 916(vi00)
    nop                             sqi.xyzw vf12, (vi04++)
    nop                             sqi.xyzw vf13, (vi04++)
    nop                             sqi.xyzw vf14, (vi04++)
    nop                             sqi.xyzw vf15, (vi04++)
    nop                             sqi.xyzw vf16, (vi04++)
    nop                             sqi.xyzw vf17, (vi04++)
    nop                             lq.xyzw vf29, 0(vi05)
    ; one vertex per pass, software-pipelined through the delay line
vertices_loop:
    nop                             ilw.w vi09, 0(vi05)                  ; vi09: the position's w word, XYZF2's w (F, ADC) as the model has it
    nop                             lq.xyzw vf30, 1(vi05)
    nop                             lq.xyzw vf31, 2(vi05)
    mulax.xyzw ACC, vf01, vf29x     iaddiu vi05, vi05, 3
    madday.xyzw ACC, vf02, vf29y    lq.xyzw vf12, 1020(vi00)
    maddaz.xyzw ACC, vf03, vf29z    lq.xyzw vf13, 1017(vi00)
    maddw.xyzw vf28, vf04, vf00w    lq.xyzw vf14, 1019(vi00)
    mulax.xy ACC, vf09, vf31x       lq.xyzw vf15, 1016(vi00)
    madday.xy ACC, vf10, vf31y      lq.xyzw vf16, 1018(vi00)
    maddw.xy vf31, vf11, vf00w      lq.xyzw vf17, 1015(vi00)
    clipw.xyz vf12, vf12w           div Q, vf00w, vf28w                  ; Q = 1 / vf28.w
    clipw.xyz vf13, vf13w           sq.xyzw vf12, 1023(vi00)             ; clip flags: vf13.xyz against +-vf13.w
    mulax.xyzw ACC, vf05, vf29x     sq.xyzw vf13, 1020(vi00)
    madday.xyzw ACC, vf06, vf29y    sq.xyzw vf31, 1015(vi00)
    ftoi0.xyzw vf30, vf30           sq.xyzw vf14, 1022(vi00)
    maddaz.xyzw ACC, vf07, vf29z    sq.xyzw vf15, 1019(vi00)
    maddw.xyzw vf27, vf08, vf00w    sq.xyzw vf16, 1021(vi00)
    mulq.xyzw vf28, vf28, Q         sq.xyzw vf17, 1018(vi00)
    mulq.xyz vf26, vf31, Q          sq.xyzw vf30, 1016(vi00)
    nop                             sq.xyzw vf30, 1(vi04)
    clipw.xyz vf27, vf27w           sq.xyzw vf27, 1017(vi00)
    ftoi4.xyzw vf28, vf28           lq.xyzw vf29, 0(vi05)                ; to 12.4 fixed point (GS XYZ)
    nop                             sq.xyzw vf26, 0(vi04)
    nop                             iaddi vi07, vi07, -1
    nop                             ibne vi09, vi00, vertices_in_view
    nop                             sq.xyz vf28, 2(vi04)
    nop                             fcand vi01, 0x03ffff                 ; vi01 = 1: one of the last three vertices is outside the clip volume
    nop                             ibeq vi01, vi00, vertices_in_view
    nop                             nop
    nop                             ibne vi09, vi00, vertices_in_view
    nop                             fcor vi01, 0xfdf7df
    nop                             ibne vi01, vi00, vertices_culled
    nop                             fcor vi01, 0xfefbef
    nop                             ibne vi01, vi00, vertices_culled
    nop                             fcor vi01, 0xff7df7
    nop                             ibne vi01, vi00, vertices_culled
    nop                             fcor vi01, 0xffbefb
    nop                             ibne vi01, vi00, vertices_culled
    nop                             fcor vi01, 0xffdf7d
    nop                             ibne vi01, vi00, vertices_culled
    nop                             fcor vi01, 0xffefbe
    nop                             ibne vi01, vi00, vertices_culled
    nop                             nop
    nop                             bal vi15, clip_triangle
    nop                             nop
    ; the triangle is wholly outside one plane: culled
vertices_culled:
    nop                             iaddiu vi09, vi00, 32767
    nop                             iaddiu vi09, vi09, 1
    ; the last three vertices are all inside the clip volume
vertices_in_view:
    nop                             iaddiu vi04, vi04, 3
    nop                             ibne vi07, vi00, vertices_loop
    nop                             isw.w vi09, -1(vi04)
    ; the epilogue: the vertices left in the delay line
    nop                             lqd.xyzw vf12, (--vi04)
    nop                             lqd.xyzw vf13, (--vi04)
    nop                             lqd.xyzw vf14, (--vi04)
    nop                             lqd.xyzw vf15, (--vi04)
    nop                             lqd.xyzw vf16, (--vi04)
    nop                             lqd.xyzw vf17, (--vi04)
    nop                             sq.xyzw vf12, 916(vi00)
    nop                             sq.xyzw vf13, 915(vi00)
    nop                             sq.xyzw vf14, 914(vi00)
    nop                             sq.xyzw vf15, 919(vi00)
    nop                             sq.xyzw vf16, 918(vi00)
    nop                             sq.xyzw vf17, 917(vi00)
    nop                             xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             nop                               [E] ; end: the next MSCNT continues at vertices_cont
    nop                             nop

    ; the next MSCNT continues here
vertices_cont:
    nop                             b batch                              ; the next batch
    nop                             nop

    ; clip the last three vertices' triangle against the six planes of the clip volume and
    ; send what is left as a fan (the GIF tag template at VU 0x3A6)
clip_triangle:
    nop                             iaddiu vi14, vi00, 934
    nop                             sqd.xyzw vf21, (--vi14)
    nop                             sqd.xyzw vf22, (--vi14)
    nop                             sqd.xyzw vf23, (--vi14)
    nop                             sqd.xyzw vf24, (--vi14)
    nop                             sqd.xyzw vf25, (--vi14)
    nop                             sqd.xyzw vf26, (--vi14)
    nop                             sqd.xyzw vf27, (--vi14)
    nop                             sqd.xyzw vf28, (--vi14)
    nop                             sqd.xyzw vf29, (--vi14)
    nop                             sqd.xyzw vf30, (--vi14)
    nop                             sqd.xyzw vf31, (--vi14)
    nop                             isubiu vi14, vi14, 1
    nop                             iswr.x vi02, (vi14)
    nop                             iswr.y vi03, (vi14)
    nop                             iswr.z vi04, (vi14)
    nop                             iswr.w vi05, (vi14)
    nop                             isubiu vi14, vi14, 1
    nop                             iswr.x vi06, (vi14)
    nop                             iswr.y vi07, (vi14)
    nop                             iswr.z vi08, (vi14)
    nop                             iswr.w vi09, (vi14)
    nop                             isubiu vi14, vi14, 1
    nop                             iswr.x vi10, (vi14)
    nop                             iswr.y vi11, (vi14)
    nop                             iswr.z vi12, (vi14)
    nop                             iswr.w vi13, (vi14)
    nop                             iaddiu vi08, vi00, 0
    nop                             iaddiu vi09, vi00, 935
    nop                             iaddiu vi10, vi00, 975
    nop                             lq.xyzw vf23, 1022(vi00)
    nop                             lq.xyzw vf24, 1019(vi00)
    nop                             lq.xyzw vf25, 1016(vi00)
    nop                             lq.xyzw vf26, 1021(vi00)
    itof0.xyzw vf23, vf23           lq.xyzw vf27, 1018(vi00)
    itof0.xyzw vf24, vf24           lq.xyzw vf28, 1015(vi00)
    itof0.xyzw vf25, vf25           lq.xyzw vf29, 1023(vi00)
    nop                             lq.xyzw vf30, 1020(vi00)
    nop                             lq.xyzw vf31, 1017(vi00)
    nop                             sq.xyzw vf23, 1(vi09)
    nop                             sq.xyzw vf24, 4(vi09)
    nop                             sq.xyzw vf25, 7(vi09)
    nop                             sq.xyzw vf23, 10(vi09)
    nop                             sq.xyzw vf26, 2(vi09)
    nop                             sq.xyzw vf27, 5(vi09)
    nop                             sq.xyzw vf28, 8(vi09)
    nop                             sq.xyzw vf26, 11(vi09)
    nop                             sq.xyzw vf29, 0(vi09)
    nop                             sq.xyzw vf30, 3(vi09)
    nop                             sq.xyzw vf31, 6(vi09)
    nop                             sq.xyzw vf29, 9(vi09)
    nop                             iaddiu vi09, vi00, 935
    nop                             iaddiu vi10, vi00, 975
    nop                             iaddiu vi05, vi00, 2048
    nop                             iaddiu vi06, vi00, 32
    subw.x vf31, vf00, vf00w        bal vi13, first_vertex
    nop                             iaddiu vi07, vi00, 2
    nop                             iaddiu vi04, vi00, 3
    nop                             iaddiu vi11, vi00, 0
    nop                             bal vi13, clip_edges
    nop                             nop
    nop                             bal vi13, close_polygon
    nop                             iaddiu vi09, vi00, 975
    nop                             iaddiu vi09, vi00, 975
    nop                             iaddiu vi10, vi00, 935
    nop                             iaddiu vi05, vi00, 1024
    nop                             iaddiu vi06, vi00, 16
    addw.x vf31, vf00, vf00w        bal vi13, pass_start
    nop                             iaddiu vi07, vi00, 2
    nop                             bal vi13, clip_edges
    nop                             nop
    nop                             bal vi13, close_polygon
    nop                             iaddiu vi09, vi00, 935
    nop                             iaddiu vi05, vi00, 128
    nop                             iaddiu vi06, vi00, 2
    subw.x vf31, vf00, vf00w        bal vi13, pass_a_to_b
    nop                             iaddiu vi07, vi00, 0
    nop                             bal vi13, clip_edges
    nop                             nop
    nop                             bal vi13, close_polygon
    nop                             iaddiu vi09, vi00, 975
    nop                             iaddiu vi05, vi00, 64
    nop                             iaddiu vi06, vi00, 1
    addw.x vf31, vf00, vf00w        bal vi13, pass_b_to_a
    nop                             iaddiu vi07, vi00, 0
    nop                             bal vi13, clip_edges
    nop                             nop
    nop                             bal vi13, close_polygon
    nop                             iaddiu vi09, vi00, 935
    nop                             iaddiu vi05, vi00, 512
    nop                             iaddiu vi06, vi00, 8
    subw.x vf31, vf00, vf00w        bal vi13, pass_a_to_b
    nop                             iaddiu vi07, vi00, 1
    nop                             bal vi13, clip_edges
    nop                             nop
    nop                             bal vi13, close_polygon
    nop                             iaddiu vi09, vi00, 975
    nop                             iaddiu vi05, vi00, 256
    nop                             iaddiu vi06, vi00, 4
    addw.x vf31, vf00, vf00w        bal vi13, pass_b_to_a
    nop                             iaddiu vi07, vi00, 1
    nop                             bal vi13, clip_edges
    nop                             nop
    nop                             bal vi13, close_polygon
    nop                             iaddiu vi09, vi00, 935
    nop                             iaddiu vi09, vi00, 935
    nop                             iaddiu vi10, vi00, 975
    nop                             iadd vi04, vi00, vi11
    nop                             iaddiu vi11, vi00, 0
    nop                             ilw.x vi12, 934(vi00)
    nop                             ilwr.y vi06, (vi02)
    nop                             lq.xyzw vf31, 934(vi00)
    nop                             lq.xyzw vf27, 12(vi00)
    nop                             lq.xyzw vf28, 13(vi00)
    nop                             iadd vi12, vi12, vi04
    nop                             iadd vi06, vi06, vi03
    nop                             iaddiu vi02, vi06, 0
    nop                             sqi.xyzw vf31, (vi06++)
    nop                             lq.xyzw vf29, 14(vi00)
    nop                             lq.xyzw vf30, 15(vi00)
    nop                             xgkick vi02                          ; send the output to the GS (PATH1)
    nop                             nop
    nop                             isw.x vi12, -1(vi06)
clip_triangle_loop:
    nop                             lqi.xyzw vf24, (vi09++)
    nop                             lqi.xyzw vf25, (vi09++)
    nop                             lqi.xyzw vf26, (vi09++)
    nop                             nop
    mulax.xyzw ACC, vf27, vf24x     nop
    madday.xyzw ACC, vf28, vf24y    nop
    maddaz.xyzw ACC, vf29, vf24z    nop
    maddw.xyzw vf23, vf30, vf24w    loi 128.0                            ; I = 128.0: the colour clamp (0x80 is 1.0 on the GS)
    minii.xyz vf25, vf25, I         nop
    nop                             nop
    nop                             nop
    nop                             div Q, vf00w, vf23w                  ; Q = 1 / vf23.w
    ftoi0.xyzw vf25, vf25           waitq
    mulq.xyzw vf23, vf23, Q         nop
    mulq.xyz vf26, vf26, Q          nop
    nop                             nop
    nop                             iaddi vi04, vi04, -1
    ftoi4.xyzw vf23, vf23           iaddiu vi06, vi06, 3                 ; to 12.4 fixed point (GS XYZ)
    nop                             sq.xyzw vf26, -3(vi06)
    nop                             sq.xyzw vf25, -2(vi06)
    nop                             ibne vi04, vi00, clip_triangle_loop
    nop                             sq.xyzw vf23, -1(vi06)
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             xgkick vi02                          ; send the output to the GS (PATH1)
clip_triangle_exit:
    nop                             ilwr.x vi10, (vi14)
    nop                             ilwr.y vi11, (vi14)
    nop                             ilwr.z vi12, (vi14)
    nop                             ilwr.w vi13, (vi14)
    nop                             iaddiu vi14, vi14, 1
    nop                             ilwr.x vi06, (vi14)
    nop                             ilwr.y vi07, (vi14)
    nop                             ilwr.z vi08, (vi14)
    nop                             ilwr.w vi09, (vi14)
    nop                             iaddiu vi14, vi14, 1
    nop                             ilwr.x vi02, (vi14)
    nop                             ilwr.y vi03, (vi14)
    nop                             ilwr.z vi04, (vi14)
    nop                             ilwr.w vi05, (vi14)
    nop                             iaddiu vi14, vi14, 1
    nop                             lqi.xyzw vf31, (vi14++)
    nop                             lqi.xyzw vf30, (vi14++)
    nop                             lqi.xyzw vf29, (vi14++)
    nop                             lqi.xyzw vf28, (vi14++)
    nop                             lqi.xyzw vf27, (vi14++)
    nop                             lqi.xyzw vf26, (vi14++)
    nop                             lqi.xyzw vf25, (vi14++)
    nop                             lqi.xyzw vf24, (vi14++)
    nop                             lqi.xyzw vf23, (vi14++)
    nop                             lqi.xyzw vf22, (vi14++)
    nop                             lqi.xyzw vf21, (vi14++)
    nop                             jr vi15
    nop                             nop

    ; after a plane: repeat the first output vertex after the last; an empty polygon leaves
    ; (clip_triangle_exit)
close_polygon:
    nop                             lqi.xyzw vf29, (vi09++)
    nop                             lqi.xyzw vf30, (vi09++)
    nop                             lqi.xyzw vf31, (vi09++)
    nop                             nop
    nop                             sqi.xyzw vf29, (vi10++)
    nop                             sqi.xyzw vf30, (vi10++)
    nop                             ibeq vi11, vi00, clip_triangle_exit
    nop                             sqi.xyzw vf31, (vi10++)
    nop                             jr vi13
    nop                             nop

    ; the next plane reads the polygon at VU 935.. and writes the one at 975.. (as set at
    ; clip_triangle)
pass_a_to_b:
    nop                             iaddiu vi09, vi00, 935
    nop                             b pass_start
    nop                             iaddiu vi10, vi00, 975

    ; the next plane reads the second polygon buffer and writes the first
pass_b_to_a:
    nop                             iaddiu vi09, vi00, 975
    nop                             iaddiu vi10, vi00, 935

    ; vi04: the vertices to clip; vi11: none written yet
pass_start:
    nop                             iadd vi04, vi00, vi11
    nop                             iaddiu vi11, vi00, 0

    ; load the polygon's first vertex (three qwords)
first_vertex:
    nop                             lqi.xyzw vf21, (vi09++)
    nop                             lqi.xyzw vf22, (vi09++)
    nop                             jr vi13
    nop                             lqi.xyzw vf23, (vi09++)

    ; clip the polygon's edges against one plane (vi05, vi06: its clip-flag bits; vf31.x its
    ; sign)
clip_edges:
    mulw.xyzw vf24, vf21, vf00w     lqi.xyzw vf21, (vi09++)
    mulw.xyzw vf25, vf22, vf00w     lqi.xyzw vf22, (vi09++)
    mulw.xyzw vf26, vf23, vf00w     lqi.xyzw vf23, (vi09++)
    nop                             nop
    clipw.xyz vf24, vf24w           nop                                  ; clip flags: vf24.xyz against +-vf24.w
    clipw.xyz vf21, vf21w           nop
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             fcget vi01
    nop                             nop
    nop                             iand vi12, vi01, vi05
    nop                             nop
    nop                             ibeq vi12, vi00, clip_edges_skip
    nop                             nop
    nop                             iand vi12, vi01, vi06
    nop                             nop
    nop                             ibne vi12, vi00, clip_edges_skip3
    nop                             nop
    nop                             bal vi01, intersect
    nop                             nop
    nop                             sqi.xyzw vf28, (vi10++)
    nop                             sqi.xyzw vf29, (vi10++)
    nop                             sqi.xyzw vf30, (vi10++)
    nop                             b clip_edges_skip3
    nop                             iaddiu vi11, vi11, 1
clip_edges_skip:
    nop                             iand vi12, vi01, vi06
    nop                             nop
    nop                             ibeq vi12, vi00, clip_edges_skip2
    nop                             nop
    nop                             bal vi01, intersect
    nop                             nop
    nop                             sqi.xyzw vf24, (vi10++)
    nop                             sqi.xyzw vf25, (vi10++)
    nop                             sqi.xyzw vf26, (vi10++)
    nop                             sqi.xyzw vf28, (vi10++)
    nop                             sqi.xyzw vf29, (vi10++)
    nop                             sqi.xyzw vf30, (vi10++)
    nop                             b clip_edges_skip3
    nop                             iaddiu vi11, vi11, 2
clip_edges_skip2:
    nop                             sqi.xyzw vf24, (vi10++)
    nop                             sqi.xyzw vf25, (vi10++)
    nop                             sqi.xyzw vf26, (vi10++)
    nop                             iaddiu vi11, vi11, 1
clip_edges_skip3:
    nop                             isubiu vi04, vi04, 1
    nop                             nop
    nop                             ibne vi04, vi00, clip_edges
    nop                             nop
    nop                             jr vi13
    nop                             nop

    ; an edge crosses the plane: write the intersection (position and attributes interpolated)
intersect:
    mulx.w vf28, vf24, vf31x        nop
    mulx.w vf29, vf21, vf31x        nop
    nop                             nop
    nop                             nop
    subw.xyzw vf28, vf24, vf28w     nop
    subw.xyzw vf29, vf21, vf29w     nop
    nop                             iadd vi12, vi00, vi07
    nop                             nop
intersect_loop:
    nop                             ibeq vi12, vi00, intersect_skip
    nop                             nop
    nop                             mr32.xyzw vf28, vf28
    nop                             mr32.xyzw vf29, vf29
    nop                             isubiu vi12, vi12, 1
    nop                             nop
    nop                             b intersect_loop
    nop                             nop
intersect_skip:
    sub.xyz vf30, vf29, vf28        nop
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             div Q, vf28x, vf30x
    nop                             waitq
    addq.x vf27, vf00, Q            nop
    sub.xyzw vf28, vf21, vf24       nop
    sub.xyzw vf29, vf22, vf25       nop
    sub.xyzw vf30, vf23, vf26       nop
    abs.x vf27, vf27                nop
    nop                             nop
    nop                             nop
    nop                             nop
    mulx.xyzw vf28, vf28, vf27x     nop
    mulx.xyzw vf29, vf29, vf27x     nop
    mulx.xyzw vf30, vf30, vf27x     nop
    nop                             nop
    add.xyzw vf28, vf28, vf24       nop
    add.xyzw vf29, vf29, vf25       nop
    add.xyzw vf30, vf30, vf26       nop
    nop                             nop
    nop                             jr vi01
    nop                             nop
.endprogram

;=======================================================================================
; Vu1Prog57: fog, gMtxUv rows, clipped
;
; gVu1ProgInfo57 (bones.c): 467 pairs (3736 bytes), batches of up to 3200 bytes;
; Vu1_SelectProgram's key 0xc080, rigid models (0x21035, 0x121035).
; Setup Vu1Pkt_DEP: an UNPACK of 17 qwords to VU 0, then MSCALF 0:
;   0        colour: gGsColorF, RGB scaled by the model's brightness
;   1-4      gMtxSlots x gMtxView x gMtxProjClip: model to screen (XYZ after the divide by w): vf01-vf04
;   5-8      the matrix above x gViewportMtx: model to the clip test's space: vf05-vf08
;   9        fog range: gGsFogFar and the word after it: vf09, vf26
;   10-12    rows 0, 1 and 3 of gMtxUv (Vu1_PutUvMatrix): vf10-vf12
;   13-16    gMtxProj, the projection matrix: vf27-vf30
; Vertices: gVu1ProgLayouts[5], 3 qwords: position, colour, texture coordinates.
; Batches at VU 0x11 and 0x11 + 0x1c0 (XTOP); the output follows each.
;=======================================================================================
.program Vu1Prog57
.base 0x11
.offset 0x1c0
.stcycl 4, 4
.unpack 0x3a6, 0x00008000, 0x303ec000, 0x00000412, 0x00000000   ; GIF tag template: EOP, PRIM 0x7d, REGS ST RGBAQ XYZF2

    ; MSCALF 0: the setup's constants into registers
init:
    nop                             lq.xyzw vf01, 1(vi00)
    nop                             lq.xyzw vf02, 2(vi00)
    nop                             lq.xyzw vf03, 3(vi00)
    nop                             lq.xyzw vf04, 4(vi00)
    nop                             lq.xyzw vf05, 5(vi00)
    nop                             lq.xyzw vf06, 6(vi00)
    nop                             lq.xyzw vf07, 7(vi00)
    nop                             lq.xyzw vf08, 8(vi00)
    nop                             lq.xyzw vf09, 9(vi00)
    nop                             lq.xyzw vf10, 10(vi00)
    nop                             lq.xyzw vf11, 11(vi00)
    nop                             lq.xyzw vf12, 12(vi00)
    nop                             nop                               [E] ; end: constants loaded
    nop                             nop

    ; MSCNT: one batch at XTOP; qword 0's x is its type, qword 1 a GIF tag
batch:
    nop                             xtop vi02                            ; vi02: the batch (BASE, or BASE + OFFSET: double buffer)
    nop                             iaddiu vi05, vi02, 0
    nop                             iaddiu vi03, vi02, 200               ; vi03: the output, 200 qwords after the batch
    nop                             ilwr.x vi06, (vi05)                  ; the batch type (qword 0)
    nop                             iaddiu vi05, vi05, 1
    nop                             ilwr.x vi08, (vi05)                  ; the GIF tag (qword 1): NLOOP, EOP
    nop                             iaddiu vi04, vi03, 0
    nop                             iaddiu vi11, vi00, 32767             ; 0x7FFF: the NLOOP mask
    nop                             lq.xyzw vf31, 0(vi05)
    nop                             iand vi07, vi11, vi08
    nop                             iaddiu vi11, vi00, 1
    nop                             iaddiu vi05, vi05, 1
    nop                             ibeq vi11, vi06, vertices
    nop                             sqi.xyzw vf31, (vi04++)

    ; a register block: the GIF tag and its NLOOP qwords (A+D) go through to the output
copy_regs:
    nop                             lq.xyzw vf31, 0(vi05)
    nop                             iaddi vi07, vi07, -1
    nop                             iaddiu vi05, vi05, 1
    nop                             iaddiu vi04, vi04, 1
    nop                             ibne vi07, vi00, copy_regs
    nop                             sq.xyzw vf31, -1(vi04)
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             nop                               [E] ; end: the next MSCNT continues at copy_regs_cont
    nop                             nop

    ; the next MSCNT continues here
copy_regs_cont:
    nop                             b batch                              ; the next batch
    nop                             nop

    ; type 1: a strip of NLOOP vertices
vertices:
    nop                             iaddiu vi08, vi08, 2                 ; NLOOP + 2: the delay line's last vertices go out first
    nop                             isw.x vi08, -1(vi04)
    nop                             lq.xyzw vf13, 917(vi00)
    nop                             lq.xyzw vf14, 918(vi00)
    nop                             lq.xyzw vf15, 919(vi00)
    nop                             lq.xyzw vf16, 914(vi00)
    nop                             lq.xyzw vf17, 915(vi00)
    nop                             lq.xyzw vf18, 916(vi00)
    nop                             lq.xyzw vf29, 0(vi05)
    nop                             sqi.xyzw vf13, (vi04++)
    nop                             sqi.xyzw vf14, (vi04++)
    nop                             sqi.xyzw vf15, (vi04++)
    mulax.xyzw ACC, vf01, vf29x     lq.xyzw vf31, 2(vi05)
    madday.xyzw ACC, vf02, vf29y    sqi.xyzw vf16, (vi04++)
    maddaz.xyzw ACC, vf03, vf29z    sqi.xyzw vf17, (vi04++)
    maddw.xyzw vf28, vf04, vf00w    lq.xyzw vf30, 1(vi05)
    mulax.xy ACC, vf10, vf31x       lq.xyzw vf13, 1020(vi00)
    madday.xy ACC, vf11, vf31y      lq.xyzw vf14, 1017(vi00)
    maddw.xy vf31, vf12, vf00w      lq.xyzw vf15, 1019(vi00)
    ftoi0.xyzw vf30, vf30           div Q, vf00w, vf28w                  ; Q = 1 / vf28.w
    clipw.xyz vf13, vf13w           ilw.w vi09, 0(vi05)                  ; vi09: the position's w word, XYZF2's w (F, ADC) as the model has it
    clipw.xyz vf14, vf14w           sqi.xyzw vf18, (vi04++)              ; clip flags: vf14.xyz against +-vf14.w
    mulax.xyzw ACC, vf05, vf29x     iaddiu vi05, vi05, 3
    madday.xyzw ACC, vf06, vf29y    lq.xyzw vf16, 1016(vi00)
    maddaz.xyzw ACC, vf07, vf29z    lq.xyzw vf17, 1018(vi00)
    maddw.xyzw vf27, vf08, vf00w    lq.xyzw vf18, 1015(vi00)
    mulq.xyz vf28, vf28, Q          iaddiu vi14, vi09, 0
    ; one vertex per pass, software-pipelined through the delay line
vertices_loop:
    nop                             sq.xyzw vf13, 1023(vi00)
    mulq.xyz vf26, vf31, Q          sq.xyzw vf14, 1020(vi00)
    nop                             sq.xyzw vf15, 1022(vi00)
    clipw.xyz vf27, vf27w           sq.xyzw vf16, 1019(vi00)
    ftoi4.xyz vf28, vf28            sq.xyzw vf17, 1021(vi00)
    nop                             sq.xyzw vf18, 1018(vi00)
    nop                             sq.xyzw vf31, 1015(vi00)
    nop                             sq.xyzw vf30, 1016(vi00)
    subw.x vf25, vf09, vf28w        sq.xyzw vf30, 1(vi04)
    nop                             sq.xyzw vf27, 1017(vi00)
    nop                             lq.xyzw vf31, 2(vi05)
    nop                             sq.xyzw vf26, 0(vi04)
    nop                             ibne vi14, vi00, vertices_in_view
    nop                             sq.xyz vf28, 2(vi04)
    nop                             fcand vi01, 0x03ffff                 ; vi01 = 1: one of the last three vertices is outside the clip volume
    nop                             ibeq vi01, vi00, vertices_in_view
    nop                             nop
    nop                             ibne vi14, vi00, vertices_in_view
    nop                             fcor vi01, 0xfdf7df
    nop                             ibne vi01, vi00, vertices_culled
    nop                             fcor vi01, 0xfefbef
    nop                             ibne vi01, vi00, vertices_culled
    nop                             fcor vi01, 0xff7df7
    nop                             ibne vi01, vi00, vertices_culled
    nop                             fcor vi01, 0xffbefb
    nop                             ibne vi01, vi00, vertices_culled
    nop                             fcor vi01, 0xffdf7d
    nop                             ibne vi01, vi00, vertices_culled
    nop                             fcor vi01, 0xffefbe
    nop                             ibne vi01, vi00, vertices_culled
    nop                             nop
    nop                             bal vi15, clip_triangle
    nop                             nop
    ; the triangle is wholly outside one plane: culled
vertices_culled:
    nop                             iaddiu vi14, vi00, 32767             ; ADC: 0x7FFF + 1 = 0x8000, so the GS draws no triangle ending here
    nop                             iaddiu vi14, vi14, 1
    ; the last three vertices are all inside the clip volume
vertices_in_view:
    muly.x vf25, vf25, vf09y        ilw.w vi09, 0(vi05)
    mulax.xy ACC, vf10, vf31x       lq.xyzw vf29, 0(vi05)
    madday.xy ACC, vf11, vf31y      lq.xyzw vf30, 1(vi05)
    maddw.xy vf31, vf12, vf00w      loi 255.0                            ; I = 255.0
    muli.x vf25, vf25, I            iaddiu vi05, vi05, 3
    mulax.xyzw ACC, vf01, vf29x     lq.xyzw vf13, 1020(vi00)
    madday.xyzw ACC, vf02, vf29y    lq.xyzw vf14, 1017(vi00)
    maddaz.xyzw ACC, vf03, vf29z    lq.xyzw vf15, 1019(vi00)
    minii.x vf25, vf25, I           lq.xyzw vf16, 1016(vi00)
    maddw.xyzw vf28, vf04, vf00w    lq.xyzw vf17, 1018(vi00)
    clipw.xyz vf13, vf13w           lq.xyzw vf18, 1015(vi00)
    clipw.xyz vf14, vf14w           iaddiu vi12, vi14, 0
    maxx.x vf25, vf25, vf00x        iaddiu vi14, vi09, 0
    mulax.xyzw ACC, vf05, vf29x     div Q, vf00w, vf28w
    madday.xyzw ACC, vf06, vf29y    iaddi vi07, vi07, -1
    maddaz.xyzw ACC, vf07, vf29z    iaddiu vi04, vi04, 3
    ftoi4.x vf25, vf25              nop
    maddw.xyzw vf27, vf08, vf00w    nop
    ftoi0.xyzw vf30, vf30           nop
    nop                             nop
    mulq.xyz vf28, vf28, Q          mtir vi13, vf25x
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             iadd vi12, vi12, vi13
    nop                             ibne vi07, vi00, vertices_loop
    nop                             isw.w vi12, -1(vi04)
    ; the epilogue: the vertices left in the delay line
    nop                             lqd.xyzw vf13, (--vi04)
    nop                             lqd.xyzw vf14, (--vi04)
    nop                             lqd.xyzw vf15, (--vi04)
    nop                             lqd.xyzw vf16, (--vi04)
    nop                             lqd.xyzw vf17, (--vi04)
    nop                             lqd.xyzw vf18, (--vi04)
    nop                             sq.xyzw vf13, 916(vi00)
    nop                             sq.xyzw vf14, 915(vi00)
    nop                             sq.xyzw vf15, 914(vi00)
    nop                             sq.xyzw vf16, 919(vi00)
    nop                             sq.xyzw vf17, 918(vi00)
    nop                             sq.xyzw vf18, 917(vi00)
    nop                             xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             nop                               [E] ; end: the next MSCNT continues at vertices_cont
    nop                             nop

    ; the next MSCNT continues here
vertices_cont:
    nop                             b batch                              ; the next batch
    nop                             nop

    ; clip the last three vertices' triangle against the six planes of the clip volume and
    ; send what is left as a fan (the GIF tag template at VU 0x3A6)
clip_triangle:
    nop                             iaddiu vi14, vi00, 934
    nop                             sqd.xyzw vf21, (--vi14)
    nop                             sqd.xyzw vf22, (--vi14)
    nop                             sqd.xyzw vf23, (--vi14)
    nop                             sqd.xyzw vf24, (--vi14)
    nop                             sqd.xyzw vf25, (--vi14)
    nop                             sqd.xyzw vf26, (--vi14)
    nop                             sqd.xyzw vf27, (--vi14)
    nop                             sqd.xyzw vf28, (--vi14)
    nop                             sqd.xyzw vf29, (--vi14)
    nop                             sqd.xyzw vf30, (--vi14)
    nop                             sqd.xyzw vf31, (--vi14)
    nop                             isubiu vi14, vi14, 1
    nop                             iswr.x vi02, (vi14)
    nop                             iswr.y vi03, (vi14)
    nop                             iswr.z vi04, (vi14)
    nop                             iswr.w vi05, (vi14)
    nop                             isubiu vi14, vi14, 1
    nop                             iswr.x vi06, (vi14)
    nop                             iswr.y vi07, (vi14)
    nop                             iswr.z vi08, (vi14)
    nop                             iswr.w vi09, (vi14)
    nop                             isubiu vi14, vi14, 1
    nop                             iswr.x vi10, (vi14)
    nop                             iswr.y vi11, (vi14)
    nop                             iswr.z vi12, (vi14)
    nop                             iswr.w vi13, (vi14)
    nop                             iaddiu vi08, vi00, 0
    nop                             iaddiu vi09, vi00, 935
    nop                             iaddiu vi10, vi00, 975
    nop                             lq.xyzw vf23, 1022(vi00)
    nop                             lq.xyzw vf24, 1019(vi00)
    nop                             lq.xyzw vf25, 1016(vi00)
    nop                             lq.xyzw vf26, 1021(vi00)
    itof0.xyzw vf23, vf23           lq.xyzw vf27, 1018(vi00)
    itof0.xyzw vf24, vf24           lq.xyzw vf28, 1015(vi00)
    itof0.xyzw vf25, vf25           lq.xyzw vf29, 1023(vi00)
    nop                             lq.xyzw vf30, 1020(vi00)
    nop                             lq.xyzw vf31, 1017(vi00)
    nop                             sq.xyzw vf23, 1(vi09)
    nop                             sq.xyzw vf24, 4(vi09)
    nop                             sq.xyzw vf25, 7(vi09)
    nop                             sq.xyzw vf23, 10(vi09)
    nop                             sq.xyzw vf26, 2(vi09)
    nop                             sq.xyzw vf27, 5(vi09)
    nop                             sq.xyzw vf28, 8(vi09)
    nop                             sq.xyzw vf26, 11(vi09)
    nop                             sq.xyzw vf29, 0(vi09)
    nop                             sq.xyzw vf30, 3(vi09)
    nop                             sq.xyzw vf31, 6(vi09)
    nop                             sq.xyzw vf29, 9(vi09)
    nop                             iaddiu vi09, vi00, 935
    nop                             iaddiu vi10, vi00, 975
    nop                             iaddiu vi05, vi00, 2048
    nop                             iaddiu vi06, vi00, 32
    subw.x vf31, vf00, vf00w        bal vi13, first_vertex
    nop                             iaddiu vi07, vi00, 2
    nop                             iaddiu vi04, vi00, 3
    nop                             iaddiu vi11, vi00, 0
    nop                             bal vi13, clip_edges
    nop                             nop
    nop                             bal vi13, close_polygon
    nop                             iaddiu vi09, vi00, 975
    nop                             iaddiu vi09, vi00, 975
    nop                             iaddiu vi10, vi00, 935
    nop                             iaddiu vi05, vi00, 1024
    nop                             iaddiu vi06, vi00, 16
    addw.x vf31, vf00, vf00w        bal vi13, pass_start
    nop                             iaddiu vi07, vi00, 2
    nop                             bal vi13, clip_edges
    nop                             nop
    nop                             bal vi13, close_polygon
    nop                             iaddiu vi09, vi00, 935
    nop                             iaddiu vi05, vi00, 128
    nop                             iaddiu vi06, vi00, 2
    subw.x vf31, vf00, vf00w        bal vi13, pass_a_to_b
    nop                             iaddiu vi07, vi00, 0
    nop                             bal vi13, clip_edges
    nop                             nop
    nop                             bal vi13, close_polygon
    nop                             iaddiu vi09, vi00, 975
    nop                             iaddiu vi05, vi00, 64
    nop                             iaddiu vi06, vi00, 1
    addw.x vf31, vf00, vf00w        bal vi13, pass_b_to_a
    nop                             iaddiu vi07, vi00, 0
    nop                             bal vi13, clip_edges
    nop                             nop
    nop                             bal vi13, close_polygon
    nop                             iaddiu vi09, vi00, 935
    nop                             iaddiu vi05, vi00, 512
    nop                             iaddiu vi06, vi00, 8
    subw.x vf31, vf00, vf00w        bal vi13, pass_a_to_b
    nop                             iaddiu vi07, vi00, 1
    nop                             bal vi13, clip_edges
    nop                             nop
    nop                             bal vi13, close_polygon
    nop                             iaddiu vi09, vi00, 975
    nop                             iaddiu vi05, vi00, 256
    nop                             iaddiu vi06, vi00, 4
    addw.x vf31, vf00, vf00w        bal vi13, pass_b_to_a
    nop                             iaddiu vi07, vi00, 1
    nop                             bal vi13, clip_edges
    nop                             nop
    nop                             bal vi13, close_polygon
    nop                             iaddiu vi09, vi00, 935
    nop                             iaddiu vi09, vi00, 935
    nop                             iaddiu vi10, vi00, 975
    nop                             iadd vi04, vi00, vi11
    nop                             iaddiu vi11, vi00, 0
    nop                             ilwr.y vi06, (vi02)
    nop                             lq.xyzw vf31, 934(vi00)
    nop                             lq.xyzw vf26, 9(vi00)
    nop                             lq.xyzw vf27, 13(vi00)
    nop                             ilw.x vi12, 934(vi00)
    nop                             iadd vi06, vi06, vi03
    nop                             iaddiu vi02, vi06, 0
    nop                             sqi.xyzw vf31, (vi06++)
    nop                             iadd vi12, vi12, vi04
    nop                             lq.xyzw vf28, 14(vi00)
    nop                             lq.xyzw vf29, 15(vi00)
    nop                             lq.xyzw vf30, 16(vi00)
    nop                             xgkick vi02                          ; send the output to the GS (PATH1)
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             isw.x vi12, -1(vi06)
    nop                             nop
clip_triangle_loop:
    nop                             lqi.xyzw vf23, (vi09++)
    nop                             lqi.xyzw vf24, (vi09++)
    nop                             lqi.xyzw vf25, (vi09++)
    nop                             nop
    mulax.xyzw ACC, vf27, vf23x     nop
    madday.xyzw ACC, vf28, vf23y    nop
    maddaz.xyzw ACC, vf29, vf23z    nop
    maddw.xyzw vf23, vf30, vf23w    loi 128.0                            ; I = 128.0: the colour clamp (0x80 is 1.0 on the GS)
    minii.xyz vf24, vf24, I         nop
    nop                             nop
    nop                             nop
    nop                             div Q, vf00w, vf23w                  ; Q = 1 / vf23.w
    ftoi0.xyzw vf24, vf24           waitq
    mulq.xyz vf23, vf23, Q          nop
    mulq.xyz vf25, vf25, Q          nop
    nop                             nop
    nop                             sq.xyzw vf24, 1(vi06)
    ftoi4.xyz vf23, vf23            nop
    nop                             sq.xyzw vf25, 0(vi06)
    nop                             nop
    nop                             nop
    nop                             sq.xyz vf23, 2(vi06)
    subw.x vf23, vf26, vf23w        nop
    nop                             nop
    nop                             nop
    nop                             nop
    muly.x vf23, vf23, vf26y        nop
    nop                             nop
    nop                             nop
    nop                             loi 255.0                            ; I = 255.0
    muli.x vf23, vf23, I            nop
    nop                             nop
    nop                             nop
    nop                             nop
    minii.x vf23, vf23, I           nop
    nop                             nop
    nop                             nop
    nop                             nop
    maxx.x vf23, vf23, vf00x        nop
    nop                             nop
    nop                             nop
    nop                             nop
    ftoi4.x vf23, vf23              nop
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             mtir vi13, vf23x
    nop                             iaddi vi04, vi04, -1
    nop                             iaddiu vi06, vi06, 3
    nop                             ibne vi04, vi00, clip_triangle_loop
    nop                             isw.w vi13, -1(vi06)
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             xgkick vi02                          ; send the output to the GS (PATH1)
    nop                             nop
clip_triangle_exit:
    nop                             ilwr.x vi10, (vi14)
    nop                             ilwr.y vi11, (vi14)
    nop                             ilwr.z vi12, (vi14)
    nop                             ilwr.w vi13, (vi14)
    nop                             iaddiu vi14, vi14, 1
    nop                             ilwr.x vi06, (vi14)
    nop                             ilwr.y vi07, (vi14)
    nop                             ilwr.z vi08, (vi14)
    nop                             ilwr.w vi09, (vi14)
    nop                             iaddiu vi14, vi14, 1
    nop                             ilwr.x vi02, (vi14)
    nop                             ilwr.y vi03, (vi14)
    nop                             ilwr.z vi04, (vi14)
    nop                             ilwr.w vi05, (vi14)
    nop                             iaddiu vi14, vi14, 1
    nop                             lqi.xyzw vf31, (vi14++)
    nop                             lqi.xyzw vf30, (vi14++)
    nop                             lqi.xyzw vf29, (vi14++)
    nop                             lqi.xyzw vf28, (vi14++)
    nop                             lqi.xyzw vf27, (vi14++)
    nop                             lqi.xyzw vf26, (vi14++)
    nop                             lqi.xyzw vf25, (vi14++)
    nop                             lqi.xyzw vf24, (vi14++)
    nop                             lqi.xyzw vf23, (vi14++)
    nop                             lqi.xyzw vf22, (vi14++)
    nop                             jr vi15
    nop                             lqi.xyzw vf21, (vi14++)

    ; after a plane: repeat the first output vertex after the last; an empty polygon leaves
    ; (clip_triangle_exit)
close_polygon:
    nop                             lqi.xyzw vf29, (vi09++)
    nop                             lqi.xyzw vf30, (vi09++)
    nop                             lqi.xyzw vf31, (vi09++)
    nop                             nop
    nop                             sqi.xyzw vf29, (vi10++)
    nop                             sqi.xyzw vf30, (vi10++)
    nop                             ibeq vi11, vi00, clip_triangle_exit
    nop                             sqi.xyzw vf31, (vi10++)
    nop                             jr vi13
    nop                             nop

    ; the next plane reads the polygon at VU 935.. and writes the one at 975.. (as set at
    ; clip_triangle)
pass_a_to_b:
    nop                             iaddiu vi09, vi00, 935
    nop                             b pass_start
    nop                             iaddiu vi10, vi00, 975

    ; the next plane reads the second polygon buffer and writes the first
pass_b_to_a:
    nop                             iaddiu vi09, vi00, 975
    nop                             iaddiu vi10, vi00, 935

    ; vi04: the vertices to clip; vi11: none written yet
pass_start:
    nop                             iadd vi04, vi00, vi11
    nop                             iaddiu vi11, vi00, 0

    ; load the polygon's first vertex (three qwords)
first_vertex:
    nop                             lqi.xyzw vf21, (vi09++)
    nop                             lqi.xyzw vf22, (vi09++)
    nop                             jr vi13
    nop                             lqi.xyzw vf23, (vi09++)

    ; clip the polygon's edges against one plane (vi05, vi06: its clip-flag bits; vf31.x its
    ; sign)
clip_edges:
    mulw.xyzw vf24, vf21, vf00w     lqi.xyzw vf21, (vi09++)
    mulw.xyzw vf25, vf22, vf00w     lqi.xyzw vf22, (vi09++)
    mulw.xyzw vf26, vf23, vf00w     lqi.xyzw vf23, (vi09++)
    nop                             nop
    clipw.xyz vf24, vf24w           nop                                  ; clip flags: vf24.xyz against +-vf24.w
    clipw.xyz vf21, vf21w           nop
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             fcget vi01
    nop                             nop
    nop                             iand vi12, vi01, vi05
    nop                             nop
    nop                             ibeq vi12, vi00, clip_edges_skip
    nop                             nop
    nop                             iand vi12, vi01, vi06
    nop                             nop
    nop                             ibne vi12, vi00, clip_edges_skip3
    nop                             nop
    nop                             bal vi01, intersect
    nop                             nop
    nop                             sqi.xyzw vf28, (vi10++)
    nop                             sqi.xyzw vf29, (vi10++)
    nop                             sqi.xyzw vf30, (vi10++)
    nop                             b clip_edges_skip3
    nop                             iaddiu vi11, vi11, 1
clip_edges_skip:
    nop                             iand vi12, vi01, vi06
    nop                             nop
    nop                             ibeq vi12, vi00, clip_edges_skip2
    nop                             nop
    nop                             bal vi01, intersect
    nop                             nop
    nop                             sqi.xyzw vf24, (vi10++)
    nop                             sqi.xyzw vf25, (vi10++)
    nop                             sqi.xyzw vf26, (vi10++)
    nop                             sqi.xyzw vf28, (vi10++)
    nop                             sqi.xyzw vf29, (vi10++)
    nop                             sqi.xyzw vf30, (vi10++)
    nop                             b clip_edges_skip3
    nop                             iaddiu vi11, vi11, 2
clip_edges_skip2:
    nop                             sqi.xyzw vf24, (vi10++)
    nop                             sqi.xyzw vf25, (vi10++)
    nop                             sqi.xyzw vf26, (vi10++)
    nop                             iaddiu vi11, vi11, 1
clip_edges_skip3:
    nop                             isubiu vi04, vi04, 1
    nop                             nop
    nop                             ibne vi04, vi00, clip_edges
    nop                             nop
    nop                             jr vi13
    nop                             nop

    ; an edge crosses the plane: write the intersection (position and attributes interpolated)
intersect:
    mulx.w vf28, vf24, vf31x        nop
    mulx.w vf29, vf21, vf31x        nop
    nop                             nop
    nop                             nop
    subw.xyzw vf28, vf24, vf28w     nop
    subw.xyzw vf29, vf21, vf29w     nop
    nop                             iadd vi12, vi00, vi07
    nop                             nop
intersect_loop:
    nop                             ibeq vi12, vi00, intersect_skip
    nop                             nop
    nop                             mr32.xyzw vf28, vf28
    nop                             mr32.xyzw vf29, vf29
    nop                             isubiu vi12, vi12, 1
    nop                             nop
    nop                             b intersect_loop
    nop                             nop
intersect_skip:
    sub.xyz vf30, vf29, vf28        nop
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             div Q, vf28x, vf30x
    nop                             waitq
    addq.x vf27, vf00, Q            nop
    sub.xyzw vf28, vf21, vf24       nop
    sub.xyzw vf29, vf22, vf25       nop
    sub.xyzw vf30, vf23, vf26       nop
    abs.x vf27, vf27                nop
    nop                             nop
    nop                             nop
    nop                             nop
    mulx.xyzw vf28, vf28, vf27x     nop
    mulx.xyzw vf29, vf29, vf27x     nop
    mulx.xyzw vf30, vf30, vf27x     nop
    nop                             nop
    add.xyzw vf28, vf28, vf24       nop
    add.xyzw vf29, vf29, vf25       nop
    add.xyzw vf30, vf30, vf26       jr vi01
    nop                             nop
.endprogram

;=======================================================================================
; Vu1Prog58: second colour, gMtxUv rows, clipped
;
; gVu1ProgInfo58 (bones.c): 497 pairs (3976 bytes), batches of up to 2880 bytes;
; Vu1_SelectProgram's key 0x24080, rigid models (0x21035, 0x121035).
; Setup Vu1Pkt_VEP: an UNPACK of 17 qwords to VU 0, then MSCALF 0:
;   0        colour: gGsColorF, RGB scaled by the model's brightness
;   1        second colour: gGsColor2F: vf13
;   2-5      gMtxSlots x gMtxView x gMtxProjClip: model to screen (XYZ after the divide by w): vf01-vf04
;   6-9      the matrix above x gViewportMtx: model to the clip test's space: vf05-vf08
;   10-12    rows 0, 1 and 3 of gMtxUv (Vu1_PutUvMatrix): vf09-vf11
;   13-16    gMtxProj, the projection matrix: vf12, vf27, vf28, vf29, vf30
; Vertices: gVu1ProgLayouts[5], 3 qwords: position, colour, texture coordinates.
; Batches at VU 0x11 and 0x11 + 0x1c0 (XTOP); the output follows each.
;=======================================================================================
.program Vu1Prog58
.base 0x11
.offset 0x1c0
.stcycl 4, 4
.unpack 0x3a6, 0x00008000, 0x302ec000, 0x00000412, 0x00000000   ; GIF tag template: EOP, PRIM 0x5d, REGS ST RGBAQ XYZF2

    ; MSCALF 0: the setup's constants into registers
init:
    nop                             lq.xyzw vf01, 2(vi00)
    nop                             lq.xyzw vf02, 3(vi00)
    nop                             lq.xyzw vf03, 4(vi00)
    nop                             lq.xyzw vf04, 5(vi00)
    nop                             lq.xyzw vf05, 6(vi00)
    nop                             lq.xyzw vf06, 7(vi00)
    nop                             lq.xyzw vf07, 8(vi00)
    nop                             lq.xyzw vf08, 9(vi00)
    nop                             lq.xyzw vf09, 10(vi00)
    nop                             lq.xyzw vf10, 11(vi00)
    nop                             lq.xyzw vf11, 12(vi00)
    nop                             lq.xyzw vf12, 13(vi00)
    nop                             lq.xyzw vf13, 1(vi00)
    nop                             nop                               [E] ; end: constants loaded
    nop                             nop

    ; MSCNT: one batch at XTOP; qword 0's x is its type, qword 1 a GIF tag
batch:
    nop                             xtop vi02                            ; vi02: the batch (BASE, or BASE + OFFSET: double buffer)
    nop                             iaddiu vi05, vi02, 0
    nop                             iaddiu vi03, vi02, 180               ; vi03: the output, 180 qwords after the batch
    nop                             iaddiu vi04, vi03, 0
    nop                             ilwr.x vi06, (vi05)                  ; the batch type (qword 0)
    nop                             iaddiu vi05, vi05, 1
    nop                             iaddiu vi11, vi00, 32767             ; 0x7FFF: the NLOOP mask
    nop                             lq.xyzw vf31, 0(vi05)
    nop                             ilwr.x vi08, (vi05)                  ; the GIF tag (qword 1): NLOOP, EOP
    nop                             iand vi07, vi11, vi08
    nop                             iaddiu vi05, vi05, 1
    nop                             sqi.xyzw vf31, (vi04++)
    nop                             iaddiu vi11, vi00, 1
    nop                             nop
    nop                             ibeq vi11, vi06, vertices
    nop                             nop

    ; a register block: the GIF tag and its NLOOP qwords (A+D) go through to the output
copy_regs:
    nop                             lq.xyzw vf30, 0(vi05)
    nop                             iaddi vi07, vi07, -1
    nop                             iaddiu vi05, vi05, 1
    nop                             iaddiu vi04, vi04, 1
    nop                             ibne vi07, vi00, copy_regs
    nop                             sq.xyzw vf30, -1(vi04)
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             nop                               [E] ; end: the next MSCNT continues at copy_regs_cont
    nop                             nop

    ; the next MSCNT continues here
copy_regs_cont:
    nop                             b batch                              ; the next batch
    nop                             nop

    ; type 1: a strip of NLOOP vertices
vertices:
    nop                             iaddiu vi08, vi08, 2                 ; NLOOP + 2: the delay line's last vertices go out first
    nop                             isw.x vi08, -1(vi04)
    nop                             lq.xyzw vf18, 917(vi00)
    nop                             lq.xyzw vf19, 918(vi00)
    nop                             lq.xyzw vf20, 919(vi00)
    nop                             lq.xyzw vf21, 914(vi00)
    nop                             lq.xyzw vf22, 915(vi00)
    nop                             lq.xyzw vf23, 916(vi00)
    nop                             sqi.xyzw vf18, (vi04++)
    nop                             sqi.xyzw vf19, (vi04++)
    nop                             sqi.xyzw vf20, (vi04++)
    nop                             sqi.xyzw vf21, (vi04++)
    nop                             sqi.xyzw vf22, (vi04++)
    nop                             sqi.xyzw vf23, (vi04++)
    ; one vertex per pass, software-pipelined through the delay line
vertices_loop:
    nop                             ilw.w vi09, 0(vi05)                  ; vi09: the position's w word, XYZF2's w (F, ADC) as the model has it
    nop                             lq.xyzw vf29, 0(vi05)
    nop                             lq.xyzw vf30, 1(vi05)
    nop                             lq.xyzw vf31, 2(vi05)
    nop                             iaddiu vi05, vi05, 3
    nop                             lq.xyzw vf18, 1020(vi00)
    nop                             lq.xyzw vf19, 1019(vi00)
    nop                             lq.xyzw vf20, 1018(vi00)
    nop                             lq.xyzw vf21, 1017(vi00)
    nop                             lq.xyzw vf22, 1016(vi00)
    nop                             lq.xyzw vf23, 1015(vi00)
    nop                             sq.xyzw vf18, 1023(vi00)
    nop                             sq.xyzw vf19, 1022(vi00)
    nop                             sq.xyzw vf20, 1021(vi00)
    nop                             sq.xyzw vf21, 1020(vi00)
    nop                             sq.xyzw vf22, 1019(vi00)
    nop                             sq.xyzw vf23, 1018(vi00)
    mul.xyzw vf25, vf30, vf13       nop
    nop                             nop
    nop                             nop
    nop                             nop
    ftoi0.xyzw vf25, vf25           nop
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             sq.xyzw vf25, 1016(vi00)
    nop                             sq.xyzw vf25, 1(vi04)
    mulax.xyzw ACC, vf01, vf29x     nop
    madday.xyzw ACC, vf02, vf29y    nop
    maddaz.xyzw ACC, vf03, vf29z    nop
    maddw.xyzw vf28, vf04, vf00w    nop
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             div Q, vf00w, vf28w                  ; Q = 1 / vf28.w
    mulax.xyzw ACC, vf05, vf29x     nop
    madday.xyzw ACC, vf06, vf29y    nop
    maddaz.xyzw ACC, vf07, vf29z    nop
    maddw.xyzw vf27, vf08, vf00w    nop
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             sq.xyzw vf27, 1017(vi00)
    clipw.xyz vf18, vf18w           nop                                  ; clip flags: vf18.xyz against +-vf18.w
    clipw.xyz vf21, vf21w           nop
    clipw.xyz vf27, vf27w           nop
    nop                             nop
    nop                             nop
    mulax.xy ACC, vf09, vf31x       nop
    madday.xy ACC, vf10, vf31y      nop
    maddw.xy vf31, vf11, vf00w      nop
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             sq.xyzw vf31, 1015(vi00)
    mulq.xyz vf28, vf28, Q          nop
    mulq.xyz vf26, vf31, Q          nop
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             ibne vi09, vi00, vertices_in_view
    nop                             nop
    nop                             fcand vi01, 0x03ffff                 ; vi01 = 1: one of the last three vertices is outside the clip volume
    nop                             ibeq vi01, vi00, vertices_in_view
    nop                             nop
    nop                             ibne vi09, vi00, vertices_in_view
    nop                             nop
    nop                             fcor vi01, 0xfdf7df
    nop                             ibne vi01, vi00, vertices_culled
    nop                             nop
    nop                             fcor vi01, 0xfefbef
    nop                             ibne vi01, vi00, vertices_culled
    nop                             nop
    nop                             fcor vi01, 0xff7df7
    nop                             ibne vi01, vi00, vertices_culled
    nop                             nop
    nop                             fcor vi01, 0xffbefb
    nop                             ibne vi01, vi00, vertices_culled
    nop                             nop
    nop                             fcor vi01, 0xffdf7d
    nop                             ibne vi01, vi00, vertices_culled
    nop                             nop
    nop                             fcor vi01, 0xffefbe
    nop                             ibne vi01, vi00, vertices_culled
    nop                             nop
    nop                             bal vi15, clip_triangle
    nop                             nop
    ; the triangle is wholly outside one plane: culled
vertices_culled:
    nop                             iaddiu vi09, vi00, 32767
    nop                             iaddiu vi09, vi09, 1
    ; the last three vertices are all inside the clip volume
vertices_in_view:
    ftoi4.xyz vf28, vf28            nop
    nop                             sq.xyzw vf26, 0(vi04)
    nop                             nop
    nop                             nop
    nop                             sq.xyz vf28, 2(vi04)
    subw.x vf24, vf12, vf28w        nop
    nop                             nop
    nop                             nop
    nop                             nop
    muly.x vf24, vf24, vf12y        nop
    nop                             nop
    nop                             nop
    nop                             loi 255.0                            ; I = 255.0
    muli.x vf24, vf24, I            nop
    nop                             nop
    nop                             nop
    nop                             nop
    minii.x vf24, vf24, I           nop
    nop                             nop
    nop                             nop
    nop                             nop
    maxx.x vf24, vf24, vf00x        nop
    nop                             nop
    nop                             nop
    nop                             nop
    ftoi4.x vf24, vf24              nop
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             mtir vi13, vf24x
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             iadd vi09, vi09, vi13
    nop                             isw.w vi09, 2(vi04)
    nop                             iaddiu vi04, vi04, 3
    nop                             iaddi vi07, vi07, -1
    nop                             nop
    nop                             ibne vi07, vi00, vertices_loop
    nop                             nop
    ; the epilogue: the vertices left in the delay line
    nop                             lqd.xyzw vf18, (--vi04)
    nop                             lqd.xyzw vf19, (--vi04)
    nop                             lqd.xyzw vf20, (--vi04)
    nop                             lqd.xyzw vf21, (--vi04)
    nop                             lqd.xyzw vf22, (--vi04)
    nop                             lqd.xyzw vf23, (--vi04)
    nop                             sq.xyzw vf18, 916(vi00)
    nop                             sq.xyzw vf19, 915(vi00)
    nop                             sq.xyzw vf20, 914(vi00)
    nop                             sq.xyzw vf21, 919(vi00)
    nop                             sq.xyzw vf22, 918(vi00)
    nop                             sq.xyzw vf23, 917(vi00)
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             nop
    nop                             nop                               [E] ; end: the next MSCNT continues at vertices_cont
    nop                             nop

    ; the next MSCNT continues here
vertices_cont:
    nop                             b batch                              ; the next batch
    nop                             nop

    ; clip the last three vertices' triangle against the six planes of the clip volume and
    ; send what is left as a fan (the GIF tag template at VU 0x3A6)
clip_triangle:
    nop                             iaddiu vi14, vi00, 934
    nop                             sqd.xyzw vf21, (--vi14)
    nop                             sqd.xyzw vf22, (--vi14)
    nop                             sqd.xyzw vf23, (--vi14)
    nop                             sqd.xyzw vf24, (--vi14)
    nop                             sqd.xyzw vf25, (--vi14)
    nop                             sqd.xyzw vf26, (--vi14)
    nop                             sqd.xyzw vf27, (--vi14)
    nop                             sqd.xyzw vf28, (--vi14)
    nop                             sqd.xyzw vf29, (--vi14)
    nop                             sqd.xyzw vf30, (--vi14)
    nop                             sqd.xyzw vf31, (--vi14)
    nop                             isubiu vi14, vi14, 1
    nop                             iswr.x vi02, (vi14)
    nop                             iswr.y vi03, (vi14)
    nop                             iswr.z vi04, (vi14)
    nop                             iswr.w vi05, (vi14)
    nop                             isubiu vi14, vi14, 1
    nop                             iswr.x vi06, (vi14)
    nop                             iswr.y vi07, (vi14)
    nop                             iswr.z vi08, (vi14)
    nop                             iswr.w vi09, (vi14)
    nop                             isubiu vi14, vi14, 1
    nop                             iswr.x vi10, (vi14)
    nop                             iswr.y vi11, (vi14)
    nop                             iswr.z vi12, (vi14)
    nop                             iswr.w vi13, (vi14)
    nop                             iaddiu vi08, vi00, 0
    nop                             iaddiu vi09, vi00, 935
    nop                             iaddiu vi10, vi00, 975
    nop                             lq.xyzw vf23, 1022(vi00)
    nop                             lq.xyzw vf24, 1019(vi00)
    nop                             lq.xyzw vf25, 1016(vi00)
    nop                             lq.xyzw vf26, 1021(vi00)
    itof0.xyzw vf23, vf23           lq.xyzw vf27, 1018(vi00)
    itof0.xyzw vf24, vf24           lq.xyzw vf28, 1015(vi00)
    itof0.xyzw vf25, vf25           lq.xyzw vf29, 1023(vi00)
    nop                             lq.xyzw vf30, 1020(vi00)
    nop                             lq.xyzw vf31, 1017(vi00)
    nop                             sq.xyzw vf23, 1(vi09)
    nop                             sq.xyzw vf24, 4(vi09)
    nop                             sq.xyzw vf25, 7(vi09)
    nop                             sq.xyzw vf23, 10(vi09)
    nop                             sq.xyzw vf26, 2(vi09)
    nop                             sq.xyzw vf27, 5(vi09)
    nop                             sq.xyzw vf28, 8(vi09)
    nop                             sq.xyzw vf26, 11(vi09)
    nop                             sq.xyzw vf29, 0(vi09)
    nop                             sq.xyzw vf30, 3(vi09)
    nop                             sq.xyzw vf31, 6(vi09)
    nop                             sq.xyzw vf29, 9(vi09)
    nop                             iaddiu vi09, vi00, 935
    nop                             iaddiu vi10, vi00, 975
    nop                             iaddiu vi05, vi00, 2048
    nop                             iaddiu vi06, vi00, 32
    subw.x vf31, vf00, vf00w        bal vi13, first_vertex
    nop                             iaddiu vi07, vi00, 2
    nop                             iaddiu vi04, vi00, 3
    nop                             iaddiu vi11, vi00, 0
    nop                             bal vi13, clip_edges
    nop                             nop
    nop                             bal vi13, close_polygon
    nop                             iaddiu vi09, vi00, 975
    nop                             iaddiu vi09, vi00, 975
    nop                             iaddiu vi10, vi00, 935
    nop                             iaddiu vi05, vi00, 1024
    nop                             iaddiu vi06, vi00, 16
    addw.x vf31, vf00, vf00w        bal vi13, pass_start
    nop                             iaddiu vi07, vi00, 2
    nop                             bal vi13, clip_edges
    nop                             nop
    nop                             bal vi13, close_polygon
    nop                             iaddiu vi09, vi00, 935
    nop                             iaddiu vi05, vi00, 128
    nop                             iaddiu vi06, vi00, 2
    subw.x vf31, vf00, vf00w        bal vi13, pass_a_to_b
    nop                             iaddiu vi07, vi00, 0
    nop                             bal vi13, clip_edges
    nop                             nop
    nop                             bal vi13, close_polygon
    nop                             iaddiu vi09, vi00, 975
    nop                             iaddiu vi05, vi00, 64
    nop                             iaddiu vi06, vi00, 1
    addw.x vf31, vf00, vf00w        bal vi13, pass_b_to_a
    nop                             iaddiu vi07, vi00, 0
    nop                             bal vi13, clip_edges
    nop                             nop
    nop                             bal vi13, close_polygon
    nop                             iaddiu vi09, vi00, 935
    nop                             iaddiu vi05, vi00, 512
    nop                             iaddiu vi06, vi00, 8
    subw.x vf31, vf00, vf00w        bal vi13, pass_a_to_b
    nop                             iaddiu vi07, vi00, 1
    nop                             bal vi13, clip_edges
    nop                             nop
    nop                             bal vi13, close_polygon
    nop                             iaddiu vi09, vi00, 975
    nop                             iaddiu vi05, vi00, 256
    nop                             iaddiu vi06, vi00, 4
    addw.x vf31, vf00, vf00w        bal vi13, pass_b_to_a
    nop                             iaddiu vi07, vi00, 1
    nop                             bal vi13, clip_edges
    nop                             nop
    nop                             bal vi13, close_polygon
    nop                             iaddiu vi09, vi00, 935
    nop                             iaddiu vi09, vi00, 935
    nop                             iaddiu vi10, vi00, 975
    nop                             iadd vi04, vi00, vi11
    nop                             iaddiu vi11, vi00, 0
    nop                             ilw.x vi12, 934(vi00)
    nop                             ilwr.y vi06, (vi02)
    nop                             lq.xyzw vf31, 934(vi00)
    nop                             lq.xyzw vf27, 13(vi00)
    nop                             lq.xyzw vf28, 14(vi00)
    nop                             iadd vi12, vi12, vi04
    nop                             iadd vi06, vi06, vi03
    nop                             iaddiu vi02, vi06, 0
    nop                             sqi.xyzw vf31, (vi06++)
    nop                             lq.xyzw vf29, 15(vi00)
    nop                             lq.xyzw vf30, 16(vi00)
    nop                             xgkick vi02                          ; send the output to the GS (PATH1)
    nop                             nop
    nop                             isw.x vi12, -1(vi06)
clip_triangle_loop:
    nop                             lqi.xyzw vf24, (vi09++)
    nop                             lqi.xyzw vf25, (vi09++)
    nop                             lqi.xyzw vf26, (vi09++)
    nop                             nop
    mulax.xyzw ACC, vf27, vf24x     nop
    madday.xyzw ACC, vf28, vf24y    nop
    maddaz.xyzw ACC, vf29, vf24z    nop
    maddw.xyzw vf23, vf30, vf24w    loi 128.0                            ; I = 128.0: the colour clamp (0x80 is 1.0 on the GS)
    minii.xyz vf25, vf25, I         nop
    nop                             nop
    nop                             nop
    nop                             div Q, vf00w, vf23w                  ; Q = 1 / vf23.w
    ftoi0.xyzw vf25, vf25           waitq
    mulq.xyzw vf23, vf23, Q         nop
    mulq.xyz vf26, vf26, Q          nop
    nop                             nop
    nop                             iaddi vi04, vi04, -1
    ftoi4.xyzw vf23, vf23           iaddiu vi06, vi06, 3                 ; to 12.4 fixed point (GS XYZ)
    nop                             sq.xyzw vf26, -3(vi06)
    nop                             sq.xyzw vf25, -2(vi06)
    nop                             ibne vi04, vi00, clip_triangle_loop
    nop                             sq.xyzw vf23, -1(vi06)
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             xgkick vi02                          ; send the output to the GS (PATH1)
clip_triangle_exit:
    nop                             ilwr.x vi10, (vi14)
    nop                             ilwr.y vi11, (vi14)
    nop                             ilwr.z vi12, (vi14)
    nop                             ilwr.w vi13, (vi14)
    nop                             iaddiu vi14, vi14, 1
    nop                             ilwr.x vi06, (vi14)
    nop                             ilwr.y vi07, (vi14)
    nop                             ilwr.z vi08, (vi14)
    nop                             ilwr.w vi09, (vi14)
    nop                             iaddiu vi14, vi14, 1
    nop                             ilwr.x vi02, (vi14)
    nop                             ilwr.y vi03, (vi14)
    nop                             ilwr.z vi04, (vi14)
    nop                             ilwr.w vi05, (vi14)
    nop                             iaddiu vi14, vi14, 1
    nop                             lqi.xyzw vf31, (vi14++)
    nop                             lqi.xyzw vf30, (vi14++)
    nop                             lqi.xyzw vf29, (vi14++)
    nop                             lqi.xyzw vf28, (vi14++)
    nop                             lqi.xyzw vf27, (vi14++)
    nop                             lqi.xyzw vf26, (vi14++)
    nop                             lqi.xyzw vf25, (vi14++)
    nop                             lqi.xyzw vf24, (vi14++)
    nop                             lqi.xyzw vf23, (vi14++)
    nop                             lqi.xyzw vf22, (vi14++)
    nop                             lqi.xyzw vf21, (vi14++)
    nop                             jr vi15
    nop                             nop

    ; after a plane: repeat the first output vertex after the last; an empty polygon leaves
    ; (clip_triangle_exit)
close_polygon:
    nop                             lqi.xyzw vf29, (vi09++)
    nop                             lqi.xyzw vf30, (vi09++)
    nop                             lqi.xyzw vf31, (vi09++)
    nop                             nop
    nop                             sqi.xyzw vf29, (vi10++)
    nop                             sqi.xyzw vf30, (vi10++)
    nop                             ibeq vi11, vi00, clip_triangle_exit
    nop                             sqi.xyzw vf31, (vi10++)
    nop                             jr vi13
    nop                             nop

    ; the next plane reads the polygon at VU 935.. and writes the one at 975.. (as set at
    ; clip_triangle)
pass_a_to_b:
    nop                             iaddiu vi09, vi00, 935
    nop                             b pass_start
    nop                             iaddiu vi10, vi00, 975

    ; the next plane reads the second polygon buffer and writes the first
pass_b_to_a:
    nop                             iaddiu vi09, vi00, 975
    nop                             iaddiu vi10, vi00, 935

    ; vi04: the vertices to clip; vi11: none written yet
pass_start:
    nop                             iadd vi04, vi00, vi11
    nop                             iaddiu vi11, vi00, 0

    ; load the polygon's first vertex (three qwords)
first_vertex:
    nop                             lqi.xyzw vf21, (vi09++)
    nop                             lqi.xyzw vf22, (vi09++)
    nop                             jr vi13
    nop                             lqi.xyzw vf23, (vi09++)

    ; clip the polygon's edges against one plane (vi05, vi06: its clip-flag bits; vf31.x its
    ; sign)
clip_edges:
    mulw.xyzw vf24, vf21, vf00w     lqi.xyzw vf21, (vi09++)
    mulw.xyzw vf25, vf22, vf00w     lqi.xyzw vf22, (vi09++)
    mulw.xyzw vf26, vf23, vf00w     lqi.xyzw vf23, (vi09++)
    nop                             nop
    clipw.xyz vf24, vf24w           nop                                  ; clip flags: vf24.xyz against +-vf24.w
    clipw.xyz vf21, vf21w           nop
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             fcget vi01
    nop                             nop
    nop                             iand vi12, vi01, vi05
    nop                             nop
    nop                             ibeq vi12, vi00, clip_edges_skip
    nop                             nop
    nop                             iand vi12, vi01, vi06
    nop                             nop
    nop                             ibne vi12, vi00, clip_edges_skip3
    nop                             nop
    nop                             bal vi01, intersect
    nop                             nop
    nop                             sqi.xyzw vf28, (vi10++)
    nop                             sqi.xyzw vf29, (vi10++)
    nop                             sqi.xyzw vf30, (vi10++)
    nop                             b clip_edges_skip3
    nop                             iaddiu vi11, vi11, 1
clip_edges_skip:
    nop                             iand vi12, vi01, vi06
    nop                             nop
    nop                             ibeq vi12, vi00, clip_edges_skip2
    nop                             nop
    nop                             bal vi01, intersect
    nop                             nop
    nop                             sqi.xyzw vf24, (vi10++)
    nop                             sqi.xyzw vf25, (vi10++)
    nop                             sqi.xyzw vf26, (vi10++)
    nop                             sqi.xyzw vf28, (vi10++)
    nop                             sqi.xyzw vf29, (vi10++)
    nop                             sqi.xyzw vf30, (vi10++)
    nop                             b clip_edges_skip3
    nop                             iaddiu vi11, vi11, 2
clip_edges_skip2:
    nop                             sqi.xyzw vf24, (vi10++)
    nop                             sqi.xyzw vf25, (vi10++)
    nop                             sqi.xyzw vf26, (vi10++)
    nop                             iaddiu vi11, vi11, 1
clip_edges_skip3:
    nop                             isubiu vi04, vi04, 1
    nop                             nop
    nop                             ibne vi04, vi00, clip_edges
    nop                             nop
    nop                             jr vi13
    nop                             nop

    ; an edge crosses the plane: write the intersection (position and attributes interpolated)
intersect:
    mulx.w vf28, vf24, vf31x        nop
    mulx.w vf29, vf21, vf31x        nop
    nop                             nop
    nop                             nop
    subw.xyzw vf28, vf24, vf28w     nop
    subw.xyzw vf29, vf21, vf29w     nop
    nop                             iadd vi12, vi00, vi07
    nop                             nop
intersect_loop:
    nop                             ibeq vi12, vi00, intersect_skip
    nop                             nop
    nop                             mr32.xyzw vf28, vf28
    nop                             mr32.xyzw vf29, vf29
    nop                             isubiu vi12, vi12, 1
    nop                             nop
    nop                             b intersect_loop
    nop                             nop
intersect_skip:
    sub.xyz vf30, vf29, vf28        nop
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             div Q, vf28x, vf30x
    nop                             waitq
    addq.x vf27, vf00, Q            nop
    sub.xyzw vf28, vf21, vf24       nop
    sub.xyzw vf29, vf22, vf25       nop
    sub.xyzw vf30, vf23, vf26       nop
    abs.x vf27, vf27                nop
    nop                             nop
    nop                             nop
    nop                             nop
    mulx.xyzw vf28, vf28, vf27x     nop
    mulx.xyzw vf29, vf29, vf27x     nop
    mulx.xyzw vf30, vf30, vf27x     nop
    nop                             nop
    add.xyzw vf28, vf28, vf24       nop
    add.xyzw vf29, vf29, vf25       nop
    add.xyzw vf30, vf30, vf26       nop
    nop                             nop
    nop                             jr vi01
    nop                             nop
.endprogram

;=======================================================================================
; Vu1Prog59: normals (key bit 0x20), fog, second colour, clipped
;
; gVu1ProgInfo59 (bones.c): 490 pairs (3920 bytes), batches of up to 2880 bytes;
; Vu1_SelectProgram's key 0x280a0, rigid models (0x21035, 0x121035).
; Setup Vu1Pkt_DVP: an UNPACK of 15 qwords to VU 0, then MSCALF 0:
;   0        colour: gGsColorF, RGB scaled by the model's brightness
;   1        second colour: gGsColor2F: vf10
;   2-5      gMtxSlots x gMtxView x gMtxProjClip: model to screen (XYZ after the divide by w): vf01-vf04
;   6-9      the matrix above x gViewportMtx: model to the clip test's space: vf05-vf08
;   10       fog range: gGsFogFar and the word after it: vf09, vf31
;   11-14    gMtxProj, the projection matrix: vf28-vf31
; Vertices: gVu1ProgLayouts[1], 4 qwords: position, normal, colour, texture coordinates.
; Batches at VU 0xf and 0xf + 0x1ea (XTOP); the output follows each.
;=======================================================================================
.program Vu1Prog59
.base 0xf
.offset 0x1ea
.stcycl 4, 4
.unpack 0x3a6, 0x00008000, 0x303ec000, 0x00000412, 0x00000000   ; GIF tag template: EOP, PRIM 0x7d, REGS ST RGBAQ XYZF2

    ; MSCALF 0: the setup's constants into registers
init:
    nop                             lq.xyzw vf01, 2(vi00)
    nop                             lq.xyzw vf02, 3(vi00)
    nop                             lq.xyzw vf03, 4(vi00)
    nop                             lq.xyzw vf04, 5(vi00)
    nop                             lq.xyzw vf05, 6(vi00)
    nop                             lq.xyzw vf06, 7(vi00)
    nop                             lq.xyzw vf07, 8(vi00)
    nop                             lq.xyzw vf08, 9(vi00)
    nop                             lq.xyzw vf09, 10(vi00)
    nop                             lq.xyzw vf10, 1(vi00)
    nop                             nop                               [E] ; end: constants loaded
    nop                             nop

    ; MSCNT: one batch at XTOP; qword 0's x is its type, qword 1 a GIF tag
batch:
    nop                             xtop vi02                            ; vi02: the batch (BASE, or BASE + OFFSET: double buffer)
    nop                             iaddiu vi05, vi02, 0
    nop                             iaddiu vi03, vi02, 180               ; vi03: the output, 180 qwords after the batch
    nop                             iaddiu vi04, vi03, 0
    nop                             ilwr.x vi06, (vi05)                  ; the batch type (qword 0)
    nop                             iaddiu vi05, vi05, 1
    nop                             iaddiu vi11, vi00, 32767             ; 0x7FFF: the NLOOP mask
    nop                             ilwr.x vi08, (vi05)                  ; the GIF tag (qword 1): NLOOP, EOP
    nop                             lq.xyzw vf31, 0(vi05)
    nop                             iaddiu vi05, vi05, 1
    nop                             iaddiu vi01, vi00, 1
    nop                             iand vi07, vi11, vi08
    nop                             ibeq vi01, vi06, vertices
    nop                             sqi.xyzw vf31, (vi04++)

    ; a register block: the GIF tag and its NLOOP qwords (A+D) go through to the output
copy_regs:
    nop                             lq.xyzw vf31, 0(vi05)
    nop                             iaddi vi07, vi07, -1
    nop                             iaddiu vi05, vi05, 1
    nop                             iaddiu vi04, vi04, 1
    nop                             ibne vi07, vi00, copy_regs
    nop                             sq.xyzw vf31, -1(vi04)
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             nop                               [E] ; end: the next MSCNT continues at copy_regs_cont
    nop                             nop

    ; the next MSCNT continues here
copy_regs_cont:
    nop                             b batch                              ; the next batch
    nop                             nop

    ; type 1: a strip of NLOOP vertices
vertices:
    nop                             iaddiu vi08, vi08, 2                 ; NLOOP + 2: the delay line's last vertices go out first
    nop                             isw.x vi08, -1(vi04)
    nop                             lq.xyzw vf16, 917(vi00)
    nop                             lq.xyzw vf17, 918(vi00)
    nop                             lq.xyzw vf18, 919(vi00)
    nop                             lq.xyzw vf19, 914(vi00)
    nop                             lq.xyzw vf20, 915(vi00)
    nop                             lq.xyzw vf21, 916(vi00)
    nop                             sqi.xyzw vf16, (vi04++)
    nop                             sqi.xyzw vf17, (vi04++)
    nop                             sqi.xyzw vf18, (vi04++)
    nop                             sqi.xyzw vf19, (vi04++)
    nop                             sqi.xyzw vf20, (vi04++)
    nop                             sqi.xyzw vf21, (vi04++)
    nop                             lq.xyzw vf16, 1020(vi00)
    nop                             lq.xyzw vf28, 0(vi05)
    nop                             lq.xyzw vf17, 1017(vi00)
    nop                             lq.xyzw vf18, 1019(vi00)
    nop                             lq.xyzw vf19, 1016(vi00)
    mulax.xyzw ACC, vf01, vf28x     lq.xyzw vf20, 1018(vi00)
    madday.xyzw ACC, vf02, vf28y    lq.xyzw vf21, 1015(vi00)
    ; one vertex per pass, software-pipelined through the delay line
vertices_loop:
    maddaz.xyzw ACC, vf03, vf28z    ilw.w vi09, 0(vi05)                  ; vi09: the position's w word, XYZF2's w (F, ADC) as the model has it
    maddw.xyzw vf27, vf04, vf00w    lq.xyzw vf29, 1(vi05)
    mulax.xyzw ACC, vf05, vf28x     lq.xyzw vf30, 2(vi05)
    madday.xyzw ACC, vf06, vf28y    lq.xyzw vf31, 3(vi05)
    maddaz.xyzw ACC, vf07, vf28z    iaddiu vi05, vi05, 4
    subw.x vf23, vf09, vf27w        div Q, vf00w, vf27w                  ; Q = 1 / vf27.w
    maddw.xyzw vf26, vf08, vf00w    loi 255.0                            ; I = 255.0
    clipw.xyz vf16, vf16w           move.xyz vf11, vf12                  ; clip flags: vf16.xyz against +-vf16.w
    clipw.xyz vf17, vf17w           move.xyz vf12, vf13
    muly.x vf23, vf23, vf09y        sq.xyzw vf16, 1023(vi00)
    clipw.xyz vf26, vf26w           sq.xyzw vf26, 1017(vi00)
    mul.xyzw vf24, vf30, vf10       sq.xyzw vf17, 1020(vi00)
    sub.xyz vf14, vf12, vf11        sq.xyzw vf18, 1022(vi00)
    mulq.xyz vf27, vf27, Q          sq.xyzw vf19, 1019(vi00)
    muli.x vf23, vf23, I            sq.xyzw vf20, 1021(vi00)
    ftoi0.xyzw vf24, vf24           sq.xyzw vf21, 1018(vi00)
    mulq.xyz vf25, vf31, Q          sq.xyzw vf31, 1015(vi00)
    sub.xyz vf15, vf27, vf11        move.xyz vf13, vf27
    minii.x vf23, vf23, I           fcand vi01, 0x03ffff                 ; vi01 = 1: one of the last three vertices is outside the clip volume
    ftoi4.xyz vf27, vf27            sq.xyzw vf24, 1016(vi00)
    nop                             ibne vi09, vi00, vertices_skip2
    opmula.xyz ACC, vf15, vf14      sq.xyzw vf24, 1(vi04)
    opmsub.xyz vf15, vf14, vf15     ibeq vi01, vi00, vertices_skip
    nop                             nop
    nop                             fcor vi01, 0xfdf7df
    nop                             ibne vi01, vi00, vertices_culled
    nop                             nop
    nop                             fcor vi01, 0xfefbef
    nop                             ibne vi01, vi00, vertices_culled
    nop                             nop
    nop                             fcor vi01, 0xff7df7
    nop                             ibne vi01, vi00, vertices_culled
    nop                             nop
    nop                             fcor vi01, 0xffbefb
    nop                             ibne vi01, vi00, vertices_culled
    nop                             nop
    nop                             fcor vi01, 0xffdf7d
    nop                             ibne vi01, vi00, vertices_culled
    nop                             nop
    nop                             fcor vi01, 0xffefbe
    nop                             ibne vi01, vi00, vertices_culled
    nop                             iaddiu vi15, vi00, 114
    nop                             b clip_triangle
    nop                             sq.xyzw vf29, 919(vi00)
vertices_skip:
    nop                             nop
    nop                             nop
    mulw.z vf15, vf15, vf29w        nop
    nop                             nop
    nop                             nop
    nop                             iaddiu vi01, vi00, 32
    nop                             fmand vi01, vi01
    nop                             ibeq vi01, vi00, vertices_skip2
    nop                             nop
    ; the triangle is wholly outside one plane: culled
vertices_culled:
    nop                             iaddiu vi09, vi00, 32767
    nop                             iaddiu vi09, vi09, 1
vertices_skip2:
    maxx.x vf23, vf23, vf00x        sq.xyzw vf25, 0(vi04)
    nop                             sq.xyz vf27, 2(vi04)
    nop                             lq.xyzw vf28, 0(vi05)
    nop                             lq.xyzw vf16, 1020(vi00)
    ftoi4.x vf23, vf23              lq.xyzw vf17, 1017(vi00)
    nop                             lq.xyzw vf18, 1019(vi00)
    mulax.xyzw ACC, vf01, vf28x     lq.xyzw vf19, 1016(vi00)
    madday.xyzw ACC, vf02, vf28y    lq.xyzw vf20, 1018(vi00)
    nop                             mtir vi13, vf23x
    nop                             lq.xyzw vf21, 1015(vi00)
    nop                             iaddi vi07, vi07, -1
    nop                             iaddiu vi04, vi04, 3
    nop                             iadd vi09, vi09, vi13
    nop                             ibne vi07, vi00, vertices_loop
    nop                             isw.w vi09, -1(vi04)
    ; the epilogue: the vertices left in the delay line
    nop                             nop                               [D] ; D bit: a debug break, when FBRST enables it
    nop                             lqd.xyzw vf16, (--vi04)
    nop                             lqd.xyzw vf17, (--vi04)
    nop                             lqd.xyzw vf18, (--vi04)
    nop                             xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             lqd.xyzw vf19, (--vi04)
    nop                             lqd.xyzw vf20, (--vi04)
    nop                             lqd.xyzw vf21, (--vi04)
    nop                             sq.xyzw vf16, 916(vi00)
    nop                             sq.xyzw vf17, 915(vi00)
    nop                             sq.xyzw vf18, 914(vi00)
    nop                             sq.xyzw vf19, 919(vi00)
    nop                             sq.xyzw vf20, 918(vi00)
    nop                             sq.xyzw vf21, 917(vi00)
    nop                             nop                               [E] ; end: the next MSCNT continues at vertices_cont
    nop                             nop

    ; the next MSCNT continues here
vertices_cont:
    nop                             b batch                              ; the next batch
    nop                             nop

    ; clip the last three vertices' triangle against the six planes of the clip volume and
    ; send what is left as a fan (the GIF tag template at VU 0x3A6)
clip_triangle:
    nop                             iaddiu vi14, vi00, 934
    nop                             sqd.xyzw vf21, (--vi14)
    nop                             sqd.xyzw vf22, (--vi14)
    nop                             sqd.xyzw vf23, (--vi14)
    nop                             sqd.xyzw vf24, (--vi14)
    nop                             sqd.xyzw vf25, (--vi14)
    nop                             sqd.xyzw vf26, (--vi14)
    nop                             sqd.xyzw vf27, (--vi14)
    nop                             sqd.xyzw vf28, (--vi14)
    nop                             sqd.xyzw vf29, (--vi14)
    nop                             sqd.xyzw vf30, (--vi14)
    nop                             sqd.xyzw vf31, (--vi14)
    nop                             isubiu vi14, vi14, 1
    nop                             iswr.x vi02, (vi14)
    nop                             iswr.y vi03, (vi14)
    nop                             iswr.z vi04, (vi14)
    nop                             iswr.w vi05, (vi14)
    nop                             isubiu vi14, vi14, 1
    nop                             iswr.x vi06, (vi14)
    nop                             iswr.y vi07, (vi14)
    nop                             iswr.z vi08, (vi14)
    nop                             iswr.w vi09, (vi14)
    nop                             isubiu vi14, vi14, 1
    nop                             iswr.x vi10, (vi14)
    nop                             iswr.y vi11, (vi14)
    nop                             iswr.z vi12, (vi14)
    nop                             iswr.w vi13, (vi14)
    nop                             iaddiu vi08, vi00, 0
    nop                             iaddiu vi09, vi00, 935
    nop                             iaddiu vi10, vi00, 975
    nop                             lq.xyzw vf23, 1022(vi00)
    nop                             lq.xyzw vf24, 1019(vi00)
    nop                             lq.xyzw vf25, 1016(vi00)
    nop                             lq.xyzw vf26, 1021(vi00)
    itof0.xyzw vf23, vf23           lq.xyzw vf27, 1018(vi00)
    itof0.xyzw vf24, vf24           lq.xyzw vf28, 1015(vi00)
    itof0.xyzw vf25, vf25           lq.xyzw vf29, 1023(vi00)
    nop                             lq.xyzw vf30, 1020(vi00)
    nop                             lq.xyzw vf31, 1017(vi00)
    nop                             sq.xyzw vf23, 1(vi09)
    nop                             sq.xyzw vf24, 4(vi09)
    nop                             sq.xyzw vf25, 7(vi09)
    nop                             sq.xyzw vf23, 10(vi09)
    nop                             sq.xyzw vf26, 2(vi09)
    nop                             sq.xyzw vf27, 5(vi09)
    nop                             sq.xyzw vf28, 8(vi09)
    nop                             sq.xyzw vf26, 11(vi09)
    nop                             sq.xyzw vf29, 0(vi09)
    nop                             sq.xyzw vf30, 3(vi09)
    nop                             sq.xyzw vf31, 6(vi09)
    nop                             sq.xyzw vf29, 9(vi09)
    nop                             iaddiu vi09, vi00, 935
    nop                             iaddiu vi10, vi00, 975
    nop                             iaddiu vi05, vi00, 2048
    nop                             iaddiu vi06, vi00, 32
    subw.x vf31, vf00, vf00w        bal vi13, first_vertex
    nop                             iaddiu vi07, vi00, 2
    nop                             iaddiu vi04, vi00, 3
    nop                             iaddiu vi11, vi00, 0
    nop                             bal vi13, clip_edges
    nop                             nop
    nop                             bal vi13, close_polygon
    nop                             iaddiu vi09, vi00, 975
    nop                             iaddiu vi09, vi00, 975
    nop                             iaddiu vi10, vi00, 935
    nop                             iaddiu vi05, vi00, 1024
    nop                             iaddiu vi06, vi00, 16
    addw.x vf31, vf00, vf00w        bal vi13, pass_start
    nop                             iaddiu vi07, vi00, 2
    nop                             bal vi13, clip_edges
    nop                             nop
    nop                             bal vi13, close_polygon
    nop                             iaddiu vi09, vi00, 935
    nop                             iaddiu vi05, vi00, 128
    nop                             iaddiu vi06, vi00, 2
    subw.x vf31, vf00, vf00w        bal vi13, pass_a_to_b
    nop                             iaddiu vi07, vi00, 0
    nop                             bal vi13, clip_edges
    nop                             nop
    nop                             bal vi13, close_polygon
    nop                             iaddiu vi09, vi00, 975
    nop                             iaddiu vi05, vi00, 64
    nop                             iaddiu vi06, vi00, 1
    addw.x vf31, vf00, vf00w        bal vi13, pass_b_to_a
    nop                             iaddiu vi07, vi00, 0
    nop                             bal vi13, clip_edges
    nop                             nop
    nop                             bal vi13, close_polygon
    nop                             iaddiu vi09, vi00, 935
    nop                             iaddiu vi05, vi00, 512
    nop                             iaddiu vi06, vi00, 8
    subw.x vf31, vf00, vf00w        bal vi13, pass_a_to_b
    nop                             iaddiu vi07, vi00, 1
    nop                             bal vi13, clip_edges
    nop                             nop
    nop                             bal vi13, close_polygon
    nop                             iaddiu vi09, vi00, 975
    nop                             iaddiu vi05, vi00, 256
    nop                             iaddiu vi06, vi00, 4
    addw.x vf31, vf00, vf00w        bal vi13, pass_b_to_a
    nop                             iaddiu vi07, vi00, 1
    nop                             bal vi13, clip_edges
    nop                             nop
    nop                             bal vi13, close_polygon
    nop                             iaddiu vi09, vi00, 935
    nop                             iaddiu vi09, vi00, 935
    nop                             iaddiu vi10, vi00, 975
    nop                             iadd vi04, vi00, vi11
    nop                             ilw.x vi12, 934(vi00)
    nop                             ilwr.y vi06, (vi02)
    nop                             lq.xyzw vf31, 934(vi00)
    nop                             iaddiu vi11, vi00, 0
    nop                             iadd vi12, vi12, vi04
    nop                             iadd vi06, vi06, vi03
    nop                             iaddiu vi02, vi06, 0
    nop                             sqi.xyzw vf31, (vi06++)
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             xgkick vi02                          ; send the output to the GS (PATH1)
    nop                             nop
    nop                             nop
    nop                             iaddiu vi08, vi00, 2
    nop                             isw.x vi12, -1(vi06)
clip_triangle_loop:
    nop                             lqi.xyzw vf23, (vi09++)
    nop                             lq.xyzw vf28, 11(vi00)
    nop                             lq.xyzw vf29, 12(vi00)
    nop                             lq.xyzw vf30, 13(vi00)
    nop                             lq.xyzw vf31, 14(vi00)
    mulax.xyzw ACC, vf28, vf23x     lqi.xyzw vf24, (vi09++)
    madday.xyzw ACC, vf29, vf23y    lqi.xyzw vf25, (vi09++)
    maddaz.xyzw ACC, vf30, vf23z    nop
    maddw.xyzw vf23, vf31, vf23w    loi 128.0                            ; I = 128.0: the colour clamp (0x80 is 1.0 on the GS)
    minii.xyz vf24, vf24, I         nop
    nop                             nop
    nop                             nop
    nop                             div Q, vf00w, vf23w                  ; Q = 1 / vf23.w
    ftoi0.xyzw vf24, vf24           nop
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             sq.xyzw vf24, 1(vi06)
    nop                             iaddiu vi08, vi08, 32767             ; NLOOP + 32767: the delay line's last vertices go out first
    nop                             nop
    mulq.xyz vf23, vf23, Q          nop
    mulq.xyz vf25, vf25, Q          iblez vi08, clip_triangle_skip
    nop                             nop
    sub.xyz vf29, vf22, vf21        nop
    sub.xyz vf30, vf23, vf21        nop
    nop                             nop
    nop                             nop
    nop                             lq.xyzw vf31, 919(vi00)
    opmula.xyz ACC, vf30, vf29      nop
    opmsub.xyz vf30, vf29, vf30     nop
    nop                             nop
    nop                             nop
    nop                             nop
    mulw.z vf30, vf30, vf31w        nop
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             iaddiu vi01, vi00, 32
    nop                             fmand vi01, vi01
    nop                             ibne vi01, vi00, clip_triangle_loop2
    nop                             nop
clip_triangle_skip:
    nop                             move.xyz vf21, vf22
    nop                             move.xyz vf22, vf23
    ftoi4.xyz vf23, vf23            sq.xyzw vf25, 0(vi06)
    nop                             lq.xyzw vf31, 10(vi00)
    nop                             nop
    nop                             nop
    nop                             sq.xyz vf23, 2(vi06)
    subw.x vf23, vf31, vf23w        nop
    nop                             nop
    nop                             nop
    nop                             nop
    muly.x vf23, vf23, vf31y        nop
    nop                             nop
    nop                             nop
    nop                             loi 255.0                            ; I = 255.0
    muli.x vf23, vf23, I            nop
    nop                             nop
    nop                             nop
    nop                             nop
    minii.x vf23, vf23, I           nop
    nop                             nop
    nop                             nop
    nop                             nop
    maxx.x vf23, vf23, vf00x        nop
    nop                             nop
    nop                             nop
    nop                             nop
    ftoi4.x vf23, vf23              nop
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             mtir vi13, vf23x
    nop                             nop
    nop                             nop
    nop                             iaddi vi04, vi04, -1
    nop                             isw.w vi13, 2(vi06)
    nop                             ibne vi04, vi00, clip_triangle_loop
    nop                             iaddiu vi06, vi06, 3
    nop                             xgkick vi02                          ; send the output to the GS (PATH1)
    nop                             nop
clip_triangle_loop2:
    nop                             ilwr.x vi10, (vi14)
    nop                             ilwr.y vi11, (vi14)
    nop                             ilwr.z vi12, (vi14)
    nop                             ilwr.w vi13, (vi14)
    nop                             iaddiu vi14, vi14, 1
    nop                             ilwr.x vi06, (vi14)
    nop                             ilwr.y vi07, (vi14)
    nop                             ilwr.z vi08, (vi14)
    nop                             ilwr.w vi09, (vi14)
    nop                             iaddiu vi14, vi14, 1
    nop                             ilwr.x vi02, (vi14)
    nop                             ilwr.y vi03, (vi14)
    nop                             ilwr.z vi04, (vi14)
    nop                             ilwr.w vi05, (vi14)
    nop                             iaddiu vi14, vi14, 1
    nop                             lqi.xyzw vf31, (vi14++)
    nop                             lqi.xyzw vf30, (vi14++)
    nop                             lqi.xyzw vf29, (vi14++)
    nop                             lqi.xyzw vf28, (vi14++)
    nop                             lqi.xyzw vf27, (vi14++)
    nop                             lqi.xyzw vf26, (vi14++)
    nop                             lqi.xyzw vf25, (vi14++)
    nop                             lqi.xyzw vf24, (vi14++)
    nop                             lqi.xyzw vf23, (vi14++)
    nop                             lqi.xyzw vf22, (vi14++)
    nop                             jr vi15
    nop                             lqi.xyzw vf21, (vi14++)

    ; after a plane: repeat the first output vertex after the last; an empty polygon leaves
    ; (clip_triangle_exit)
close_polygon:
    nop                             lqi.xyzw vf29, (vi09++)
    nop                             lqi.xyzw vf30, (vi09++)
    nop                             lqi.xyzw vf31, (vi09++)
    nop                             nop
    nop                             sqi.xyzw vf29, (vi10++)
    nop                             sqi.xyzw vf30, (vi10++)
    nop                             ibeq vi11, vi00, clip_triangle_loop2
    nop                             sqi.xyzw vf31, (vi10++)
    nop                             jr vi13
    nop                             nop

    ; the next plane reads the polygon at VU 935.. and writes the one at 975.. (as set at
    ; clip_triangle)
pass_a_to_b:
    nop                             iaddiu vi09, vi00, 935
    nop                             b pass_start
    nop                             iaddiu vi10, vi00, 975

    ; the next plane reads the second polygon buffer and writes the first
pass_b_to_a:
    nop                             iaddiu vi09, vi00, 975
    nop                             iaddiu vi10, vi00, 935

    ; vi04: the vertices to clip; vi11: none written yet
pass_start:
    nop                             iadd vi04, vi00, vi11
    nop                             iaddiu vi11, vi00, 0

    ; load the polygon's first vertex (three qwords)
first_vertex:
    nop                             lqi.xyzw vf21, (vi09++)
    nop                             lqi.xyzw vf22, (vi09++)
    nop                             jr vi13
    nop                             lqi.xyzw vf23, (vi09++)

    ; clip the polygon's edges against one plane (vi05, vi06: its clip-flag bits; vf31.x its
    ; sign)
clip_edges:
    mulw.xyzw vf24, vf21, vf00w     lqi.xyzw vf21, (vi09++)
    mulw.xyzw vf25, vf22, vf00w     lqi.xyzw vf22, (vi09++)
    mulw.xyzw vf26, vf23, vf00w     lqi.xyzw vf23, (vi09++)
    nop                             nop
    clipw.xyz vf24, vf24w           nop                                  ; clip flags: vf24.xyz against +-vf24.w
    clipw.xyz vf21, vf21w           nop
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             fcget vi01
    nop                             nop
    nop                             iand vi12, vi01, vi05
    nop                             nop
    nop                             ibeq vi12, vi00, clip_edges_skip
    nop                             nop
    nop                             iand vi12, vi01, vi06
    nop                             nop
    nop                             ibne vi12, vi00, clip_edges_skip3
    nop                             nop
    nop                             bal vi01, intersect
    nop                             nop
    nop                             sqi.xyzw vf28, (vi10++)
    nop                             sqi.xyzw vf29, (vi10++)
    nop                             sqi.xyzw vf30, (vi10++)
    nop                             b clip_edges_skip3
    nop                             iaddiu vi11, vi11, 1
clip_edges_skip:
    nop                             iand vi12, vi01, vi06
    nop                             nop
    nop                             ibeq vi12, vi00, clip_edges_skip2
    nop                             nop
    nop                             bal vi01, intersect
    nop                             nop
    nop                             sqi.xyzw vf24, (vi10++)
    nop                             sqi.xyzw vf25, (vi10++)
    nop                             sqi.xyzw vf26, (vi10++)
    nop                             sqi.xyzw vf28, (vi10++)
    nop                             sqi.xyzw vf29, (vi10++)
    nop                             sqi.xyzw vf30, (vi10++)
    nop                             b clip_edges_skip3
    nop                             iaddiu vi11, vi11, 2
clip_edges_skip2:
    nop                             sqi.xyzw vf24, (vi10++)
    nop                             sqi.xyzw vf25, (vi10++)
    nop                             sqi.xyzw vf26, (vi10++)
    nop                             iaddiu vi11, vi11, 1
clip_edges_skip3:
    nop                             isubiu vi04, vi04, 1
    nop                             nop
    nop                             ibne vi04, vi00, clip_edges
    nop                             nop
    nop                             jr vi13
    nop                             nop

    ; an edge crosses the plane: write the intersection (position and attributes interpolated)
intersect:
    mulx.w vf28, vf24, vf31x        nop
    mulx.w vf29, vf21, vf31x        nop
    nop                             nop
    nop                             nop
    subw.xyzw vf28, vf24, vf28w     nop
    subw.xyzw vf29, vf21, vf29w     nop
    nop                             iadd vi12, vi00, vi07
    nop                             nop
intersect_loop:
    nop                             ibeq vi12, vi00, intersect_skip
    nop                             nop
    nop                             mr32.xyzw vf28, vf28
    nop                             mr32.xyzw vf29, vf29
    nop                             isubiu vi12, vi12, 1
    nop                             nop
    nop                             b intersect_loop
    nop                             nop
intersect_skip:
    sub.xyz vf30, vf29, vf28        nop
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             div Q, vf28x, vf30x
    nop                             waitq
    addq.x vf27, vf00, Q            nop
    sub.xyzw vf28, vf21, vf24       nop
    sub.xyzw vf29, vf22, vf25       nop
    sub.xyzw vf30, vf23, vf26       nop
    abs.x vf27, vf27                nop
    nop                             nop
    nop                             nop
    nop                             nop
    mulx.xyzw vf28, vf28, vf27x     nop
    mulx.xyzw vf29, vf29, vf27x     nop
    mulx.xyzw vf30, vf30, vf27x     nop
    nop                             nop
    add.xyzw vf28, vf28, vf24       nop
    add.xyzw vf29, vf29, vf25       nop
    add.xyzw vf30, vf30, vf26       jr vi01
    nop                             nop
.endprogram
