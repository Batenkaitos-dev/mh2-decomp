    nop                             sqi.xyzw vf16, (vi04++)
    nop                             div Q, vf00w, vf28w                  ; Q = 1 / vf28.w
    mulax.xyzw ACC, vf05, vf29x     sqi.xyzw vf17, (vi04++)
    madday.xyzw ACC, vf06, vf29y    lq.xyzw vf15, 1020(vi00)
    maddaz.xyzw ACC, vf07, vf29z    sqi.xyzw vf18, (vi04++)
    maddw.xyzw vf27, vf08, vf00w    lq.xyzw vf31, 2(vi05)
