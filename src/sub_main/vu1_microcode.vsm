    mulax.xyzw ACC, vf01, vf29x     sq.xyzw vf25, 1(vi04)
    madday.xyzw ACC, vf02, vf29y    sq.xyzw vf25, 1016(vi00)
    maddaz.xyzw ACC, vf03, vf29z    sq.xyz vf28, 2(vi04)
