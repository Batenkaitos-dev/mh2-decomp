    maddaz.xyzw ACC, vf07, vf29z    sqi.xyzw vf13, (vi04++)
    maddw.xyzw vf27, vf08, vf00w    div Q, vf00w, vf28w                  ; Q = 1 / vf28.w
    mul.xyzw vf25, vf30, vf12       sqi.xyzw vf14, (vi04++)
    mulax.xy ACC, vf09, vf31x       sqi.xyzw vf15, (vi04++)
    madday.xy ACC, vf10, vf31y      sq.xyzw vf16, 1021(vi00)
    maddw.xy vf31, vf11, vf00w      sq.xyzw vf17, 1022(vi00)
    clipw.xyz vf27, vf27w           sq.xyzw vf18, 1023(vi00)             ; clip flags: vf27.xyz against +-vf27.w
    ftoi0.xyzw vf25, vf25           iaddi vi07, vi07, -1
    mulq.xyzw vf28, vf28, Q         lq.xyzw vf29, 0(vi05)
    mulq.xyz vf26, vf31, Q          lq.xyzw vf30, 1(vi05)
    nop                             fcand vi01, 0x03ffff                 ; vi01 = 1: one of the last three vertices is outside the clip volume
    nop                             ibeq vi01, vi00, vertices_in_view
    ftoi4.xyzw vf28, vf28           sq.xyzw vf25, 1019(vi00)             ; to 12.4 fixed point (GS XYZ)
    nop                             iaddiu vi09, vi00, 32767
    nop                             iaddiu vi09, vi09, 1
    ; the last three vertices are all inside the clip volume
vertices_in_view:
    nop                             sq.xyzw vf26, 1018(vi00)
    nop                             isw.w vi09, 1020(vi00)
    nop                             ibne vi07, vi00, vertices_loop
    nop                             sq.xyz vf28, 1020(vi00)
    ; the epilogue: the vertices left in the delay line
    nop                             lq.xyzw vf13, 1021(vi00)
    nop                             lq.xyzw vf14, 1022(vi00)
    nop                             lq.xyzw vf15, 1023(vi00)
    nop                             lq.xyzw vf16, 1018(vi00)
    nop                             lq.xyzw vf17, 1019(vi00)
    nop                             lq.xyzw vf18, 1020(vi00)
    nop                             sqi.xyzw vf13, (vi04++)
    nop                             sqi.xyzw vf14, (vi04++)
    nop                             sqi.xyzw vf15, (vi04++)
    nop                             sqi.xyzw vf16, (vi04++)
    nop                             sqi.xyzw vf17, (vi04++)
    nop                             sqi.xyzw vf18, (vi04++)
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             xgkick vi03                       [E] ; end: the next MSCNT continues at vertices_cont
    nop                             nop

    ; the next MSCNT continues here
vertices_cont:
    nop                             b batch                              ; the next batch
    nop                             nop
.endprogram

;=======================================================================================
; Vu1Prog36: three lights, material colour, no vertex colours, fog, gMtxUv rows
;
; gVu1ProgInfo36 (bones.c): 124 pairs (992 bytes), batches of up to 3968 bytes;
; Vu1_SelectProgram's key 0xc202, rigid models (0x21035, 0x121035).
; Setup Vu1Pkt_LDE: an UNPACK of 20 qwords to VU 0, then MSCALF 0:
;   0        colour: gGsColorF, RGB scaled by the model's brightness: vf28
;   1-4      gMtxSlots x gMtxView x gMtxProjClip: model to screen (XYZ after the divide by w): vf01-vf04
;   5-8      the matrix above x gViewportMtx: model to the clip test's space: vf05-vf08
;   9-11     light directions (model space, negated): vf09-vf11
;   12-15    light colours (three lights and the ambient): vf24-vf27
;   16-18    rows 0, 1 and 3 of gMtxUv (Vu1_PutUvMatrix): vf16-vf18
;   19       fog range: gGsFogFar and the word after it: vf19
; Vertices: gVu1ProgLayouts[0], 3 qwords: position, normal, texture coordinates.
; Batches at VU 0x14 and 0x14 + 0x1f3 (XTOP); the output follows each.
;=======================================================================================
.program Vu1Prog36
.base 0x14
.offset 0x1f3

    ; MSCALF 0: the setup's constants into registers
init:
    nop                             lq.xyzw vf01, 1(vi00)
    nop                             lq.xyzw vf02, 2(vi00)
    nop                             lq.xyzw vf03, 3(vi00)
    nop                             lq.xyzw vf04, 4(vi00)
    nop                             lq.xyzw vf05, 5(vi00)
    nop                             lq.xyzw vf06, 6(vi00)
    nop                             lq.xyzw vf07, 7(vi00)
    nop                             lq.xyzw vf08, 8(vi00)
    nop                             lq.xyzw vf09, 9(vi00)
    nop                             lq.xyzw vf10, 10(vi00)
    nop                             lq.xyzw vf11, 11(vi00)
    nop                             lq.xyzw vf16, 16(vi00)
    nop                             lq.xyzw vf17, 17(vi00)
    nop                             lq.xyzw vf18, 18(vi00)
    nop                             lq.xyzw vf19, 19(vi00)
    nop                             nop                               [E] ; end: constants loaded
    nop                             nop

    ; MSCNT: one batch at XTOP; qword 0's x is its type, qword 1 a GIF tag
batch:
    nop                             xtop vi02                            ; vi02: the batch (BASE, or BASE + OFFSET: double buffer)
    nop                             iaddiu vi05, vi02, 0
    nop                             iaddiu vi03, vi02, 248               ; vi03: the output, 248 qwords after the batch
    nop                             ilwr.x vi06, (vi05)                  ; the batch type (qword 0)
    nop                             iaddiu vi05, vi05, 1
    nop                             ilwr.x vi08, (vi05)                  ; the GIF tag (qword 1): NLOOP, EOP
    nop                             iaddiu vi04, vi03, 0
    nop                             iaddiu vi11, vi00, 32767             ; 0x7FFF: the NLOOP mask
    nop                             lq.xyzw vf31, 0(vi05)
    nop                             iand vi07, vi11, vi08
    nop                             iaddiu vi11, vi00, 1
    nop                             iaddiu vi05, vi05, 1
    nop                             ibeq vi11, vi06, vertices
    nop                             sqi.xyzw vf31, (vi04++)

    ; a register block: the GIF tag and its NLOOP qwords (A+D) go through to the output
copy_regs:
    nop                             lq.xyzw vf30, 0(vi05)
    nop                             iaddi vi07, vi07, -1
    nop                             iaddiu vi05, vi05, 1
    nop                             iaddiu vi04, vi04, 1
    nop                             ibne vi07, vi00, copy_regs
    nop                             sq.xyzw vf30, -1(vi04)
    nop                             lq.xyzw vf28, 0(vi00)
    nop                             lqi.xyzw vf29, (vi05++)
    nop                             lq.xyzw vf24, 12(vi00)
    nop                             lq.xyzw vf25, 13(vi00)
    nop                             lq.xyzw vf26, 14(vi00)
    nop                             lq.xyzw vf27, 15(vi00)
    mul.xyzw vf24, vf29, vf24       nop
    mul.xyzw vf25, vf29, vf25       lqi.xyzw vf30, (vi05++)
    mul.xyzw vf26, vf29, vf26       nop
    add.xyzw vf23, vf27, vf28       nop
    ftoi0.xyzw vf29, vf29           loi 128.0                            ; I = 128.0: the colour clamp (0x80 is 1.0 on the GS)
    muli.xyzw vf12, vf24, I         nop
    muli.xyzw vf13, vf25, I         nop
    muli.xyzw vf14, vf26, I         nop
    mul.xyzw vf15, vf23, vf30       mtir vi15, vf29w
    minii.xyzw vf12, vf12, I        nop
    minii.xyzw vf13, vf13, I        nop
    minii.xyzw vf14, vf14, I        nop
    minii.xyzw vf15, vf15, I        xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             nop                               [E] ; end: the next MSCNT continues at copy_regs_cont
    nop                             nop

    ; the next MSCNT continues here
copy_regs_cont:
    nop                             b batch                              ; the next batch
    nop                             nop

    ; type 1: a strip of NLOOP vertices
vertices:
    nop                             lq.xyzw vf29, 0(vi05)
    nop                             iaddiu vi08, vi08, 2                 ; NLOOP + 2: the delay line's last vertices go out first
    nop                             isw.x vi08, -1(vi04)
    nop                             lq.xyzw vf31, 2(vi05)
    mulax.xyzw ACC, vf01, vf29x     ilw.w vi09, 0(vi05)                  ; vi09: the position's w word, XYZF2's w (F, ADC) as the model has it
    madday.xyzw ACC, vf02, vf29y    lq.xyzw vf30, 1(vi05)
    maddaz.xyzw ACC, vf03, vf29z    iaddiu vi05, vi05, 3
    maddw.xyzw vf28, vf04, vf00w    nop
    mulax.xy ACC, vf16, vf31x       nop
    madday.xy ACC, vf17, vf31y      nop
    maddw.xy vf31, vf18, vf00w      nop
    ; one vertex per pass, software-pipelined through the delay line
vertices_loop:
    subw.x vf27, vf19, vf28w        div Q, vf00w, vf28w                  ; Q = 1 / vf28.w
    mulax.xyzw ACC, vf09, vf30x     lq.xyzw vf20, 1021(vi00)
    madday.xyzw ACC, vf10, vf30y    lq.xyzw vf21, 1022(vi00)
    maddz.xyzw vf25, vf11, vf30z    lq.xyzw vf22, 1023(vi00)
    muly.x vf27, vf27, vf19y        loi 255.0                            ; I = 255.0
    mulax.xyzw ACC, vf05, vf29x     sqi.xyzw vf20, (vi04++)
    madday.xyzw ACC, vf06, vf29y    sqi.xyzw vf21, (vi04++)
    maxx.xyzw vf25, vf25, vf00x     sqi.xyzw vf22, (vi04++)
    muli.x vf27, vf27, I            iaddi vi07, vi07, -1
    maddaz.xyzw ACC, vf07, vf29z    lq.xyzw vf20, 1018(vi00)
    maddw.xyzw vf24, vf08, vf00w    lq.xyzw vf21, 1019(vi00)
    mulax.xyzw ACC, vf12, vf25x     lq.xyzw vf22, 1020(vi00)
    minii.x vf27, vf27, I           loi 128.0                            ; I = 128.0: the colour clamp (0x80 is 1.0 on the GS)
    madday.xyzw ACC, vf13, vf25y    sq.xyzw vf20, 1021(vi00)
    maddz.xyzw vf25, vf14, vf25z    sq.xyzw vf21, 1022(vi00)
    mulq.xyz vf28, vf28, Q          sq.xyzw vf22, 1023(vi00)
    maxx.x vf27, vf27, vf00x        iaddiu vi14, vi09, 0
    mulq.xyz vf26, vf31, Q          lq.xyzw vf29, 0(vi05)
    add.xyzw vf25, vf25, vf15       ilw.w vi09, 0(vi05)
    ftoi4.xyz vf28, vf28            lq.xyzw vf30, 1(vi05)
    ftoi4.x vf27, vf27              lq.xyzw vf31, 2(vi05)
    clipw.xyz vf24, vf24w           iaddiu vi05, vi05, 3                 ; clip flags: vf24.xyz against +-vf24.w
    minii.xyzw vf25, vf25, I        sq.xyzw vf26, 1018(vi00)
    mulax.xyzw ACC, vf01, vf29x     sq.xyz vf28, 1020(vi00)
    madday.xyzw ACC, vf02, vf29y    mtir vi13, vf27x
    maddaz.xyzw ACC, vf03, vf29z    fcand vi01, 0x03ffff                 ; vi01 = 1: one of the last three vertices is outside the clip volume
    ftoi0.xyzw vf25, vf25           ibeq vi01, vi00, vertices_in_view
    maddw.xyzw vf28, vf04, vf00w    isw.w vi15, 1019(vi00)
    nop                             iaddiu vi14, vi00, 32767             ; ADC: 0x7FFF + 1 = 0x8000, so the GS draws no triangle ending here
    nop                             iaddiu vi14, vi14, 1
    ; the last three vertices are all inside the clip volume
vertices_in_view:
    mulax.xy ACC, vf16, vf31x       iadd vi14, vi14, vi13
    madday.xy ACC, vf17, vf31y      isw.w vi14, 1020(vi00)
    maddw.xy vf31, vf18, vf00w      ibne vi07, vi00, vertices_loop
    nop                             sq.xyz vf25, 1019(vi00)
    ; the epilogue: the vertices left in the delay line
    nop                             lq.xyzw vf20, 1021(vi00)
    nop                             lq.xyzw vf21, 1022(vi00)
    nop                             lq.xyzw vf22, 1023(vi00)
    nop                             lq.xyzw vf23, 1018(vi00)
    nop                             lq.xyzw vf24, 1019(vi00)
    nop                             lq.xyzw vf25, 1020(vi00)
    nop                             sqi.xyzw vf20, (vi04++)
    nop                             sqi.xyzw vf21, (vi04++)
    nop                             sqi.xyzw vf22, (vi04++)
    nop                             sqi.xyzw vf23, (vi04++)
    nop                             sqi.xyzw vf24, (vi04++)
    nop                             sqi.xyzw vf25, (vi04++)
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             xgkick vi03                       [E] ; end: the next MSCNT continues at vertices_cont
    nop                             nop

    ; the next MSCNT continues here
vertices_cont:
    nop                             b batch                              ; the next batch
    nop                             nop
.endprogram

;=======================================================================================
; Vu1Prog37: skinned, three lights, material colour, no vertex colours, fog, gMtxUv rows
;
; gVu1ProgInfo37 (bones.c): 354 pairs (2832 bytes), batches of up to 3200 bytes;
; Vu1_SelectProgram's key 0xc202, skinned models (0x321135, 0x221135).
; Setup Vu1Pkt_SLDE: an UNPACK of 244 qwords to VU 0, then MSCALF 0:
;   0        colour: gGsColorF, RGB scaled by the model's brightness: vf28
;   1-4      gMtxView x gMtxProjClip: world to screen (XYZ after the divide by w): vf01-vf04
;   5-8      gMtxView x gViewportMtx: world to the clip test's space: vf05-vf08
;   9-11     light directions (world space, negated): vf29-vf31
;   12-15    light colours (three lights and the ambient): vf24-vf27
;   16       fog range: gGsFogFar and the word after it: vf16
;   17-19    rows 0, 1 and 3 of gMtxUv (Vu1_PutUvMatrix): vf17-vf19
;   20-147   bone matrices: the 32 gMtxSlots the model's mask (e+0x54) selects
; Vertices: gVu1ProgLayouts[8], 5 qwords: position, normal, texture coordinates, bone indices, bone weights.
; Batches at VU 0xf4 and 0xf4 + 0x183 (XTOP); the output follows each.
;=======================================================================================
.program Vu1Prog37
.base 0xf4
.offset 0x183

    ; MSCALF 0: the setup's constants into registers
init:
    nop                             iaddiu vi07, vi00, 32
    nop                             iaddiu vi10, vi00, 20
    nop                             iaddiu vi11, vi00, 148
    nop                             lq.xyzw vf29, 9(vi00)
    nop                             lq.xyzw vf30, 10(vi00)
    nop                             lq.xyzw vf31, 11(vi00)
    nop                             lq.xyzw vf01, 0(vi10)
    nop                             lq.xyzw vf02, 1(vi10)
    nop                             lq.xyzw vf03, 2(vi10)
    nop                             iaddiu vi10, vi10, 4
    addx.x vf04, vf00, vf01x        nop
    addy.x vf05, vf00, vf01y        nop
    addz.x vf06, vf00, vf01z        nop
    addx.y vf04, vf00, vf02x        nop
    addy.y vf05, vf00, vf02y        nop
    addz.y vf06, vf00, vf02z        nop
    addx.z vf04, vf00, vf03x        nop
    addy.z vf05, vf00, vf03y        nop
    addz.z vf06, vf00, vf03z        nop
    nop                             nop
    mulax.xyz ACC, vf04, vf29x      nop
    madday.xyz ACC, vf05, vf29y     nop
    maddz.xyz vf07, vf06, vf29z     nop
    mulax.xyz ACC, vf04, vf30x      nop
    madday.xyz ACC, vf05, vf30y     nop
    maddz.xyz vf08, vf06, vf30z     nop
    mulax.xyz ACC, vf04, vf31x      nop
    madday.xyz ACC, vf05, vf31y     nop
    maddz.xyz vf09, vf06, vf31z     nop
    nop                             nop
    mul.xyz vf10, vf07, vf07        nop
    mul.xyz vf11, vf08, vf08        nop
    mul.xyz vf12, vf09, vf09        nop
    nop                             lq.xyzw vf01, 0(vi10)
    addy.x vf10, vf10, vf10y        lq.xyzw vf02, 1(vi10)
    addy.x vf11, vf11, vf11y        lq.xyzw vf03, 2(vi10)
    addy.x vf12, vf12, vf12y        nop
    nop                             nop
    addz.x vf10, vf10, vf10z        nop
init_loop:
    addz.x vf11, vf11, vf11z        nop
    addz.x vf12, vf12, vf12z        iaddiu vi10, vi10, 4
    addx.x vf04, vf00, vf01x        nop
    addy.x vf05, vf00, vf01y        rsqrt Q, vf00w, vf10x
    addz.x vf06, vf00, vf01z        ersqrt P, vf11x
    addx.y vf04, vf00, vf02x        nop
    addy.y vf05, vf00, vf02y        nop
    addz.y vf06, vf00, vf02z        move.xyzw vf20, vf07
    addx.z vf04, vf00, vf03x        move.xyzw vf21, vf08
    addy.z vf05, vf00, vf03y        move.xyzw vf22, vf09
    addz.z vf06, vf00, vf03z        nop
    nop                             nop
    mulax.xyz ACC, vf04, vf29x      nop
    madday.xyz ACC, vf05, vf29y     nop
    maddz.xyz vf07, vf06, vf29z     nop
    mulax.xyz ACC, vf04, vf30x      nop
    mulq.xyz vf13, vf20, Q          rsqrt Q, vf00w, vf12x
    madday.xyz ACC, vf05, vf30y     nop
    maddz.xyz vf08, vf06, vf30z     nop
    mulax.xyz ACC, vf04, vf31x      nop
    addx.x vf16, vf00, vf13x        nop
    addy.x vf17, vf00, vf13y        nop
    addz.x vf18, vf00, vf13z        mfp.x vf19, P
    madday.xyz ACC, vf05, vf31y     nop
    maddz.xyz vf09, vf06, vf31z     nop
    mul.xyz vf10, vf07, vf07        nop
    mulx.xyz vf14, vf21, vf19x      nop
    mul.xyz vf11, vf08, vf08        nop
    mul.xyz vf12, vf09, vf09        nop
    mulq.xyz vf15, vf22, Q          nop
    addx.y vf16, vf00, vf14x        nop
    addy.y vf17, vf00, vf14y        nop
    addz.y vf18, vf00, vf14z        nop
    addx.z vf16, vf00, vf15x        lq.xyzw vf01, 0(vi10)
    addy.z vf17, vf00, vf15y        lq.xyzw vf02, 1(vi10)
    addz.z vf18, vf00, vf15z        lq.xyzw vf03, 2(vi10)
    addy.x vf10, vf10, vf10y        iaddi vi07, vi07, -1
    addy.x vf11, vf11, vf11y        sqi.xyzw vf16, (vi11++)
    addy.x vf12, vf12, vf12y        sqi.xyzw vf17, (vi11++)
    nop                             ibne vi07, vi00, init_loop
    addz.x vf10, vf10, vf10z        sqi.xyzw vf18, (vi11++)
    addx.x vf09, vf00, vf29x        lq.xyzw vf01, 1(vi00)
    addy.x vf10, vf00, vf29y        lq.xyzw vf02, 2(vi00)
    addz.x vf11, vf00, vf29z        lq.xyzw vf03, 3(vi00)
    addx.y vf09, vf00, vf30x        lq.xyzw vf04, 4(vi00)
    addy.y vf10, vf00, vf30y        lq.xyzw vf05, 5(vi00)
    addz.y vf11, vf00, vf30z        lq.xyzw vf06, 6(vi00)
    addx.z vf09, vf00, vf31x        lq.xyzw vf07, 7(vi00)
    addy.z vf10, vf00, vf31y        lq.xyzw vf08, 8(vi00)
    addz.z vf11, vf00, vf31z        lq.xyzw vf16, 16(vi00)
    nop                             nop
    nop                             sq.xyzw vf09, 9(vi00)
    nop                             sq.xyzw vf10, 10(vi00)
    nop                             sq.xyzw vf11, 11(vi00)
    nop                             nop                               [E] ; end: constants loaded
    nop                             nop

    ; MSCNT: one batch at XTOP; qword 0's x is its type, qword 1 a GIF tag
batch:
    nop                             xtop vi02                            ; vi02: the batch (BASE, or BASE + OFFSET: double buffer)
    nop                             iaddiu vi05, vi02, 0
    nop                             iaddiu vi03, vi02, 200               ; vi03: the output, 200 qwords after the batch
    nop                             iaddiu vi04, vi03, 0
    nop                             ilwr.x vi06, (vi05)                  ; the batch type (qword 0)
    nop                             iaddiu vi05, vi05, 1
    nop                             iaddiu vi11, vi00, 32767             ; 0x7FFF: the NLOOP mask
    nop                             lq.xyzw vf31, 0(vi05)
    nop                             ilwr.x vi08, (vi05)                  ; the GIF tag (qword 1): NLOOP, EOP
    nop                             iand vi07, vi11, vi08
    nop                             iaddiu vi11, vi00, 1
    nop                             iaddiu vi05, vi05, 1
    nop                             ibeq vi11, vi06, rigid
    nop                             sqi.xyzw vf31, (vi04++)
    nop                             iaddiu vi11, vi00, 2
    nop                             nop
    nop                             ibeq vi11, vi06, blended
    nop                             nop

    ; a register block: the GIF tag and its NLOOP qwords (A+D) go through to the output
copy_regs:
    nop                             lq.xyzw vf31, 0(vi05)
    nop                             iaddi vi07, vi07, -1
    nop                             iaddiu vi05, vi05, 1
    nop                             iaddiu vi04, vi04, 1
    nop                             ibne vi07, vi00, copy_regs
    nop                             sq.xyzw vf31, -1(vi04)
    nop                             lqi.xyzw vf29, (vi05++)
    nop                             lq.xyzw vf24, 12(vi00)
    nop                             lq.xyzw vf25, 13(vi00)
    nop                             lq.xyzw vf26, 14(vi00)
    nop                             lq.xyzw vf27, 15(vi00)
    nop                             lq.xyzw vf28, 0(vi00)
    mul.xyzw vf24, vf29, vf24       lqi.xyzw vf30, (vi05++)
    mul.xyzw vf25, vf29, vf25       nop
    mul.xyzw vf26, vf29, vf26       nop
    add.xyzw vf23, vf27, vf28       nop
    ftoi0.xyzw vf29, vf29           loi 128.0                            ; I = 128.0: the colour clamp (0x80 is 1.0 on the GS)
    muli.xyzw vf12, vf24, I         nop
    muli.xyzw vf13, vf25, I         nop
    muli.xyzw vf14, vf26, I         nop
    mul.xyzw vf15, vf23, vf30       mtir vi15, vf29w
    minii.xyzw vf12, vf12, I        nop
    minii.xyzw vf13, vf13, I        nop
    minii.xyzw vf14, vf14, I        nop
    minii.xyzw vf15, vf15, I        nop
    nop                             xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             nop                               [E] ; end: the next MSCNT continues at copy_regs_cont
    nop                             nop

    ; the next MSCNT continues here
copy_regs_cont:
    nop                             b batch                              ; the next batch
    nop                             nop

    ; type 1: vertices of one bone each (qword 3: the bone's matrix addresses)
rigid:
    nop                             iaddiu vi08, vi08, 2                 ; NLOOP + 2: the delay line's last vertices go out first
    nop                             isw.x vi08, -1(vi04)
    nop                             lq.xyzw vf20, 1021(vi00)
    nop                             lq.xyzw vf21, 1022(vi00)
    nop                             lq.xyzw vf22, 1023(vi00)
    nop                             lq.xyzw vf23, 1018(vi00)
    nop                             lq.xyzw vf24, 1019(vi00)
    nop                             lq.xyzw vf25, 1020(vi00)
    nop                             sqi.xyzw vf20, (vi04++)
    nop                             sqi.xyzw vf21, (vi04++)
    nop                             sqi.xyzw vf22, (vi04++)
    nop                             sqi.xyzw vf23, (vi04++)
    nop                             sqi.xyzw vf24, (vi04++)
    nop                             sqi.xyzw vf25, (vi04++)
    nop                             ilw.x vi10, 3(vi05)
    nop                             ilw.y vi11, 3(vi05)
    nop                             lq.xyzw vf29, 0(vi05)
    nop                             lq.xyzw vf30, 1(vi05)
    nop                             lq.xyzw vf20, 0(vi10)
    nop                             lq.xyzw vf21, 1(vi10)
    nop                             lq.xyzw vf22, 2(vi10)
    nop                             lq.xyzw vf23, 3(vi10)
    mulax.xyzw ACC, vf20, vf29x     lq.xyzw vf20, 0(vi11)
    madday.xyzw ACC, vf21, vf29y    lq.xyzw vf21, 1(vi11)
    maddaz.xyzw ACC, vf22, vf29z    lq.xyzw vf22, 2(vi11)
    maddw.xyzw vf25, vf23, vf00w    ilw.w vi09, 0(vi05)                  ; vi09: the position's w word, XYZF2's w (F, ADC) as the model has it
    mulax.xyz ACC, vf20, vf30x      lq.xyzw vf31, 2(vi05)
    madday.xyz ACC, vf21, vf30y     iaddiu vi05, vi05, 5
    maddz.xyz vf26, vf22, vf30z     lq.xyzw vf17, 17(vi00)
    mulax.xyzw ACC, vf01, vf25x     lq.xyzw vf18, 18(vi00)
    madday.xyzw ACC, vf02, vf25y    lq.xyzw vf19, 19(vi00)
    maddaz.xyzw ACC, vf03, vf25z    nop
    maxx.xyzw vf26, vf26, vf00x     nop
    ; one vertex per pass, software-pipelined through the delay line
rigid_loop:
    maddw.xyzw vf28, vf04, vf00w    iaddiu vi14, vi09, 0
    mulax.xy ACC, vf17, vf31x       lq.xyzw vf30, 1(vi05)
    madday.xy ACC, vf18, vf31y      ilw.w vi09, 0(vi05)
    maddw.xy vf31, vf19, vf00w      ilw.x vi10, 3(vi05)
    subw.x vf23, vf16, vf28w        div Q, vf00w, vf28w                  ; Q = 1 / vf28.w
    mulax.xyz ACC, vf12, vf26x      ilw.y vi11, 3(vi05)
    madday.xyz ACC, vf13, vf26y     lq.xyzw vf29, 0(vi05)
    maddaz.xyz ACC, vf14, vf26z     iaddi vi07, vi07, -1
    muly.x vf23, vf23, vf16y        iaddiu vi04, vi04, 3
    maddw.xyz vf26, vf15, vf00w     lq.xyzw vf20, 0(vi10)
    mulax.xyzw ACC, vf05, vf25x     lq.xyzw vf21, 1(vi10)
    mulq.xyz vf28, vf28, Q          loi 255.0                            ; I = 255.0
    muli.x vf23, vf23, I            loi 128.0                            ; I = 128.0: the colour clamp (0x80 is 1.0 on the GS)
    minii.xyzw vf26, vf26, I        lq.xyzw vf22, 2(vi10)
    mulq.xyz vf27, vf31, Q          lq.xyzw vf31, 2(vi05)
    ftoi4.xyz vf28, vf28            loi 255.0
    minii.x vf23, vf23, I           iaddiu vi05, vi05, 5
    ftoi0.xyz vf26, vf26            isw.w vi15, -2(vi04)
    madday.xyzw ACC, vf06, vf25y    sq.xyzw vf27, -3(vi04)
    maddaz.xyzw ACC, vf07, vf25z    sq.xyz vf28, -1(vi04)
    maxx.x vf23, vf23, vf00x        nop
    maddw.xyzw vf24, vf08, vf00w    nop
    mulax.xyzw ACC, vf20, vf29x     lq.xyzw vf25, 3(vi10)
    madday.xyzw ACC, vf21, vf29y    sq.xyz vf26, -2(vi04)
    ftoi4.x vf23, vf23              lq.xyzw vf20, 0(vi11)
    clipw.xyz vf24, vf24w           lq.xyzw vf21, 1(vi11)                ; clip flags: vf24.xyz against +-vf24.w
    maddaz.xyzw ACC, vf22, vf29z    lq.xyzw vf22, 2(vi11)
    maddw.xyzw vf25, vf25, vf00w    nop
    mulax.xyz ACC, vf20, vf30x      mtir vi13, vf23x
    madday.xyz ACC, vf21, vf30y     fcand vi01, 0x03ffff                 ; vi01 = 1: one of the last three vertices is outside the clip volume
    maddz.xyz vf26, vf22, vf30z     ibeq vi01, vi00, rigid_in_view
    mulax.xyzw ACC, vf01, vf25x     nop
    nop                             iaddiu vi14, vi00, 32767             ; ADC: 0x7FFF + 1 = 0x8000, so the GS draws no triangle ending here
    nop                             iaddiu vi14, vi14, 1
    ; the last three vertices are all inside the clip volume
rigid_in_view:
    madday.xyzw ACC, vf02, vf25y    iadd vi14, vi14, vi13
    maddaz.xyzw ACC, vf03, vf25z    ibne vi07, vi00, rigid_loop
    maxx.xyzw vf26, vf26, vf00x     isw.w vi14, -1(vi04)
    ; the epilogue: the vertices left in the delay line
    nop                             lqd.xyzw vf20, (--vi04)
    nop                             lqd.xyzw vf21, (--vi04)
    nop                             lqd.xyzw vf22, (--vi04)
    nop                             lqd.xyzw vf23, (--vi04)
    nop                             lqd.xyzw vf24, (--vi04)
    nop                             lqd.xyzw vf25, (--vi04)
    nop                             sq.xyzw vf20, 1020(vi00)
    nop                             sq.xyzw vf21, 1019(vi00)
    nop                             sq.xyzw vf22, 1018(vi00)
    nop                             sq.xyzw vf23, 1023(vi00)
    nop                             sq.xyzw vf24, 1022(vi00)
    nop                             sq.xyzw vf25, 1021(vi00)
    nop                             xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             nop
    nop                             nop                               [E] ; end: the next MSCNT continues at rigid_cont
    nop                             nop

    ; the next MSCNT continues here
rigid_cont:
    nop                             b batch                              ; the next batch
    nop                             nop

    ; type 2: vertices of four bones (qword 3: the matrix addresses, qword 4: the weights)
blended:
    nop                             iaddiu vi08, vi08, 2                 ; NLOOP + 2: the delay line's last vertices go out first
    nop                             isw.x vi08, -1(vi04)
    nop                             lq.xyzw vf20, 1021(vi00)
    nop                             lq.xyzw vf21, 1022(vi00)
    nop                             lq.xyzw vf22, 1023(vi00)
    nop                             lq.xyzw vf23, 1018(vi00)
    nop                             lq.xyzw vf24, 1019(vi00)
    nop                             lq.xyzw vf25, 1020(vi00)
    nop                             sqi.xyzw vf20, (vi04++)
    nop                             sqi.xyzw vf21, (vi04++)
    nop                             sqi.xyzw vf22, (vi04++)
    nop                             sqi.xyzw vf23, (vi04++)
    nop                             sqi.xyzw vf24, (vi04++)
    nop                             sqi.xyzw vf25, (vi04++)
    nop                             ilw.x vi10, 3(vi05)
    nop                             ilw.y vi11, 3(vi05)
    nop                             ilw.z vi12, 3(vi05)
    nop                             ilw.w vi13, 3(vi05)
    nop                             lq.xyzw vf31, 4(vi05)
    nop                             lq.xyzw vf17, 0(vi10)
    nop                             lq.xyzw vf18, 0(vi11)
    nop                             lq.xyzw vf19, 0(vi12)
    nop                             lq.xyzw vf20, 0(vi13)
    mulax.xyzw ACC, vf17, vf31x     lq.xyzw vf17, 1(vi10)
    madday.xyzw ACC, vf18, vf31y    lq.xyzw vf18, 1(vi11)
    maddaz.xyzw ACC, vf19, vf31z    lq.xyzw vf19, 1(vi12)
    maddw.xyzw vf21, vf20, vf31w    lq.xyzw vf20, 1(vi13)
    mulax.xyzw ACC, vf17, vf31x     lq.xyzw vf17, 2(vi10)
    madday.xyzw ACC, vf18, vf31y    lq.xyzw vf18, 2(vi11)
    maddaz.xyzw ACC, vf19, vf31z    lq.xyzw vf19, 2(vi12)
    maddw.xyzw vf22, vf20, vf31w    lq.xyzw vf20, 2(vi13)
    mulax.xyzw ACC, vf17, vf31x     lq.xyzw vf17, 3(vi10)
    madday.xyzw ACC, vf18, vf31y    lq.xyzw vf18, 3(vi11)
    maddaz.xyzw ACC, vf19, vf31z    lq.xyzw vf19, 3(vi12)
    maddw.xyzw vf23, vf20, vf31w    lq.xyzw vf20, 3(vi13)
    mulax.xyzw ACC, vf17, vf31x     lq.xyzw vf29, 1(vi05)
    madday.xyzw ACC, vf18, vf31y    lq.xyzw vf28, 0(vi05)
    maddaz.xyzw ACC, vf19, vf31z    ilw.w vi09, 0(vi05)                  ; vi09: the position's w word, XYZF2's w (F, ADC) as the model has it
    maddw.xyzw vf24, vf20, vf31w    lq.xyzw vf30, 2(vi05)
    mulax.xyz ACC, vf21, vf29x      iaddiu vi05, vi05, 5
    madday.xyz ACC, vf22, vf29y     nop
    maddz.xyz vf27, vf23, vf29z     nop
    mulax.xyzw ACC, vf21, vf28x     lq.xyzw vf17, 17(vi00)
    madday.xyzw ACC, vf22, vf28y    lq.xyzw vf18, 18(vi00)
    maddaz.xyzw ACC, vf23, vf28z    lq.xyzw vf19, 19(vi00)
    ; one vertex per pass, software-pipelined through the delay line
blended_loop:
    maddw.xyzw vf28, vf24, vf00w    erleng.xyz P, vf27                   ; P = 1 / |vf27.xyz|
    mulax.xy ACC, vf17, vf30x       ilw.x vi10, 3(vi05)
    madday.xy ACC, vf18, vf30y      ilw.y vi11, 3(vi05)
    maddw.xy vf30, vf19, vf00w      ilw.z vi12, 3(vi05)
    mulax.xyzw ACC, vf01, vf28x     ilw.w vi13, 3(vi05)
    madday.xyzw ACC, vf02, vf28y    lq.xyzw vf31, 4(vi05)
    maddaz.xyzw ACC, vf03, vf28z    lq.xyzw vf29, 1(vi05)
    maddw.xyzw vf26, vf04, vf00w    lq.xyzw vf17, 0(vi10)
    mulax.xyzw ACC, vf05, vf28x     lq.xyzw vf18, 0(vi11)
    madday.xyzw ACC, vf06, vf28y    lq.xyzw vf19, 0(vi12)
    maddaz.xyzw ACC, vf07, vf28z    lq.xyzw vf20, 0(vi13)
    subw.x vf23, vf16, vf26w        div Q, vf00w, vf26w                  ; Q = 1 / vf26.w
    maddw.xyzw vf28, vf08, vf00w    iaddi vi07, vi07, -1
    mulax.xyzw ACC, vf17, vf31x     lq.xyzw vf17, 1(vi10)
    madday.xyzw ACC, vf18, vf31y    lq.xyzw vf18, 1(vi11)
    muly.x vf23, vf23, vf16y        isw.w vi15, 1(vi04)
    clipw.xyz vf28, vf28w           iaddiu vi04, vi04, 3                 ; clip flags: vf28.xyz against +-vf28.w
    maddaz.xyzw ACC, vf19, vf31z    lq.xyzw vf19, 1(vi12)
    mulq.xyz vf26, vf26, Q          loi 255.0                            ; I = 255.0
    muli.x vf23, vf23, I            iaddiu vi14, vi09, 0
    mulq.xyz vf30, vf30, Q          fcand vi01, 0x03ffff                 ; vi01 = 1: one of the last three vertices is outside the clip volume
    maddw.xyzw vf21, vf20, vf31w    ibeq vi01, vi00, blended_in_view
    ftoi4.xyz vf26, vf26            lq.xyzw vf20, 1(vi13)
    nop                             iaddiu vi14, vi00, 32767             ; ADC: 0x7FFF + 1 = 0x8000, so the GS draws no triangle ending here
    nop                             iaddiu vi14, vi14, 1
    ; the last three vertices are all inside the clip volume
blended_in_view:
    minii.x vf23, vf23, I           ilw.w vi09, 0(vi05)
    mulax.xyzw ACC, vf17, vf31x     mfp.w vf27, P
    madday.xyzw ACC, vf18, vf31y    sq.xyzw vf30, -3(vi04)
    maddaz.xyzw ACC, vf19, vf31z    sq.xyz vf26, -1(vi04)
    maxx.x vf23, vf23, vf00x        lq.xyzw vf17, 2(vi10)
    mulw.xyz vf27, vf27, vf27w      lq.xyzw vf18, 2(vi11)
    maddw.xyzw vf22, vf20, vf31w    lq.xyzw vf19, 2(vi12)
    nop                             lq.xyzw vf20, 2(vi13)
    ftoi4.x vf23, vf23              lq.xyzw vf28, 0(vi05)
    mulax.xyz ACC, vf09, vf27x      lq.xyzw vf30, 2(vi05)
    madday.xyz ACC, vf10, vf27y     iaddiu vi05, vi05, 5
    maddz.xyz vf27, vf11, vf27z     nop
    mulax.xyzw ACC, vf17, vf31x     mtir vi01, vf23x
    madday.xyzw ACC, vf18, vf31y    lq.xyzw vf17, 3(vi10)
    maddaz.xyzw ACC, vf19, vf31z    lq.xyzw vf18, 3(vi11)
    maxx.xyz vf27, vf27, vf00x      lq.xyzw vf19, 3(vi12)
    maddw.xyzw vf23, vf20, vf31w    iadd vi14, vi14, vi01
    nop                             lq.xyzw vf20, 3(vi13)
    nop                             nop
    mulax.xyz ACC, vf12, vf27x      nop
    madday.xyz ACC, vf13, vf27y     isw.w vi14, -1(vi04)
    maddaz.xyz ACC, vf14, vf27z     nop
    maddw.xyz vf25, vf15, vf00w     nop
    mulax.xyzw ACC, vf17, vf31x     nop
    madday.xyzw ACC, vf18, vf31y    nop
    maddaz.xyzw ACC, vf19, vf31z    loi 128.0                            ; I = 128.0: the colour clamp (0x80 is 1.0 on the GS)
    minii.xyz vf25, vf25, I         nop
    maddw.xyzw vf24, vf20, vf31w    nop
    mulax.xyz ACC, vf21, vf29x      nop
    madday.xyz ACC, vf22, vf29y     nop
    ftoi0.xyz vf25, vf25            lq.xyzw vf17, 17(vi00)
    maddz.xyz vf27, vf23, vf29z     lq.xyzw vf18, 18(vi00)
    mulax.xyzw ACC, vf21, vf28x     lq.xyzw vf19, 19(vi00)
    madday.xyzw ACC, vf22, vf28y    ibne vi07, vi00, blended_loop
    maddaz.xyzw ACC, vf23, vf28z    sq.xyz vf25, -2(vi04)
    ; the epilogue: the vertices left in the delay line
    nop                             lqd.xyzw vf20, (--vi04)
    nop                             lqd.xyzw vf21, (--vi04)
    nop                             lqd.xyzw vf22, (--vi04)
    nop                             lqd.xyzw vf23, (--vi04)
    nop                             lqd.xyzw vf24, (--vi04)
    nop                             lqd.xyzw vf25, (--vi04)
    nop                             sq.xyzw vf20, 1020(vi00)
    nop                             sq.xyzw vf21, 1019(vi00)
    nop                             sq.xyzw vf22, 1018(vi00)
    nop                             sq.xyzw vf23, 1023(vi00)
    nop                             sq.xyzw vf24, 1022(vi00)
    nop                             sq.xyzw vf25, 1021(vi00)
    nop                             xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             nop
    nop                             nop                               [E] ; end: the next MSCNT continues at blended_cont
    nop                             nop

    ; the next MSCNT continues here
blended_cont:
    nop                             b batch                              ; the next batch
    nop                             nop
.endprogram

;=======================================================================================
; Vu1Prog38: three lights, material colour, no vertex colours, fog, second colour, gMtxUv rows
;
; gVu1ProgInfo38 (bones.c): 129 pairs (1032 bytes), batches of up to 3840 bytes;
; Vu1_SelectProgram's key 0x2c202, rigid models (0x21035, 0x121035).
; Setup Vu1Pkt_LDVE: an UNPACK of 21 qwords to VU 0, then MSCALF 0:
;   0        colour: gGsColorF, RGB scaled by the model's brightness: vf28
;   1        second colour: gGsColor2F: vf20
;   2-5      gMtxSlots x gMtxView x gMtxProjClip: model to screen (XYZ after the divide by w): vf01-vf04
;   6-9      the matrix above x gViewportMtx: model to the clip test's space: vf05-vf08
;   10-12    light directions (model space, negated): vf09-vf11
;   13-16    light colours (three lights and the ambient): vf24-vf27
;   17-19    rows 0, 1 and 3 of gMtxUv (Vu1_PutUvMatrix): vf16-vf18
;   20       fog range: gGsFogFar and the word after it: vf19
; Vertices: gVu1ProgLayouts[0], 3 qwords: position, normal, texture coordinates.
; Batches at VU 0x15 and 0x15 + 0x1f3 (XTOP); the output follows each.
;=======================================================================================
.program Vu1Prog38
.base 0x15
.offset 0x1f3

    ; MSCALF 0: the setup's constants into registers
init:
    nop                             lq.xyzw vf01, 2(vi00)
    nop                             lq.xyzw vf02, 3(vi00)
    nop                             lq.xyzw vf03, 4(vi00)
    nop                             lq.xyzw vf04, 5(vi00)
    nop                             lq.xyzw vf05, 6(vi00)
    nop                             lq.xyzw vf06, 7(vi00)
    nop                             lq.xyzw vf07, 8(vi00)
    nop                             lq.xyzw vf08, 9(vi00)
    nop                             lq.xyzw vf09, 10(vi00)
    nop                             lq.xyzw vf10, 11(vi00)
    nop                             lq.xyzw vf11, 12(vi00)
    nop                             lq.xyzw vf16, 17(vi00)
    nop                             lq.xyzw vf17, 18(vi00)
    nop                             lq.xyzw vf18, 19(vi00)
    nop                             lq.xyzw vf19, 20(vi00)
    nop                             lq.xyzw vf20, 1(vi00)
    nop                             nop                               [E] ; end: constants loaded
    nop                             nop

    ; MSCNT: one batch at XTOP; qword 0's x is its type, qword 1 a GIF tag
batch:
    nop                             xtop vi02                            ; vi02: the batch (BASE, or BASE + OFFSET: double buffer)
    nop                             iaddiu vi05, vi02, 0
    nop                             iaddiu vi03, vi02, 240               ; vi03: the output, 240 qwords after the batch
    nop                             ilwr.x vi06, (vi05)                  ; the batch type (qword 0)
    nop                             iaddiu vi05, vi05, 1
    nop                             ilwr.x vi08, (vi05)                  ; the GIF tag (qword 1): NLOOP, EOP
    nop                             iaddiu vi04, vi03, 0
    nop                             iaddiu vi11, vi00, 32767             ; 0x7FFF: the NLOOP mask
    nop                             lq.xyzw vf31, 0(vi05)
    nop                             iand vi07, vi11, vi08
    nop                             iaddiu vi11, vi00, 1
    nop                             iaddiu vi05, vi05, 1
    nop                             ibeq vi11, vi06, vertices
    nop                             sqi.xyzw vf31, (vi04++)

    ; a register block: the GIF tag and its NLOOP qwords (A+D) go through to the output
copy_regs:
    nop                             lq.xyzw vf30, 0(vi05)
    nop                             iaddi vi07, vi07, -1
    nop                             iaddiu vi05, vi05, 1
    nop                             iaddiu vi04, vi04, 1
    nop                             ibne vi07, vi00, copy_regs
    nop                             sq.xyzw vf30, -1(vi04)
    nop                             lqi.xyzw vf29, (vi05++)
    nop                             lq.xyzw vf24, 13(vi00)
    nop                             lq.xyzw vf25, 14(vi00)
    nop                             lq.xyzw vf26, 15(vi00)
    nop                             lq.xyzw vf27, 16(vi00)
    mul.xyzw vf24, vf29, vf24       lq.xyzw vf28, 0(vi00)
    mul.xyzw vf25, vf29, vf25       lqi.xyzw vf30, (vi05++)
    mul.xyzw vf26, vf29, vf26       nop
    mul.xyzw vf29, vf29, vf20       loi 128.0                            ; I = 128.0: the colour clamp (0x80 is 1.0 on the GS)
    add.xyzw vf23, vf27, vf28       nop
    muli.xyzw vf12, vf24, I         nop
    muli.xyzw vf13, vf25, I         nop
    muli.xyzw vf14, vf26, I         nop
    ftoi0.xyzw vf29, vf29           nop
    mul.xyzw vf15, vf23, vf30       nop
    minii.xyzw vf12, vf12, I        nop
    minii.xyzw vf13, vf13, I        nop
    minii.xyzw vf14, vf14, I        mtir vi15, vf29w
    minii.xyzw vf15, vf15, I        xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             nop                               [E] ; end: the next MSCNT continues at copy_regs_cont
    nop                             nop

    ; the next MSCNT continues here
copy_regs_cont:
    nop                             b batch                              ; the next batch
    nop                             nop

    ; type 1: a strip of NLOOP vertices
vertices:
    nop                             iaddiu vi08, vi08, 2                 ; NLOOP + 2: the delay line's last vertices go out first
    nop                             isw.x vi08, -1(vi04)
    nop                             ilw.w vi09, 0(vi05)                  ; vi09: the position's w word, XYZF2's w (F, ADC) as the model has it
    nop                             lq.xyzw vf29, 0(vi05)
    nop                             lq.xyzw vf30, 1(vi05)
    nop                             lq.xyzw vf31, 2(vi05)
    nop                             iaddiu vi05, vi05, 3
    mulax.xyzw ACC, vf01, vf29x     nop
    madday.xyzw ACC, vf02, vf29y    nop
    maddaz.xyzw ACC, vf03, vf29z    nop
    maddw.xyzw vf28, vf04, vf00w    nop
    mulax.xyzw ACC, vf09, vf30x     nop
    madday.xyzw ACC, vf10, vf30y    nop
    maddz.xyzw vf25, vf11, vf30z    nop
    ; one vertex per pass, software-pipelined through the delay line
vertices_loop:
    subw.x vf27, vf19, vf28w        div Q, vf00w, vf28w                  ; Q = 1 / vf28.w
    mulax.xyzw ACC, vf05, vf29x     nop
    madday.xyzw ACC, vf06, vf29y    iaddiu vi14, vi09, 0
    maxx.xyzw vf25, vf25, vf00x     lq.xyzw vf21, 1021(vi00)
    muly.x vf27, vf27, vf19y        lq.xyzw vf22, 1022(vi00)
    maddaz.xyzw ACC, vf07, vf29z    lq.xyzw vf23, 1023(vi00)
    maddw.xyzw vf24, vf08, vf00w    loi 255.0                            ; I = 255.0
    mulax.xyzw ACC, vf12, vf25x     sqi.xyzw vf21, (vi04++)
    madday.xyzw ACC, vf13, vf25y    sqi.xyzw vf22, (vi04++)
    maddz.xyzw vf25, vf14, vf25z    sqi.xyzw vf23, (vi04++)
    muli.x vf27, vf27, I            iaddi vi07, vi07, -1
    clipw.xyz vf24, vf24w           lq.xyzw vf21, 1018(vi00)             ; clip flags: vf24.xyz against +-vf24.w
    mulax.xy ACC, vf16, vf31x       lq.xyzw vf22, 1019(vi00)
    add.xyzw vf25, vf25, vf15       lq.xyzw vf23, 1020(vi00)
    minii.x vf27, vf27, I           loi 128.0                            ; I = 128.0: the colour clamp (0x80 is 1.0 on the GS)
    madday.xy ACC, vf17, vf31y      fcand vi01, 0x03ffff                 ; vi01 = 1: one of the last three vertices is outside the clip volume
    maddw.xy vf31, vf18, vf00w      ibeq vi01, vi00, vertices_in_view
    minii.xyzw vf25, vf25, I        sq.xyzw vf21, 1021(vi00)
    nop                             iaddiu vi14, vi00, 32767             ; ADC: 0x7FFF + 1 = 0x8000, so the GS draws no triangle ending here
    nop                             iaddiu vi14, vi14, 1
    ; the last three vertices are all inside the clip volume
vertices_in_view:
    maxx.x vf27, vf27, vf00x        sq.xyzw vf22, 1022(vi00)
    mulq.xyz vf28, vf28, Q          sq.xyzw vf23, 1023(vi00)
    mulq.xyz vf26, vf31, Q          lq.xyzw vf29, 0(vi05)
    mul.xyzw vf25, vf25, vf20       lq.xyzw vf30, 1(vi05)
    ftoi4.x vf27, vf27              ilw.w vi09, 0(vi05)
    ftoi4.xyz vf28, vf28            lq.xyzw vf31, 2(vi05)
    mulax.xyzw ACC, vf01, vf29x     sq.xyzw vf26, 1018(vi00)
    ftoi0.xyzw vf25, vf25           iaddiu vi05, vi05, 3
    madday.xyzw ACC, vf02, vf29y    mtir vi13, vf27x
    maddaz.xyzw ACC, vf03, vf29z    sq.xyz vf28, 1020(vi00)
    maddw.xyzw vf28, vf04, vf00w    isw.w vi15, 1019(vi00)
    nop                             sq.xyz vf25, 1019(vi00)
    mulax.xyzw ACC, vf09, vf30x     iadd vi14, vi14, vi13
    madday.xyzw ACC, vf10, vf30y    ibne vi07, vi00, vertices_loop
    maddz.xyzw vf25, vf11, vf30z    isw.w vi14, 1020(vi00)
    ; the epilogue: the vertices left in the delay line
    nop                             lq.xyzw vf21, 1021(vi00)
    nop                             lq.xyzw vf22, 1022(vi00)
    nop                             lq.xyzw vf23, 1023(vi00)
    nop                             lq.xyzw vf24, 1018(vi00)
    nop                             lq.xyzw vf25, 1019(vi00)
    nop                             lq.xyzw vf26, 1020(vi00)
    nop                             sqi.xyzw vf21, (vi04++)
    nop                             sqi.xyzw vf22, (vi04++)
    nop                             sqi.xyzw vf23, (vi04++)
    nop                             sqi.xyzw vf24, (vi04++)
    nop                             sqi.xyzw vf25, (vi04++)
    nop                             sqi.xyzw vf26, (vi04++)
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             xgkick vi03                       [E] ; end: the next MSCNT continues at vertices_cont
    nop                             nop

    ; the next MSCNT continues here
vertices_cont:
    nop                             b batch                              ; the next batch
    nop                             nop
.endprogram

;=======================================================================================
; Vu1Prog39: three lights, fog, gMtxUv rows
;
; gVu1ProgInfo39 (bones.c): 128 pairs (1024 bytes), batches of up to 4000 bytes;
; Vu1_SelectProgram's key 0xc200, rigid models (0x21035, 0x121035).
; Setup Vu1Pkt_LDE: an UNPACK of 20 qwords to VU 0, then MSCALF 0:
;   0        colour: gGsColorF, RGB scaled by the model's brightness: vf20
;   1-4      gMtxSlots x gMtxView x gMtxProjClip: model to screen (XYZ after the divide by w): vf01-vf04
;   5-8      the matrix above x gViewportMtx: model to the clip test's space: vf05-vf08
;   9-11     light directions (model space, negated): vf09-vf11
;   12-15    light colours (three lights and the ambient): vf12-vf15
;   16-18    rows 0, 1 and 3 of gMtxUv (Vu1_PutUvMatrix): vf16-vf18
;   19       fog range: gGsFogFar and the word after it: vf19
; Vertices: gVu1ProgLayouts[1], 4 qwords: position, normal, colour, texture coordinates.
; Batches at VU 0x14 and 0x14 + 0x1f3 (XTOP); the output follows each.
;=======================================================================================
.program Vu1Prog39
.base 0x14
.offset 0x1f3

    ; MSCALF 0: the setup's constants into registers
init:
    nop                             lq.xyzw vf10, 10(vi00)
    nop                             lq.xyzw vf11, 11(vi00)
    nop                             lq.xyzw vf12, 12(vi00)
    nop                             lq.xyzw vf13, 13(vi00)
    nop                             lq.xyzw vf14, 14(vi00)
    nop                             lq.xyzw vf15, 15(vi00)
    nop                             lq.xyzw vf16, 16(vi00)
    nop                             lq.xyzw vf17, 17(vi00)
    nop                             lq.xyzw vf18, 18(vi00)
    nop                             lq.xyzw vf19, 19(vi00)
    nop                             lq.xyzw vf20, 0(vi00)
    nop                             lq.xyzw vf01, 1(vi00)
    nop                             lq.xyzw vf02, 2(vi00)
    nop                             loi 128.0                            ; I = 128.0: the colour clamp (0x80 is 1.0 on the GS)
    muli.xyzw vf12, vf12, I         lq.xyzw vf03, 3(vi00)
    muli.xyzw vf13, vf13, I         lq.xyzw vf04, 4(vi00)
    muli.xyzw vf14, vf14, I         lq.xyzw vf05, 5(vi00)
    nop                             lq.xyzw vf06, 6(vi00)
    minii.xyzw vf12, vf12, I        lq.xyzw vf07, 7(vi00)
    minii.xyzw vf13, vf13, I        lq.xyzw vf08, 8(vi00)
    minii.xyzw vf14, vf14, I        lq.xyzw vf09, 9(vi00)
    nop                             nop                               [E] ; end: constants loaded
    nop                             nop

    ; MSCNT: one batch at XTOP; qword 0's x is its type, qword 1 a GIF tag
batch:
    nop                             xtop vi02                            ; vi02: the batch (BASE, or BASE + OFFSET: double buffer)
    nop                             iaddiu vi05, vi02, 0
    nop                             iaddiu vi03, vi02, 250               ; vi03: the output, 250 qwords after the batch
    nop                             ilwr.x vi06, (vi05)                  ; the batch type (qword 0)
    nop                             iaddiu vi05, vi05, 1
    nop                             ilwr.x vi08, (vi05)                  ; the GIF tag (qword 1): NLOOP, EOP
    nop                             iaddiu vi04, vi03, 0
    nop                             iaddiu vi11, vi00, 32767             ; 0x7FFF: the NLOOP mask
    nop                             lq.xyzw vf31, 0(vi05)
    nop                             iand vi07, vi11, vi08
    nop                             iaddiu vi11, vi00, 1
    nop                             iaddiu vi05, vi05, 1
    nop                             ibeq vi11, vi06, vertices
    nop                             sqi.xyzw vf31, (vi04++)

    ; a register block: the GIF tag and its NLOOP qwords (A+D) go through to the output
copy_regs:
    nop                             lq.xyzw vf30, 0(vi05)
    nop                             iaddi vi07, vi07, -1
    nop                             iaddiu vi05, vi05, 1
    nop                             iaddiu vi04, vi04, 1
    nop                             ibne vi07, vi00, copy_regs
    nop                             sq.xyzw vf30, -1(vi04)
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             nop                               [E] ; end: the next MSCNT continues at copy_regs_cont
    nop                             nop

    ; the next MSCNT continues here
copy_regs_cont:
    nop                             b batch                              ; the next batch
    nop                             nop

    ; type 1: a strip of NLOOP vertices
vertices:
    nop                             lq.xyzw vf28, 0(vi05)
    nop                             nop
    nop                             nop
    nop                             nop
    mulax.xyzw ACC, vf01, vf28x     lq.xyzw vf31, 3(vi05)
    madday.xyzw ACC, vf02, vf28y    nop
    maddaz.xyzw ACC, vf03, vf28z    iaddiu vi08, vi08, 2                 ; NLOOP + 2: the delay line's last vertices go out first
    maddw.xyzw vf27, vf04, vf00w    isw.x vi08, -1(vi04)
    mulax.xy ACC, vf16, vf31x       lq.xyzw vf21, 1021(vi00)
    madday.xy ACC, vf17, vf31y      lq.xyzw vf22, 1022(vi00)
    maddw.xy vf31, vf18, vf00w      lq.xyzw vf29, 1(vi05)
    mulax.xyzw ACC, vf05, vf28x     div Q, vf00w, vf27w                  ; Q = 1 / vf27.w
    madday.xyzw ACC, vf06, vf28y    lq.xyzw vf23, 1023(vi00)
    maddaz.xyzw ACC, vf07, vf28z    sqi.xyzw vf21, (vi04++)
    maddw.xyzw vf21, vf08, vf00w    lq.xyzw vf24, 1018(vi00)
    mulax.xyzw ACC, vf09, vf29x     lq.xyzw vf25, 1019(vi00)
    madday.xyzw ACC, vf10, vf29y    sqi.xyzw vf22, (vi04++)
    maddz.xyzw vf22, vf11, vf29z    lq.xyzw vf26, 1020(vi00)
    mulq.xyz vf27, vf27, Q          sqi.xyzw vf23, (vi04++)
    mulq.xyz vf23, vf31, Q          nop
    nop                             sqi.xyzw vf24, (vi04++)
    maxx.xyzw vf22, vf22, vf00x     sqi.xyzw vf25, (vi04++)
    ftoi4.xyz vf27, vf27            sqi.xyzw vf26, (vi04++)
    ; one vertex per pass, software-pipelined through the delay line
vertices_loop:
    nop                             sq.xyzw vf23, 0(vi04)
    clipw.xyz vf21, vf21w           ilw.w vi09, 0(vi05)                  ; vi09: the position's w word, XYZF2's w (F, ADC) as the model has it
    mulax.xyz ACC, vf12, vf22x      lq.xyzw vf30, 2(vi05)
    subw.x vf24, vf19, vf27w        sq.xyz vf27, 2(vi04)
    madday.xyz ACC, vf13, vf22y     iaddiu vi05, vi05, 4
    maddaz.xyz ACC, vf14, vf22z     lq.xyzw vf28, 0(vi05)
    madda.xyz ACC, vf15, vf30       nop
    muly.x vf24, vf24, vf19y        nop
    madd.xyz vf30, vf20, vf30       nop
    mulax.xyzw ACC, vf01, vf28x     lq.xyzw vf31, 3(vi05)
    madday.xyzw ACC, vf02, vf28y    loi 255.0                            ; I = 255.0
    muli.x vf24, vf24, I            loi 128.0                            ; I = 128.0: the colour clamp (0x80 is 1.0 on the GS)
    minii.xyzw vf22, vf30, I        nop
    maddaz.xyzw ACC, vf03, vf28z    nop
    maddw.xyzw vf27, vf04, vf00w    nop
    mulax.xy ACC, vf16, vf31x       loi 255.0
    minii.x vf24, vf24, I           nop
    ftoi0.xyzw vf22, vf22           nop
    madday.xy ACC, vf17, vf31y      div Q, vf00w, vf27w
    maddw.xy vf31, vf18, vf00w      lq.xyzw vf29, 1(vi05)
    maxx.x vf24, vf24, vf00x        nop
    mulax.xyzw ACC, vf05, vf28x     sq.xyzw vf22, 1(vi04)
    madday.xyzw ACC, vf06, vf28y    nop
    maddaz.xyzw ACC, vf07, vf28z    nop
    ftoi4.x vf24, vf24              nop
    maddw.xyzw vf21, vf08, vf00w    nop
    mulax.xyzw ACC, vf09, vf29x     fcand vi01, 0x03ffff                 ; vi01 = 1: one of the last three vertices is outside the clip volume
    madday.xyzw ACC, vf10, vf29y    ibeq vi01, vi00, vertices_in_view
    maddz.xyzw vf22, vf11, vf29z    mtir vi13, vf24x
    nop                             iaddiu vi09, vi00, 32767
    nop                             iaddiu vi09, vi09, 1
    ; the last three vertices are all inside the clip volume
vertices_in_view:
    mulq.xyz vf27, vf27, Q          nop
    mulq.xyz vf23, vf31, Q          iaddiu vi04, vi04, 3
    nop                             iaddi vi07, vi07, -1
    maxx.xyzw vf22, vf22, vf00x     iadd vi09, vi09, vi13
    ftoi4.xyz vf27, vf27            ibne vi07, vi00, vertices_loop
    nop                             isw.w vi09, -1(vi04)
    ; the epilogue: the vertices left in the delay line
    nop                             lqd.xyzw vf21, (--vi04)
    nop                             lqd.xyzw vf22, (--vi04)
    nop                             lqd.xyzw vf23, (--vi04)
    nop                             lqd.xyzw vf24, (--vi04)
    nop                             lqd.xyzw vf25, (--vi04)
    nop                             lqd.xyzw vf26, (--vi04)
    nop                             sq.xyzw vf21, 1020(vi00)
    nop                             sq.xyzw vf22, 1019(vi00)
    nop                             sq.xyzw vf23, 1018(vi00)
    nop                             sq.xyzw vf24, 1023(vi00)
    nop                             sq.xyzw vf25, 1022(vi00)
    nop                             sq.xyzw vf26, 1021(vi00)
    nop                             xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             nop                               [E] ; end: the next MSCNT continues at vertices_cont
    nop                             nop

    ; the next MSCNT continues here
vertices_cont:
    nop                             b batch                              ; the next batch
    nop                             nop
.endprogram

;=======================================================================================
; Vu1Prog40: three lights, fog, second colour, gMtxUv rows
;
; gVu1ProgInfo40 (bones.c): 129 pairs (1032 bytes), batches of up to 3840 bytes;
; Vu1_SelectProgram's key 0x2c200, rigid models (0x21035, 0x121035).
; Setup Vu1Pkt_LDVE: an UNPACK of 21 qwords to VU 0, then MSCALF 0:
;   0        colour: gGsColorF, RGB scaled by the model's brightness: vf21
;   1        second colour: gGsColor2F: vf20
;   2-5      gMtxSlots x gMtxView x gMtxProjClip: model to screen (XYZ after the divide by w): vf01-vf04
;   6-9      the matrix above x gViewportMtx: model to the clip test's space: vf05-vf08
;   10-12    light directions (model space, negated): vf09-vf11
;   13-16    light colours (three lights and the ambient): vf12-vf15
;   17-19    rows 0, 1 and 3 of gMtxUv (Vu1_PutUvMatrix): vf16-vf18
;   20       fog range: gGsFogFar and the word after it: vf19
; Vertices: gVu1ProgLayouts[1], 4 qwords: position, normal, colour, texture coordinates.
; Batches at VU 0x15 and 0x15 + 0x1f3 (XTOP); the output follows each.
;=======================================================================================
.program Vu1Prog40
.base 0x15
.offset 0x1f3

    ; MSCALF 0: the setup's constants into registers
init:
    nop                             lq.xyzw vf10, 11(vi00)
    nop                             lq.xyzw vf11, 12(vi00)
    nop                             lq.xyzw vf12, 13(vi00)
    nop                             lq.xyzw vf13, 14(vi00)
    nop                             lq.xyzw vf14, 15(vi00)
    nop                             lq.xyzw vf15, 16(vi00)
    nop                             lq.xyzw vf16, 17(vi00)
    nop                             lq.xyzw vf17, 18(vi00)
    nop                             lq.xyzw vf18, 19(vi00)
    nop                             lq.xyzw vf19, 20(vi00)
    nop                             lq.xyzw vf20, 1(vi00)
    nop                             lq.xyzw vf21, 0(vi00)
    nop                             lq.xyzw vf01, 2(vi00)
    nop                             lq.xyzw vf02, 3(vi00)
    nop                             loi 128.0                            ; I = 128.0: the colour clamp (0x80 is 1.0 on the GS)
    muli.xyzw vf12, vf12, I         lq.xyzw vf03, 4(vi00)
    muli.xyzw vf13, vf13, I         lq.xyzw vf04, 5(vi00)
    muli.xyzw vf14, vf14, I         lq.xyzw vf05, 6(vi00)
    nop                             lq.xyzw vf06, 7(vi00)
    minii.xyzw vf12, vf12, I        lq.xyzw vf07, 8(vi00)
    minii.xyzw vf13, vf13, I        lq.xyzw vf08, 9(vi00)
    minii.xyzw vf14, vf14, I        lq.xyzw vf09, 10(vi00)
    nop                             nop                               [E] ; end: constants loaded
    nop                             nop

    ; MSCNT: one batch at XTOP; qword 0's x is its type, qword 1 a GIF tag
batch:
    nop                             xtop vi02                            ; vi02: the batch (BASE, or BASE + OFFSET: double buffer)
    nop                             iaddiu vi05, vi02, 0
    nop                             iaddiu vi03, vi02, 240               ; vi03: the output, 240 qwords after the batch
    nop                             ilwr.x vi06, (vi05)                  ; the batch type (qword 0)
    nop                             iaddiu vi05, vi05, 1
    nop                             ilwr.x vi08, (vi05)                  ; the GIF tag (qword 1): NLOOP, EOP
    nop                             iaddiu vi04, vi03, 0
    nop                             iaddiu vi11, vi00, 32767             ; 0x7FFF: the NLOOP mask
    nop                             lq.xyzw vf31, 0(vi05)
    nop                             iand vi07, vi11, vi08
    nop                             iaddiu vi11, vi00, 1
    nop                             iaddiu vi05, vi05, 1
    nop                             ibeq vi11, vi06, vertices
    nop                             sqi.xyzw vf31, (vi04++)

    ; a register block: the GIF tag and its NLOOP qwords (A+D) go through to the output
copy_regs:
    nop                             lq.xyzw vf30, 0(vi05)
    nop                             iaddi vi07, vi07, -1
    nop                             iaddiu vi05, vi05, 1
    nop                             iaddiu vi04, vi04, 1
    nop                             ibne vi07, vi00, copy_regs
    nop                             sq.xyzw vf30, -1(vi04)
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             nop                               [E] ; end: the next MSCNT continues at copy_regs_cont
    nop                             nop

    ; the next MSCNT continues here
copy_regs_cont:
    nop                             b batch                              ; the next batch
    nop                             nop

    ; type 1: a strip of NLOOP vertices
vertices:
    nop                             lq.xyzw vf28, 0(vi05)
    nop                             iaddiu vi08, vi08, 2                 ; NLOOP + 2: the delay line's last vertices go out first
    nop                             isw.x vi08, -1(vi04)
    nop                             nop
    mulax.xyzw ACC, vf01, vf28x     lq.xyzw vf31, 3(vi05)
    madday.xyzw ACC, vf02, vf28y    nop
    maddaz.xyzw ACC, vf03, vf28z    nop
    maddw.xyzw vf27, vf04, vf00w    lq.xyzw vf22, 1021(vi00)
    mulax.xy ACC, vf16, vf31x       lq.xyzw vf23, 1022(vi00)
    madday.xy ACC, vf17, vf31y      lq.xyzw vf24, 1023(vi00)
    maddw.xy vf31, vf18, vf00w      lq.xyzw vf29, 1(vi05)
    mulax.xyzw ACC, vf05, vf28x     div Q, vf00w, vf27w                  ; Q = 1 / vf27.w
    madday.xyzw ACC, vf06, vf28y    nop
    maddaz.xyzw ACC, vf07, vf28z    sqi.xyzw vf22, (vi04++)
    maddw.xyzw vf26, vf08, vf00w    sqi.xyzw vf23, (vi04++)
    mulax.xyz ACC, vf09, vf29x      sqi.xyzw vf24, (vi04++)
    madday.xyz ACC, vf10, vf29y     lq.xyzw vf24, 1018(vi00)
    maddz.xyz vf25, vf11, vf29z     lq.xyzw vf23, 1019(vi00)
    mulq.xyz vf27, vf27, Q          lq.xyzw vf22, 1020(vi00)
    mulq.xyz vf31, vf31, Q          nop
    nop                             sqi.xyzw vf24, (vi04++)
    maxx.xyz vf25, vf25, vf00x      sqi.xyzw vf23, (vi04++)
    ftoi4.xyz vf27, vf27            sqi.xyzw vf22, (vi04++)
    ; one vertex per pass, software-pipelined through the delay line
vertices_loop:
    nop                             sq.xyzw vf31, 0(vi04)
    clipw.xyz vf26, vf26w           ilw.w vi09, 0(vi05)                  ; vi09: the position's w word, XYZF2's w (F, ADC) as the model has it
    mulax.xyz ACC, vf12, vf25x      lq.xyzw vf30, 2(vi05)
    subw.x vf24, vf19, vf27w        sq.xyz vf27, 2(vi04)
    madday.xyz ACC, vf13, vf25y     iaddiu vi05, vi05, 4
    maddaz.xyz ACC, vf14, vf25z     lq.xyzw vf28, 0(vi05)
    madda.xyz ACC, vf15, vf30       iaddiu vi14, vi09, 0
    muly.x vf24, vf24, vf19y        nop
    madd.xyz vf30, vf21, vf30       nop
    mulax.xyzw ACC, vf01, vf28x     lq.xyzw vf31, 3(vi05)
    madday.xyzw ACC, vf02, vf28y    loi 255.0                            ; I = 255.0
    muli.x vf24, vf24, I            loi 128.0                            ; I = 128.0: the colour clamp (0x80 is 1.0 on the GS)
    minii.xyzw vf25, vf30, I        nop
    maddaz.xyzw ACC, vf03, vf28z    nop
    maddw.xyzw vf27, vf04, vf00w    nop
    mulax.xy ACC, vf16, vf31x       loi 255.0
    minii.x vf24, vf24, I           nop
    mul.xyzw vf25, vf25, vf20       nop
    madday.xy ACC, vf17, vf31y      div Q, vf00w, vf27w
    maddw.xy vf31, vf18, vf00w      lq.xyzw vf29, 1(vi05)
    maxx.x vf24, vf24, vf00x        nop
    ftoi0.xyzw vf25, vf25           nop
    mulax.xyzw ACC, vf05, vf28x     nop
    madday.xyzw ACC, vf06, vf28y    nop
    ftoi4.x vf24, vf24              nop
    maddaz.xyzw ACC, vf07, vf28z    sq.xyzw vf25, 1(vi04)
    maddw.xyzw vf26, vf08, vf00w    fcand vi01, 0x03ffff                 ; vi01 = 1: one of the last three vertices is outside the clip volume
    mulax.xyz ACC, vf09, vf29x      ibeq vi01, vi00, vertices_in_view
    madday.xyz ACC, vf10, vf29y     mtir vi13, vf24x
