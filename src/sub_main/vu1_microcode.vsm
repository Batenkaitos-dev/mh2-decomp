    nop                             iaddiu vi05, vi05, 1
    nop                             ilwr.x vi08, (vi05)                  ; the GIF tag (qword 1): NLOOP, EOP
    nop                             iaddiu vi11, vi00, 32767             ; 0x7FFF: the NLOOP mask
    nop                             lq.xyzw vf31, 0(vi05)
    nop                             iaddiu vi04, vi03, 0
    nop                             iand vi07, vi11, vi08
    nop                             iaddiu vi11, vi00, 1
    nop                             iaddiu vi05, vi05, 1
    nop                             ibeq vi11, vi06, vertices
    nop                             sqi.xyzw vf31, (vi04++)

    ; a register block: the GIF tag and its NLOOP qwords (A+D) go through to the output
copy_regs:
    nop                             lqi.xyzw vf31, (vi05++)
