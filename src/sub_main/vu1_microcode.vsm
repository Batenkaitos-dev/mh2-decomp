    nop                             b batch                              ; the next batch
    nop                             nop

    ; clip the last three vertices' triangle against the six planes of the clip volume and
    ; send what is left as a fan (the GIF tag template at VU 0x3A6)
clip_triangle:
    nop                             iaddiu vi14, vi00, 934
    nop                             sqd.xyzw vf21, (--vi14)
    nop                             sqd.xyzw vf22, (--vi14)
    nop                             sqd.xyzw vf23, (--vi14)
    nop                             sqd.xyzw vf24, (--vi14)
    nop                             sqd.xyzw vf25, (--vi14)
    nop                             sqd.xyzw vf26, (--vi14)
    nop                             sqd.xyzw vf27, (--vi14)
    nop                             sqd.xyzw vf28, (--vi14)
    nop                             sqd.xyzw vf29, (--vi14)
    nop                             sqd.xyzw vf30, (--vi14)
    nop                             sqd.xyzw vf31, (--vi14)
    nop                             isubiu vi14, vi14, 1
    nop                             iswr.x vi02, (vi14)
    nop                             iswr.y vi03, (vi14)
    nop                             iswr.z vi04, (vi14)
    nop                             iswr.w vi05, (vi14)
    nop                             isubiu vi14, vi14, 1
    nop                             iswr.x vi06, (vi14)
    nop                             iswr.y vi07, (vi14)
    nop                             iswr.z vi08, (vi14)
    nop                             iswr.w vi09, (vi14)
    nop                             isubiu vi14, vi14, 1
    nop                             iswr.x vi10, (vi14)
    nop                             iswr.y vi11, (vi14)
    nop                             iswr.z vi12, (vi14)
    nop                             iswr.w vi13, (vi14)
    nop                             iaddiu vi08, vi00, 0
    nop                             iaddiu vi09, vi00, 935
    nop                             iaddiu vi10, vi00, 975
    nop                             lq.xyzw vf23, 1022(vi00)
    nop                             lq.xyzw vf24, 1019(vi00)
    nop                             lq.xyzw vf25, 1016(vi00)
    nop                             lq.xyzw vf26, 1021(vi00)
    itof0.xyzw vf23, vf23           lq.xyzw vf27, 1018(vi00)
    itof0.xyzw vf24, vf24           lq.xyzw vf28, 1015(vi00)
    itof0.xyzw vf25, vf25           lq.xyzw vf29, 1023(vi00)
    nop                             lq.xyzw vf30, 1020(vi00)
    nop                             lq.xyzw vf31, 1017(vi00)
    nop                             sq.xyzw vf23, 1(vi09)
    nop                             sq.xyzw vf24, 4(vi09)
    nop                             sq.xyzw vf25, 7(vi09)
    nop                             sq.xyzw vf23, 10(vi09)
    nop                             sq.xyzw vf26, 2(vi09)
    nop                             sq.xyzw vf27, 5(vi09)
    nop                             sq.xyzw vf28, 8(vi09)
    nop                             sq.xyzw vf26, 11(vi09)
    nop                             sq.xyzw vf29, 0(vi09)
    nop                             sq.xyzw vf30, 3(vi09)
    nop                             sq.xyzw vf31, 6(vi09)
    nop                             sq.xyzw vf29, 9(vi09)
    nop                             iaddiu vi09, vi00, 935
    nop                             iaddiu vi10, vi00, 975
    nop                             iaddiu vi05, vi00, 2048
    nop                             iaddiu vi06, vi00, 32
    subw.x vf31, vf00, vf00w        bal vi13, first_vertex
    nop                             iaddiu vi07, vi00, 2
    nop                             iaddiu vi04, vi00, 3
    nop                             iaddiu vi11, vi00, 0
    nop                             bal vi13, clip_edges
    nop                             nop
    nop                             bal vi13, close_polygon
    nop                             iaddiu vi09, vi00, 975
    nop                             iaddiu vi09, vi00, 975
    nop                             iaddiu vi10, vi00, 935
    nop                             iaddiu vi05, vi00, 1024
    nop                             iaddiu vi06, vi00, 16
    addw.x vf31, vf00, vf00w        bal vi13, pass_start
    nop                             iaddiu vi07, vi00, 2
    nop                             bal vi13, clip_edges
    nop                             nop
    nop                             bal vi13, close_polygon
    nop                             iaddiu vi09, vi00, 935
    nop                             iaddiu vi05, vi00, 128
    nop                             iaddiu vi06, vi00, 2
    subw.x vf31, vf00, vf00w        bal vi13, pass_a_to_b
    nop                             iaddiu vi07, vi00, 0
    nop                             bal vi13, clip_edges
    nop                             nop
    nop                             bal vi13, close_polygon
    nop                             iaddiu vi09, vi00, 975
    nop                             iaddiu vi05, vi00, 64
    nop                             iaddiu vi06, vi00, 1
    addw.x vf31, vf00, vf00w        bal vi13, pass_b_to_a
    nop                             iaddiu vi07, vi00, 0
    nop                             bal vi13, clip_edges
    nop                             nop
    nop                             bal vi13, close_polygon
    nop                             iaddiu vi09, vi00, 935
    nop                             iaddiu vi05, vi00, 512
    nop                             iaddiu vi06, vi00, 8
    subw.x vf31, vf00, vf00w        bal vi13, pass_a_to_b
    nop                             iaddiu vi07, vi00, 1
    nop                             bal vi13, clip_edges
    nop                             nop
    nop                             bal vi13, close_polygon
    nop                             iaddiu vi09, vi00, 975
    nop                             iaddiu vi05, vi00, 256
    nop                             iaddiu vi06, vi00, 4
    addw.x vf31, vf00, vf00w        bal vi13, pass_b_to_a
    nop                             iaddiu vi07, vi00, 1
    nop                             bal vi13, clip_edges
    nop                             nop
    nop                             bal vi13, close_polygon
    nop                             iaddiu vi09, vi00, 935
    nop                             iaddiu vi09, vi00, 935
    nop                             iaddiu vi10, vi00, 975
    nop                             iadd vi04, vi00, vi11
    nop                             iaddiu vi11, vi00, 0
    nop                             ilwr.y vi06, (vi02)
    nop                             lq.xyzw vf31, 934(vi00)
    nop                             lq.xyzw vf26, 10(vi00)
    nop                             lq.xyzw vf27, 11(vi00)
    nop                             ilw.x vi12, 934(vi00)
    nop                             iadd vi06, vi06, vi03
    nop                             iaddiu vi02, vi06, 0
    nop                             sqi.xyzw vf31, (vi06++)
    nop                             iadd vi12, vi12, vi04
    nop                             lq.xyzw vf28, 12(vi00)
    nop                             lq.xyzw vf29, 13(vi00)
    nop                             lq.xyzw vf30, 14(vi00)
    nop                             xgkick vi02                          ; send the output to the GS (PATH1)
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             isw.x vi12, -1(vi06)
    nop                             nop
clip_triangle_loop:
    nop                             lqi.xyzw vf23, (vi09++)
    nop                             lqi.xyzw vf24, (vi09++)
    nop                             lqi.xyzw vf25, (vi09++)
    nop                             nop
    mulax.xyzw ACC, vf27, vf23x     nop
    madday.xyzw ACC, vf28, vf23y    nop
    maddaz.xyzw ACC, vf29, vf23z    nop
    maddw.xyzw vf23, vf30, vf23w    loi 128.0                            ; I = 128.0: the colour clamp (0x80 is 1.0 on the GS)
    minii.xyz vf24, vf24, I         nop
    nop                             nop
    nop                             nop
    nop                             div Q, vf00w, vf23w                  ; Q = 1 / vf23.w
    ftoi0.xyzw vf24, vf24           waitq
    mulq.xyz vf23, vf23, Q          nop
    mulq.xyz vf25, vf25, Q          nop
    nop                             nop
    nop                             sq.xyzw vf24, 1(vi06)
    ftoi4.xyz vf23, vf23            nop
    nop                             sq.xyzw vf25, 0(vi06)
    nop                             nop
    nop                             nop
    nop                             sq.xyz vf23, 2(vi06)
    subw.x vf23, vf26, vf23w        nop
    nop                             nop
    nop                             nop
    nop                             nop
    muly.x vf23, vf23, vf26y        nop
    nop                             nop
    nop                             nop
    nop                             loi 255.0                            ; I = 255.0
    muli.x vf23, vf23, I            nop
    nop                             nop
    nop                             nop
    nop                             nop
    minii.x vf23, vf23, I           nop
    nop                             nop
    nop                             nop
    nop                             nop
    maxx.x vf23, vf23, vf00x        nop
    nop                             nop
    nop                             nop
    nop                             nop
    ftoi4.x vf23, vf23              nop
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             mtir vi13, vf23x
    nop                             iaddi vi04, vi04, -1
    nop                             iaddiu vi06, vi06, 3
    nop                             ibne vi04, vi00, clip_triangle_loop
    nop                             isw.w vi13, -1(vi06)
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             xgkick vi02                          ; send the output to the GS (PATH1)
    nop                             nop
clip_triangle_exit:
    nop                             ilwr.x vi10, (vi14)
    nop                             ilwr.y vi11, (vi14)
    nop                             ilwr.z vi12, (vi14)
    nop                             ilwr.w vi13, (vi14)
    nop                             iaddiu vi14, vi14, 1
    nop                             ilwr.x vi06, (vi14)
    nop                             ilwr.y vi07, (vi14)
    nop                             ilwr.z vi08, (vi14)
    nop                             ilwr.w vi09, (vi14)
    nop                             iaddiu vi14, vi14, 1
    nop                             ilwr.x vi02, (vi14)
    nop                             ilwr.y vi03, (vi14)
    nop                             ilwr.z vi04, (vi14)
    nop                             ilwr.w vi05, (vi14)
    nop                             iaddiu vi14, vi14, 1
    nop                             lqi.xyzw vf31, (vi14++)
    nop                             lqi.xyzw vf30, (vi14++)
    nop                             lqi.xyzw vf29, (vi14++)
    nop                             lqi.xyzw vf28, (vi14++)
    nop                             lqi.xyzw vf27, (vi14++)
    nop                             lqi.xyzw vf26, (vi14++)
    nop                             lqi.xyzw vf25, (vi14++)
    nop                             lqi.xyzw vf24, (vi14++)
    nop                             lqi.xyzw vf23, (vi14++)
    nop                             lqi.xyzw vf22, (vi14++)
    nop                             jr vi15
    nop                             lqi.xyzw vf21, (vi14++)

    ; after a plane: repeat the first output vertex after the last; an empty polygon leaves
    ; (clip_triangle_exit)
close_polygon:
    nop                             lqi.xyzw vf29, (vi09++)
    nop                             lqi.xyzw vf30, (vi09++)
    nop                             lqi.xyzw vf31, (vi09++)
    nop                             nop
    nop                             sqi.xyzw vf29, (vi10++)
    nop                             sqi.xyzw vf30, (vi10++)
    nop                             ibeq vi11, vi00, clip_triangle_exit
    nop                             sqi.xyzw vf31, (vi10++)
    nop                             jr vi13
    nop                             nop

    ; the next plane reads the polygon at VU 935.. and writes the one at 975.. (as set at
    ; clip_triangle)
pass_a_to_b:
    nop                             iaddiu vi09, vi00, 935
    nop                             b pass_start
    nop                             iaddiu vi10, vi00, 975

    ; the next plane reads the second polygon buffer and writes the first
pass_b_to_a:
    nop                             iaddiu vi09, vi00, 975
    nop                             iaddiu vi10, vi00, 935

    ; vi04: the vertices to clip; vi11: none written yet
pass_start:
    nop                             iadd vi04, vi00, vi11
    nop                             iaddiu vi11, vi00, 0

    ; load the polygon's first vertex (three qwords)
first_vertex:
    nop                             lqi.xyzw vf21, (vi09++)
    nop                             lqi.xyzw vf22, (vi09++)
    nop                             jr vi13
    nop                             lqi.xyzw vf23, (vi09++)

    ; clip the polygon's edges against one plane (vi05, vi06: its clip-flag bits; vf31.x its
    ; sign)
clip_edges:
    mulw.xyzw vf24, vf21, vf00w     lqi.xyzw vf21, (vi09++)
    mulw.xyzw vf25, vf22, vf00w     lqi.xyzw vf22, (vi09++)
    mulw.xyzw vf26, vf23, vf00w     lqi.xyzw vf23, (vi09++)
    nop                             nop
    clipw.xyz vf24, vf24w           nop                                  ; clip flags: vf24.xyz against +-vf24.w
    clipw.xyz vf21, vf21w           nop
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             fcget vi01
    nop                             nop
    nop                             iand vi12, vi01, vi05
    nop                             nop
    nop                             ibeq vi12, vi00, clip_edges_skip
    nop                             nop
    nop                             iand vi12, vi01, vi06
    nop                             nop
    nop                             ibne vi12, vi00, clip_edges_skip3
    nop                             nop
    nop                             bal vi01, intersect
    nop                             nop
    nop                             sqi.xyzw vf28, (vi10++)
    nop                             sqi.xyzw vf29, (vi10++)
    nop                             sqi.xyzw vf30, (vi10++)
    nop                             b clip_edges_skip3
    nop                             iaddiu vi11, vi11, 1
clip_edges_skip:
    nop                             iand vi12, vi01, vi06
    nop                             nop
    nop                             ibeq vi12, vi00, clip_edges_skip2
    nop                             nop
    nop                             bal vi01, intersect
    nop                             nop
    nop                             sqi.xyzw vf24, (vi10++)
    nop                             sqi.xyzw vf25, (vi10++)
    nop                             sqi.xyzw vf26, (vi10++)
    nop                             sqi.xyzw vf28, (vi10++)
    nop                             sqi.xyzw vf29, (vi10++)
    nop                             sqi.xyzw vf30, (vi10++)
    nop                             b clip_edges_skip3
    nop                             iaddiu vi11, vi11, 2
clip_edges_skip2:
    nop                             sqi.xyzw vf24, (vi10++)
    nop                             sqi.xyzw vf25, (vi10++)
    nop                             sqi.xyzw vf26, (vi10++)
    nop                             iaddiu vi11, vi11, 1
clip_edges_skip3:
    nop                             isubiu vi04, vi04, 1
    nop                             nop
    nop                             ibne vi04, vi00, clip_edges
    nop                             nop
    nop                             jr vi13
    nop                             nop

    ; an edge crosses the plane: write the intersection (position and attributes interpolated)
intersect:
    mulx.w vf28, vf24, vf31x        nop
    mulx.w vf29, vf21, vf31x        nop
    nop                             nop
    nop                             nop
    subw.xyzw vf28, vf24, vf28w     nop
    subw.xyzw vf29, vf21, vf29w     nop
    nop                             iadd vi12, vi00, vi07
    nop                             nop
intersect_loop:
    nop                             ibeq vi12, vi00, intersect_skip
    nop                             nop
    nop                             mr32.xyzw vf28, vf28
    nop                             mr32.xyzw vf29, vf29
    nop                             isubiu vi12, vi12, 1
    nop                             nop
    nop                             b intersect_loop
    nop                             nop
intersect_skip:
    sub.xyz vf30, vf29, vf28        nop
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             div Q, vf28x, vf30x
    nop                             waitq
    addq.x vf27, vf00, Q            nop
    sub.xyzw vf28, vf21, vf24       nop
    sub.xyzw vf29, vf22, vf25       nop
    sub.xyzw vf30, vf23, vf26       nop
    abs.x vf27, vf27                nop
    nop                             nop
    nop                             nop
    nop                             nop
    mulx.xyzw vf28, vf28, vf27x     nop
    mulx.xyzw vf29, vf29, vf27x     nop
    mulx.xyzw vf30, vf30, vf27x     nop
    nop                             nop
    add.xyzw vf28, vf28, vf24       nop
    add.xyzw vf29, vf29, vf25       nop
    add.xyzw vf30, vf30, vf26       jr vi01
    nop                             nop
.endprogram

;=======================================================================================
; Vu1Prog46: fog, second colour, gMtxUv rows, clipped
;
; gVu1ProgInfo46 (bones.c): 452 pairs (3616 bytes), batches of up to 2880 bytes;
; Vu1_SelectProgram's key 0x2c080, rigid models (0x21035, 0x121035).
; Setup Vu1Pkt_DVEP: an UNPACK of 18 qwords to VU 0, then MSCALF 0:
;   0        colour: gGsColorF, RGB scaled by the model's brightness
;   1        second colour: gGsColor2F: vf13
;   2-5      gMtxSlots x gMtxView x gMtxProjClip: model to screen (XYZ after the divide by w): vf01-vf04
;   6-9      the matrix above x gViewportMtx: model to the clip test's space: vf05-vf08
;   10-12    rows 0, 1 and 3 of gMtxUv (Vu1_PutUvMatrix): vf09-vf11
;   13       fog range: gGsFogFar and the word after it: vf12, vf26
;   14-17    gMtxProj, the projection matrix: vf27-vf30
; Vertices: gVu1ProgLayouts[5], 3 qwords: position, colour, texture coordinates.
; Batches at VU 0x12 and 0x12 + 0x1e5 (XTOP); the output follows each.
;=======================================================================================
.program Vu1Prog46
.base 0x12
.offset 0x1e5
.stcycl 4, 4
.unpack 0x3a6, 0x00008000, 0x303ec000, 0x00000412, 0x00000000   ; GIF tag template: EOP, PRIM 0x7d, REGS ST RGBAQ XYZF2

    ; MSCALF 0: the setup's constants into registers
init:
    nop                             lq.xyzw vf01, 2(vi00)
    nop                             lq.xyzw vf02, 3(vi00)
    nop                             lq.xyzw vf03, 4(vi00)
    nop                             lq.xyzw vf04, 5(vi00)
    nop                             lq.xyzw vf05, 6(vi00)
    nop                             lq.xyzw vf06, 7(vi00)
    nop                             lq.xyzw vf07, 8(vi00)
    nop                             lq.xyzw vf08, 9(vi00)
    nop                             lq.xyzw vf09, 10(vi00)
    nop                             lq.xyzw vf10, 11(vi00)
    nop                             lq.xyzw vf11, 12(vi00)
    nop                             lq.xyzw vf12, 13(vi00)
    nop                             lq.xyzw vf13, 1(vi00)
    nop                             nop                               [E] ; end: constants loaded
    nop                             nop

    ; MSCNT: one batch at XTOP; qword 0's x is its type, qword 1 a GIF tag
batch:
    nop                             xtop vi02                            ; vi02: the batch (BASE, or BASE + OFFSET: double buffer)
    nop                             iaddiu vi05, vi02, 0
    nop                             iaddiu vi03, vi02, 180               ; vi03: the output, 180 qwords after the batch
    nop                             ilwr.x vi06, (vi05)                  ; the batch type (qword 0)
    nop                             iaddiu vi05, vi05, 1
    nop                             ilwr.x vi08, (vi05)                  ; the GIF tag (qword 1): NLOOP, EOP
    nop                             iaddiu vi11, vi00, 32767             ; 0x7FFF: the NLOOP mask
    nop                             lq.xyzw vf31, 0(vi05)
    nop                             iaddiu vi04, vi03, 0
    nop                             iand vi07, vi11, vi08
    nop                             iaddiu vi11, vi00, 1
    nop                             iaddiu vi05, vi05, 1
    nop                             ibeq vi11, vi06, vertices
    nop                             sqi.xyzw vf31, (vi04++)

    ; a register block: the GIF tag and its NLOOP qwords (A+D) go through to the output
copy_regs:
    nop                             lqi.xyzw vf30, (vi05++)
    nop                             iaddi vi07, vi07, -1
    nop                             iaddiu vi04, vi04, 1
    nop                             ibne vi07, vi00, copy_regs
    nop                             sq.xyzw vf30, -1(vi04)
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             nop                               [E] ; end: the next MSCNT continues at copy_regs_cont
    nop                             nop

    ; the next MSCNT continues here
copy_regs_cont:
    nop                             b batch                              ; the next batch
    nop                             nop

    ; type 1: a strip of NLOOP vertices
vertices:
    nop                             iaddiu vi08, vi08, 2                 ; NLOOP + 2: the delay line's last vertices go out first
    nop                             isw.x vi08, -1(vi04)
    nop                             lq.xyzw vf29, 0(vi05)
    nop                             lq.xyzw vf18, 917(vi00)
    nop                             lq.xyzw vf19, 918(vi00)
    nop                             lq.xyzw vf20, 919(vi00)
    mulax.xyzw ACC, vf01, vf29x     lq.xyzw vf31, 2(vi05)
    madday.xyzw ACC, vf02, vf29y    lq.xyzw vf21, 914(vi00)
    maddaz.xyzw ACC, vf03, vf29z    lq.xyzw vf22, 915(vi00)
    maddw.xyzw vf28, vf04, vf00w    lq.xyzw vf23, 916(vi00)
    mulax.xy ACC, vf09, vf31x       sqi.xyzw vf18, (vi04++)
    madday.xy ACC, vf10, vf31y      sqi.xyzw vf19, (vi04++)
    maddw.xy vf31, vf11, vf00w      lq.xyzw vf30, 1(vi05)
    mulax.xyzw ACC, vf05, vf29x     div Q, vf00w, vf28w                  ; Q = 1 / vf28.w
    madday.xyzw ACC, vf06, vf29y    sqi.xyzw vf20, (vi04++)
    maddaz.xyzw ACC, vf07, vf29z    sqi.xyzw vf21, (vi04++)
    maddw.xyzw vf27, vf08, vf00w    sqi.xyzw vf22, (vi04++)
    mul.xyzw vf25, vf30, vf13       sqi.xyzw vf23, (vi04++)
    nop                             lq.xyzw vf18, 1020(vi00)
    nop                             lq.xyzw vf19, 1019(vi00)
    mulq.xyz vf28, vf28, Q          lq.xyzw vf20, 1018(vi00)
    mulq.xyz vf26, vf31, Q          lq.xyzw vf21, 1017(vi00)
    ftoi0.xyzw vf25, vf25           lq.xyzw vf22, 1016(vi00)
    nop                             lq.xyzw vf23, 1015(vi00)
    ; one vertex per pass, software-pipelined through the delay line
vertices_loop:
    ftoi4.xyz vf28, vf28            lq.xyzw vf29, 3(vi05)
    clipw.xyz vf18, vf18w           sq.xyzw vf26, 0(vi04)                ; clip flags: vf18.xyz against +-vf18.w
    clipw.xyz vf21, vf21w           sq.xyzw vf25, 1(vi04)
    clipw.xyz vf27, vf27w           sq.xyzw vf25, 1016(vi00)
    subw.x vf24, vf12, vf28w        sq.xyz vf28, 2(vi04)
    mulax.xyzw ACC, vf01, vf29x     sq.xyzw vf31, 1015(vi00)
    madday.xyzw ACC, vf02, vf29y    lq.xyzw vf31, 5(vi05)
    maddaz.xyzw ACC, vf03, vf29z    sq.xyzw vf27, 1017(vi00)
    maddw.xyzw vf28, vf04, vf00w    sq.xyzw vf18, 1023(vi00)
    muly.x vf24, vf24, vf12y        sq.xyzw vf19, 1022(vi00)
    mulax.xy ACC, vf09, vf31x       sq.xyzw vf20, 1021(vi00)
    madday.xy ACC, vf10, vf31y      loi 255.0                            ; I = 255.0
    maddw.xy vf31, vf11, vf00w      div Q, vf00w, vf28w
    muli.x vf24, vf24, I            sq.xyzw vf21, 1020(vi00)
    mulax.xyzw ACC, vf05, vf29x     sq.xyzw vf22, 1019(vi00)
    madday.xyzw ACC, vf06, vf29y    sq.xyzw vf23, 1018(vi00)
    maddaz.xyzw ACC, vf07, vf29z    ilw.w vi09, 0(vi05)                  ; vi09: the position's w word, XYZF2's w (F, ADC) as the model has it
    minii.x vf24, vf24, I           iaddiu vi05, vi05, 3
    maddw.xyzw vf27, vf08, vf00w    lq.xyzw vf30, 1(vi05)
    mulq.xyz vf28, vf28, Q          lq.xyzw vf18, 1020(vi00)
    mulq.xyz vf26, vf31, Q          lq.xyzw vf19, 1019(vi00)
    maxx.x vf24, vf24, vf00x        lq.xyzw vf20, 1018(vi00)
    mul.xyzw vf25, vf30, vf13       lq.xyzw vf21, 1017(vi00)
    nop                             lq.xyzw vf22, 1016(vi00)
    nop                             lq.xyzw vf23, 1015(vi00)
    ftoi4.x vf24, vf24              iaddiu vi04, vi04, 3
    ftoi0.xyzw vf25, vf25           iaddi vi07, vi07, -1
    nop                             fcand vi01, 0x03ffff                 ; vi01 = 1: one of the last three vertices is outside the clip volume
    nop                             ibne vi09, vi00, vertices_in_view
    nop                             mtir vi13, vf24x
    nop                             ibeq vi01, vi00, vertices_in_view
    nop                             fcor vi01, 0xfdf7df
    nop                             ibne vi01, vi00, vertices_culled
    nop                             fcor vi01, 0xfefbef
    nop                             ibne vi01, vi00, vertices_culled
    nop                             fcor vi01, 0xff7df7
    nop                             ibne vi01, vi00, vertices_culled
    nop                             fcor vi01, 0xffbefb
    nop                             ibne vi01, vi00, vertices_culled
    nop                             fcor vi01, 0xffdf7d
    nop                             ibne vi01, vi00, vertices_culled
    nop                             fcor vi01, 0xffefbe
    nop                             ibne vi01, vi00, vertices_culled
    nop                             nop
    nop                             bal vi15, clip_triangle
    ; the triangle is wholly outside one plane: culled
vertices_culled:
    nop                             iaddiu vi09, vi00, 32767
    nop                             iaddiu vi09, vi09, 1
    ; the last three vertices are all inside the clip volume
vertices_in_view:
    nop                             iadd vi09, vi09, vi13
    nop                             ibne vi07, vi00, vertices_loop
    nop                             isw.w vi09, -1(vi04)
    ; the epilogue: the vertices left in the delay line
    nop                             lqd.xyzw vf18, (--vi04)
    nop                             lqd.xyzw vf19, (--vi04)
    nop                             lqd.xyzw vf20, (--vi04)
    nop                             lqd.xyzw vf21, (--vi04)
    nop                             lqd.xyzw vf22, (--vi04)
    nop                             lqd.xyzw vf23, (--vi04)
    nop                             sq.xyzw vf18, 916(vi00)
    nop                             sq.xyzw vf19, 915(vi00)
    nop                             sq.xyzw vf20, 914(vi00)
    nop                             sq.xyzw vf21, 919(vi00)
    nop                             sq.xyzw vf22, 918(vi00)
    nop                             sq.xyzw vf23, 917(vi00)
    nop                             xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             nop                               [E] ; end: the next MSCNT continues at vertices_cont
    nop                             nop

    ; the next MSCNT continues here
vertices_cont:
    nop                             b batch                              ; the next batch
    nop                             nop

    ; clip the last three vertices' triangle against the six planes of the clip volume and
    ; send what is left as a fan (the GIF tag template at VU 0x3A6)
clip_triangle:
    nop                             iaddiu vi14, vi00, 934
    nop                             sqd.xyzw vf21, (--vi14)
    nop                             sqd.xyzw vf22, (--vi14)
    nop                             sqd.xyzw vf23, (--vi14)
    nop                             sqd.xyzw vf24, (--vi14)
    nop                             sqd.xyzw vf25, (--vi14)
    nop                             sqd.xyzw vf26, (--vi14)
    nop                             sqd.xyzw vf27, (--vi14)
    nop                             sqd.xyzw vf28, (--vi14)
    nop                             sqd.xyzw vf29, (--vi14)
    nop                             sqd.xyzw vf30, (--vi14)
    nop                             sqd.xyzw vf31, (--vi14)
    nop                             isubiu vi14, vi14, 1
    nop                             iswr.x vi02, (vi14)
    nop                             iswr.y vi03, (vi14)
    nop                             iswr.z vi04, (vi14)
    nop                             iswr.w vi05, (vi14)
    nop                             isubiu vi14, vi14, 1
    nop                             iswr.x vi06, (vi14)
    nop                             iswr.y vi07, (vi14)
    nop                             iswr.z vi08, (vi14)
    nop                             iswr.w vi09, (vi14)
    nop                             isubiu vi14, vi14, 1
    nop                             iswr.x vi10, (vi14)
    nop                             iswr.y vi11, (vi14)
    nop                             iswr.z vi12, (vi14)
    nop                             iswr.w vi13, (vi14)
    nop                             iaddiu vi08, vi00, 0
    nop                             iaddiu vi09, vi00, 935
    nop                             iaddiu vi10, vi00, 975
    nop                             lq.xyzw vf23, 1022(vi00)
    nop                             lq.xyzw vf24, 1019(vi00)
    nop                             lq.xyzw vf25, 1016(vi00)
    nop                             lq.xyzw vf26, 1021(vi00)
    itof0.xyzw vf23, vf23           lq.xyzw vf27, 1018(vi00)
    itof0.xyzw vf24, vf24           lq.xyzw vf28, 1015(vi00)
    itof0.xyzw vf25, vf25           lq.xyzw vf29, 1023(vi00)
    nop                             lq.xyzw vf30, 1020(vi00)
    nop                             lq.xyzw vf31, 1017(vi00)
    nop                             sq.xyzw vf23, 1(vi09)
    nop                             sq.xyzw vf24, 4(vi09)
    nop                             sq.xyzw vf25, 7(vi09)
    nop                             sq.xyzw vf23, 10(vi09)
    nop                             sq.xyzw vf26, 2(vi09)
    nop                             sq.xyzw vf27, 5(vi09)
    nop                             sq.xyzw vf28, 8(vi09)
    nop                             sq.xyzw vf26, 11(vi09)
    nop                             sq.xyzw vf29, 0(vi09)
    nop                             sq.xyzw vf30, 3(vi09)
    nop                             sq.xyzw vf31, 6(vi09)
    nop                             sq.xyzw vf29, 9(vi09)
    nop                             iaddiu vi09, vi00, 935
    nop                             iaddiu vi10, vi00, 975
    nop                             iaddiu vi05, vi00, 2048
    nop                             iaddiu vi06, vi00, 32
    subw.x vf31, vf00, vf00w        bal vi13, first_vertex
    nop                             iaddiu vi07, vi00, 2
    nop                             iaddiu vi04, vi00, 3
    nop                             iaddiu vi11, vi00, 0
    nop                             bal vi13, clip_edges
    nop                             nop
    nop                             bal vi13, close_polygon
    nop                             iaddiu vi09, vi00, 975
    nop                             iaddiu vi09, vi00, 975
    nop                             iaddiu vi10, vi00, 935
    nop                             iaddiu vi05, vi00, 1024
    nop                             iaddiu vi06, vi00, 16
    addw.x vf31, vf00, vf00w        bal vi13, pass_start
    nop                             iaddiu vi07, vi00, 2
    nop                             bal vi13, clip_edges
    nop                             nop
    nop                             bal vi13, close_polygon
    nop                             iaddiu vi09, vi00, 935
    nop                             iaddiu vi05, vi00, 128
    nop                             iaddiu vi06, vi00, 2
    subw.x vf31, vf00, vf00w        bal vi13, pass_a_to_b
    nop                             iaddiu vi07, vi00, 0
    nop                             bal vi13, clip_edges
    nop                             nop
    nop                             bal vi13, close_polygon
    nop                             iaddiu vi09, vi00, 975
    nop                             iaddiu vi05, vi00, 64
    nop                             iaddiu vi06, vi00, 1
    addw.x vf31, vf00, vf00w        bal vi13, pass_b_to_a
    nop                             iaddiu vi07, vi00, 0
    nop                             bal vi13, clip_edges
    nop                             nop
    nop                             bal vi13, close_polygon
    nop                             iaddiu vi09, vi00, 935
    nop                             iaddiu vi05, vi00, 512
    nop                             iaddiu vi06, vi00, 8
    subw.x vf31, vf00, vf00w        bal vi13, pass_a_to_b
    nop                             iaddiu vi07, vi00, 1
    nop                             bal vi13, clip_edges
    nop                             nop
    nop                             bal vi13, close_polygon
    nop                             iaddiu vi09, vi00, 975
    nop                             iaddiu vi05, vi00, 256
    nop                             iaddiu vi06, vi00, 4
    addw.x vf31, vf00, vf00w        bal vi13, pass_b_to_a
    nop                             iaddiu vi07, vi00, 1
    nop                             bal vi13, clip_edges
    nop                             nop
    nop                             bal vi13, close_polygon
    nop                             iaddiu vi09, vi00, 935
    nop                             iaddiu vi09, vi00, 935
    nop                             iaddiu vi10, vi00, 975
    nop                             iadd vi04, vi00, vi11
    nop                             iaddiu vi11, vi00, 0
    nop                             ilwr.y vi06, (vi02)
    nop                             lq.xyzw vf31, 934(vi00)
    nop                             lq.xyzw vf26, 13(vi00)
    nop                             lq.xyzw vf27, 14(vi00)
    nop                             ilw.x vi12, 934(vi00)
    nop                             iadd vi06, vi06, vi03
    nop                             iaddiu vi02, vi06, 0
    nop                             sqi.xyzw vf31, (vi06++)
    nop                             iadd vi12, vi12, vi04
    nop                             lq.xyzw vf28, 15(vi00)
    nop                             lq.xyzw vf29, 16(vi00)
    nop                             lq.xyzw vf30, 17(vi00)
    nop                             xgkick vi02                          ; send the output to the GS (PATH1)
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             isw.x vi12, -1(vi06)
    nop                             nop
clip_triangle_loop:
    nop                             lqi.xyzw vf23, (vi09++)
    nop                             lqi.xyzw vf24, (vi09++)
    nop                             lqi.xyzw vf25, (vi09++)
    nop                             nop
    mulax.xyzw ACC, vf27, vf23x     nop
    madday.xyzw ACC, vf28, vf23y    nop
    maddaz.xyzw ACC, vf29, vf23z    nop
    maddw.xyzw vf23, vf30, vf23w    loi 128.0                            ; I = 128.0: the colour clamp (0x80 is 1.0 on the GS)
    minii.xyz vf24, vf24, I         nop
    nop                             nop
    nop                             nop
    nop                             div Q, vf00w, vf23w                  ; Q = 1 / vf23.w
    ftoi0.xyzw vf24, vf24           waitq
    mulq.xyz vf23, vf23, Q          nop
    mulq.xyz vf25, vf25, Q          nop
    nop                             nop
    nop                             sq.xyzw vf24, 1(vi06)
    ftoi4.xyz vf23, vf23            nop
    nop                             sq.xyzw vf25, 0(vi06)
    nop                             nop
    nop                             nop
    nop                             sq.xyz vf23, 2(vi06)
    subw.x vf23, vf26, vf23w        nop
    nop                             nop
    nop                             nop
    nop                             nop
    muly.x vf23, vf23, vf26y        nop
    nop                             nop
    nop                             nop
    nop                             loi 255.0                            ; I = 255.0
    muli.x vf23, vf23, I            nop
    nop                             nop
    nop                             nop
    nop                             nop
    minii.x vf23, vf23, I           nop
    nop                             nop
    nop                             nop
    nop                             nop
    maxx.x vf23, vf23, vf00x        nop
    nop                             nop
    nop                             nop
    nop                             nop
    ftoi4.x vf23, vf23              nop
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             mtir vi13, vf23x
    nop                             iaddi vi04, vi04, -1
    nop                             iaddiu vi06, vi06, 3
    nop                             ibne vi04, vi00, clip_triangle_loop
    nop                             isw.w vi13, -1(vi06)
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             xgkick vi02                          ; send the output to the GS (PATH1)
    nop                             nop
clip_triangle_exit:
    nop                             ilwr.x vi10, (vi14)
    nop                             ilwr.y vi11, (vi14)
    nop                             ilwr.z vi12, (vi14)
    nop                             ilwr.w vi13, (vi14)
    nop                             iaddiu vi14, vi14, 1
    nop                             ilwr.x vi06, (vi14)
    nop                             ilwr.y vi07, (vi14)
    nop                             ilwr.z vi08, (vi14)
    nop                             ilwr.w vi09, (vi14)
    nop                             iaddiu vi14, vi14, 1
    nop                             ilwr.x vi02, (vi14)
    nop                             ilwr.y vi03, (vi14)
    nop                             ilwr.z vi04, (vi14)
    nop                             ilwr.w vi05, (vi14)
    nop                             iaddiu vi14, vi14, 1
    nop                             lqi.xyzw vf31, (vi14++)
    nop                             lqi.xyzw vf30, (vi14++)
    nop                             lqi.xyzw vf29, (vi14++)
    nop                             lqi.xyzw vf28, (vi14++)
    nop                             lqi.xyzw vf27, (vi14++)
    nop                             lqi.xyzw vf26, (vi14++)
    nop                             lqi.xyzw vf25, (vi14++)
    nop                             lqi.xyzw vf24, (vi14++)
    nop                             lqi.xyzw vf23, (vi14++)
    nop                             lqi.xyzw vf22, (vi14++)
    nop                             jr vi15
    nop                             lqi.xyzw vf21, (vi14++)

    ; after a plane: repeat the first output vertex after the last; an empty polygon leaves
    ; (clip_triangle_exit)
close_polygon:
    nop                             lqi.xyzw vf29, (vi09++)
    nop                             lqi.xyzw vf30, (vi09++)
    nop                             lqi.xyzw vf31, (vi09++)
    nop                             nop
    nop                             sqi.xyzw vf29, (vi10++)
    nop                             sqi.xyzw vf30, (vi10++)
    nop                             ibeq vi11, vi00, clip_triangle_exit
    nop                             sqi.xyzw vf31, (vi10++)
    nop                             jr vi13
    nop                             nop

    ; the next plane reads the polygon at VU 935.. and writes the one at 975.. (as set at
    ; clip_triangle)
pass_a_to_b:
    nop                             iaddiu vi09, vi00, 935
    nop                             b pass_start
    nop                             iaddiu vi10, vi00, 975

    ; the next plane reads the second polygon buffer and writes the first
pass_b_to_a:
    nop                             iaddiu vi09, vi00, 975
    nop                             iaddiu vi10, vi00, 935

    ; vi04: the vertices to clip; vi11: none written yet
pass_start:
    nop                             iadd vi04, vi00, vi11
    nop                             iaddiu vi11, vi00, 0

    ; load the polygon's first vertex (three qwords)
first_vertex:
    nop                             lqi.xyzw vf21, (vi09++)
    nop                             lqi.xyzw vf22, (vi09++)
    nop                             jr vi13
    nop                             lqi.xyzw vf23, (vi09++)

    ; clip the polygon's edges against one plane (vi05, vi06: its clip-flag bits; vf31.x its
    ; sign)
clip_edges:
    mulw.xyzw vf24, vf21, vf00w     lqi.xyzw vf21, (vi09++)
    mulw.xyzw vf25, vf22, vf00w     lqi.xyzw vf22, (vi09++)
    mulw.xyzw vf26, vf23, vf00w     lqi.xyzw vf23, (vi09++)
    nop                             nop
    clipw.xyz vf24, vf24w           nop                                  ; clip flags: vf24.xyz against +-vf24.w
    clipw.xyz vf21, vf21w           nop
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             fcget vi01
    nop                             nop
    nop                             iand vi12, vi01, vi05
    nop                             nop
    nop                             ibeq vi12, vi00, clip_edges_skip
    nop                             nop
    nop                             iand vi12, vi01, vi06
    nop                             nop
    nop                             ibne vi12, vi00, clip_edges_skip3
    nop                             nop
    nop                             bal vi01, intersect
    nop                             nop
    nop                             sqi.xyzw vf28, (vi10++)
    nop                             sqi.xyzw vf29, (vi10++)
    nop                             sqi.xyzw vf30, (vi10++)
    nop                             b clip_edges_skip3
    nop                             iaddiu vi11, vi11, 1
clip_edges_skip:
    nop                             iand vi12, vi01, vi06
    nop                             nop
    nop                             ibeq vi12, vi00, clip_edges_skip2
    nop                             nop
    nop                             bal vi01, intersect
    nop                             nop
    nop                             sqi.xyzw vf24, (vi10++)
    nop                             sqi.xyzw vf25, (vi10++)
    nop                             sqi.xyzw vf26, (vi10++)
    nop                             sqi.xyzw vf28, (vi10++)
    nop                             sqi.xyzw vf29, (vi10++)
    nop                             sqi.xyzw vf30, (vi10++)
    nop                             b clip_edges_skip3
    nop                             iaddiu vi11, vi11, 2
clip_edges_skip2:
    nop                             sqi.xyzw vf24, (vi10++)
    nop                             sqi.xyzw vf25, (vi10++)
    nop                             sqi.xyzw vf26, (vi10++)
    nop                             iaddiu vi11, vi11, 1
clip_edges_skip3:
    nop                             isubiu vi04, vi04, 1
    nop                             nop
    nop                             ibne vi04, vi00, clip_edges
    nop                             nop
    nop                             jr vi13
    nop                             nop

    ; an edge crosses the plane: write the intersection (position and attributes interpolated)
intersect:
    mulx.w vf28, vf24, vf31x        nop
    mulx.w vf29, vf21, vf31x        nop
    nop                             nop
    nop                             nop
    subw.xyzw vf28, vf24, vf28w     nop
    subw.xyzw vf29, vf21, vf29w     nop
    nop                             iadd vi12, vi00, vi07
    nop                             nop
intersect_loop:
    nop                             ibeq vi12, vi00, intersect_skip
    nop                             nop
    nop                             mr32.xyzw vf28, vf28
    nop                             mr32.xyzw vf29, vf29
    nop                             isubiu vi12, vi12, 1
    nop                             nop
    nop                             b intersect_loop
    nop                             nop
intersect_skip:
    sub.xyz vf30, vf29, vf28        nop
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             div Q, vf28x, vf30x
    nop                             waitq
    addq.x vf27, vf00, Q            nop
    sub.xyzw vf28, vf21, vf24       nop
    sub.xyzw vf29, vf22, vf25       nop
    sub.xyzw vf30, vf23, vf26       nop
    abs.x vf27, vf27                nop
    nop                             nop
    nop                             nop
    nop                             nop
    mulx.xyzw vf28, vf28, vf27x     nop
    mulx.xyzw vf29, vf29, vf27x     nop
    mulx.xyzw vf30, vf30, vf27x     nop
    nop                             nop
    add.xyzw vf28, vf28, vf24       nop
    add.xyzw vf29, vf29, vf25       nop
    add.xyzw vf30, vf30, vf26       jr vi01
    nop                             nop
.endprogram

;=======================================================================================
; Vu1Prog47: three lights, fog, second colour, gMtxUv rows, clipped
;
; gVu1ProgInfo47 (bones.c): 462 pairs (3696 bytes), batches of up to 2720 bytes;
; Vu1_SelectProgram's key 0x2c280, rigid models (0x21035, 0x121035).
; Setup Vu1Pkt_LDVEP: an UNPACK of 25 qwords to VU 0, then MSCALF 0:
;   0        colour: gGsColorF, RGB scaled by the model's brightness: vf16
;   1        second colour: gGsColor2F: vf21
;   2-5      gMtxSlots x gMtxView x gMtxProjClip: model to screen (XYZ after the divide by w): vf01-vf04
;   6-9      the matrix above x gViewportMtx: model to the clip test's space: vf05-vf08
;   10-12    light directions (model space, negated): vf09-vf11
;   13-16    light colours (three lights and the ambient): vf12-vf15
;   17-19    rows 0, 1 and 3 of gMtxUv (Vu1_PutUvMatrix): vf17-vf19
;   20       fog range: gGsFogFar and the word after it: vf20, vf26
;   21-24    gMtxProj, the projection matrix: vf27-vf30
; Vertices: gVu1ProgLayouts[1], 4 qwords: position, normal, colour, texture coordinates.
; Batches at VU 0x19 and 0x19 + 0x1e0 (XTOP); the output follows each.
;=======================================================================================
.program Vu1Prog47
.base 0x19
.offset 0x1e0
.stcycl 4, 4
.unpack 0x3a6, 0x00008000, 0x303ec000, 0x00000412, 0x00000000   ; GIF tag template: EOP, PRIM 0x7d, REGS ST RGBAQ XYZF2

    ; MSCALF 0: the setup's constants into registers
init:
    nop                             lq.xyzw vf12, 13(vi00)
    nop                             lq.xyzw vf13, 14(vi00)
    nop                             lq.xyzw vf14, 15(vi00)
    nop                             loi 128.0                            ; I = 128.0: the colour clamp (0x80 is 1.0 on the GS)
    muli.xyzw vf12, vf12, I         lq.xyzw vf01, 2(vi00)
    muli.xyzw vf13, vf13, I         lq.xyzw vf02, 3(vi00)
    muli.xyzw vf14, vf14, I         lq.xyzw vf03, 4(vi00)
    nop                             lq.xyzw vf04, 5(vi00)
    minii.xyzw vf12, vf12, I        lq.xyzw vf05, 6(vi00)
    minii.xyzw vf13, vf13, I        lq.xyzw vf06, 7(vi00)
    minii.xyzw vf14, vf14, I        lq.xyzw vf07, 8(vi00)
    nop                             lq.xyzw vf08, 9(vi00)
    nop                             lq.xyzw vf09, 10(vi00)
    nop                             lq.xyzw vf10, 11(vi00)
    nop                             lq.xyzw vf11, 12(vi00)
    nop                             lq.xyzw vf15, 16(vi00)
    nop                             lq.xyzw vf16, 0(vi00)
    nop                             lq.xyzw vf17, 17(vi00)
    nop                             lq.xyzw vf18, 18(vi00)
    nop                             lq.xyzw vf19, 19(vi00)
    nop                             lq.xyzw vf20, 20(vi00)
    nop                             lq.xyzw vf21, 1(vi00)
    nop                             nop                               [E] ; end: constants loaded
    nop                             nop

    ; MSCNT: one batch at XTOP; qword 0's x is its type, qword 1 a GIF tag
batch:
    nop                             xtop vi02                            ; vi02: the batch (BASE, or BASE + OFFSET: double buffer)
    nop                             iaddiu vi05, vi02, 0
    nop                             iaddiu vi03, vi02, 170               ; vi03: the output, 170 qwords after the batch
    nop                             iaddiu vi04, vi03, 0
    nop                             ilwr.x vi06, (vi05)                  ; the batch type (qword 0)
    nop                             iaddiu vi05, vi05, 1
    nop                             iaddiu vi11, vi00, 32767             ; 0x7FFF: the NLOOP mask
    nop                             lq.xyzw vf31, 0(vi05)
    nop                             ilwr.x vi08, (vi05)                  ; the GIF tag (qword 1): NLOOP, EOP
    nop                             iand vi07, vi11, vi08
    nop                             iaddiu vi11, vi00, 1
    nop                             iaddiu vi05, vi05, 1
    nop                             ibeq vi11, vi06, vertices
    nop                             sqi.xyzw vf31, (vi04++)

    ; a register block: the GIF tag and its NLOOP qwords (A+D) go through to the output
copy_regs:
    nop                             lq.xyzw vf30, 0(vi05)
    nop                             iaddi vi07, vi07, -1
    nop                             iaddiu vi05, vi05, 1
    nop                             iaddiu vi04, vi04, 1
    nop                             ibne vi07, vi00, copy_regs
    nop                             sq.xyzw vf30, -1(vi04)
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             nop                               [E] ; end: the next MSCNT continues at copy_regs_cont
    nop                             nop

    ; the next MSCNT continues here
copy_regs_cont:
    nop                             b batch                              ; the next batch
    nop                             nop

    ; type 1: a strip of NLOOP vertices
vertices:
    nop                             iaddiu vi08, vi08, 2                 ; NLOOP + 2: the delay line's last vertices go out first
    nop                             lq.xyzw vf22, 917(vi00)
    nop                             lq.xyzw vf23, 918(vi00)
    nop                             lq.xyzw vf24, 919(vi00)
    nop                             isw.x vi08, -1(vi04)
    nop                             sqi.xyzw vf22, (vi04++)
    nop                             sqi.xyzw vf23, (vi04++)
    nop                             sqi.xyzw vf24, (vi04++)
    nop                             lq.xyzw vf28, 0(vi05)
    nop                             lq.xyzw vf29, 1(vi05)
    nop                             lq.xyzw vf31, 3(vi05)
    nop                             lq.xyzw vf30, 2(vi05)
    mulax.xyzw ACC, vf01, vf28x     lq.xyzw vf22, 914(vi00)
    madday.xyzw ACC, vf02, vf28y    lq.xyzw vf23, 915(vi00)
    maddaz.xyzw ACC, vf03, vf28z    lq.xyzw vf24, 916(vi00)
    maddw.xyzw vf27, vf04, vf00w    nop
    mulax.xyz ACC, vf09, vf29x      sqi.xyzw vf22, (vi04++)
    madday.xyz ACC, vf10, vf29y     sqi.xyzw vf23, (vi04++)
    maddz.xyz vf29, vf11, vf29z     sqi.xyzw vf24, (vi04++)
    ; one vertex per pass, software-pipelined through the delay line
vertices_loop:
    subw.x vf26, vf20, vf27w        div Q, vf00w, vf27w                  ; Q = 1 / vf27.w
    mulax.xy ACC, vf17, vf31x       ilw.w vi09, 0(vi05)                  ; vi09: the position's w word, XYZF2's w (F, ADC) as the model has it
    madday.xy ACC, vf18, vf31y      lq.xyzw vf22, 1020(vi00)
    maxx.xyz vf29, vf29, vf00x      lq.xyzw vf24, 1019(vi00)
    muly.x vf26, vf26, vf20y        lq.xyzw vf25, 1018(vi00)
    maddw.xy vf31, vf19, vf00w      iaddiu vi05, vi05, 4
    clipw.xyz vf22, vf22w           loi 255.0                            ; I = 255.0
    mulax.xyz ACC, vf12, vf29x      sq.xyzw vf22, 1023(vi00)
    muli.x vf26, vf26, I            sq.xyzw vf24, 1022(vi00)
    madday.xyz ACC, vf13, vf29y     sq.xyzw vf25, 1021(vi00)
    maddaz.xyz ACC, vf14, vf29z     iaddi vi07, vi07, -1
    madda.xyz ACC, vf15, vf30       lq.xyzw vf23, 1015(vi00)
    minii.x vf26, vf26, I           lq.xyzw vf24, 1017(vi00)
    madd.xyz vf30, vf16, vf30       lq.xyzw vf25, 1016(vi00)
    mulq.xyz vf27, vf27, Q          nop
    mulq.xyz vf31, vf31, Q          sq.xyzw vf31, 1015(vi00)
    maxx.x vf26, vf26, vf00x        loi 128.0                            ; I = 128.0: the colour clamp (0x80 is 1.0 on the GS)
    minii.xyzw vf30, vf30, I        sq.xyzw vf23, 1018(vi00)
    ftoi4.xyz vf27, vf27            sq.xyzw vf24, 1020(vi00)
    mulax.xyzw ACC, vf05, vf28x     sq.xyzw vf31, 0(vi04)
    ftoi4.x vf26, vf26              sq.xyzw vf25, 1019(vi00)
    mul.xyzw vf30, vf30, vf21       lq.xyzw vf29, 1(vi05)
    madday.xyzw ACC, vf06, vf28y    sq.xyz vf27, 2(vi04)
    maddaz.xyzw ACC, vf07, vf28z    lq.xyzw vf28, 0(vi05)
    maddw.xyzw vf26, vf08, vf00w    mtir vi13, vf26x
    ftoi0.xyzw vf25, vf30           iaddiu vi04, vi04, 3
    clipw.xyz vf24, vf24w           lq.xyzw vf31, 3(vi05)                ; clip flags: vf24.xyz against +-vf24.w
    mulax.xyzw ACC, vf01, vf28x     lq.xyzw vf30, 2(vi05)
    clipw.xyz vf26, vf26w           sq.xyzw vf26, 1017(vi00)
    madday.xyzw ACC, vf02, vf28y    sq.xyzw vf25, 1016(vi00)
    maddaz.xyzw ACC, vf03, vf28z    ibne vi09, vi00, vertices_in_view
    maddw.xyzw vf27, vf04, vf00w    sq.xyzw vf25, -2(vi04)
    nop                             fcand vi01, 0x03ffff                 ; vi01 = 1: one of the last three vertices is outside the clip volume
    nop                             ibeq vi01, vi00, vertices_in_view
    nop                             fcor vi01, 0xfdf7df
    nop                             ibne vi01, vi00, vertices_culled
    nop                             fcor vi01, 0xfefbef
    nop                             ibne vi01, vi00, vertices_culled
    nop                             fcor vi01, 0xff7df7
    nop                             ibne vi01, vi00, vertices_culled
    nop                             fcor vi01, 0xffbefb
    nop                             ibne vi01, vi00, vertices_culled
    nop                             fcor vi01, 0xffdf7d
    nop                             ibne vi01, vi00, vertices_culled
    nop                             fcor vi01, 0xffefbe
    nop                             ibne vi01, vi00, vertices_culled
    nop                             nop
    nop                             bal vi15, clip_triangle
    nop                             nop
    ; the triangle is wholly outside one plane: culled
vertices_culled:
    nop                             iaddiu vi09, vi00, 32767
    nop                             iaddiu vi09, vi09, 1
    ; the last three vertices are all inside the clip volume
vertices_in_view:
    mulax.xyz ACC, vf09, vf29x      iadd vi09, vi09, vi13
    madday.xyz ACC, vf10, vf29y     ibne vi07, vi00, vertices_loop
    maddz.xyz vf29, vf11, vf29z     isw.w vi09, -1(vi04)
    ; the epilogue: the vertices left in the delay line
    nop                             lqd.xyzw vf22, (--vi04)
    nop                             lqd.xyzw vf23, (--vi04)
    nop                             lqd.xyzw vf24, (--vi04)
    nop                             lqd.xyzw vf25, (--vi04)
    nop                             lqd.xyzw vf26, (--vi04)
    nop                             lqd.xyzw vf27, (--vi04)
    nop                             sq.xyzw vf22, 916(vi00)
    nop                             sq.xyzw vf23, 915(vi00)
    nop                             sq.xyzw vf24, 914(vi00)
    nop                             sq.xyzw vf25, 919(vi00)
    nop                             sq.xyzw vf26, 918(vi00)
    nop                             sq.xyzw vf27, 917(vi00)
    nop                             xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             nop
    nop                             nop                               [E] ; end: the next MSCNT continues at vertices_cont
    nop                             nop

    ; the next MSCNT continues here
vertices_cont:
    nop                             b batch                              ; the next batch
    nop                             nop

    ; clip the last three vertices' triangle against the six planes of the clip volume and
    ; send what is left as a fan (the GIF tag template at VU 0x3A6)
clip_triangle:
    nop                             iaddiu vi14, vi00, 934
    nop                             sqd.xyzw vf21, (--vi14)
    nop                             sqd.xyzw vf22, (--vi14)
    nop                             sqd.xyzw vf23, (--vi14)
    nop                             sqd.xyzw vf24, (--vi14)
    nop                             sqd.xyzw vf25, (--vi14)
    nop                             sqd.xyzw vf26, (--vi14)
    nop                             sqd.xyzw vf27, (--vi14)
    nop                             sqd.xyzw vf28, (--vi14)
    nop                             sqd.xyzw vf29, (--vi14)
    nop                             sqd.xyzw vf30, (--vi14)
    nop                             sqd.xyzw vf31, (--vi14)
    nop                             isubiu vi14, vi14, 1
    nop                             iswr.x vi02, (vi14)
    nop                             iswr.y vi03, (vi14)
    nop                             iswr.z vi04, (vi14)
    nop                             iswr.w vi05, (vi14)
    nop                             isubiu vi14, vi14, 1
    nop                             iswr.x vi06, (vi14)
    nop                             iswr.y vi07, (vi14)
    nop                             iswr.z vi08, (vi14)
    nop                             iswr.w vi09, (vi14)
    nop                             isubiu vi14, vi14, 1
    nop                             iswr.x vi10, (vi14)
    nop                             iswr.y vi11, (vi14)
    nop                             iswr.z vi12, (vi14)
    nop                             iswr.w vi13, (vi14)
    nop                             iaddiu vi08, vi00, 0
    nop                             iaddiu vi09, vi00, 935
    nop                             iaddiu vi10, vi00, 975
    nop                             lq.xyzw vf23, 1022(vi00)
    nop                             lq.xyzw vf24, 1019(vi00)
    nop                             lq.xyzw vf25, 1016(vi00)
    nop                             lq.xyzw vf26, 1021(vi00)
    itof0.xyzw vf23, vf23           lq.xyzw vf27, 1018(vi00)
    itof0.xyzw vf24, vf24           lq.xyzw vf28, 1015(vi00)
    itof0.xyzw vf25, vf25           lq.xyzw vf29, 1023(vi00)
    nop                             lq.xyzw vf30, 1020(vi00)
    nop                             lq.xyzw vf31, 1017(vi00)
    nop                             sq.xyzw vf23, 1(vi09)
    nop                             sq.xyzw vf24, 4(vi09)
    nop                             sq.xyzw vf25, 7(vi09)
    nop                             sq.xyzw vf23, 10(vi09)
    nop                             sq.xyzw vf26, 2(vi09)
    nop                             sq.xyzw vf27, 5(vi09)
    nop                             sq.xyzw vf28, 8(vi09)
    nop                             sq.xyzw vf26, 11(vi09)
    nop                             sq.xyzw vf29, 0(vi09)
    nop                             sq.xyzw vf30, 3(vi09)
    nop                             sq.xyzw vf31, 6(vi09)
    nop                             sq.xyzw vf29, 9(vi09)
    nop                             iaddiu vi09, vi00, 935
    nop                             iaddiu vi10, vi00, 975
    nop                             iaddiu vi05, vi00, 2048
    nop                             iaddiu vi06, vi00, 32
    subw.x vf31, vf00, vf00w        bal vi13, first_vertex
    nop                             iaddiu vi07, vi00, 2
    nop                             iaddiu vi04, vi00, 3
    nop                             iaddiu vi11, vi00, 0
    nop                             bal vi13, clip_edges
    nop                             nop
    nop                             bal vi13, close_polygon
    nop                             iaddiu vi09, vi00, 975
    nop                             iaddiu vi09, vi00, 975
    nop                             iaddiu vi10, vi00, 935
    nop                             iaddiu vi05, vi00, 1024
    nop                             iaddiu vi06, vi00, 16
    addw.x vf31, vf00, vf00w        bal vi13, pass_start
    nop                             iaddiu vi07, vi00, 2
    nop                             bal vi13, clip_edges
    nop                             nop
    nop                             bal vi13, close_polygon
    nop                             iaddiu vi09, vi00, 935
    nop                             iaddiu vi05, vi00, 128
    nop                             iaddiu vi06, vi00, 2
    subw.x vf31, vf00, vf00w        bal vi13, pass_a_to_b
    nop                             iaddiu vi07, vi00, 0
    nop                             bal vi13, clip_edges
    nop                             nop
    nop                             bal vi13, close_polygon
    nop                             iaddiu vi09, vi00, 975
    nop                             iaddiu vi05, vi00, 64
    nop                             iaddiu vi06, vi00, 1
    addw.x vf31, vf00, vf00w        bal vi13, pass_b_to_a
    nop                             iaddiu vi07, vi00, 0
    nop                             bal vi13, clip_edges
    nop                             nop
    nop                             bal vi13, close_polygon
    nop                             iaddiu vi09, vi00, 935
    nop                             iaddiu vi05, vi00, 512
    nop                             iaddiu vi06, vi00, 8
    subw.x vf31, vf00, vf00w        bal vi13, pass_a_to_b
    nop                             iaddiu vi07, vi00, 1
    nop                             bal vi13, clip_edges
    nop                             nop
    nop                             bal vi13, close_polygon
    nop                             iaddiu vi09, vi00, 975
    nop                             iaddiu vi05, vi00, 256
    nop                             iaddiu vi06, vi00, 4
    addw.x vf31, vf00, vf00w        bal vi13, pass_b_to_a
    nop                             iaddiu vi07, vi00, 1
    nop                             bal vi13, clip_edges
    nop                             nop
    nop                             bal vi13, close_polygon
    nop                             iaddiu vi09, vi00, 935
    nop                             iaddiu vi09, vi00, 935
    nop                             iaddiu vi10, vi00, 975
    nop                             iadd vi04, vi00, vi11
    nop                             iaddiu vi11, vi00, 0
    nop                             ilwr.y vi06, (vi02)
    nop                             lq.xyzw vf31, 934(vi00)
    nop                             lq.xyzw vf26, 20(vi00)
    nop                             lq.xyzw vf27, 21(vi00)
    nop                             ilw.x vi12, 934(vi00)
    nop                             iadd vi06, vi06, vi03
    nop                             iaddiu vi02, vi06, 0
    nop                             sqi.xyzw vf31, (vi06++)
    nop                             iadd vi12, vi12, vi04
    nop                             lq.xyzw vf28, 22(vi00)
    nop                             lq.xyzw vf29, 23(vi00)
    nop                             lq.xyzw vf30, 24(vi00)
    nop                             xgkick vi02                          ; send the output to the GS (PATH1)
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             isw.x vi12, -1(vi06)
    nop                             nop
clip_triangle_loop:
    nop                             lqi.xyzw vf23, (vi09++)
    nop                             lqi.xyzw vf24, (vi09++)
    nop                             lqi.xyzw vf25, (vi09++)
    nop                             nop
    mulax.xyzw ACC, vf27, vf23x     nop
    madday.xyzw ACC, vf28, vf23y    nop
    maddaz.xyzw ACC, vf29, vf23z    nop
    maddw.xyzw vf23, vf30, vf23w    loi 128.0                            ; I = 128.0: the colour clamp (0x80 is 1.0 on the GS)
    minii.xyz vf24, vf24, I         nop
    nop                             nop
    nop                             nop
    nop                             div Q, vf00w, vf23w                  ; Q = 1 / vf23.w
    ftoi0.xyzw vf24, vf24           waitq
    mulq.xyz vf23, vf23, Q          nop
    mulq.xyz vf25, vf25, Q          nop
    nop                             nop
    nop                             sq.xyzw vf24, 1(vi06)
    ftoi4.xyz vf23, vf23            nop
    nop                             sq.xyzw vf25, 0(vi06)
    nop                             nop
    nop                             nop
    nop                             sq.xyz vf23, 2(vi06)
    subw.x vf23, vf26, vf23w        nop
    nop                             nop
    nop                             nop
    nop                             nop
    muly.x vf23, vf23, vf26y        nop
    nop                             nop
    nop                             nop
    nop                             loi 255.0                            ; I = 255.0
    muli.x vf23, vf23, I            nop
    nop                             nop
    nop                             nop
    nop                             nop
    minii.x vf23, vf23, I           nop
    nop                             nop
    nop                             nop
    nop                             nop
    maxx.x vf23, vf23, vf00x        nop
    nop                             nop
    nop                             nop
    nop                             nop
    ftoi4.x vf23, vf23              nop
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             mtir vi13, vf23x
    nop                             iaddi vi04, vi04, -1
    nop                             iaddiu vi06, vi06, 3
    nop                             ibne vi04, vi00, clip_triangle_loop
    nop                             isw.w vi13, -1(vi06)
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             xgkick vi02                          ; send the output to the GS (PATH1)
    nop                             nop
clip_triangle_exit:
    nop                             ilwr.x vi10, (vi14)
    nop                             ilwr.y vi11, (vi14)
    nop                             ilwr.z vi12, (vi14)
    nop                             ilwr.w vi13, (vi14)
    nop                             iaddiu vi14, vi14, 1
    nop                             ilwr.x vi06, (vi14)
    nop                             ilwr.y vi07, (vi14)
    nop                             ilwr.z vi08, (vi14)
    nop                             ilwr.w vi09, (vi14)
    nop                             iaddiu vi14, vi14, 1
    nop                             ilwr.x vi02, (vi14)
    nop                             ilwr.y vi03, (vi14)
    nop                             ilwr.z vi04, (vi14)
    nop                             ilwr.w vi05, (vi14)
    nop                             iaddiu vi14, vi14, 1
    nop                             lqi.xyzw vf31, (vi14++)
    nop                             lqi.xyzw vf30, (vi14++)
    nop                             lqi.xyzw vf29, (vi14++)
    nop                             lqi.xyzw vf28, (vi14++)
    nop                             lqi.xyzw vf27, (vi14++)
    nop                             lqi.xyzw vf26, (vi14++)
    nop                             lqi.xyzw vf25, (vi14++)
    nop                             lqi.xyzw vf24, (vi14++)
    nop                             lqi.xyzw vf23, (vi14++)
    nop                             lqi.xyzw vf22, (vi14++)
    nop                             jr vi15
    nop                             lqi.xyzw vf21, (vi14++)

    ; after a plane: repeat the first output vertex after the last; an empty polygon leaves
    ; (clip_triangle_exit)
close_polygon:
    nop                             lqi.xyzw vf29, (vi09++)
    nop                             lqi.xyzw vf30, (vi09++)
    nop                             lqi.xyzw vf31, (vi09++)
    nop                             nop
    nop                             sqi.xyzw vf29, (vi10++)
    nop                             sqi.xyzw vf30, (vi10++)
    nop                             ibeq vi11, vi00, clip_triangle_exit
    nop                             sqi.xyzw vf31, (vi10++)
    nop                             jr vi13
    nop                             nop

    ; the next plane reads the polygon at VU 935.. and writes the one at 975.. (as set at
    ; clip_triangle)
pass_a_to_b:
    nop                             iaddiu vi09, vi00, 935
    nop                             b pass_start
    nop                             iaddiu vi10, vi00, 975

    ; the next plane reads the second polygon buffer and writes the first
pass_b_to_a:
    nop                             iaddiu vi09, vi00, 975
    nop                             iaddiu vi10, vi00, 935

    ; vi04: the vertices to clip; vi11: none written yet
pass_start:
    nop                             iadd vi04, vi00, vi11
    nop                             iaddiu vi11, vi00, 0

    ; load the polygon's first vertex (three qwords)
first_vertex:
    nop                             lqi.xyzw vf21, (vi09++)
    nop                             lqi.xyzw vf22, (vi09++)
    nop                             jr vi13
    nop                             lqi.xyzw vf23, (vi09++)

    ; clip the polygon's edges against one plane (vi05, vi06: its clip-flag bits; vf31.x its
    ; sign)
clip_edges:
    mulw.xyzw vf24, vf21, vf00w     lqi.xyzw vf21, (vi09++)
    mulw.xyzw vf25, vf22, vf00w     lqi.xyzw vf22, (vi09++)
    mulw.xyzw vf26, vf23, vf00w     lqi.xyzw vf23, (vi09++)
    nop                             nop
    clipw.xyz vf24, vf24w           nop                                  ; clip flags: vf24.xyz against +-vf24.w
    clipw.xyz vf21, vf21w           nop
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             fcget vi01
    nop                             nop
    nop                             iand vi12, vi01, vi05
    nop                             nop
    nop                             ibeq vi12, vi00, clip_edges_skip
    nop                             nop
    nop                             iand vi12, vi01, vi06
    nop                             nop
    nop                             ibne vi12, vi00, clip_edges_skip3
    nop                             nop
    nop                             bal vi01, intersect
    nop                             nop
    nop                             sqi.xyzw vf28, (vi10++)
    nop                             sqi.xyzw vf29, (vi10++)
    nop                             sqi.xyzw vf30, (vi10++)
    nop                             b clip_edges_skip3
    nop                             iaddiu vi11, vi11, 1
clip_edges_skip:
    nop                             iand vi12, vi01, vi06
    nop                             nop
    nop                             ibeq vi12, vi00, clip_edges_skip2
    nop                             nop
    nop                             bal vi01, intersect
    nop                             nop
    nop                             sqi.xyzw vf24, (vi10++)
    nop                             sqi.xyzw vf25, (vi10++)
    nop                             sqi.xyzw vf26, (vi10++)
    nop                             sqi.xyzw vf28, (vi10++)
    nop                             sqi.xyzw vf29, (vi10++)
    nop                             sqi.xyzw vf30, (vi10++)
    nop                             b clip_edges_skip3
    nop                             iaddiu vi11, vi11, 2
clip_edges_skip2:
    nop                             sqi.xyzw vf24, (vi10++)
    nop                             sqi.xyzw vf25, (vi10++)
    nop                             sqi.xyzw vf26, (vi10++)
    nop                             iaddiu vi11, vi11, 1
clip_edges_skip3:
    nop                             isubiu vi04, vi04, 1
    nop                             nop
    nop                             ibne vi04, vi00, clip_edges
    nop                             nop
    nop                             jr vi13
    nop                             nop

    ; an edge crosses the plane: write the intersection (position and attributes interpolated)
intersect:
    mulx.w vf28, vf24, vf31x        nop
    mulx.w vf29, vf21, vf31x        nop
    nop                             nop
    nop                             nop
    subw.xyzw vf28, vf24, vf28w     nop
    subw.xyzw vf29, vf21, vf29w     nop
    nop                             iadd vi12, vi00, vi07
    nop                             nop
intersect_loop:
    nop                             ibeq vi12, vi00, intersect_skip
    nop                             nop
    nop                             mr32.xyzw vf28, vf28
    nop                             mr32.xyzw vf29, vf29
    nop                             isubiu vi12, vi12, 1
    nop                             nop
    nop                             b intersect_loop
    nop                             nop
intersect_skip:
    sub.xyz vf30, vf29, vf28        nop
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             div Q, vf28x, vf30x
    nop                             waitq
    addq.x vf27, vf00, Q            nop
    sub.xyzw vf28, vf21, vf24       nop
    sub.xyzw vf29, vf22, vf25       nop
    sub.xyzw vf30, vf23, vf26       nop
    abs.x vf27, vf27                nop
    nop                             nop
    nop                             nop
    nop                             nop
    mulx.xyzw vf28, vf28, vf27x     nop
    mulx.xyzw vf29, vf29, vf27x     nop
    mulx.xyzw vf30, vf30, vf27x     nop
    nop                             nop
    add.xyzw vf28, vf28, vf24       nop
    add.xyzw vf29, vf29, vf25       nop
    add.xyzw vf30, vf30, vf26       jr vi01
    nop                             nop
.endprogram

;=======================================================================================
; Vu1Prog48: normals (key bit 0x20), material colour, no vertex colours, fog, second colour
;
; gVu1ProgInfo48 (bones.c): 120 pairs (960 bytes), batches of up to 3200 bytes;
; Vu1_SelectProgram's key 0x28022, rigid models (0x21035, 0x121035).
; Setup Vu1Pkt_DV: an UNPACK of 11 qwords to VU 0, then MSCALF 0:
;   0        colour: gGsColorF, RGB scaled by the model's brightness
;   1        second colour: gGsColor2F: vf10
;   2-5      gMtxSlots x gMtxView x gMtxProjClip: model to screen (XYZ after the divide by w): vf01-vf04
;   6-9      the matrix above x gViewportMtx: model to the clip test's space: vf05-vf08
;   10       fog range: gGsFogFar and the word after it: vf09
; Vertices: gVu1ProgLayouts[0], 3 qwords: position, normal, texture coordinates.
; Batches at VU 0xb and 0xb + 0x1fa (XTOP); the output follows each.
;=======================================================================================
.program Vu1Prog48
.base 0xb
.offset 0x1fa

    ; MSCALF 0: the setup's constants into registers
init:
    nop                             lq.xyzw vf01, 2(vi00)
    nop                             lq.xyzw vf02, 3(vi00)
    nop                             lq.xyzw vf03, 4(vi00)
    nop                             lq.xyzw vf04, 5(vi00)
    nop                             lq.xyzw vf05, 6(vi00)
    nop                             lq.xyzw vf06, 7(vi00)
    nop                             lq.xyzw vf07, 8(vi00)
    nop                             lq.xyzw vf08, 9(vi00)
    nop                             lq.xyzw vf09, 10(vi00)
    nop                             lq.xyzw vf10, 1(vi00)
    nop                             nop                               [E] ; end: constants loaded
    nop                             nop

    ; MSCNT: one batch at XTOP; qword 0's x is its type, qword 1 a GIF tag
batch:
    nop                             xtop vi02                            ; vi02: the batch (BASE, or BASE + OFFSET: double buffer)
    nop                             iaddiu vi05, vi02, 0
    nop                             iaddiu vi03, vi02, 200               ; vi03: the output, 200 qwords after the batch
    nop                             iaddiu vi04, vi03, 0
    nop                             ilwr.x vi06, (vi05)                  ; the batch type (qword 0)
    nop                             iaddiu vi05, vi05, 1
    nop                             iaddiu vi11, vi00, 32767             ; 0x7FFF: the NLOOP mask
    nop                             ilwr.x vi08, (vi05)                  ; the GIF tag (qword 1): NLOOP, EOP
    nop                             lq.xyzw vf31, 0(vi05)
    nop                             iaddiu vi05, vi05, 1
    nop                             iaddiu vi01, vi00, 1
    nop                             iand vi07, vi11, vi08
    nop                             ibeq vi01, vi06, vertices
    nop                             sqi.xyzw vf31, (vi04++)

    ; a register block: the GIF tag and its NLOOP qwords (A+D) go through to the output
copy_regs:
    nop                             lq.xyzw vf31, 0(vi05)
    nop                             iaddi vi07, vi07, -1
    nop                             iaddiu vi05, vi05, 1
    nop                             iaddiu vi04, vi04, 1
    nop                             ibne vi07, vi00, copy_regs
    nop                             sq.xyzw vf31, -1(vi04)
    nop                             lq.xyzw vf25, 0(vi05)
    nop                             nop
    nop                             nop
    nop                             loi 128.0                            ; I = 128.0: the colour clamp (0x80 is 1.0 on the GS)
    muli.xyz vf25, vf25, I          nop
    nop                             nop
    nop                             nop
    nop                             nop
    minii.xyz vf25, vf25, I         nop
    nop                             nop
    nop                             nop
    nop                             nop
    mul.xyzw vf25, vf25, vf10       nop
    nop                             nop
    nop                             nop
    nop                             nop
    ftoi0.xyzw vf25, vf25           xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             nop                               [E] ; end: the next MSCNT continues at copy_regs_cont
    nop                             nop

    ; the next MSCNT continues here
copy_regs_cont:
    nop                             b batch                              ; the next batch
    nop                             nop

    ; type 1: a strip of NLOOP vertices
vertices:
    nop                             iaddiu vi08, vi08, 2                 ; NLOOP + 2: the delay line's last vertices go out first
    nop                             isw.x vi08, -1(vi04)
    nop                             loi 255.0                            ; I = 255.0
    nop                             lq.xyzw vf29, 0(vi05)
    nop                             ilw.w vi09, 0(vi05)                  ; vi09: the position's w word, XYZF2's w (F, ADC) as the model has it
    nop                             lq.xyzw vf30, 1(vi05)
    nop                             lq.xyzw vf31, 2(vi05)
    nop                             iaddiu vi05, vi05, 3
    mulax.xyzw ACC, vf01, vf29x     lq.xyzw vf11, 1022(vi00)
    madday.xyzw ACC, vf02, vf29y    lq.xyzw vf12, 1023(vi00)
    maddaz.xyzw ACC, vf03, vf29z    lq.xyzw vf13, 1020(vi00)
    maddw.xyzw vf24, vf04, vf00w    lq.xyzw vf14, 1021(vi00)
    nop                             sqi.xyzw vf11, (vi04++)
    nop                             sqi.xyzw vf25, (vi04++)
    nop                             sqi.xyzw vf12, (vi04++)
    subw.x vf21, vf09, vf24w        div Q, vf00w, vf24w                  ; Q = 1 / vf24.w
    nop                             sqi.xyzw vf13, (vi04++)
    nop                             sqi.xyzw vf25, (vi04++)
    mulax.xyzw ACC, vf05, vf29x     sqi.xyzw vf14, (vi04++)
    ; one vertex per pass, software-pipelined through the delay line
vertices_loop:
    muly.x vf21, vf21, vf09y        nop
    madday.xyzw ACC, vf06, vf29y    move.xyz vf26, vf27
    maddaz.xyzw ACC, vf07, vf29z    move.xyz vf27, vf28
    maddw.xyzw vf22, vf08, vf00w    nop
    muli.x vf21, vf21, I            nop
    mulq.xyz vf20, vf24, Q          nop
    sub.xyz vf18, vf27, vf26        iaddi vi07, vi07, -1
    clipw.xyz vf22, vf22w           nop                                  ; clip flags: vf22.xyz against +-vf22.w
    minii.x vf21, vf21, I           nop
    sub.xyz vf19, vf20, vf26        move.xyz vf28, vf20
    ftoi4.xyz vf20, vf20            lq.xyzw vf29, 0(vi05)
    mulq.xyz vf23, vf31, Q          iaddiu vi14, vi09, 0
    maxx.x vf21, vf21, vf00x        ilw.w vi09, 0(vi05)
    opmula.xyz ACC, vf19, vf18      lq.xyzw vf31, 2(vi05)
    opmsub.xyz vf17, vf18, vf19     sq.xyz vf20, 2(vi04)
    mulax.xyzw ACC, vf01, vf29x     sq.xyzw vf25, 1(vi04)
    ftoi4.x vf21, vf21              sq.xyzw vf23, 0(vi04)
    madday.xyzw ACC, vf02, vf29y    iaddiu vi05, vi05, 3
    maddaz.xyzw ACC, vf03, vf29z    fcand vi01, 0x03ffff                 ; vi01 = 1: one of the last three vertices is outside the clip volume
    maddw.xyzw vf24, vf04, vf00w    ibne vi01, vi00, vertices_skip
    mulw.z vf17, vf17, vf30w        mtir vi13, vf21x
    nop                             nop
    nop                             ibne vi14, vi00, vertices_skip2
    nop                             iaddiu vi01, vi00, 32
    nop                             fmand vi01, vi01
    nop                             ibeq vi01, vi00, vertices_skip2
    nop                             nop
vertices_skip:
    nop                             iaddiu vi14, vi00, 32767             ; ADC: 0x7FFF + 1 = 0x8000, so the GS draws no triangle ending here
    nop                             iaddiu vi14, vi14, 1
vertices_skip2:
    nop                             lq.xyzw vf30, -2(vi05)
    nop                             iaddiu vi04, vi04, 3
    subw.x vf21, vf09, vf24w        div Q, vf00w, vf24w
    nop                             iadd vi14, vi14, vi13
    nop                             ibne vi07, vi00, vertices_loop
    mulax.xyzw ACC, vf05, vf29x     isw.w vi14, -1(vi04)
    ; the epilogue: the vertices left in the delay line
    nop                             lq.xyzw vf11, -1(vi04)
    nop                             lq.xyzw vf12, -3(vi04)
    nop                             lq.xyzw vf13, -4(vi04)
    nop                             xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             lq.xyzw vf14, -6(vi04)
    nop                             sq.xyzw vf11, 1021(vi00)
    nop                             sq.xyzw vf12, 1020(vi00)
    nop                             sq.xyzw vf13, 1023(vi00)
    nop                             sq.xyzw vf14, 1022(vi00)
    nop                             nop                               [E] ; end: the next MSCNT continues at vertices_cont
    nop                             nop

    ; the next MSCNT continues here
vertices_cont:
    nop                             b batch                              ; the next batch
    nop                             nop
.endprogram

;=======================================================================================
; Vu1Prog49: three lights, normals (key bit 0x20), material colour, no vertex colours, gMtxUv rows
;
; gVu1ProgInfo49 (bones.c): 135 pairs (1080 bytes), batches of up to 3968 bytes;
