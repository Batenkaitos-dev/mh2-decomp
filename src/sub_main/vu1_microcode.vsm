vertices_in_view:
    ftoi4.xyzw vf28, vf28           lq.xyzw vf31, 1(vi05)                ; to 12.4 fixed point (GS XYZ)
    nop                             sq.xyzw vf26, 1018(vi00)
    nop                             isw.w vi09, 1020(vi00)
    nop                             ibne vi07, vi00, vertices_loop
