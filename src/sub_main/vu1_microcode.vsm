blended_loop:
    nop                             nop
    nop                             loi 255.0                            ; I = 255.0
    mulax.xyzw ACC, vf05, vf28x     lq.xyzw vf31, 7(vi05)
    madday.xyzw ACC, vf06, vf28y    ilw.x vi10, 6(vi05)
    maddaz.xyzw ACC, vf07, vf28z    ilw.y vi11, 6(vi05)
    maddw.xyzw vf25, vf08, vf00w    ilw.z vi12, 6(vi05)
    mulax.xyzw ACC, vf01, vf28x     ilw.w vi13, 6(vi05)
    madday.xyzw ACC, vf02, vf28y    lq.xyzw vf11, 0(vi10)
    maddaz.xyzw ACC, vf03, vf28z    lq.xyzw vf12, 0(vi11)
    maddw.xyzw vf27, vf04, vf00w    lq.xyzw vf13, 0(vi12)
    clipw.xyz vf25, vf25w           lq.xyzw vf14, 0(vi13)                ; clip flags: vf25.xyz against +-vf25.w
    mulax.xyzw ACC, vf11, vf31x     lq.xyzw vf11, 1(vi10)
    madday.xyzw ACC, vf12, vf31y    lq.xyzw vf12, 1(vi11)
    subw.x vf24, vf10, vf27w        div Q, vf00w, vf27w                  ; Q = 1 / vf27.w
    maddaz.xyzw ACC, vf13, vf31z    lq.xyzw vf13, 1(vi12)
    maddw.xyzw vf15, vf14, vf31w    iaddi vi07, vi07, -1
    mulax.xyzw ACC, vf11, vf31x     ilw.w vi09, 0(vi05)                  ; vi09: the position's w word, XYZF2's w (F, ADC) as the model has it
    muly.x vf24, vf24, vf10y        lq.xyzw vf14, 1(vi13)
    madday.xyzw ACC, vf12, vf31y    lq.xyzw vf29, 1(vi05)
    maddaz.xyzw ACC, vf13, vf31z    iaddiu vi05, vi05, 4
    mulq.xyz vf27, vf27, Q          lq.xyzw vf11, 2(vi10)
    muli.x vf24, vf24, I            lq.xyzw vf12, 2(vi11)
    mulq.xyz vf26, vf29, Q          lq.xyzw vf13, 2(vi12)
    maddw.xyzw vf16, vf14, vf31w    lq.xyzw vf14, 2(vi13)
    ftoi4.xyz vf27, vf27            sq.xyzw vf30, 1(vi04)
    minii.x vf24, vf24, I           nop
    mulax.xyzw ACC, vf11, vf31x     sq.xyzw vf26, 0(vi04)
    madday.xyzw ACC, vf12, vf31y    lq.xyzw vf11, 3(vi10)
    maddaz.xyzw ACC, vf13, vf31z    lq.xyzw vf12, 3(vi11)
    maxx.x vf24, vf24, vf00x        sq.xyz vf27, 2(vi04)
    maddw.xyzw vf17, vf14, vf31w    lq.xyzw vf13, 3(vi12)
    mulax.xyzw ACC, vf11, vf31x     lq.xyzw vf14, 3(vi13)
    madday.xyzw ACC, vf12, vf31y    lq.xyzw vf28, 0(vi05)
    ftoi4.x vf24, vf24              nop
    maddaz.xyzw ACC, vf13, vf31z    iaddiu vi04, vi04, 3
    maddw.xyzw vf18, vf14, vf31w    fcand vi01, 0x03ffff                 ; vi01 = 1: one of the last three vertices is outside the clip volume
    mulax.xyzw ACC, vf15, vf28x     ibeq vi01, vi00, blended_in_view
    madday.xyzw ACC, vf16, vf28y    mtir vi13, vf24x
    nop                             iaddiu vi09, vi00, 32767
    nop                             iaddiu vi09, vi09, 1
    ; the last three vertices are all inside the clip volume
blended_in_view:
    maddaz.xyzw ACC, vf17, vf28z    iadd vi09, vi09, vi13
    maddw.xyzw vf28, vf18, vf00w    ibne vi07, vi00, blended_loop
    nop                             isw.w vi09, -1(vi04)
    ; the epilogue: the vertices left in the delay line
    nop                             lqd.xyzw vf11, (--vi04)
    nop                             lqd.xyzw vf12, (--vi04)
    nop                             lqd.xyzw vf13, (--vi04)
    nop                             lqd.xyzw vf14, (--vi04)
    nop                             lqd.xyzw vf15, (--vi04)
    nop                             lqd.xyzw vf16, (--vi04)
    nop                             sq.xyzw vf11, 1020(vi00)
    nop                             sq.xyzw vf12, 1019(vi00)
    nop                             sq.xyzw vf13, 1018(vi00)
    nop                             sq.xyzw vf14, 1023(vi00)
    nop                             sq.xyzw vf15, 1022(vi00)
    nop                             sq.xyzw vf16, 1021(vi00)
    nop                             xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             nop
    nop                             nop                               [E] ; end: the next MSCNT continues at blended_cont
    nop                             nop

    ; the next MSCNT continues here
blended_cont:
    nop                             b batch                              ; the next batch
    nop                             nop
.endprogram

;=======================================================================================
; Vu1Prog28: three lights, material colour, no vertex colours, gMtxUv rows
;
; gVu1ProgInfo28 (bones.c): 114 pairs (912 bytes), batches of up to 3968 bytes;
; Vu1_SelectProgram's key 0x4202, rigid models (0x21035, 0x121035).
; Setup Vu1Pkt_LE: an UNPACK of 19 qwords to VU 0, then MSCALF 0:
;   0        colour: gGsColorF, RGB scaled by the model's brightness: vf28
;   1-4      gMtxSlots x gMtxView x gMtxProjClip: model to screen (XYZ after the divide by w): vf01-vf04
;   5-8      the matrix above x gViewportMtx: model to the clip test's space: vf05-vf08
;   9-11     light directions (model space, negated): vf09-vf11
;   12-15    light colours (three lights and the ambient): vf24-vf27
;   16-18    rows 0, 1 and 3 of gMtxUv (Vu1_PutUvMatrix): vf16-vf18
; Vertices: gVu1ProgLayouts[0], 3 qwords: position, normal, texture coordinates.
; Batches at VU 0x13 and 0x13 + 0x1f2 (XTOP); the output follows each.
;=======================================================================================
.program Vu1Prog28
.base 0x13
.offset 0x1f2

    ; MSCALF 0: the setup's constants into registers
init:
    nop                             lq.xyzw vf01, 1(vi00)
    nop                             lq.xyzw vf02, 2(vi00)
    nop                             lq.xyzw vf03, 3(vi00)
    nop                             lq.xyzw vf04, 4(vi00)
    nop                             lq.xyzw vf05, 5(vi00)
    nop                             lq.xyzw vf06, 6(vi00)
    nop                             lq.xyzw vf07, 7(vi00)
    nop                             lq.xyzw vf08, 8(vi00)
    nop                             lq.xyzw vf09, 9(vi00)
    nop                             lq.xyzw vf10, 10(vi00)
    nop                             lq.xyzw vf11, 11(vi00)
    nop                             lq.xyzw vf16, 16(vi00)
    nop                             lq.xyzw vf17, 17(vi00)
    nop                             lq.xyzw vf18, 18(vi00)            [E] ; end: constants loaded
    nop                             loi 128.0                            ; I = 128.0: the colour clamp (0x80 is 1.0 on the GS)

    ; MSCNT: one batch at XTOP; qword 0's x is its type, qword 1 a GIF tag
batch:
    nop                             xtop vi02                            ; vi02: the batch (BASE, or BASE + OFFSET: double buffer)
    nop                             iaddiu vi05, vi02, 0
    nop                             iaddiu vi03, vi02, 248               ; vi03: the output, 248 qwords after the batch
    nop                             ilwr.x vi06, (vi05)                  ; the batch type (qword 0)
    nop                             iaddiu vi05, vi05, 1
    nop                             ilwr.x vi08, (vi05)                  ; the GIF tag (qword 1): NLOOP, EOP
    nop                             iaddiu vi04, vi03, 0
    nop                             iaddiu vi11, vi00, 32767             ; 0x7FFF: the NLOOP mask
    nop                             lq.xyzw vf31, 0(vi05)
    nop                             iand vi07, vi11, vi08
    nop                             iaddiu vi11, vi00, 1
    nop                             iaddiu vi05, vi05, 1
    nop                             ibeq vi11, vi06, vertices
    nop                             sqi.xyzw vf31, (vi04++)

    ; a register block: the GIF tag and its NLOOP qwords (A+D) go through to the output
copy_regs:
    nop                             lqi.xyzw vf30, (vi05++)
    nop                             iaddi vi07, vi07, -1
    nop                             iaddiu vi04, vi04, 1
    nop                             ibne vi07, vi00, copy_regs
    nop                             sq.xyzw vf30, -1(vi04)
    nop                             lq.xyzw vf28, 0(vi00)
    nop                             lqi.xyzw vf29, (vi05++)
    nop                             lq.xyzw vf24, 12(vi00)
    nop                             lq.xyzw vf25, 13(vi00)
    nop                             lq.xyzw vf26, 14(vi00)
    nop                             lq.xyzw vf27, 15(vi00)
    mul.xyzw vf24, vf29, vf24       nop
    mul.xyzw vf25, vf29, vf25       lqi.xyzw vf30, (vi05++)
    mul.xyzw vf26, vf29, vf26       nop
    add.xyzw vf23, vf27, vf28       nop
    muli.xyzw vf12, vf24, I         nop
    muli.xyzw vf13, vf25, I         nop
    muli.xyzw vf14, vf26, I         nop
    mul.xyzw vf15, vf23, vf30       nop
    ftoi0.xyzw vf29, vf29           nop
    minii.xyzw vf12, vf12, I        nop
    minii.xyzw vf13, vf13, I        nop
    minii.xyzw vf14, vf14, I        nop
    minii.xyzw vf15, vf15, I        mtir vi15, vf29w
    nop                             xgkick vi03                       [E] ; end: the next MSCNT continues at copy_regs_cont
    nop                             nop

    ; the next MSCNT continues here
copy_regs_cont:
    nop                             b batch                              ; the next batch
    nop                             nop

    ; type 1: a strip of NLOOP vertices
vertices:
    nop                             iaddiu vi08, vi08, 2                 ; NLOOP + 2: the delay line's last vertices go out first
    nop                             isw.x vi08, -1(vi04)
    nop                             lq.xyzw vf30, 1(vi05)
    nop                             ilw.w vi09, 0(vi05)                  ; vi09: the position's w word, XYZF2's w (F, ADC) as the model has it
    nop                             lq.xyzw vf29, 0(vi05)
    nop                             lq.xyzw vf31, 2(vi05)
    nop                             iaddiu vi05, vi05, 3
    mulax.xyzw ACC, vf09, vf30x     lq.xyzw vf19, 1021(vi00)
    madday.xyzw ACC, vf10, vf30y    lq.xyzw vf20, 1022(vi00)
    maddz.xyzw vf25, vf11, vf30z    lq.xyzw vf21, 1023(vi00)
    mulax.xyzw ACC, vf01, vf29x     lq.xyzw vf30, 1(vi05)
    madday.xyzw ACC, vf02, vf29y    sqi.xyzw vf19, (vi04++)
    ; one vertex per pass, software-pipelined through the delay line
vertices_loop:
    maddaz.xyzw ACC, vf03, vf29z    sqi.xyzw vf20, (vi04++)
    maddw.xyzw vf28, vf04, vf00w    sqi.xyzw vf21, (vi04++)
    maxx.xyzw vf25, vf25, vf00x     iaddiu vi14, vi09, 0
    mulax.xy ACC, vf16, vf31x       lq.xyzw vf19, 1018(vi00)
    madday.xy ACC, vf17, vf31y      lq.xyzw vf20, 1019(vi00)
    maddw.xy vf31, vf18, vf00w      lq.xyzw vf21, 1020(vi00)
    mulax.xyzw ACC, vf12, vf25x     div Q, vf00w, vf28w                  ; Q = 1 / vf28.w
    madday.xyzw ACC, vf13, vf25y    sq.xyzw vf19, 1021(vi00)
    maddz.xyzw vf25, vf14, vf25z    sq.xyzw vf20, 1022(vi00)
    mulax.xyzw ACC, vf05, vf29x     sq.xyzw vf21, 1023(vi00)
    madday.xyzw ACC, vf06, vf29y    ilw.w vi09, 0(vi05)
    maddaz.xyzw ACC, vf07, vf29z    lq.xyzw vf29, 0(vi05)
    add.xyzw vf25, vf25, vf15       iaddiu vi05, vi05, 3
    mulq.xyzw vf28, vf28, Q         iaddi vi07, vi07, -1
    mulq.xyz vf26, vf31, Q          isw.w vi15, 1019(vi00)
    maddw.xyzw vf27, vf08, vf00w    lq.xyzw vf31, -1(vi05)
    minii.xyzw vf25, vf25, I        lq.xyzw vf19, 1021(vi00)
    ftoi4.xyzw vf28, vf28           lq.xyzw vf20, 1022(vi00)             ; to 12.4 fixed point (GS XYZ)
    mulax.xyzw ACC, vf09, vf30x     sq.xyzw vf26, 1018(vi00)
    clipw.xyz vf27, vf27w           lq.xyzw vf21, 1023(vi00)             ; clip flags: vf27.xyz against +-vf27.w
    ftoi0.xyzw vf24, vf25           sqi.xyzw vf19, (vi04++)
    madday.xyzw ACC, vf10, vf30y    sq.xyz vf28, 1020(vi00)
    maddz.xyzw vf25, vf11, vf30z    lq.xyzw vf30, 1(vi05)
    mulax.xyzw ACC, vf01, vf29x     fcand vi01, 0x03ffff                 ; vi01 = 1: one of the last three vertices is outside the clip volume
    madday.xyzw ACC, vf02, vf29y    ibeq vi01, vi00, vertices_in_view
    nop                             sq.xyz vf24, 1019(vi00)
    nop                             iaddiu vi14, vi00, 32767             ; ADC: 0x7FFF + 1 = 0x8000, so the GS draws no triangle ending here
    nop                             iaddiu vi14, vi14, 1
    ; the last three vertices are all inside the clip volume
vertices_in_view:
    nop                             ibne vi07, vi00, vertices_loop
    nop                             isw.w vi14, 1020(vi00)
    ; the epilogue: the vertices left in the delay line
    nop                             sqi.xyzw vf20, (vi04++)
    nop                             lq.xyzw vf22, 1018(vi00)
    nop                             lq.xyzw vf23, 1019(vi00)
    nop                             lq.xyzw vf24, 1020(vi00)
    nop                             sqi.xyzw vf21, (vi04++)
    nop                             sqi.xyzw vf22, (vi04++)
    nop                             sqi.xyzw vf23, (vi04++)
    nop                             sqi.xyzw vf24, (vi04++)
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             xgkick vi03                       [E] ; end: the next MSCNT continues at vertices_cont
    nop                             nop

    ; the next MSCNT continues here
vertices_cont:
    nop                             b batch                              ; the next batch
    nop                             nop
.endprogram

;=======================================================================================
; Vu1Prog29: three lights, material colour, no vertex colours, second colour, gMtxUv rows
;
; gVu1ProgInfo29 (bones.c): 125 pairs (1000 bytes), batches of up to 3968 bytes;
; Vu1_SelectProgram's key 0x24202, rigid models (0x21035, 0x121035).
; Setup Vu1Pkt_LVE: an UNPACK of 20 qwords to VU 0, then MSCALF 0:
;   0        colour: gGsColorF, RGB scaled by the model's brightness: vf28
;   1        second colour: gGsColor2F: vf19
;   2-5      gMtxSlots x gMtxView x gMtxProjClip: model to screen (XYZ after the divide by w): vf01-vf04
;   6-9      the matrix above x gViewportMtx: model to the clip test's space: vf05-vf08
;   10-12    light directions (model space, negated): vf09-vf11
;   13-16    light colours (three lights and the ambient): vf24-vf27
;   17-19    rows 0, 1 and 3 of gMtxUv (Vu1_PutUvMatrix): vf16-vf18
; Vertices: gVu1ProgLayouts[0], 3 qwords: position, normal, texture coordinates.
; Batches at VU 0x14 and 0x14 + 0x1f2 (XTOP); the output follows each.
;=======================================================================================
.program Vu1Prog29
.base 0x14
.offset 0x1f2

    ; MSCALF 0: the setup's constants into registers
init:
    nop                             loi 128.0                            ; I = 128.0: the colour clamp (0x80 is 1.0 on the GS)
    nop                             lq.xyzw vf01, 2(vi00)
    nop                             lq.xyzw vf02, 3(vi00)
    nop                             lq.xyzw vf03, 4(vi00)
    nop                             lq.xyzw vf04, 5(vi00)
    nop                             lq.xyzw vf05, 6(vi00)
    nop                             lq.xyzw vf06, 7(vi00)
    nop                             lq.xyzw vf07, 8(vi00)
    nop                             lq.xyzw vf08, 9(vi00)
    nop                             lq.xyzw vf09, 10(vi00)
    nop                             lq.xyzw vf10, 11(vi00)
    nop                             lq.xyzw vf11, 12(vi00)
    nop                             lq.xyzw vf16, 17(vi00)
    nop                             lq.xyzw vf17, 18(vi00)
    nop                             lq.xyzw vf18, 19(vi00)
    nop                             lq.xyzw vf19, 1(vi00)
    nop                             nop                               [E] ; end: constants loaded
    nop                             nop

    ; MSCNT: one batch at XTOP; qword 0's x is its type, qword 1 a GIF tag
batch:
    nop                             xtop vi02                            ; vi02: the batch (BASE, or BASE + OFFSET: double buffer)
    nop                             iaddiu vi05, vi02, 0
    nop                             iaddiu vi03, vi02, 248               ; vi03: the output, 248 qwords after the batch
    nop                             ilwr.x vi06, (vi05)                  ; the batch type (qword 0)
    nop                             iaddiu vi05, vi05, 1
    nop                             ilwr.x vi08, (vi05)                  ; the GIF tag (qword 1): NLOOP, EOP
    nop                             iaddiu vi04, vi03, 0
    nop                             iaddiu vi11, vi00, 32767             ; 0x7FFF: the NLOOP mask
    nop                             lq.xyzw vf31, 0(vi05)
    nop                             iand vi07, vi11, vi08
    nop                             iaddiu vi11, vi00, 1
    nop                             iaddiu vi05, vi05, 1
    nop                             ibeq vi11, vi06, vertices
    nop                             sqi.xyzw vf31, (vi04++)

    ; a register block: the GIF tag and its NLOOP qwords (A+D) go through to the output
copy_regs:
    nop                             lq.xyzw vf31, 0(vi05)
    nop                             iaddi vi07, vi07, -1
    nop                             iaddiu vi05, vi05, 1
    nop                             iaddiu vi04, vi04, 1
    nop                             ibne vi07, vi00, copy_regs
    nop                             sq.xyzw vf31, -1(vi04)
    nop                             lqi.xyzw vf29, (vi05++)
    nop                             lq.xyzw vf24, 13(vi00)
    nop                             lq.xyzw vf25, 14(vi00)
    nop                             lq.xyzw vf26, 15(vi00)
    mul.xyzw vf29, vf29, vf19       lq.xyzw vf27, 16(vi00)
    nop                             lq.xyzw vf28, 0(vi00)
    nop                             nop
    nop                             nop
    mul.xyzw vf24, vf29, vf24       nop
    mul.xyzw vf25, vf29, vf25       lqi.xyzw vf30, (vi05++)
    mul.xyzw vf26, vf29, vf26       nop
    add.xyzw vf23, vf27, vf28       nop
    ftoi0.xyzw vf29, vf29           nop
    muli.xyzw vf12, vf24, I         nop
    muli.xyzw vf13, vf25, I         nop
    muli.xyzw vf14, vf26, I         nop
    mul.xyzw vf15, vf23, vf30       mtir vi15, vf29w
    minii.xyzw vf12, vf12, I        nop
    minii.xyzw vf13, vf13, I        nop
    minii.xyzw vf14, vf14, I        nop
    minii.xyzw vf15, vf15, I        xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             nop                               [E] ; end: the next MSCNT continues at copy_regs_cont
    nop                             nop

    ; the next MSCNT continues here
copy_regs_cont:
    nop                             b batch                              ; the next batch
    nop                             nop

    ; type 1: a strip of NLOOP vertices
vertices:
    nop                             iaddiu vi08, vi08, 2                 ; NLOOP + 2: the delay line's last vertices go out first
    nop                             isw.x vi08, -1(vi04)
    nop                             lq.xyzw vf30, 1(vi05)
    nop                             lq.xyzw vf29, 0(vi05)
    nop                             ilw.w vi09, 0(vi05)                  ; vi09: the position's w word, XYZF2's w (F, ADC) as the model has it
    nop                             lq.xyzw vf31, 2(vi05)
    nop                             iaddiu vi05, vi05, 3
    mulax.xyzw ACC, vf09, vf30x     nop
    madday.xyzw ACC, vf10, vf30y    nop
    maddz.xyzw vf25, vf11, vf30z    nop
    mulax.xyzw ACC, vf01, vf29x     nop
    madday.xyzw ACC, vf02, vf29y    nop
    maddaz.xyzw ACC, vf03, vf29z    nop
    ; one vertex per pass, software-pipelined through the delay line
vertices_loop:
    maxx.xyzw vf25, vf25, vf00x     iaddiu vi14, vi09, 0
    maddw.xyzw vf28, vf04, vf00w    iaddi vi07, vi07, -1
    mulax.xy ACC, vf16, vf31x       lq.xyzw vf20, 1021(vi00)
    madday.xy ACC, vf17, vf31y      lq.xyzw vf21, 1022(vi00)
    maddw.xy vf31, vf18, vf00w      lq.xyzw vf22, 1023(vi00)
    mulax.xyzw ACC, vf12, vf25x     div Q, vf00w, vf28w                  ; Q = 1 / vf28.w
    madday.xyzw ACC, vf13, vf25y    sqi.xyzw vf20, (vi04++)
    maddz.xyzw vf25, vf14, vf25z    sqi.xyzw vf21, (vi04++)
    mulax.xyzw ACC, vf05, vf29x     sqi.xyzw vf22, (vi04++)
    madday.xyzw ACC, vf06, vf29y    lq.xyzw vf30, 1(vi05)
    maddaz.xyzw ACC, vf07, vf29z    lq.xyzw vf20, 1018(vi00)
    add.xyzw vf25, vf25, vf15       lq.xyzw vf21, 1019(vi00)
    maddw.xyzw vf27, vf08, vf00w    lq.xyzw vf22, 1020(vi00)
    mulq.xyzw vf28, vf28, Q         lq.xyzw vf29, 0(vi05)
    mulq.xyz vf26, vf31, Q          sq.xyzw vf20, 1021(vi00)
    minii.xyzw vf25, vf25, I        sq.xyzw vf21, 1022(vi00)
    clipw.xyz vf27, vf27w           sq.xyzw vf22, 1023(vi00)             ; clip flags: vf27.xyz against +-vf27.w
    ftoi4.xyzw vf28, vf28           ilw.w vi09, 0(vi05)                  ; to 12.4 fixed point (GS XYZ)
    nop                             sq.xyzw vf26, 1018(vi00)
    mul.xyzw vf27, vf25, vf19       lq.xyzw vf31, 2(vi05)
    nop                             fcand vi01, 0x03ffff                 ; vi01 = 1: one of the last three vertices is outside the clip volume
    mulax.xyzw ACC, vf09, vf30x     ibeq vi01, vi00, vertices_in_view
    madday.xyzw ACC, vf10, vf30y    sq.xyz vf28, 1020(vi00)
    nop                             iaddiu vi14, vi00, 32767             ; ADC: 0x7FFF + 1 = 0x8000, so the GS draws no triangle ending here
    nop                             iaddiu vi14, vi14, 1
    ; the last three vertices are all inside the clip volume
vertices_in_view:
    ftoi0.xyzw vf27, vf27           iaddiu vi05, vi05, 3
    maddz.xyzw vf25, vf11, vf30z    isw.w vi14, 1020(vi00)
    mulax.xyzw ACC, vf01, vf29x     isw.w vi15, 1019(vi00)
    madday.xyzw ACC, vf02, vf29y    ibne vi07, vi00, vertices_loop
    maddaz.xyzw ACC, vf03, vf29z    sq.xyz vf27, 1019(vi00)
    ; the epilogue: the vertices left in the delay line
    nop                             lq.xyzw vf20, 1021(vi00)
    nop                             lq.xyzw vf21, 1022(vi00)
    nop                             lq.xyzw vf22, 1023(vi00)
    nop                             lq.xyzw vf23, 1018(vi00)
    nop                             lq.xyzw vf24, 1019(vi00)
    nop                             lq.xyzw vf25, 1020(vi00)
    nop                             sqi.xyzw vf20, (vi04++)
    nop                             sqi.xyzw vf21, (vi04++)
    nop                             sqi.xyzw vf22, (vi04++)
    nop                             sqi.xyzw vf23, (vi04++)
    nop                             sqi.xyzw vf24, (vi04++)
    nop                             sqi.xyzw vf25, (vi04++)
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             xgkick vi03                       [E] ; end: the next MSCNT continues at vertices_cont
    nop                             nop

    ; the next MSCNT continues here
vertices_cont:
    nop                             b batch                              ; the next batch
    nop                             nop
.endprogram

;=======================================================================================
; Vu1Prog30: three lights, gMtxUv rows
;
; gVu1ProgInfo30 (bones.c): 116 pairs (928 bytes), batches of up to 4080 bytes;
; Vu1_SelectProgram's key 0x4200, rigid models (0x21035, 0x121035).
; Setup Vu1Pkt_LE: an UNPACK of 19 qwords to VU 0, then MSCALF 0:
;   0        colour: gGsColorF, RGB scaled by the model's brightness: vf19
;   1-4      gMtxSlots x gMtxView x gMtxProjClip: model to screen (XYZ after the divide by w): vf01-vf04
;   5-8      the matrix above x gViewportMtx: model to the clip test's space: vf05-vf08
;   9-11     light directions (model space, negated): vf09-vf11
;   12-15    light colours (three lights and the ambient): vf12-vf15
;   16-18    rows 0, 1 and 3 of gMtxUv (Vu1_PutUvMatrix): vf16-vf18
; Vertices: gVu1ProgLayouts[1], 4 qwords: position, normal, colour, texture coordinates.
; Batches at VU 0x13 and 0x13 + 0x1f2 (XTOP); the output follows each.
;=======================================================================================
.program Vu1Prog30
.base 0x13
.offset 0x1f2

    ; MSCALF 0: the setup's constants into registers
init:
    nop                             lq.xyzw vf07, 7(vi00)
    nop                             lq.xyzw vf08, 8(vi00)
    nop                             lq.xyzw vf09, 9(vi00)
    nop                             lq.xyzw vf10, 10(vi00)
    nop                             lq.xyzw vf11, 11(vi00)
    nop                             lq.xyzw vf12, 12(vi00)
    nop                             lq.xyzw vf13, 13(vi00)
    nop                             lq.xyzw vf14, 14(vi00)
    nop                             lq.xyzw vf15, 15(vi00)
    nop                             lq.xyzw vf19, 0(vi00)
    nop                             lq.xyzw vf01, 1(vi00)
    nop                             lq.xyzw vf02, 2(vi00)
    nop                             loi 128.0                            ; I = 128.0: the colour clamp (0x80 is 1.0 on the GS)
    muli.xyzw vf12, vf12, I         lq.xyzw vf03, 3(vi00)
    muli.xyzw vf13, vf13, I         lq.xyzw vf04, 4(vi00)
    muli.xyzw vf14, vf14, I         lq.xyzw vf05, 5(vi00)
    nop                             lq.xyzw vf06, 6(vi00)
    minii.xyzw vf12, vf12, I        lq.xyzw vf16, 16(vi00)
    minii.xyzw vf13, vf13, I        lq.xyzw vf17, 17(vi00)
    minii.xyzw vf14, vf14, I        lq.xyzw vf18, 18(vi00)
    nop                             nop                               [E] ; end: constants loaded
    nop                             nop

    ; MSCNT: one batch at XTOP; qword 0's x is its type, qword 1 a GIF tag
batch:
    nop                             xtop vi02                            ; vi02: the batch (BASE, or BASE + OFFSET: double buffer)
    nop                             iaddiu vi05, vi02, 0
    nop                             iaddiu vi03, vi02, 255               ; vi03: the output, 255 qwords after the batch
    nop                             ilwr.x vi06, (vi05)                  ; the batch type (qword 0)
    nop                             iaddiu vi05, vi05, 1
    nop                             ilwr.x vi08, (vi05)                  ; the GIF tag (qword 1): NLOOP, EOP
    nop                             iaddiu vi04, vi03, 0
    nop                             iaddiu vi11, vi00, 32767             ; 0x7FFF: the NLOOP mask
    nop                             lq.xyzw vf31, 0(vi05)
    nop                             iand vi07, vi11, vi08
    nop                             iaddiu vi11, vi00, 1
    nop                             iaddiu vi05, vi05, 1
    nop                             ibeq vi11, vi06, vertices
    nop                             sqi.xyzw vf31, (vi04++)

    ; a register block: the GIF tag and its NLOOP qwords (A+D) go through to the output
copy_regs:
    nop                             lq.xyzw vf31, 0(vi05)
    nop                             iaddi vi07, vi07, -1
    nop                             iaddiu vi05, vi05, 1
    nop                             iaddiu vi04, vi04, 1
    nop                             ibne vi07, vi00, copy_regs
    nop                             sq.xyzw vf31, -1(vi04)
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             nop                               [E] ; end: the next MSCNT continues at copy_regs_cont
    nop                             nop

    ; the next MSCNT continues here
copy_regs_cont:
    nop                             b batch                              ; the next batch
    nop                             nop

    ; type 1: a strip of NLOOP vertices
vertices:
    nop                             iaddiu vi08, vi08, 2                 ; NLOOP + 2: the delay line's last vertices go out first
    nop                             isw.x vi08, -1(vi04)
    nop                             lq.xyzw vf20, 1021(vi00)
    nop                             lq.xyzw vf28, 0(vi05)
    nop                             lq.xyzw vf21, 1022(vi00)
    nop                             lq.xyzw vf22, 1023(vi00)
    nop                             lq.xyzw vf23, 1018(vi00)
    mulax.xyzw ACC, vf01, vf28x     lq.xyzw vf31, 3(vi05)
    madday.xyzw ACC, vf02, vf28y    lq.xyzw vf24, 1019(vi00)
    maddaz.xyzw ACC, vf03, vf28z    lq.xyzw vf25, 1020(vi00)
    maddw.xyzw vf27, vf04, vf00w    sqi.xyzw vf20, (vi04++)
    mulax.xy ACC, vf16, vf31x       sqi.xyzw vf21, (vi04++)
    madday.xy ACC, vf17, vf31y      sqi.xyzw vf22, (vi04++)
    maddw.xy vf31, vf18, vf00w      lq.xyzw vf29, 1(vi05)
    mulax.xyzw ACC, vf05, vf28x     div Q, vf00w, vf27w                  ; Q = 1 / vf27.w
    madday.xyzw ACC, vf06, vf28y    sqi.xyzw vf23, (vi04++)
    maddaz.xyzw ACC, vf07, vf28z    sqi.xyzw vf24, (vi04++)
    maddw.xyzw vf26, vf08, vf00w    sqi.xyzw vf25, (vi04++)
    mulax.xyzw ACC, vf09, vf29x     loi 128.0                            ; I = 128.0: the colour clamp (0x80 is 1.0 on the GS)
    ; one vertex per pass, software-pipelined through the delay line
vertices_loop:
    madday.xyzw ACC, vf10, vf29y    nop
    maddz.xyzw vf25, vf11, vf29z    ilw.w vi09, 0(vi05)                  ; vi09: the position's w word, XYZF2's w (F, ADC) as the model has it
    mulq.xyzw vf27, vf27, Q         nop
    mulq.xyz vf24, vf31, Q          lq.xyzw vf30, 2(vi05)
    clipw.xyz vf26, vf26w           iaddiu vi05, vi05, 4                 ; clip flags: vf26.xyz against +-vf26.w
    maxx.xyzw vf25, vf25, vf00x     iaddiu vi14, vi09, 0
    ftoi4.xyzw vf27, vf27           nop                                  ; to 12.4 fixed point (GS XYZ)
    nop                             sq.xyzw vf24, 0(vi04)
    nop                             nop
    mulax.xyz ACC, vf12, vf25x      lq.xyzw vf28, 0(vi05)
    madday.xyz ACC, vf13, vf25y     sq.xyz vf27, 2(vi04)
    maddaz.xyz ACC, vf14, vf25z     lq.xyzw vf29, 1(vi05)
    madda.xyz ACC, vf15, vf30       nop
    madd.xyz vf30, vf19, vf30       nop
    mulax.xyzw ACC, vf01, vf28x     lq.xyzw vf31, 3(vi05)
    madday.xyzw ACC, vf02, vf28y    nop
    maddaz.xyzw ACC, vf03, vf28z    nop
    minii.xyzw vf25, vf30, I        nop
    maddw.xyzw vf27, vf04, vf00w    iaddi vi07, vi07, -1
    mulax.xy ACC, vf16, vf31x       iaddiu vi04, vi04, 3
    madday.xy ACC, vf17, vf31y      nop
    ftoi0.xyzw vf25, vf25           nop
    maddw.xy vf31, vf18, vf00w      div Q, vf00w, vf27w
    mulax.xyzw ACC, vf05, vf28x     fcand vi01, 0x03ffff                 ; vi01 = 1: one of the last three vertices is outside the clip volume
    madday.xyzw ACC, vf06, vf28y    ibeq vi01, vi00, vertices_in_view
    maddaz.xyzw ACC, vf07, vf28z    sq.xyzw vf25, -2(vi04)
    nop                             iaddiu vi14, vi00, 32767             ; ADC: 0x7FFF + 1 = 0x8000, so the GS draws no triangle ending here
    nop                             iaddiu vi14, vi14, 1
    ; the last three vertices are all inside the clip volume
vertices_in_view:
    maddw.xyzw vf26, vf08, vf00w    ibne vi07, vi00, vertices_loop
    mulax.xyzw ACC, vf09, vf29x     isw.w vi14, -1(vi04)
    ; the epilogue: the vertices left in the delay line
    nop                             lqd.xyzw vf20, (--vi04)
    nop                             lqd.xyzw vf21, (--vi04)
    nop                             lqd.xyzw vf22, (--vi04)
    nop                             lqd.xyzw vf23, (--vi04)
    nop                             lqd.xyzw vf24, (--vi04)
    nop                             lqd.xyzw vf25, (--vi04)
    nop                             sq.xyzw vf20, 1020(vi00)
    nop                             sq.xyzw vf21, 1019(vi00)
    nop                             sq.xyzw vf22, 1018(vi00)
    nop                             sq.xyzw vf23, 1023(vi00)
    nop                             sq.xyzw vf24, 1022(vi00)
    nop                             sq.xyzw vf25, 1021(vi00)
    nop                             xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             nop                               [E] ; end: the next MSCNT continues at vertices_cont
    nop                             nop

    ; the next MSCNT continues here
vertices_cont:
    nop                             b batch                              ; the next batch
    nop                             nop
.endprogram

;=======================================================================================
; Vu1Prog31: three lights, second colour, gMtxUv rows
;
; gVu1ProgInfo31 (bones.c): 118 pairs (944 bytes), batches of up to 4080 bytes;
; Vu1_SelectProgram's key 0x24200, rigid models (0x21035, 0x121035).
; Setup Vu1Pkt_LVE: an UNPACK of 20 qwords to VU 0, then MSCALF 0:
;   0        colour: gGsColorF, RGB scaled by the model's brightness: vf20
;   1        second colour: gGsColor2F: vf19
;   2-5      gMtxSlots x gMtxView x gMtxProjClip: model to screen (XYZ after the divide by w): vf01-vf04
;   6-9      the matrix above x gViewportMtx: model to the clip test's space: vf05-vf08
;   10-12    light directions (model space, negated): vf09-vf11
;   13-16    light colours (three lights and the ambient): vf12-vf15
;   17-19    rows 0, 1 and 3 of gMtxUv (Vu1_PutUvMatrix): vf16-vf18
; Vertices: gVu1ProgLayouts[1], 4 qwords: position, normal, colour, texture coordinates.
; Batches at VU 0x14 and 0x14 + 0x1f2 (XTOP); the output follows each.
;=======================================================================================
.program Vu1Prog31
.base 0x14
.offset 0x1f2

    ; MSCALF 0: the setup's constants into registers
init:
    nop                             lq.xyzw vf06, 7(vi00)
    nop                             lq.xyzw vf07, 8(vi00)
    nop                             lq.xyzw vf08, 9(vi00)
    nop                             lq.xyzw vf09, 10(vi00)
    nop                             lq.xyzw vf10, 11(vi00)
    nop                             lq.xyzw vf11, 12(vi00)
    nop                             lq.xyzw vf12, 13(vi00)
    nop                             lq.xyzw vf13, 14(vi00)
    nop                             lq.xyzw vf14, 15(vi00)
    nop                             lq.xyzw vf15, 16(vi00)
    nop                             lq.xyzw vf20, 0(vi00)
    nop                             lq.xyzw vf01, 2(vi00)
    nop                             lq.xyzw vf02, 3(vi00)
    nop                             loi 128.0                            ; I = 128.0: the colour clamp (0x80 is 1.0 on the GS)
    muli.xyzw vf12, vf12, I         lq.xyzw vf03, 4(vi00)
    muli.xyzw vf13, vf13, I         lq.xyzw vf04, 5(vi00)
    muli.xyzw vf14, vf14, I         lq.xyzw vf05, 6(vi00)
    nop                             lq.xyzw vf16, 17(vi00)
    minii.xyzw vf12, vf12, I        lq.xyzw vf17, 18(vi00)
    minii.xyzw vf13, vf13, I        lq.xyzw vf18, 19(vi00)
    minii.xyzw vf14, vf14, I        lq.xyzw vf19, 1(vi00)
    nop                             nop                               [E] ; end: constants loaded
    nop                             nop

    ; MSCNT: one batch at XTOP; qword 0's x is its type, qword 1 a GIF tag
batch:
    nop                             xtop vi02                            ; vi02: the batch (BASE, or BASE + OFFSET: double buffer)
    nop                             iaddiu vi05, vi02, 0
    nop                             iaddiu vi03, vi02, 255               ; vi03: the output, 255 qwords after the batch
    nop                             ilwr.x vi06, (vi05)                  ; the batch type (qword 0)
    nop                             iaddiu vi05, vi05, 1
    nop                             ilwr.x vi08, (vi05)                  ; the GIF tag (qword 1): NLOOP, EOP
    nop                             iaddiu vi04, vi03, 0
    nop                             iaddiu vi11, vi00, 32767             ; 0x7FFF: the NLOOP mask
    nop                             lq.xyzw vf31, 0(vi05)
    nop                             iand vi07, vi11, vi08
    nop                             iaddiu vi11, vi00, 1
    nop                             iaddiu vi05, vi05, 1
    nop                             ibeq vi11, vi06, vertices
    nop                             sqi.xyzw vf31, (vi04++)

    ; a register block: the GIF tag and its NLOOP qwords (A+D) go through to the output
copy_regs:
    nop                             lq.xyzw vf31, 0(vi05)
    nop                             iaddi vi07, vi07, -1
    nop                             iaddiu vi05, vi05, 1
    nop                             iaddiu vi04, vi04, 1
    nop                             ibne vi07, vi00, copy_regs
    nop                             sq.xyzw vf31, -1(vi04)
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             nop                               [E] ; end: the next MSCNT continues at copy_regs_cont
    nop                             nop

    ; the next MSCNT continues here
copy_regs_cont:
    nop                             b batch                              ; the next batch
    nop                             nop

    ; type 1: a strip of NLOOP vertices
vertices:
    nop                             lq.xyzw vf28, 0(vi05)
    nop                             iaddiu vi08, vi08, 2                 ; NLOOP + 2: the delay line's last vertices go out first
    nop                             isw.x vi08, -1(vi04)
    nop                             lq.xyzw vf21, 1021(vi00)
    mulax.xyzw ACC, vf01, vf28x     lq.xyzw vf31, 3(vi05)
    madday.xyzw ACC, vf02, vf28y    lq.xyzw vf22, 1022(vi00)
    maddaz.xyzw ACC, vf03, vf28z    lq.xyzw vf23, 1023(vi00)
    maddw.xyzw vf27, vf04, vf00w    lq.xyzw vf24, 1018(vi00)
    mulax.xy ACC, vf16, vf31x       lq.xyzw vf25, 1019(vi00)
    madday.xy ACC, vf17, vf31y      lq.xyzw vf26, 1020(vi00)
    maddw.xy vf31, vf18, vf00w      lq.xyzw vf29, 1(vi05)
    mulax.xyzw ACC, vf05, vf28x     div Q, vf00w, vf27w                  ; Q = 1 / vf27.w
    madday.xyzw ACC, vf06, vf28y    sqi.xyzw vf21, (vi04++)
    maddaz.xyzw ACC, vf07, vf28z    sqi.xyzw vf22, (vi04++)
    maddw.xyzw vf21, vf08, vf00w    sqi.xyzw vf23, (vi04++)
    mulax.xyzw ACC, vf09, vf29x     sqi.xyzw vf24, (vi04++)
    madday.xyzw ACC, vf10, vf29y    sqi.xyzw vf25, (vi04++)
    maddz.xyzw vf23, vf11, vf29z    sqi.xyzw vf26, (vi04++)
    mulq.xyzw vf27, vf27, Q         loi 128.0                            ; I = 128.0: the colour clamp (0x80 is 1.0 on the GS)
    ; one vertex per pass, software-pipelined through the delay line
vertices_loop:
    mulq.xyz vf24, vf31, Q          nop
    clipw.xyz vf21, vf21w           nop                                  ; clip flags: vf21.xyz against +-vf21.w
    maxx.xyzw vf23, vf23, vf00x     lq.xyzw vf30, 2(vi05)
    ftoi4.xyzw vf27, vf27           ilw.w vi09, 0(vi05)                  ; vi09: the position's w word, XYZF2's w (F, ADC) as the model has it
    nop                             sq.xyzw vf24, 0(vi04)
    nop                             iaddiu vi05, vi05, 4
    mulax.xyz ACC, vf12, vf23x      lq.xyzw vf28, 0(vi05)
    madday.xyz ACC, vf13, vf23y     sq.xyz vf27, 2(vi04)
    maddaz.xyz ACC, vf14, vf23z     nop
    madda.xyz ACC, vf15, vf30       nop
    madd.xyz vf30, vf20, vf30       nop
    mulax.xyzw ACC, vf01, vf28x     lq.xyzw vf31, 3(vi05)
    madday.xyzw ACC, vf02, vf28y    iaddiu vi14, vi09, 0
    maddaz.xyzw ACC, vf03, vf28z    lq.xyzw vf29, 1(vi05)
    minii.xyzw vf23, vf30, I        nop
    maddw.xyzw vf27, vf04, vf00w    nop
    mulax.xy ACC, vf16, vf31x       nop
    madday.xy ACC, vf17, vf31y      nop
    mul.xyzw vf23, vf23, vf19       nop
    maddw.xy vf31, vf18, vf00w      div Q, vf00w, vf27w
    mulax.xyzw ACC, vf05, vf28x     iaddiu vi04, vi04, 3
    madday.xyzw ACC, vf06, vf28y    iaddi vi07, vi07, -1
    ftoi0.xyzw vf23, vf23           nop
    maddaz.xyzw ACC, vf07, vf28z    nop
    maddw.xyzw vf21, vf08, vf00w    fcand vi01, 0x03ffff                 ; vi01 = 1: one of the last three vertices is outside the clip volume
    mulax.xyzw ACC, vf09, vf29x     ibeq vi01, vi00, vertices_in_view
    madday.xyzw ACC, vf10, vf29y    sq.xyzw vf23, -2(vi04)
    nop                             iaddiu vi14, vi00, 32767             ; ADC: 0x7FFF + 1 = 0x8000, so the GS draws no triangle ending here
    nop                             iaddiu vi14, vi14, 1
    ; the last three vertices are all inside the clip volume
vertices_in_view:
    maddz.xyzw vf23, vf11, vf29z    ibne vi07, vi00, vertices_loop
    mulq.xyzw vf27, vf27, Q         isw.w vi14, -1(vi04)
    ; the epilogue: the vertices left in the delay line
    nop                             lqd.xyzw vf21, (--vi04)
    nop                             lqd.xyzw vf22, (--vi04)
    nop                             lqd.xyzw vf23, (--vi04)
    nop                             lqd.xyzw vf24, (--vi04)
    nop                             lqd.xyzw vf25, (--vi04)
    nop                             lqd.xyzw vf26, (--vi04)
    nop                             sq.xyzw vf21, 1020(vi00)
    nop                             sq.xyzw vf22, 1019(vi00)
    nop                             sq.xyzw vf23, 1018(vi00)
    nop                             sq.xyzw vf24, 1023(vi00)
    nop                             sq.xyzw vf25, 1022(vi00)
    nop                             sq.xyzw vf26, 1021(vi00)
    nop                             xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             nop                               [E] ; end: the next MSCNT continues at vertices_cont
    nop                             nop

    ; the next MSCNT continues here
vertices_cont:
    nop                             b batch                              ; the next batch
    nop                             nop
.endprogram

;=======================================================================================
; Vu1Prog32: material colour, no vertex colours, gMtxUv rows
;
; gVu1ProgInfo32 (bones.c): 100 pairs (800 bytes), batches of up to 3200 bytes;
; Vu1_SelectProgram's key 0x4002, rigid models (0x21035, 0x121035).
; Setup Vu1Pkt_E: an UNPACK of 12 qwords to VU 0, then MSCALF 0:
;   0        colour: gGsColorF, RGB scaled by the model's brightness
;   1-4      gMtxSlots x gMtxView x gMtxProjClip: model to screen (XYZ after the divide by w): vf01-vf04
;   5-8      the matrix above x gViewportMtx: model to the clip test's space: vf05-vf08
;   9-11     rows 0, 1 and 3 of gMtxUv (Vu1_PutUvMatrix): vf09-vf11
; Vertices: gVu1ProgLayouts[4], 2 qwords: position, texture coordinates.
; Batches at VU 0xc and 0xc + 0x1f7 (XTOP); the output follows each.
;=======================================================================================
.program Vu1Prog32
.base 0xc
.offset 0x1f7

    ; MSCALF 0: the setup's constants into registers
init:
    nop                             loi 128.0                            ; I = 128.0: the colour clamp (0x80 is 1.0 on the GS)
    nop                             lq.xyzw vf01, 1(vi00)
    nop                             lq.xyzw vf02, 2(vi00)
    nop                             lq.xyzw vf03, 3(vi00)
    nop                             lq.xyzw vf04, 4(vi00)
    nop                             lq.xyzw vf05, 5(vi00)
    nop                             lq.xyzw vf06, 6(vi00)
    nop                             lq.xyzw vf07, 7(vi00)
    nop                             lq.xyzw vf08, 8(vi00)
    nop                             lq.xyzw vf09, 9(vi00)
    nop                             lq.xyzw vf10, 10(vi00)
    nop                             lq.xyzw vf11, 11(vi00)
    nop                             nop                               [E] ; end: constants loaded
    nop                             nop

    ; MSCNT: one batch at XTOP; qword 0's x is its type, qword 1 a GIF tag
batch:
    nop                             xtop vi02                            ; vi02: the batch (BASE, or BASE + OFFSET: double buffer)
    nop                             iaddiu vi05, vi02, 0
    nop                             iaddiu vi03, vi02, 200               ; vi03: the output, 200 qwords after the batch
    nop                             ilwr.x vi06, (vi05)                  ; the batch type (qword 0)
    nop                             iaddiu vi05, vi05, 1
    nop                             ilwr.x vi08, (vi05)                  ; the GIF tag (qword 1): NLOOP, EOP
    nop                             iaddiu vi04, vi03, 0
    nop                             iaddiu vi11, vi00, 32767             ; 0x7FFF: the NLOOP mask
    nop                             lq.xyzw vf31, 0(vi05)
    nop                             iand vi07, vi11, vi08
    nop                             iaddiu vi11, vi00, 1
    nop                             iaddiu vi05, vi05, 1
    nop                             ibeq vi11, vi06, vertices
    nop                             sqi.xyzw vf31, (vi04++)

    ; a register block: the GIF tag and its NLOOP qwords (A+D) go through to the output
copy_regs:
    nop                             lqi.xyzw vf30, (vi05++)
    nop                             iaddi vi07, vi07, -1
    nop                             iaddiu vi04, vi04, 1
    nop                             ibne vi07, vi00, copy_regs
    nop                             sq.xyzw vf30, -1(vi04)
    nop                             lq.xyzw vf29, 0(vi05)
    nop                             nop
    nop                             nop
    nop                             nop
    muli.xyz vf29, vf29, I          nop
    nop                             nop
    nop                             nop
    nop                             nop
    minii.xyz vf29, vf29, I         nop
    nop                             nop
    nop                             nop
    nop                             nop
    ftoi0.xyzw vf29, vf29           xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             nop                               [E] ; end: the next MSCNT continues at copy_regs_cont
    nop                             nop

    ; the next MSCNT continues here
copy_regs_cont:
    nop                             b batch                              ; the next batch
    nop                             nop

    ; type 1: a strip of NLOOP vertices
vertices:
    nop                             iaddiu vi08, vi08, 2                 ; NLOOP + 2: the delay line's last vertices go out first
    nop                             isw.x vi08, -1(vi04)
    nop                             lq.xyzw vf30, 0(vi05)
    nop                             lq.xyzw vf31, 1(vi05)
    ; one vertex per pass, software-pipelined through the delay line
vertices_loop:
    nop                             ilw.w vi09, 0(vi05)                  ; vi09: the position's w word, XYZF2's w (F, ADC) as the model has it
