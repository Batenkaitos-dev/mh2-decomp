    nop                             lq.xyzw vf15, 1022(vi00)
    nop                             lq.xyzw vf16, 1023(vi00)
    nop                             lq.xyzw vf17, 1018(vi00)
    nop                             lq.xyzw vf18, 1019(vi00)
    nop                             lq.xyzw vf19, 1020(vi00)
    nop                             sqi.xyzw vf14, (vi04++)
    nop                             sqi.xyzw vf15, (vi04++)
    nop                             sqi.xyzw vf16, (vi04++)
    nop                             sqi.xyzw vf17, (vi04++)
    nop                             sqi.xyzw vf18, (vi04++)
    nop                             sqi.xyzw vf19, (vi04++)
