    nop                             nop
    ftoi0.xyzw vf29, vf29           xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             nop                               [E] ; end: the next MSCNT continues at copy_regs_cont
    nop                             nop

    ; the next MSCNT continues here
copy_regs_cont:
    nop                             b batch                              ; the next batch
    nop                             nop

    ; type 1: a strip of NLOOP vertices
vertices:
    nop                             iaddiu vi08, vi08, 2                 ; NLOOP + 2: the delay line's last vertices go out first
    nop                             isw.x vi08, -1(vi04)
    nop                             loi 255.0                            ; I = 255.0
    nop                             lq.xyzw vf30, 0(vi05)
    nop                             ilw.w vi09, 0(vi05)                  ; vi09: the position's w word, XYZF2's w (F, ADC) as the model has it
    nop                             lq.xyzw vf31, 1(vi05)
    nop                             iaddiu vi05, vi05, 2
    mulax.xyzw ACC, vf01, vf30x     lq.xyzw vf10, 1021(vi00)
    madday.xyzw ACC, vf02, vf30y    lq.xyzw vf11, 1022(vi00)
    maddaz.xyzw ACC, vf03, vf30z    lq.xyzw vf12, 1023(vi00)
    maddw.xyzw vf28, vf04, vf00w    iaddiu vi14, vi09, 0
    mulax.xyzw ACC, vf05, vf30x     sqi.xyzw vf10, (vi04++)
    madday.xyzw ACC, vf06, vf30y    sqi.xyzw vf11, (vi04++)
    maddaz.xyzw ACC, vf07, vf30z    sqi.xyzw vf12, (vi04++)
    subw.x vf25, vf09, vf28w        div Q, vf00w, vf28w                  ; Q = 1 / vf28.w
    ; one vertex per pass, software-pipelined through the delay line
vertices_loop:
    maddw.xyzw vf27, vf08, vf00w    lq.xyzw vf30, 0(vi05)
    nop                             ilw.w vi09, 0(vi05)
    nop                             lq.xyzw vf13, 1018(vi00)
    muly.x vf25, vf25, vf09y        lq.xyzw vf14, 1019(vi00)
    clipw.xyz vf27, vf27w           lq.xyzw vf15, 1020(vi00)             ; clip flags: vf27.xyz against +-vf27.w
    mulax.xyzw ACC, vf01, vf30x     sq.xyzw vf29, 1019(vi00)
    mulq.xyz vf28, vf28, Q          sq.xyzw vf13, 1021(vi00)
    muli.x vf25, vf25, I            sq.xyzw vf14, 1022(vi00)
    mulq.xyz vf26, vf31, Q          fcand vi01, 0x03ffff                 ; vi01 = 1: one of the last three vertices is outside the clip volume
    madday.xyzw ACC, vf02, vf30y    ibeq vi01, vi00, vertices_in_view
    ftoi4.xyz vf24, vf28            lq.xyzw vf31, 1(vi05)
    nop                             iaddiu vi14, vi00, 32767             ; ADC: 0x7FFF + 1 = 0x8000, so the GS draws no triangle ending here
    nop                             iaddiu vi14, vi14, 1
    ; the last three vertices are all inside the clip volume
vertices_in_view:
    minii.x vf23, vf25, I           iaddiu vi05, vi05, 2
    maddaz.xyzw ACC, vf03, vf30z    sq.xyzw vf26, 1018(vi00)
    maddw.xyzw vf28, vf04, vf00w    sq.xyzw vf15, 1023(vi00)
    mulax.xyzw ACC, vf05, vf30x     sq.xyz vf24, 1020(vi00)
    maxx.x vf23, vf23, vf00x        lq.xyzw vf10, 1021(vi00)
    madday.xyzw ACC, vf06, vf30y    lq.xyzw vf11, 1022(vi00)
    maddaz.xyzw ACC, vf07, vf30z    lq.xyzw vf12, 1023(vi00)
    subw.x vf25, vf09, vf28w        iaddi vi07, vi07, -1
    ftoi4.x vf23, vf23              sqi.xyzw vf10, (vi04++)
    nop                             sqi.xyzw vf11, (vi04++)
    nop                             sqi.xyzw vf12, (vi04++)
    nop                             div Q, vf00w, vf28w
    nop                             mtir vi13, vf23x
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             iadd vi13, vi14, vi13
    nop                             iaddiu vi14, vi09, 0
    nop                             ibne vi07, vi00, vertices_loop
    nop                             isw.w vi13, 1020(vi00)
    ; the epilogue: the vertices left in the delay line
    nop                             nop
    nop                             lq.xyzw vf13, 1018(vi00)
    nop                             lq.xyzw vf14, 1019(vi00)
    nop                             lq.xyzw vf15, 1020(vi00)
    nop                             nop
    nop                             sqi.xyzw vf13, (vi04++)
    nop                             sqi.xyzw vf14, (vi04++)
    nop                             sqi.xyzw vf15, (vi04++)
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             xgkick vi03                       [E] ; end: the next MSCNT continues at vertices_cont
    nop                             nop

    ; the next MSCNT continues here
vertices_cont:
    nop                             b batch                              ; the next batch
    nop                             nop
.endprogram

;=======================================================================================
; Vu1Prog24: three lights, fog, second colour
;
; gVu1ProgInfo24 (bones.c): 130 pairs (1040 bytes), batches of up to 4080 bytes;
; Vu1_SelectProgram's key 0x28200, rigid models (0x21035, 0x121035).
; Setup Vu1Pkt_LDV: an UNPACK of 18 qwords to VU 0, then MSCALF 0:
;   0        colour: gGsColorF, RGB scaled by the model's brightness: vf18
;   1        second colour: gGsColor2F: vf17
;   2-5      gMtxSlots x gMtxView x gMtxProjClip: model to screen (XYZ after the divide by w): vf01-vf04
;   6-9      the matrix above x gViewportMtx: model to the clip test's space: vf05-vf08
;   10-12    light directions (model space, negated): vf09-vf11
;   13-16    light colours (three lights and the ambient): vf12-vf15
;   17       fog range: gGsFogFar and the word after it: vf16
; Vertices: gVu1ProgLayouts[1], 4 qwords: position, normal, colour, texture coordinates.
; Batches at VU 0x12 and 0x12 + 0x1f4 (XTOP); the output follows each.
;=======================================================================================
.program Vu1Prog24
.base 0x12
.offset 0x1f4

    ; MSCALF 0: the setup's constants into registers
init:
    nop                             lq.xyzw vf10, 11(vi00)
    nop                             lq.xyzw vf11, 12(vi00)
    nop                             lq.xyzw vf12, 13(vi00)
    nop                             lq.xyzw vf13, 14(vi00)
    nop                             lq.xyzw vf14, 15(vi00)
    nop                             lq.xyzw vf15, 16(vi00)
    nop                             lq.xyzw vf16, 17(vi00)
    nop                             lq.xyzw vf17, 1(vi00)
    nop                             lq.xyzw vf18, 0(vi00)
    nop                             lq.xyzw vf01, 2(vi00)
    nop                             lq.xyzw vf02, 3(vi00)
    nop                             loi 128.0                            ; I = 128.0: the colour clamp (0x80 is 1.0 on the GS)
    muli.xyzw vf12, vf12, I         lq.xyzw vf03, 4(vi00)
    muli.xyzw vf13, vf13, I         lq.xyzw vf04, 5(vi00)
    muli.xyzw vf14, vf14, I         lq.xyzw vf05, 6(vi00)
    nop                             lq.xyzw vf06, 7(vi00)
    minii.xyzw vf12, vf12, I        lq.xyzw vf07, 8(vi00)
    minii.xyzw vf13, vf13, I        lq.xyzw vf08, 9(vi00)
    minii.xyzw vf14, vf14, I        lq.xyzw vf09, 10(vi00)
    nop                             nop                               [E] ; end: constants loaded
    nop                             nop

    ; MSCNT: one batch at XTOP; qword 0's x is its type, qword 1 a GIF tag
batch:
    nop                             xtop vi02                            ; vi02: the batch (BASE, or BASE + OFFSET: double buffer)
    nop                             iaddiu vi05, vi02, 0
    nop                             iaddiu vi03, vi02, 255               ; vi03: the output, 255 qwords after the batch
    nop                             iaddiu vi04, vi03, 0
    nop                             ilwr.x vi06, (vi05)                  ; the batch type (qword 0)
    nop                             iaddiu vi05, vi05, 1
    nop                             iaddiu vi11, vi00, 32767             ; 0x7FFF: the NLOOP mask
    nop                             lq.xyzw vf31, 0(vi05)
    nop                             ilwr.x vi08, (vi05)                  ; the GIF tag (qword 1): NLOOP, EOP
    nop                             iand vi07, vi11, vi08
    nop                             iaddiu vi11, vi00, 1
    nop                             iaddiu vi05, vi05, 1
    nop                             ibeq vi11, vi06, vertices
    nop                             sqi.xyzw vf31, (vi04++)

    ; a register block: the GIF tag and its NLOOP qwords (A+D) go through to the output
copy_regs:
    nop                             lq.xyzw vf31, 0(vi05)
    nop                             iaddi vi07, vi07, -1
    nop                             iaddiu vi05, vi05, 1
    nop                             iaddiu vi04, vi04, 1
    nop                             ibne vi07, vi00, copy_regs
    nop                             sq.xyzw vf31, -1(vi04)
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             nop                               [E] ; end: the next MSCNT continues at copy_regs_cont
    nop                             nop

    ; the next MSCNT continues here
copy_regs_cont:
    nop                             b batch                              ; the next batch
    nop                             nop

    ; type 1: a strip of NLOOP vertices
vertices:
    nop                             lq.xyzw vf28, 0(vi05)
    nop                             nop
    nop                             nop
    nop                             nop
    mulax.xyzw ACC, vf01, vf28x     lq.xyzw vf29, 1(vi05)
    madday.xyzw ACC, vf02, vf28y    iaddiu vi08, vi08, 2                 ; NLOOP + 2: the delay line's last vertices go out first
    maddaz.xyzw ACC, vf03, vf28z    isw.x vi08, -1(vi04)
    maddw.xyzw vf27, vf04, vf00w    lq.xyzw vf19, 1021(vi00)
    mulax.xyzw ACC, vf09, vf29x     lq.xyzw vf20, 1022(vi00)
    madday.xyzw ACC, vf10, vf29y    lq.xyzw vf21, 1023(vi00)
    maddz.xyzw vf25, vf11, vf29z    lq.xyzw vf22, 1018(vi00)
    mulax.xyzw ACC, vf05, vf28x     div Q, vf00w, vf27w                  ; Q = 1 / vf27.w
    madday.xyzw ACC, vf06, vf28y    lq.xyzw vf23, 1019(vi00)
    maddaz.xyzw ACC, vf07, vf28z    lq.xyzw vf24, 1020(vi00)
    maxx.xyzw vf25, vf25, vf00x     sqi.xyzw vf19, (vi04++)
    maddw.xyzw vf26, vf08, vf00w    sqi.xyzw vf20, (vi04++)
    nop                             sqi.xyzw vf21, (vi04++)
    nop                             lq.xyzw vf30, 2(vi05)
    mulax.xyz ACC, vf12, vf25x      sqi.xyzw vf22, (vi04++)
    madday.xyz ACC, vf13, vf25y     ilw.w vi09, 0(vi05)                  ; vi09: the position's w word, XYZF2's w (F, ADC) as the model has it
    maddaz.xyz ACC, vf14, vf25z     lq.xyzw vf31, 3(vi05)
    madda.xyz ACC, vf15, vf30       sqi.xyzw vf23, (vi04++)
    madd.xyz vf30, vf18, vf30       iaddiu vi05, vi05, 4
    mulq.xyz vf27, vf27, Q          sqi.xyzw vf24, (vi04++)
    ; one vertex per pass, software-pipelined through the delay line
vertices_loop:
    mulq.xyz vf24, vf31, Q          lq.xyzw vf28, 0(vi05)
    clipw.xyz vf26, vf26w           loi 128.0                            ; I = 128.0: the colour clamp (0x80 is 1.0 on the GS)
    minii.xyzw vf25, vf30, I        nop
    ftoi4.xyz vf27, vf27            nop
    mulax.xyzw ACC, vf01, vf28x     nop
    madday.xyzw ACC, vf02, vf28y    sq.xyzw vf24, 0(vi04)
    mul.xyzw vf24, vf25, vf17       nop
    subw.x vf26, vf16, vf27w        sq.xyz vf27, 2(vi04)
    maddaz.xyzw ACC, vf03, vf28z    lq.xyzw vf29, 1(vi05)
    maddw.xyzw vf27, vf04, vf00w    nop
    ftoi0.xyzw vf24, vf24           nop
    muly.x vf26, vf26, vf16y        nop
    mulax.xyzw ACC, vf09, vf29x     loi 255.0                            ; I = 255.0
    madday.xyzw ACC, vf10, vf29y    div Q, vf00w, vf27w
    maddz.xyzw vf25, vf11, vf29z    sq.xyzw vf24, 1(vi04)
    muli.x vf26, vf26, I            nop
    mulax.xyzw ACC, vf05, vf28x     nop
    madday.xyzw ACC, vf06, vf28y    lq.xyzw vf31, 3(vi05)
    maddaz.xyzw ACC, vf07, vf28z    nop
    minii.x vf23, vf26, I           nop
    maxx.xyzw vf25, vf25, vf00x     nop
    maddw.xyzw vf26, vf08, vf00w    iaddiu vi14, vi09, 0
    mulq.xyz vf27, vf27, Q          ilw.w vi09, 0(vi05)
    maxx.x vf23, vf23, vf00x        nop
    mulax.xyz ACC, vf12, vf25x      lq.xyzw vf30, 2(vi05)
    madday.xyz ACC, vf13, vf25y     nop
    maddaz.xyz ACC, vf14, vf25z     nop
    ftoi4.x vf23, vf23              nop
    madda.xyz ACC, vf15, vf30       nop
    madd.xyz vf30, vf18, vf30       fcand vi01, 0x03ffff                 ; vi01 = 1: one of the last three vertices is outside the clip volume
    nop                             ibeq vi01, vi00, vertices_in_view
    nop                             mtir vi13, vf23x
    nop                             iaddiu vi14, vi00, 32767             ; ADC: 0x7FFF + 1 = 0x8000, so the GS draws no triangle ending here
    nop                             iaddiu vi14, vi14, 1
    ; the last three vertices are all inside the clip volume
vertices_in_view:
    nop                             iaddiu vi05, vi05, 4
    nop                             iaddiu vi04, vi04, 3
    nop                             iaddi vi07, vi07, -1
    nop                             iadd vi14, vi14, vi13
    nop                             ibne vi07, vi00, vertices_loop
    nop                             isw.w vi14, -1(vi04)
    ; the epilogue: the vertices left in the delay line
    nop                             lqd.xyzw vf19, (--vi04)
    nop                             lqd.xyzw vf20, (--vi04)
    nop                             lqd.xyzw vf21, (--vi04)
    nop                             lqd.xyzw vf22, (--vi04)
    nop                             lqd.xyzw vf23, (--vi04)
    nop                             lqd.xyzw vf24, (--vi04)
    nop                             sq.xyzw vf19, 1020(vi00)
    nop                             sq.xyzw vf20, 1019(vi00)
    nop                             sq.xyzw vf21, 1018(vi00)
    nop                             sq.xyzw vf22, 1023(vi00)
    nop                             sq.xyzw vf23, 1022(vi00)
    nop                             sq.xyzw vf24, 1021(vi00)
    nop                             xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             nop                               [E] ; end: the next MSCNT continues at vertices_cont
    nop                             nop

    ; the next MSCNT continues here
vertices_cont:
    nop                             b batch                              ; the next batch
    nop                             nop
