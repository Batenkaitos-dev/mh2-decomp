;=======================================================================================
; Vu1Prog50: skinned, three lights, normals (key bit 0x20), material colour, no vertex colours, gMtxUv rows
;
; gVu1ProgInfo50 (bones.c): 346 pairs (2768 bytes), batches of up to 3200 bytes;
; Vu1_SelectProgram's key 0x4222, skinned models (0x321135, 0x221135).
; Setup Vu1Pkt_SLE: an UNPACK of 243 qwords to VU 0, then MSCALF 0:
;   0        colour: gGsColorF, RGB scaled by the model's brightness: vf28
;   1-4      gMtxView x gMtxProjClip: world to screen (XYZ after the divide by w): vf01-vf04
;   5-8      gMtxView x gViewportMtx: world to the clip test's space: vf05-vf08
;   9-11     light directions (world space, negated): vf01, vf02, vf03, vf20, vf21, vf22
;   12-15    light colours (three lights and the ambient): vf24-vf27
;   16-18    rows 0, 1 and 3 of gMtxUv (Vu1_PutUvMatrix): vf16, vf17, vf18, vf20, vf21, vf22
;   19-146   bone matrices: the 32 gMtxSlots the model's mask (e+0x54) selects
; Vertices: gVu1ProgLayouts[8], 5 qwords: position, normal, texture coordinates, bone indices, bone weights.
; Batches at VU 0xf3 and 0xf3 + 0x183 (XTOP); the output follows each.
;=======================================================================================
.program Vu1Prog50
.base 0xf3
.offset 0x183

    ; MSCALF 0: the setup's constants into registers
init:
    nop                             iaddiu vi10, vi00, 19
    nop                             lq.xyzw vf07, 0(vi10)
    nop                             lq.xyzw vf08, 1(vi10)
    nop                             iaddiu vi07, vi00, 32
    nop                             iaddiu vi11, vi00, 147
    addx.x vf04, vf00, vf07x        nop
    addy.x vf05, vf00, vf07y        nop
    addz.x vf06, vf00, vf07z        lq.xyzw vf09, 2(vi10)
    addx.y vf04, vf00, vf08x        nop
    addy.y vf05, vf00, vf08y        nop
    addz.y vf06, vf00, vf08z        nop
    addx.z vf04, vf00, vf09x        lq.xyzw vf01, 9(vi00)
    addy.z vf05, vf00, vf09y        lq.xyzw vf02, 10(vi00)
    addz.z vf06, vf00, vf09z        lq.xyzw vf03, 11(vi00)
