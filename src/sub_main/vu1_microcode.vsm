    nop                             iaddiu vi14, vi14, 1
    ; the last three vertices are all inside the clip volume
vertices_in_view:
    maxx.x vf24, vf24, vf00x        sq.xyz vf28, 1020(vi00)
    maddaz.xyzw ACC, vf03, vf29z    sq.xyzw vf25, 1019(vi00)
