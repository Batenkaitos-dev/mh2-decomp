    nop                             lqd.xyzw vf22, (--vi04)
    nop                             lqd.xyzw vf23, (--vi04)
    nop                             lqd.xyzw vf24, (--vi04)
    nop                             lqd.xyzw vf25, (--vi04)
    nop                             lqd.xyzw vf26, (--vi04)
    nop                             lqd.xyzw vf27, (--vi04)
    nop                             sq.xyzw vf22, 1020(vi00)
    nop                             sq.xyzw vf23, 1019(vi00)
    nop                             sq.xyzw vf24, 1018(vi00)
    nop                             sq.xyzw vf25, 1023(vi00)
    nop                             sq.xyzw vf26, 1022(vi00)
    nop                             sq.xyzw vf27, 1021(vi00)
    nop                             xgkick vi03                          ; send the output to the GS (PATH1)
