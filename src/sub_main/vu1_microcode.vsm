;=======================================================================================
; Vu1Prog26: material colour, no vertex colours, fog, second colour
;
; gVu1ProgInfo26 (bones.c): 114 pairs (912 bytes), batches of up to 3200 bytes;
; Vu1_SelectProgram's key 0x28002, rigid models (0x21035, 0x121035).
; Setup Vu1Pkt_DV: an UNPACK of 11 qwords to VU 0, then MSCALF 0:
;   0        colour: gGsColorF, RGB scaled by the model's brightness
;   1        second colour: gGsColor2F: vf10
;   2-5      gMtxSlots x gMtxView x gMtxProjClip: model to screen (XYZ after the divide by w): vf01-vf04
;   6-9      the matrix above x gViewportMtx: model to the clip test's space: vf05-vf08
;   10       fog range: gGsFogFar and the word after it: vf09
; Vertices: gVu1ProgLayouts[4], 2 qwords: position, texture coordinates.
; Batches at VU 0xb and 0xb + 0x1fa (XTOP); the output follows each.
;=======================================================================================
.program Vu1Prog26
.base 0xb
.offset 0x1fa

    ; MSCALF 0: the setup's constants into registers
init:
    nop                             lq.xyzw vf01, 2(vi00)
    nop                             lq.xyzw vf02, 3(vi00)
    nop                             lq.xyzw vf03, 4(vi00)
    nop                             lq.xyzw vf04, 5(vi00)
    nop                             lq.xyzw vf05, 6(vi00)
    nop                             lq.xyzw vf06, 7(vi00)
    nop                             lq.xyzw vf07, 8(vi00)
    nop                             lq.xyzw vf08, 9(vi00)
    nop                             lq.xyzw vf09, 10(vi00)
    nop                             lq.xyzw vf10, 1(vi00)
    nop                             nop                               [E] ; end: constants loaded
    nop                             nop

    ; MSCNT: one batch at XTOP; qword 0's x is its type, qword 1 a GIF tag
batch:
    nop                             xtop vi02                            ; vi02: the batch (BASE, or BASE + OFFSET: double buffer)
    nop                             iaddiu vi05, vi02, 0
    nop                             iaddiu vi03, vi02, 200               ; vi03: the output, 200 qwords after the batch
    nop                             iaddiu vi04, vi03, 0
    nop                             ilwr.x vi06, (vi05)                  ; the batch type (qword 0)
    nop                             iaddiu vi05, vi05, 1
    nop                             iaddiu vi11, vi00, 32767             ; 0x7FFF: the NLOOP mask
    nop                             ilwr.x vi08, (vi05)                  ; the GIF tag (qword 1): NLOOP, EOP
    nop                             lq.xyzw vf31, 0(vi05)
    nop                             iaddiu vi05, vi05, 1
    nop                             iaddiu vi01, vi00, 1
    nop                             iand vi07, vi11, vi08
    nop                             ibeq vi01, vi06, vertices
    nop                             sqi.xyzw vf31, (vi04++)

    ; a register block: the GIF tag and its NLOOP qwords (A+D) go through to the output
copy_regs:
    nop                             lq.xyzw vf31, 0(vi05)
    nop                             iaddi vi07, vi07, -1
    nop                             iaddiu vi05, vi05, 1
    nop                             iaddiu vi04, vi04, 1
    nop                             ibne vi07, vi00, copy_regs
    nop                             sq.xyzw vf31, -1(vi04)
    nop                             lq.xyzw vf29, 0(vi05)
    nop                             nop
    nop                             nop
    nop                             loi 128.0                            ; I = 128.0: the colour clamp (0x80 is 1.0 on the GS)
    muli.xyz vf29, vf29, I          nop
    nop                             nop
    nop                             nop
    nop                             nop
    minii.xyz vf29, vf29, I         nop
    nop                             nop
    nop                             nop
    nop                             nop
    mul.xyzw vf29, vf29, vf10       nop
    nop                             nop
    nop                             nop
    nop                             nop
    ftoi0.xyzw vf29, vf29           xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             nop                               [E] ; end: the next MSCNT continues at copy_regs_cont
    nop                             nop

    ; the next MSCNT continues here
copy_regs_cont:
    nop                             b batch                              ; the next batch
    nop                             nop

    ; type 1: a strip of NLOOP vertices
vertices:
    nop                             lq.xyzw vf30, 0(vi05)
    nop                             ilw.w vi09, 0(vi05)                  ; vi09: the position's w word, XYZF2's w (F, ADC) as the model has it
    nop                             lq.xyzw vf31, 1(vi05)
    nop                             iaddiu vi05, vi05, 2
    mulax.xyzw ACC, vf01, vf30x     nop
    madday.xyzw ACC, vf02, vf30y    iaddiu vi08, vi08, 2                 ; NLOOP + 2: the delay line's last vertices go out first
    maddaz.xyzw ACC, vf03, vf30z    isw.x vi08, -1(vi04)
    maddw.xyzw vf28, vf04, vf00w    loi 255.0                            ; I = 255.0
    mulax.xyzw ACC, vf05, vf30x     lq.xyzw vf11, 1021(vi00)
    madday.xyzw ACC, vf06, vf30y    lq.xyzw vf12, 1022(vi00)
    maddaz.xyzw ACC, vf07, vf30z    lq.xyzw vf13, 1023(vi00)
    subw.x vf25, vf09, vf28w        div Q, vf00w, vf28w                  ; Q = 1 / vf28.w
    maddw.xyzw vf27, vf08, vf00w    lq.xyzw vf14, 1018(vi00)
    nop                             lq.xyzw vf15, 1019(vi00)
    nop                             lq.xyzw vf16, 1020(vi00)
    muly.x vf23, vf25, vf09y        sqi.xyzw vf11, (vi04++)
    nop                             sqi.xyzw vf12, (vi04++)
    nop                             sqi.xyzw vf13, (vi04++)
    nop                             sqi.xyzw vf14, (vi04++)
    muli.x vf23, vf23, I            sqi.xyzw vf15, (vi04++)
    mulq.xyz vf24, vf28, Q          sqi.xyzw vf16, (vi04++)
    ; one vertex per pass, software-pipelined through the delay line
vertices_loop:
    mulq.xyz vf26, vf31, Q          lq.xyzw vf30, 0(vi05)
    clipw.xyz vf27, vf27w           iaddiu vi14, vi09, 0                 ; clip flags: vf27.xyz against +-vf27.w
    minii.x vf23, vf23, I           lq.xyzw vf31, 1(vi05)
    ftoi4.xyz vf24, vf24            ilw.w vi09, 0(vi05)
    mulax.xyzw ACC, vf01, vf30x     sq.xyzw vf26, 0(vi04)
    madday.xyzw ACC, vf02, vf30y    sq.xyzw vf29, 1(vi04)
    maxx.x vf23, vf23, vf00x        iaddiu vi05, vi05, 2
    maddaz.xyzw ACC, vf03, vf30z    sq.xyz vf24, 2(vi04)
    maddw.xyzw vf28, vf04, vf00w    nop
    mulax.xyzw ACC, vf05, vf30x     nop
    ftoi4.x vf23, vf23              nop
    madday.xyzw ACC, vf06, vf30y    div Q, vf00w, vf28w
    subw.x vf25, vf09, vf28w        nop
    maddaz.xyzw ACC, vf07, vf30z    iaddiu vi04, vi04, 3
    maddw.xyzw vf27, vf08, vf00w    mtir vi13, vf23x
    nop                             fcand vi01, 0x03ffff                 ; vi01 = 1: one of the last three vertices is outside the clip volume
    muly.x vf23, vf25, vf09y        ibeq vi01, vi00, vertices_in_view
    nop                             iaddi vi07, vi07, -1
    nop                             iaddiu vi14, vi00, 32767             ; ADC: 0x7FFF + 1 = 0x8000, so the GS draws no triangle ending here
    nop                             iaddiu vi14, vi14, 1
    ; the last three vertices are all inside the clip volume
vertices_in_view:
    nop                             iadd vi14, vi14, vi13
    mulq.xyz vf24, vf28, Q          ibne vi07, vi00, vertices_loop
    muli.x vf23, vf23, I            isw.w vi14, -1(vi04)
    ; the epilogue: the vertices left in the delay line
    nop                             lq.xyzw vf16, -6(vi04)
    nop                             lq.xyzw vf15, -5(vi04)
    nop                             lq.xyzw vf14, -4(vi04)
    nop                             xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             lq.xyzw vf13, -3(vi04)
    nop                             lq.xyzw vf12, -2(vi04)
    nop                             lq.xyzw vf11, -1(vi04)
    nop                             sq.xyzw vf16, 1021(vi00)
    nop                             sq.xyzw vf15, 1022(vi00)
    nop                             sq.xyzw vf14, 1023(vi00)
    nop                             sq.xyzw vf13, 1018(vi00)
    nop                             sq.xyzw vf12, 1019(vi00)
    nop                             sq.xyzw vf11, 1020(vi00)
    nop                             nop                               [E] ; end: the next MSCNT continues at vertices_cont
    nop                             nop

    ; the next MSCNT continues here
vertices_cont:
    nop                             b batch                              ; the next batch
    nop                             nop
.endprogram

;=======================================================================================
; Vu1Prog27: skinned, material colour, no vertex colours, fog, second colour
;
; gVu1ProgInfo27 (bones.c): 242 pairs (1936 bytes), batches of up to 3200 bytes;
; Vu1_SelectProgram's key 0x28002, skinned models (0x321135, 0x221135).
; Setup Vu1Pkt_SDV: an UNPACK of 139 qwords to VU 0, then MSCALF 0:
;   0        colour: gGsColorF, RGB scaled by the model's brightness
;   1        second colour: gGsColor2F: vf09
;   2        fog range: gGsFogFar and the word after it: vf10
;   3-6      gMtxView x gMtxProjClip: world to screen (XYZ after the divide by w): vf01-vf04
;   7-10     gMtxView x gViewportMtx: world to the clip test's space: vf05-vf08
;   11-138   bone matrices: the 32 gMtxSlots the model's mask (e+0x54) selects
; Vertices: gVu1ProgLayouts[10], 4 qwords: position, texture coordinates, bone indices, bone weights.
; Batches at VU 0x8b and 0x8b + 0x1b7 (XTOP); the output follows each.
;=======================================================================================
.program Vu1Prog27
.base 0x8b
.offset 0x1b7

    ; MSCALF 0: the setup's constants into registers
init:
    nop                             lq.xyzw vf01, 3(vi00)
    nop                             lq.xyzw vf02, 4(vi00)
    nop                             lq.xyzw vf03, 5(vi00)
    nop                             lq.xyzw vf04, 6(vi00)
    nop                             lq.xyzw vf05, 7(vi00)
    nop                             lq.xyzw vf06, 8(vi00)
    nop                             lq.xyzw vf07, 9(vi00)
    nop                             lq.xyzw vf08, 10(vi00)
    nop                             lq.xyzw vf09, 1(vi00)
    nop                             lq.xyzw vf10, 2(vi00)
    nop                             nop                               [E] ; end: constants loaded
    nop                             nop

    ; MSCNT: one batch at XTOP; qword 0's x is its type, qword 1 a GIF tag
batch:
    nop                             xtop vi02                            ; vi02: the batch (BASE, or BASE + OFFSET: double buffer)
    nop                             iaddiu vi05, vi02, 0
    nop                             iaddiu vi03, vi02, 200               ; vi03: the output, 200 qwords after the batch
    nop                             iaddiu vi04, vi03, 0
    nop                             ilwr.x vi06, (vi05)                  ; the batch type (qword 0)
    nop                             iaddiu vi05, vi05, 1
    nop                             iaddiu vi11, vi00, 32767             ; 0x7FFF: the NLOOP mask
    nop                             lq.xyzw vf31, 0(vi05)
    nop                             ilwr.x vi08, (vi05)                  ; the GIF tag (qword 1): NLOOP, EOP
    nop                             iand vi07, vi11, vi08
    nop                             iaddiu vi11, vi00, 1
    nop                             iaddiu vi05, vi05, 1
    nop                             ibeq vi11, vi06, rigid
    nop                             sqi.xyzw vf31, (vi04++)
    nop                             iaddiu vi11, vi00, 2
