    maddw.xyzw vf28, vf04, vf00w    iaddiu vi05, vi05, 3
    mulax.xy ACC, vf09, vf31x       nop
    madday.xy ACC, vf10, vf31y      nop
    maddw.xy vf31, vf11, vf00w      nop
    subw.x vf24, vf12, vf28w        div Q, vf00w, vf28w                  ; Q = 1 / vf28.w
    mulax.xyzw ACC, vf05, vf29x     nop
    ; one vertex per pass, software-pipelined through the delay line
vertices_loop:
    madday.xyzw ACC, vf06, vf29y    iaddiu vi14, vi09, 0
    maddaz.xyzw ACC, vf07, vf29z    iaddi vi07, vi07, -1
    muly.x vf24, vf24, vf12y        lq.xyzw vf13, 1021(vi00)
    maddw.xyzw vf27, vf08, vf00w    lq.xyzw vf14, 1022(vi00)
    ftoi0.xyzw vf25, vf30           lq.xyzw vf15, 1023(vi00)
    mulq.xyz vf28, vf28, Q          lq.xyzw vf16, 1018(vi00)
    muli.x vf24, vf24, I            lq.xyzw vf17, 1019(vi00)
    clipw.xyz vf27, vf27w           lq.xyzw vf18, 1020(vi00)             ; clip flags: vf27.xyz against +-vf27.w
    mulq.xyz vf26, vf31, Q          lq.xyzw vf29, 0(vi05)
    ftoi4.xyz vf28, vf28            lq.xyzw vf31, 2(vi05)
    minii.x vf24, vf24, I           ilw.w vi09, 0(vi05)
    nop                             fcand vi01, 0x03ffff                 ; vi01 = 1: one of the last three vertices is outside the clip volume
    nop                             ibeq vi01, vi00, vertices_in_view
    nop                             sq.xyzw vf26, 1018(vi00)
    nop                             iaddiu vi14, vi00, 32767             ; ADC: 0x7FFF + 1 = 0x8000, so the GS draws no triangle ending here
    nop                             iaddiu vi14, vi14, 1
    ; the last three vertices are all inside the clip volume
vertices_in_view:
    maxx.x vf24, vf24, vf00x        sq.xyz vf28, 1020(vi00)
    mulax.xyzw ACC, vf01, vf29x     sq.xyzw vf25, 1019(vi00)
    madday.xyzw ACC, vf02, vf29y    lq.xyzw vf30, 1(vi05)
    maddaz.xyzw ACC, vf03, vf29z    iaddiu vi05, vi05, 3
