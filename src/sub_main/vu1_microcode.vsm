    mulax.xyzw ACC, vf15, vf28x     sqi.xyzw vf20, (vi04++)
    madday.xyzw ACC, vf16, vf28y    sqi.xyzw vf21, (vi04++)
    maddaz.xyzw ACC, vf17, vf28z    sqi.xyzw vf22, (vi04++)
    maddw.xyzw vf28, vf18, vf00w    sqi.xyzw vf23, (vi04++)
    nop                             sqi.xyzw vf24, (vi04++)
