    madday.xyzw ACC, vf12, vf31y    lq.xyzw vf12, 1(vi11)
    maddaz.xyzw ACC, vf13, vf31z    lq.xyzw vf13, 1(vi12)
    maddw.xyzw vf15, vf14, vf31w    lq.xyzw vf14, 1(vi13)
    mulax.xyzw ACC, vf11, vf31x     lq.xyzw vf11, 2(vi10)
    madday.xyzw ACC, vf12, vf31y    lq.xyzw vf12, 2(vi11)
    maddaz.xyzw ACC, vf13, vf31z    lq.xyzw vf13, 2(vi12)
    maddw.xyzw vf16, vf14, vf31w    lq.xyzw vf14, 2(vi13)
    mulax.xyzw ACC, vf11, vf31x     lq.xyzw vf11, 3(vi10)
    madday.xyzw ACC, vf12, vf31y    lq.xyzw vf12, 3(vi11)
    maddaz.xyzw ACC, vf13, vf31z    lq.xyzw vf13, 3(vi12)
    maddw.xyzw vf17, vf14, vf31w    lq.xyzw vf14, 3(vi13)
    mulax.xyzw ACC, vf11, vf31x     lq.xyzw vf28, 0(vi05)
    madday.xyzw ACC, vf12, vf31y    lq.xyzw vf23, 1019(vi00)
    maddaz.xyzw ACC, vf13, vf31z    lq.xyzw vf24, 1020(vi00)
