    nop                             isw.x vi08, -1(vi04)
    mulax.xyzw ACC, vf01, vf29x     lq.xyzw vf31, 2(vi05)
    madday.xyzw ACC, vf02, vf29y    ilw.w vi09, 0(vi05)                  ; vi09: the position's w word, XYZF2's w (F, ADC) as the model has it
