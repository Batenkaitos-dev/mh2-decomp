;=======================================================================================
; Vu1Prog21: three lights, fog
;
; gVu1ProgInfo21 (bones.c): 132 pairs (1056 bytes), batches of up to 4080 bytes;
; Vu1_SelectProgram's key 0x8200, rigid models (0x21035, 0x121035).
; Setup Vu1Pkt_LD: an UNPACK of 17 qwords to VU 0, then MSCALF 0:
;   0        colour: gGsColorF, RGB scaled by the model's brightness: vf17
;   1-4      gMtxSlots x gMtxView x gMtxProjClip: model to screen (XYZ after the divide by w): vf01-vf04
;   5-8      the matrix above x gViewportMtx: model to the clip test's space: vf05-vf08
;   9-11     light directions (model space, negated): vf09-vf11
;   12-15    light colours (three lights and the ambient): vf12-vf15
;   16       fog range: gGsFogFar and the word after it: vf16
; Vertices: gVu1ProgLayouts[1], 4 qwords: position, normal, colour, texture coordinates.
; Batches at VU 0x11 and 0x11 + 0x1f7 (XTOP); the output follows each.
;=======================================================================================
.program Vu1Prog21
.base 0x11
.offset 0x1f7

    ; MSCALF 0: the setup's constants into registers
init:
    nop                             lq.xyzw vf08, 8(vi00)
    nop                             lq.xyzw vf09, 9(vi00)
    nop                             lq.xyzw vf10, 10(vi00)
    nop                             lq.xyzw vf11, 11(vi00)
    nop                             lq.xyzw vf12, 12(vi00)
    nop                             lq.xyzw vf13, 13(vi00)
    nop                             lq.xyzw vf14, 14(vi00)
    nop                             lq.xyzw vf15, 15(vi00)
    nop                             lq.xyzw vf16, 16(vi00)
    nop                             lq.xyzw vf17, 0(vi00)
    nop                             loi 128.0                            ; I = 128.0: the colour clamp (0x80 is 1.0 on the GS)
    muli.xyzw vf12, vf12, I         lq.xyzw vf01, 1(vi00)
    muli.xyzw vf13, vf13, I         lq.xyzw vf02, 2(vi00)
    muli.xyzw vf14, vf14, I         lq.xyzw vf03, 3(vi00)
    nop                             lq.xyzw vf04, 4(vi00)
    minii.xyzw vf12, vf12, I        lq.xyzw vf05, 5(vi00)
    minii.xyzw vf13, vf13, I        lq.xyzw vf06, 6(vi00)
    minii.xyzw vf14, vf14, I        lq.xyzw vf07, 7(vi00)
    nop                             nop                               [E] ; end: constants loaded
    nop                             nop

    ; MSCNT: one batch at XTOP; qword 0's x is its type, qword 1 a GIF tag
batch:
    nop                             xtop vi02                            ; vi02: the batch (BASE, or BASE + OFFSET: double buffer)
    nop                             iaddiu vi05, vi02, 0
    nop                             iaddiu vi03, vi02, 255               ; vi03: the output, 255 qwords after the batch
    nop                             ilwr.x vi06, (vi05)                  ; the batch type (qword 0)
    nop                             iaddiu vi05, vi05, 1
    nop                             ilwr.x vi08, (vi05)                  ; the GIF tag (qword 1): NLOOP, EOP
    nop                             iaddiu vi04, vi03, 0
    nop                             iaddiu vi11, vi00, 32767             ; 0x7FFF: the NLOOP mask
    nop                             lq.xyzw vf31, 0(vi05)
    nop                             iand vi07, vi11, vi08
    nop                             iaddiu vi11, vi00, 1
    nop                             iaddiu vi05, vi05, 1
    nop                             ibeq vi11, vi06, vertices
    nop                             sqi.xyzw vf31, (vi04++)

    ; a register block: the GIF tag and its NLOOP qwords (A+D) go through to the output
copy_regs:
    nop                             lq.xyzw vf31, 0(vi05)
    nop                             iaddi vi07, vi07, -1
    nop                             iaddiu vi05, vi05, 1
    nop                             iaddiu vi04, vi04, 1
    nop                             ibne vi07, vi00, copy_regs
    nop                             sq.xyzw vf31, -1(vi04)
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             nop                               [E] ; end: the next MSCNT continues at copy_regs_cont
    nop                             nop

    ; the next MSCNT continues here
copy_regs_cont:
    nop                             b batch                              ; the next batch
    nop                             nop

    ; type 1: a strip of NLOOP vertices
vertices:
    nop                             lq.xyzw vf28, 0(vi05)
    nop                             nop
    nop                             nop
    nop                             nop
    mulax.xyzw ACC, vf01, vf28x     lq.xyzw vf29, 1(vi05)
    madday.xyzw ACC, vf02, vf28y    nop
    maddaz.xyzw ACC, vf03, vf28z    iaddiu vi08, vi08, 2                 ; NLOOP + 2: the delay line's last vertices go out first
    maddw.xyzw vf27, vf04, vf00w    isw.x vi08, -1(vi04)
    mulax.xyzw ACC, vf09, vf29x     lq.xyzw vf18, 1021(vi00)
    madday.xyzw ACC, vf10, vf29y    lq.xyzw vf19, 1022(vi00)
    maddz.xyzw vf25, vf11, vf29z    lq.xyzw vf20, 1023(vi00)
    mulax.xyzw ACC, vf05, vf28x     div Q, vf00w, vf27w                  ; Q = 1 / vf27.w
    madday.xyzw ACC, vf06, vf28y    lq.xyzw vf21, 1018(vi00)
    maddaz.xyzw ACC, vf07, vf28z    lq.xyzw vf22, 1019(vi00)
    maxx.xyzw vf25, vf25, vf00x     lq.xyzw vf23, 1020(vi00)
    maddw.xyzw vf26, vf08, vf00w    sqi.xyzw vf18, (vi04++)
    nop                             sqi.xyzw vf19, (vi04++)
    nop                             lq.xyzw vf30, 2(vi05)
    mulax.xyz ACC, vf12, vf25x      sqi.xyzw vf20, (vi04++)
    madday.xyz ACC, vf13, vf25y     sqi.xyzw vf21, (vi04++)
    maddaz.xyz ACC, vf14, vf25z     lq.xyzw vf31, 3(vi05)
    madda.xyz ACC, vf15, vf30       sqi.xyzw vf22, (vi04++)
    madd.xyz vf30, vf17, vf30       sqi.xyzw vf23, (vi04++)
    mulq.xyz vf27, vf27, Q          ilw.w vi09, 0(vi05)                  ; vi09: the position's w word, XYZF2's w (F, ADC) as the model has it
    mulq.xyz vf24, vf31, Q          nop
    ; one vertex per pass, software-pipelined through the delay line
vertices_loop:
    clipw.xyz vf26, vf26w           loi 128.0                            ; I = 128.0: the colour clamp (0x80 is 1.0 on the GS)
    nop                             nop
    ftoi4.xyz vf27, vf27            iaddiu vi05, vi05, 4
    nop                             sq.xyzw vf24, 0(vi04)
    nop                             iaddiu vi14, vi09, 0
    nop                             nop
    subw.x vf26, vf16, vf27w        sq.xyz vf27, 2(vi04)
    minii.xyzw vf25, vf30, I        nop
    nop                             nop
    nop                             nop
    muly.x vf26, vf26, vf16y        lq.xyzw vf28, 0(vi05)
    ftoi0.xyzw vf25, vf25           lq.xyzw vf29, 1(vi05)
    nop                             lq.xyzw vf30, 2(vi05)
    nop                             loi 255.0                            ; I = 255.0
    muli.x vf26, vf26, I            lq.xyzw vf31, 3(vi05)
    mulax.xyzw ACC, vf01, vf28x     sq.xyzw vf25, 1(vi04)
    madday.xyzw ACC, vf02, vf28y    nop
    maddaz.xyzw ACC, vf03, vf28z    nop
    minii.x vf26, vf26, I           nop
    maddw.xyzw vf27, vf04, vf00w    nop
    mulax.xyzw ACC, vf09, vf29x     nop
    madday.xyzw ACC, vf10, vf29y    nop
    maxx.x vf26, vf26, vf00x        nop
    maddz.xyzw vf25, vf11, vf29z    div Q, vf00w, vf27w
    mulax.xyzw ACC, vf05, vf28x     nop
    madday.xyzw ACC, vf06, vf28y    nop
    ftoi4.x vf23, vf26              nop
    maddaz.xyzw ACC, vf07, vf28z    nop
    maxx.xyzw vf25, vf25, vf00x     fcand vi01, 0x03ffff                 ; vi01 = 1: one of the last three vertices is outside the clip volume
    maddw.xyzw vf26, vf08, vf00w    ibeq vi01, vi00, vertices_in_view
    mulq.xyz vf24, vf31, Q          mtir vi13, vf23x
    nop                             iaddiu vi14, vi00, 32767             ; ADC: 0x7FFF + 1 = 0x8000, so the GS draws no triangle ending here
    nop                             iaddiu vi14, vi14, 1
    ; the last three vertices are all inside the clip volume
vertices_in_view:
    mulq.xyz vf27, vf27, Q          ilw.w vi09, 0(vi05)
    mulax.xyz ACC, vf12, vf25x      iaddi vi07, vi07, -1
    madday.xyz ACC, vf13, vf25y     iaddiu vi04, vi04, 3
    maddaz.xyz ACC, vf14, vf25z     iadd vi14, vi14, vi13
    madda.xyz ACC, vf15, vf30       ibne vi07, vi00, vertices_loop
    madd.xyz vf30, vf17, vf30       isw.w vi14, -1(vi04)
    ; the epilogue: the vertices left in the delay line
    nop                             lqd.xyzw vf18, (--vi04)
    nop                             lqd.xyzw vf19, (--vi04)
    nop                             lqd.xyzw vf20, (--vi04)
    nop                             lqd.xyzw vf21, (--vi04)
    nop                             lqd.xyzw vf22, (--vi04)
    nop                             lqd.xyzw vf23, (--vi04)
    nop                             sq.xyzw vf18, 1020(vi00)
    nop                             sq.xyzw vf19, 1019(vi00)
    nop                             sq.xyzw vf20, 1018(vi00)
    nop                             sq.xyzw vf21, 1023(vi00)
    nop                             sq.xyzw vf22, 1022(vi00)
    nop                             sq.xyzw vf23, 1021(vi00)
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             nop                               [E] ; end: the next MSCNT continues at vertices_cont
    nop                             nop

    ; the next MSCNT continues here
vertices_cont:
    nop                             b batch                              ; the next batch
    nop                             nop
.endprogram

;=======================================================================================
; Vu1Prog22: fog
;
