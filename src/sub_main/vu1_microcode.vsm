    mulax.xyzw ACC, vf01, vf30x     lq.xyzw vf12, 1021(vi00)
    madday.xyzw ACC, vf02, vf30y    lq.xyzw vf13, 1022(vi00)
    maddaz.xyzw ACC, vf03, vf30z    lq.xyzw vf14, 1023(vi00)
