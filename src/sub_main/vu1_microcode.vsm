    maddw.xyzw vf27, vf08, vf00w    div Q, vf00w, vf28w                  ; Q = 1 / vf28.w
    mulax.xy ACC, vf09, vf31x       sqi.xyzw vf13, (vi04++)
    madday.xy ACC, vf10, vf31y      sqi.xyzw vf14, (vi04++)
    maddw.xy vf31, vf11, vf00w      sq.xyzw vf15, 1021(vi00)
