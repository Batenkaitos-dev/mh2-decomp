vertices:
    nop                             iaddiu vi08, vi08, 2                 ; NLOOP + 2: the delay line's last vertices go out first
    nop                             isw.x vi08, -1(vi04)
    nop                             lq.xyzw vf27, 1021(vi00)
    nop                             lq.xyzw vf29, 0(vi05)
    nop                             lq.xyzw vf30, 1(vi05)
    nop                             lq.xyzw vf31, 2(vi05)
    nop                             sqi.xyzw vf27, (vi04++)
    mulax.xyzw ACC, vf01, vf29x     lq.xyzw vf23, 1022(vi00)
    madday.xyzw ACC, vf02, vf29y    lq.xyzw vf24, 1023(vi00)
    maddaz.xyzw ACC, vf03, vf29z    lq.xyzw vf25, 1018(vi00)
    maddw.xyzw vf27, vf04, vf00w    lq.xyzw vf26, 1019(vi00)
    mulax.xyzw ACC, vf09, vf30x     lq.xyzw vf22, 1020(vi00)
    madday.xyzw ACC, vf10, vf30y    sqi.xyzw vf23, (vi04++)
    maddz.xyzw vf28, vf11, vf30z    sqi.xyzw vf24, (vi04++)
    mulax.xy ACC, vf16, vf31x       div Q, vf00w, vf27w                  ; Q = 1 / vf27.w
    madday.xy ACC, vf17, vf31y      sqi.xyzw vf25, (vi04++)
    maddw.xy vf31, vf18, vf00w      sqi.xyzw vf26, (vi04++)
    maxx.xyzw vf28, vf28, vf00x     sqi.xyzw vf22, (vi04++)
    nop                             ilw.w vi09, 0(vi05)                  ; vi09: the position's w word, XYZF2's w (F, ADC) as the model has it
    nop                             iaddiu vi05, vi05, 3
    ; one vertex per pass, software-pipelined through the delay line
vertices_loop:
    nop                             nop
    mulq.xyzw vf27, vf27, Q         move.xyzw vf25, vf30
    mulq.xyz vf26, vf31, Q          nop
    mulax.xyz ACC, vf12, vf28x      move.xyz vf19, vf20
    madday.xyz ACC, vf13, vf28y     move.xyz vf20, vf21
    maddaz.xyz ACC, vf14, vf28z     move.xyz vf21, vf27
    maddw.xyz vf28, vf15, vf00w     nop
    ftoi4.xyzw vf27, vf27           nop                                  ; to 12.4 fixed point (GS XYZ)
    mulax.xyzw ACC, vf05, vf29x     sq.xyzw vf26, 0(vi04)
    madday.xyzw ACC, vf06, vf29y    nop
    minii.xyzw vf28, vf28, I        nop
    maddaz.xyzw ACC, vf07, vf29z    sq.xyz vf27, 2(vi04)
    maddw.xyzw vf24, vf08, vf00w    lq.xyzw vf29, 0(vi05)
    sub.xyz vf22, vf20, vf19        lq.xyzw vf30, 1(vi05)
    ftoi0.xyzw vf28, vf28           lq.xyzw vf31, 2(vi05)
    sub.xyz vf23, vf21, vf19        iaddiu vi05, vi05, 3
    clipw.xyz vf24, vf24w           nop                                  ; clip flags: vf24.xyz against +-vf24.w
    mulax.xyzw ACC, vf01, vf29x     isw.w vi12, 1(vi04)
    madday.xyzw ACC, vf02, vf29y    sq.xyz vf28, 1(vi04)
    maddaz.xyzw ACC, vf03, vf29z    iaddiu vi04, vi04, 3
    maddw.xyzw vf27, vf04, vf00w    fcand vi01, 0x03ffff                 ; vi01 = 1: one of the last three vertices is outside the clip volume
    opmula.xyz ACC, vf23, vf22      nop
    opmsub.xyz vf23, vf22, vf23     nop
    mulax.xyzw ACC, vf09, vf30x     nop
    madday.xyzw ACC, vf10, vf30y    div Q, vf00w, vf27w
    maddz.xyzw vf28, vf11, vf30z    ibne vi01, vi00, vertices_skip
    mulw.z vf23, vf23, vf25w        nop
    nop                             ibne vi09, vi00, vertices_skip2
    nop                             nop
    nop                             iaddiu vi01, vi00, 32
    nop                             fmand vi01, vi01
    nop                             ibeq vi01, vi00, vertices_skip2
    nop                             nop
vertices_skip:
    nop                             iaddiu vi09, vi00, 32767
    nop                             iaddiu vi09, vi09, 1
vertices_skip2:
    mulax.xy ACC, vf16, vf31x       iaddi vi07, vi07, -1
    madday.xy ACC, vf17, vf31y      isw.w vi09, -1(vi04)
    maddw.xy vf31, vf18, vf00w      ibne vi07, vi00, vertices_loop
    maxx.xyzw vf28, vf28, vf00x     ilw.w vi09, -3(vi05)
