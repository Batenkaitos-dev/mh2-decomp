    ; one vertex per pass, software-pipelined through the delay line
vertices_loop:
    nop                             iaddi vi07, vi07, -1
    nop                             iaddiu vi14, vi09, 0
    nop                             lq.xyzw vf16, 1021(vi00)
    mulax.xyzw ACC, vf01, vf29x     lq.xyzw vf17, 1022(vi00)
    madday.xyzw ACC, vf02, vf29y    lq.xyzw vf18, 1023(vi00)
    maddaz.xyzw ACC, vf03, vf29z    lq.xyzw vf19, 1018(vi00)
    maddw.xyzw vf25, vf04, vf00w    lq.xyzw vf20, 1019(vi00)
    mulax.xyzw ACC, vf05, vf29x     lq.xyzw vf21, 1020(vi00)
    madday.xyzw ACC, vf06, vf29y    sqi.xyzw vf16, (vi04++)
    maddaz.xyzw ACC, vf07, vf29z    sqi.xyzw vf17, (vi04++)
    maddw.xyzw vf23, vf08, vf00w    div Q, vf00w, vf25w                  ; Q = 1 / vf25.w
    nop                             sqi.xyzw vf18, (vi04++)
    nop                             sq.xyzw vf19, 1021(vi00)
    nop                             sq.xyzw vf20, 1022(vi00)
    clipw.xyz vf23, vf23w           sq.xyzw vf21, 1023(vi00)             ; clip flags: vf23.xyz against +-vf23.w
    nop                             sq.xyzw vf27, 1019(vi00)
    nop                             ilw.w vi09, 0(vi05)
    mulq.xyzw vf24, vf25, Q         lq.xyzw vf29, 0(vi05)
    mulq.xyz vf28, vf31, Q          fcand vi01, 0x03ffff                 ; vi01 = 1: one of the last three vertices is outside the clip volume
    nop                             ibeq vi01, vi00, vertices_in_view
    nop                             lq.xyzw vf31, 1(vi05)
    nop                             iaddiu vi14, vi00, 32767             ; ADC: 0x7FFF + 1 = 0x8000, so the GS draws no triangle ending here
    nop                             iaddiu vi14, vi14, 1
    ; the last three vertices are all inside the clip volume
vertices_in_view:
    ftoi4.xyzw vf24, vf24           iaddiu vi05, vi05, 2                 ; to 12.4 fixed point (GS XYZ)
    nop                             sq.xyzw vf28, 1018(vi00)
    nop                             isw.w vi14, 1020(vi00)
    nop                             ibne vi07, vi00, vertices_loop
    nop                             sq.xyz vf24, 1020(vi00)
    ; the epilogue: the vertices left in the delay line
    nop                             lq.xyzw vf16, 1021(vi00)
    nop                             lq.xyzw vf17, 1022(vi00)
    nop                             lq.xyzw vf18, 1023(vi00)
    nop                             lq.xyzw vf19, 1018(vi00)
    nop                             lq.xyzw vf20, 1019(vi00)
    nop                             lq.xyzw vf21, 1020(vi00)
    nop                             sqi.xyzw vf16, (vi04++)
    nop                             sqi.xyzw vf17, (vi04++)
    nop                             sqi.xyzw vf18, (vi04++)
    nop                             sqi.xyzw vf19, (vi04++)
    nop                             sqi.xyzw vf20, (vi04++)
    nop                             sqi.xyzw vf21, (vi04++)
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             xgkick vi03                       [E] ; end: the next MSCNT continues at vertices_cont
    nop                             nop

    ; the next MSCNT continues here
vertices_cont:
    nop                             b batch                              ; the next batch
    nop                             nop
.endprogram

;=======================================================================================
; Vu1Prog14: three lights, normals (key bit 0x20), material colour, no vertex colours, fog
;
; gVu1ProgInfo14 (bones.c): 165 pairs (1320 bytes), batches of up to 3968 bytes;
; Vu1_SelectProgram's key 0x8222, rigid models (0x21035, 0x121035).
; Setup Vu1Pkt_LD: an UNPACK of 17 qwords to VU 0, then MSCALF 0:
;   0        colour: gGsColorF, RGB scaled by the model's brightness: vf28
;   1-4      gMtxSlots x gMtxView x gMtxProjClip: model to screen (XYZ after the divide by w): vf01-vf04
;   5-8      the matrix above x gViewportMtx: model to the clip test's space: vf05-vf08
;   9-11     light directions (model space, negated): vf09-vf11
;   12-15    light colours (three lights and the ambient): vf24-vf27
;   16       fog range: gGsFogFar and the word after it: vf16
; Vertices: gVu1ProgLayouts[0], 3 qwords: position, normal, texture coordinates.
; Batches at VU 0x11 and 0x11 + 0x1f4 (XTOP); the output follows each.
;=======================================================================================
.program Vu1Prog14
.base 0x11
.offset 0x1f4

    ; MSCALF 0: the setup's constants into registers
init:
    nop                             lq.xyzw vf01, 1(vi00)
    nop                             lq.xyzw vf02, 2(vi00)
    nop                             lq.xyzw vf03, 3(vi00)
    nop                             lq.xyzw vf04, 4(vi00)
    nop                             lq.xyzw vf05, 5(vi00)
    nop                             lq.xyzw vf06, 6(vi00)
    nop                             lq.xyzw vf07, 7(vi00)
    nop                             lq.xyzw vf08, 8(vi00)
    nop                             lq.xyzw vf09, 9(vi00)
    nop                             lq.xyzw vf10, 10(vi00)
    nop                             lq.xyzw vf11, 11(vi00)
    nop                             lq.xyzw vf16, 16(vi00)
    nop                             nop                               [E] ; end: constants loaded
    nop                             nop

    ; MSCNT: one batch at XTOP; qword 0's x is its type, qword 1 a GIF tag
batch:
    nop                             xtop vi02                            ; vi02: the batch (BASE, or BASE + OFFSET: double buffer)
    nop                             iaddiu vi05, vi02, 0
    nop                             iaddiu vi03, vi02, 248               ; vi03: the output, 248 qwords after the batch
    nop                             ilwr.x vi06, (vi05)                  ; the batch type (qword 0)
    nop                             iaddiu vi05, vi05, 1
    nop                             ilwr.x vi08, (vi05)                  ; the GIF tag (qword 1): NLOOP, EOP
    nop                             iaddiu vi04, vi03, 0
    nop                             iaddiu vi11, vi00, 32767             ; 0x7FFF: the NLOOP mask
    nop                             lq.xyzw vf31, 0(vi05)
    nop                             iand vi07, vi11, vi08
    nop                             iaddiu vi11, vi00, 1
    nop                             iaddiu vi05, vi05, 1
    nop                             ibeq vi11, vi06, vertices
    nop                             sqi.xyzw vf31, (vi04++)

    ; a register block: the GIF tag and its NLOOP qwords (A+D) go through to the output
copy_regs:
    nop                             lq.xyzw vf31, 0(vi05)
    nop                             iaddi vi07, vi07, -1
    nop                             iaddiu vi05, vi05, 1
    nop                             iaddiu vi04, vi04, 1
    nop                             ibne vi07, vi00, copy_regs
    nop                             sq.xyzw vf31, -1(vi04)
    nop                             lq.xyzw vf28, 0(vi00)
    nop                             lqi.xyzw vf29, (vi05++)
    nop                             lq.xyzw vf24, 12(vi00)
    nop                             lq.xyzw vf25, 13(vi00)
    nop                             lq.xyzw vf26, 14(vi00)
    ftoi0.xyzw vf20, vf29           lq.xyzw vf27, 15(vi00)
    mul.xyzw vf24, vf29, vf24       nop
    mul.xyzw vf25, vf29, vf25       lqi.xyzw vf30, (vi05++)
    mul.xyzw vf26, vf29, vf26       loi 128.0                            ; I = 128.0: the colour clamp (0x80 is 1.0 on the GS)
    add.xyzw vf23, vf27, vf28       mtir vi15, vf20w
    muli.xyzw vf12, vf24, I         nop
    muli.xyzw vf13, vf25, I         nop
    muli.xyzw vf14, vf26, I         nop
    mul.xyzw vf15, vf23, vf30       nop
    minii.xyzw vf12, vf12, I        nop
    minii.xyzw vf13, vf13, I        nop
    minii.xyzw vf14, vf14, I        nop
    minii.xyzw vf15, vf15, I        nop
    nop                             xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             nop                               [E] ; end: the next MSCNT continues at copy_regs_cont
    nop                             nop

    ; the next MSCNT continues here
copy_regs_cont:
    nop                             b batch                              ; the next batch
    nop                             nop

    ; type 1: a strip of NLOOP vertices
vertices:
    nop                             iaddiu vi08, vi08, 2                 ; NLOOP + 2: the delay line's last vertices go out first
    nop                             isw.x vi08, -1(vi04)
    nop                             lq.xyzw vf20, 1021(vi00)
    nop                             lq.xyzw vf21, 1022(vi00)
    nop                             lq.xyzw vf30, 1(vi05)
    nop                             lq.xyzw vf22, 1023(vi00)
    nop                             lq.xyzw vf29, 0(vi05)
    nop                             sqi.xyzw vf20, (vi04++)
    mulax.xyzw ACC, vf09, vf30x     sqi.xyzw vf21, (vi04++)
    madday.xyzw ACC, vf10, vf30y    sqi.xyzw vf22, (vi04++)
    maddz.xyzw vf22, vf11, vf30z    lq.xyzw vf23, 1018(vi00)
    mulax.xyzw ACC, vf05, vf29x     nop
    madday.xyzw ACC, vf06, vf29y    nop
    maddaz.xyzw ACC, vf07, vf29z    nop
    maxx.xyzw vf22, vf22, vf00x     sqi.xyzw vf23, (vi04++)
    maddw.xyzw vf23, vf08, vf00w    nop
    nop                             nop
    nop                             loi 128.0                            ; I = 128.0: the colour clamp (0x80 is 1.0 on the GS)
    mulax.xyz ACC, vf12, vf22x      lq.xyzw vf31, 2(vi05)
    madday.xyz ACC, vf13, vf22y     ilw.w vi09, 0(vi05)                  ; vi09: the position's w word, XYZF2's w (F, ADC) as the model has it
    maddaz.xyz ACC, vf14, vf22z     lq.xyzw vf24, 1019(vi00)
    maddw.xyz vf21, vf15, vf00w     lq.xyzw vf25, 1020(vi00)
    clipw.xyz vf23, vf23w           iaddiu vi05, vi05, 3                 ; clip flags: vf23.xyz against +-vf23.w
    mulax.xyzw ACC, vf01, vf29x     iaddiu vi14, vi09, 0
    madday.xyzw ACC, vf02, vf29y    sqi.xyzw vf24, (vi04++)
    minii.xyzw vf21, vf21, I        sqi.xyzw vf25, (vi04++)
    ; one vertex per pass, software-pipelined through the delay line
vertices_loop:
    maddaz.xyzw ACC, vf03, vf29z    lq.xyzw vf29, 0(vi05)
    maddw.xyzw vf25, vf04, vf00w    nop
    nop                             nop
    ftoi0.xyzw vf21, vf21           loi 255.0                            ; I = 255.0
    nop                             iaddi vi07, vi07, -1
    nop                             div Q, vf00w, vf25w                  ; Q = 1 / vf25.w
    nop                             isw.w vi15, 1(vi04)
    nop                             sq.xyz vf21, 1(vi04)
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             nop
    mulq.xyz vf25, vf25, Q          nop
    mulq.xyz vf24, vf31, Q          ilw.w vi09, 0(vi05)
    nop                             move.xyz vf17, vf18
    nop                             move.xyz vf18, vf19
    nop                             move.xyz vf19, vf25
    ftoi4.xyz vf25, vf25            lq.xyzw vf31, 2(vi05)
    nop                             sq.xyzw vf24, 0(vi04)
    sub.xyz vf20, vf18, vf17        fcand vi01, 0x03ffff                 ; vi01 = 1: one of the last three vertices is outside the clip volume
    sub.xyz vf21, vf19, vf17        ibne vi01, vi00, vertices_skip
    subw.x vf23, vf16, vf25w        sq.xyz vf25, 2(vi04)
    nop                             nop
    nop                             nop
    opmula.xyz ACC, vf21, vf20      nop
    opmsub.xyz vf21, vf20, vf21     nop
    nop                             nop
    nop                             nop
    nop                             nop
    mulw.z vf21, vf21, vf30w        nop
    nop                             nop
    nop                             nop
    nop                             iaddiu vi01, vi00, 32
    nop                             fmand vi01, vi01
    nop                             ibeq vi01, vi00, vertices_skip2
    nop                             nop
vertices_skip:
    nop                             iaddiu vi14, vi00, 32767             ; ADC: 0x7FFF + 1 = 0x8000, so the GS draws no triangle ending here
    nop                             iaddiu vi14, vi14, 1
vertices_skip2:
    nop                             lq.xyzw vf30, 1(vi05)
    nop                             iadd vi14, vi14, vi13
    nop                             isw.w vi14, 2(vi04)
    muly.x vf23, vf23, vf16y        iaddiu vi05, vi05, 3
    mulax.xyzw ACC, vf09, vf30x     iaddiu vi04, vi04, 3
    madday.xyzw ACC, vf10, vf30y    iaddiu vi14, vi09, 0
    maddz.xyzw vf22, vf11, vf30z    nop
    muli.x vf23, vf23, I            nop
    mulax.xyzw ACC, vf05, vf29x     nop
    madday.xyzw ACC, vf06, vf29y    nop
    maddaz.xyzw ACC, vf07, vf29z    nop
    minii.x vf25, vf23, I           nop
    maxx.xyzw vf22, vf22, vf00x     nop
    maddw.xyzw vf23, vf08, vf00w    nop
    nop                             nop
    nop                             nop
    mulax.xyz ACC, vf12, vf22x      nop
    maxx.x vf25, vf25, vf00x        nop
    madday.xyz ACC, vf13, vf22y     nop
    clipw.xyz vf23, vf23w           nop
    maddaz.xyz ACC, vf14, vf22z     nop
    ftoi4.x vf25, vf25              loi 128.0
    maddw.xyz vf21, vf15, vf00w     nop
    mulax.xyzw ACC, vf01, vf29x     nop
    nop                             nop
    madday.xyzw ACC, vf02, vf29y    ibne vi07, vi00, vertices_loop
    minii.xyzw vf21, vf21, I        mtir vi13, vf25x
    ; the epilogue: the vertices left in the delay line
    nop                             lqd.xyzw vf20, (--vi04)
    nop                             lqd.xyzw vf21, (--vi04)
    nop                             lqd.xyzw vf22, (--vi04)
    nop                             lqd.xyzw vf23, (--vi04)
    nop                             lqd.xyzw vf24, (--vi04)
    nop                             lqd.xyzw vf25, (--vi04)
    nop                             sq.xyzw vf20, 1020(vi00)
    nop                             sq.xyzw vf21, 1019(vi00)
    nop                             sq.xyzw vf22, 1018(vi00)
    nop                             sq.xyzw vf23, 1023(vi00)
    nop                             sq.xyzw vf24, 1022(vi00)
    nop                             sq.xyzw vf25, 1021(vi00)
    nop                             xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             nop                               [E] ; end: the next MSCNT continues at vertices_cont
    nop                             nop

    ; the next MSCNT continues here
vertices_cont:
    nop                             b batch                              ; the next batch
    nop                             nop
.endprogram

;=======================================================================================
; Vu1Prog15: skinned, three lights, normals (key bit 0x20), material colour, no vertex colours, fog
;
; gVu1ProgInfo15 (bones.c): 455 pairs (3640 bytes), batches of up to 3200 bytes;
; Vu1_SelectProgram's key 0x8222, skinned models (0x321135, 0x221135).
; Setup Vu1Pkt_SLD: an UNPACK of 241 qwords to VU 0, then MSCALF 0:
;   0        colour: gGsColorF, RGB scaled by the model's brightness: vf28
;   1-4      gMtxView x gMtxProjClip: world to screen (XYZ after the divide by w): vf01-vf04
;   5-8      gMtxView x gViewportMtx: world to the clip test's space: vf05-vf08
;   9-11     light directions (world space, negated): vf09, vf10, vf11, vf29, vf30, vf31
;   12-15    light colours (three lights and the ambient): vf24-vf27
;   16       fog range: gGsFogFar and the word after it: vf16
;   17-144   bone matrices: the 32 gMtxSlots the model's mask (e+0x54) selects
; Vertices: gVu1ProgLayouts[8], 5 qwords: position, normal, texture coordinates, bone indices, bone weights.
; Batches at VU 0xf1 and 0xf1 + 0x184 (XTOP); the output follows each.
;=======================================================================================
.program Vu1Prog15
.base 0xf1
.offset 0x184

    ; MSCALF 0: the setup's constants into registers
init:
    nop                             iaddiu vi07, vi00, 32
    nop                             iaddiu vi10, vi00, 17
    nop                             iaddiu vi11, vi00, 145
    nop                             lq.xyzw vf29, 9(vi00)
    nop                             lq.xyzw vf30, 10(vi00)
    nop                             lq.xyzw vf31, 11(vi00)
    nop                             lq.xyzw vf01, 0(vi10)
    nop                             lq.xyzw vf02, 1(vi10)
    nop                             lq.xyzw vf03, 2(vi10)
    nop                             iaddiu vi10, vi10, 4
    addx.x vf04, vf00, vf01x        nop
    addy.x vf05, vf00, vf01y        nop
    addz.x vf06, vf00, vf01z        nop
    addx.y vf04, vf00, vf02x        nop
    addy.y vf05, vf00, vf02y        nop
    addz.y vf06, vf00, vf02z        nop
    addx.z vf04, vf00, vf03x        nop
    addy.z vf05, vf00, vf03y        nop
    addz.z vf06, vf00, vf03z        nop
    nop                             nop
    mulax.xyz ACC, vf04, vf29x      nop
    madday.xyz ACC, vf05, vf29y     nop
    maddz.xyz vf07, vf06, vf29z     nop
    mulax.xyz ACC, vf04, vf30x      nop
    madday.xyz ACC, vf05, vf30y     nop
    maddz.xyz vf08, vf06, vf30z     nop
    mulax.xyz ACC, vf04, vf31x      nop
    madday.xyz ACC, vf05, vf31y     nop
    maddz.xyz vf09, vf06, vf31z     nop
    nop                             nop
    mul.xyz vf10, vf07, vf07        nop
    mul.xyz vf11, vf08, vf08        nop
    mul.xyz vf12, vf09, vf09        nop
    nop                             lq.xyzw vf01, 0(vi10)
    addy.x vf10, vf10, vf10y        lq.xyzw vf02, 1(vi10)
    addy.x vf11, vf11, vf11y        lq.xyzw vf03, 2(vi10)
    addy.x vf12, vf12, vf12y        nop
    nop                             nop
    addz.x vf10, vf10, vf10z        nop
init_loop:
    addz.x vf11, vf11, vf11z        nop
    addz.x vf12, vf12, vf12z        iaddiu vi10, vi10, 4
    addx.x vf04, vf00, vf01x        nop
    addy.x vf05, vf00, vf01y        rsqrt Q, vf00w, vf10x
    addz.x vf06, vf00, vf01z        ersqrt P, vf11x
    addx.y vf04, vf00, vf02x        nop
    addy.y vf05, vf00, vf02y        nop
    addz.y vf06, vf00, vf02z        move.xyzw vf20, vf07
    addx.z vf04, vf00, vf03x        move.xyzw vf21, vf08
    addy.z vf05, vf00, vf03y        move.xyzw vf22, vf09
    addz.z vf06, vf00, vf03z        nop
    nop                             nop
    mulax.xyz ACC, vf04, vf29x      nop
    madday.xyz ACC, vf05, vf29y     nop
    maddz.xyz vf07, vf06, vf29z     nop
    mulax.xyz ACC, vf04, vf30x      nop
    mulq.xyz vf13, vf20, Q          rsqrt Q, vf00w, vf12x
    madday.xyz ACC, vf05, vf30y     nop
    maddz.xyz vf08, vf06, vf30z     nop
    mulax.xyz ACC, vf04, vf31x      nop
    addx.x vf16, vf00, vf13x        nop
    addy.x vf17, vf00, vf13y        nop
    addz.x vf18, vf00, vf13z        mfp.x vf19, P
    madday.xyz ACC, vf05, vf31y     nop
    maddz.xyz vf09, vf06, vf31z     nop
    mul.xyz vf10, vf07, vf07        nop
    mulx.xyz vf14, vf21, vf19x      nop
    mul.xyz vf11, vf08, vf08        nop
    mul.xyz vf12, vf09, vf09        nop
    mulq.xyz vf15, vf22, Q          nop
    addx.y vf16, vf00, vf14x        nop
    addy.y vf17, vf00, vf14y        nop
    addz.y vf18, vf00, vf14z        nop
    addx.z vf16, vf00, vf15x        lq.xyzw vf01, 0(vi10)
    addy.z vf17, vf00, vf15y        lq.xyzw vf02, 1(vi10)
    addz.z vf18, vf00, vf15z        lq.xyzw vf03, 2(vi10)
    addy.x vf10, vf10, vf10y        iaddi vi07, vi07, -1
    addy.x vf11, vf11, vf11y        sqi.xyzw vf16, (vi11++)
    addy.x vf12, vf12, vf12y        sqi.xyzw vf17, (vi11++)
    nop                             ibne vi07, vi00, init_loop
    addz.x vf10, vf10, vf10z        sqi.xyzw vf18, (vi11++)
    addx.x vf09, vf00, vf29x        lq.xyzw vf01, 1(vi00)
    addy.x vf10, vf00, vf29y        lq.xyzw vf02, 2(vi00)
    addz.x vf11, vf00, vf29z        lq.xyzw vf03, 3(vi00)
    addx.y vf09, vf00, vf30x        lq.xyzw vf04, 4(vi00)
    addy.y vf10, vf00, vf30y        lq.xyzw vf16, 16(vi00)
    addz.y vf11, vf00, vf30z        nop
    addx.z vf09, vf00, vf31x        nop
    addy.z vf10, vf00, vf31y        nop
    addz.z vf11, vf00, vf31z        nop
    nop                             nop
    nop                             sq.xyzw vf09, 9(vi00)
    nop                             sq.xyzw vf10, 10(vi00)
    nop                             sq.xyzw vf11, 11(vi00)
    nop                             nop
    nop                             nop                               [E] ; end: constants loaded
    nop                             nop

    ; MSCNT: one batch at XTOP; qword 0's x is its type, qword 1 a GIF tag
batch:
    nop                             xtop vi02                            ; vi02: the batch (BASE, or BASE + OFFSET: double buffer)
    nop                             iaddiu vi05, vi02, 0
    nop                             iaddiu vi03, vi02, 200               ; vi03: the output, 200 qwords after the batch
    nop                             iaddiu vi04, vi03, 0
    nop                             ilwr.x vi06, (vi05)                  ; the batch type (qword 0)
    nop                             iaddiu vi05, vi05, 1
    nop                             iaddiu vi11, vi00, 32767             ; 0x7FFF: the NLOOP mask
    nop                             lq.xyzw vf31, 0(vi05)
    nop                             ilwr.x vi08, (vi05)                  ; the GIF tag (qword 1): NLOOP, EOP
    nop                             iand vi07, vi11, vi08
    nop                             iaddiu vi11, vi00, 1
    nop                             iaddiu vi05, vi05, 1
    nop                             ibeq vi11, vi06, rigid
    nop                             sqi.xyzw vf31, (vi04++)
    nop                             iaddiu vi11, vi00, 2
    nop                             nop
    nop                             ibeq vi11, vi06, blended
    nop                             nop

    ; a register block: the GIF tag and its NLOOP qwords (A+D) go through to the output
copy_regs:
    nop                             lq.xyzw vf31, 0(vi05)
    nop                             iaddi vi07, vi07, -1
    nop                             iaddiu vi05, vi05, 1
    nop                             iaddiu vi04, vi04, 1
    nop                             ibne vi07, vi00, copy_regs
    nop                             sq.xyzw vf31, -1(vi04)
    nop                             lq.xyzw vf24, 12(vi00)
    nop                             lq.xyzw vf25, 13(vi00)
    nop                             lq.xyzw vf26, 14(vi00)
    nop                             lq.xyzw vf27, 15(vi00)
    nop                             lq.xyzw vf28, 0(vi00)
    nop                             lqi.xyzw vf29, (vi05++)
    nop                             lqi.xyzw vf30, (vi05++)
    nop                             nop
    nop                             nop
    mul.xyzw vf24, vf29, vf24       nop
    mul.xyzw vf25, vf29, vf25       nop
    mul.xyzw vf26, vf29, vf26       nop
    add.xyzw vf23, vf27, vf28       nop
    ftoi0.xyzw vf29, vf29           nop
    nop                             loi 128.0                            ; I = 128.0: the colour clamp (0x80 is 1.0 on the GS)
    muli.xyzw vf12, vf24, I         nop
    muli.xyzw vf13, vf25, I         nop
    muli.xyzw vf14, vf26, I         nop
    mul.xyzw vf15, vf23, vf30       nop
    nop                             mtir vi15, vf29w
    minii.xyzw vf12, vf12, I        nop
    minii.xyzw vf13, vf13, I        nop
    minii.xyzw vf14, vf14, I        nop
    minii.xyzw vf15, vf15, I        nop
    nop                             xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             nop                               [E] ; end: the next MSCNT continues at copy_regs_cont
    nop                             nop

    ; the next MSCNT continues here
copy_regs_cont:
    nop                             b batch                              ; the next batch
    nop                             nop

    ; type 1: vertices of one bone each (qword 3: the bone's matrix addresses)
rigid:
    nop                             iaddiu vi08, vi08, 2                 ; NLOOP + 2: the delay line's last vertices go out first
    nop                             isw.x vi08, -1(vi04)
    nop                             lq.xyzw vf20, 1021(vi00)
    nop                             lq.xyzw vf21, 1022(vi00)
    nop                             lq.xyzw vf22, 1023(vi00)
    nop                             lq.xyzw vf23, 1018(vi00)
    nop                             lq.xyzw vf24, 1019(vi00)
    nop                             lq.xyzw vf25, 1020(vi00)
    nop                             sqi.xyzw vf20, (vi04++)
    nop                             sqi.xyzw vf21, (vi04++)
    nop                             sqi.xyzw vf22, (vi04++)
    nop                             sqi.xyzw vf23, (vi04++)
    nop                             sqi.xyzw vf24, (vi04++)
    nop                             sqi.xyzw vf25, (vi04++)
    nop                             ilw.x vi10, 3(vi05)
    nop                             ilw.y vi11, 3(vi05)
    nop                             lq.xyzw vf29, 0(vi05)
    nop                             lq.xyzw vf30, 1(vi05)
    nop                             lq.xyzw vf20, 0(vi10)
    nop                             lq.xyzw vf21, 1(vi10)
    nop                             lq.xyzw vf22, 2(vi10)
    nop                             lq.xyzw vf23, 3(vi10)
    mulax.xyzw ACC, vf20, vf29x     lq.xyzw vf20, 0(vi11)
    madday.xyzw ACC, vf21, vf29y    lq.xyzw vf21, 1(vi11)
    maddaz.xyzw ACC, vf22, vf29z    lq.xyzw vf22, 2(vi11)
    maddw.xyzw vf09, vf23, vf00w    lq.xyzw vf05, 5(vi00)
    mulax.xyz ACC, vf20, vf30x      lq.xyzw vf06, 6(vi00)
    madday.xyz ACC, vf21, vf30y     lq.xyzw vf07, 7(vi00)
    maddz.xyz vf26, vf22, vf30z     lq.xyzw vf08, 8(vi00)
    mulax.xyzw ACC, vf01, vf09x     nop
    madday.xyzw ACC, vf02, vf09y    nop
    maddaz.xyzw ACC, vf03, vf09z    nop
    maddw.xyzw vf28, vf04, vf00w    nop
    ; one vertex per pass, software-pipelined through the delay line
rigid_loop:
    maxx.xyzw vf26, vf26, vf00x     nop
    nop                             nop
    nop                             nop
    subw.x vf27, vf16, vf28w        div Q, vf00w, vf28w                  ; Q = 1 / vf28.w
    mulax.xyz ACC, vf12, vf26x      move.xyz vf17, vf18
    madday.xyz ACC, vf13, vf26y     move.xyz vf18, vf19
    maddaz.xyz ACC, vf14, vf26z     lq.xyzw vf31, 2(vi05)
    muly.x vf27, vf27, vf16y        ilw.w vi09, 0(vi05)                  ; vi09: the position's w word, XYZF2's w (F, ADC) as the model has it
    maddw.xyz vf26, vf15, vf00w     iaddiu vi05, vi05, 5
    sub.xyz vf24, vf18, vf17        isw.w vi15, 1(vi04)
    mulq.xyz vf28, vf28, Q          loi 255.0                            ; I = 255.0
    muli.x vf27, vf27, I            loi 128.0                            ; I = 128.0: the colour clamp (0x80 is 1.0 on the GS)
    minii.xyzw vf26, vf26, I        loi 255.0
    mulq.xyz vf31, vf31, Q          ilw.x vi10, 3(vi05)
    sub.xyz vf25, vf28, vf17        move.xyz vf19, vf28
    minii.x vf27, vf27, I           move.xyzw vf10, vf30
    ftoi4.xyz vf28, vf28            lq.xyzw vf29, 0(vi05)
    ftoi0.xyz vf26, vf26            sq.xyzw vf31, 0(vi04)
    opmula.xyz ACC, vf25, vf24      ilw.y vi11, 3(vi05)
    maxx.x vf27, vf27, vf00x        lq.xyzw vf30, 1(vi05)
    opmsub.xyz vf25, vf24, vf25     sq.xyz vf28, 2(vi04)
    mulax.xyzw ACC, vf05, vf09x     sq.xyz vf26, 1(vi04)
    madday.xyzw ACC, vf06, vf09y    lq.xyzw vf20, 0(vi10)
    ftoi4.x vf27, vf27              lq.xyzw vf21, 1(vi10)
    maddaz.xyzw ACC, vf07, vf09z    lq.xyzw vf22, 2(vi10)
    maddw.xyzw vf09, vf08, vf00w    lq.xyzw vf23, 3(vi10)
    mulax.xyzw ACC, vf20, vf29x     lq.xyzw vf20, 0(vi11)
    madday.xyzw ACC, vf21, vf29y    mtir vi13, vf27x
    maddaz.xyzw ACC, vf22, vf29z    lq.xyzw vf21, 1(vi11)
    clipw.xyz vf09, vf09w           lq.xyzw vf22, 2(vi11)                ; clip flags: vf09.xyz against +-vf09.w
    maddw.xyzw vf09, vf23, vf00w    iaddiu vi04, vi04, 3
    mulax.xyz ACC, vf20, vf30x      iaddi vi07, vi07, -1
    mulw.z vf25, vf25, vf10w        nop
    madday.xyz ACC, vf21, vf30y     fcand vi01, 0x03ffff                 ; vi01 = 1: one of the last three vertices is outside the clip volume
    maddz.xyz vf26, vf22, vf30z     ibne vi01, vi00, rigid_skip
    mulax.xyzw ACC, vf01, vf09x     iaddiu vi01, vi00, 32
    nop                             fmand vi01, vi01
    nop                             ibeq vi01, vi00, rigid_skip2
    nop                             nop
rigid_skip:
    nop                             iaddiu vi09, vi00, 32767
    nop                             iaddiu vi09, vi09, 1
rigid_skip2:
    madday.xyzw ACC, vf02, vf09y    iadd vi09, vi09, vi13
    maddaz.xyzw ACC, vf03, vf09z    ibne vi07, vi00, rigid_loop
    maddw.xyzw vf28, vf04, vf00w    isw.w vi09, -1(vi04)
    ; the epilogue: the vertices left in the delay line
    nop                             lqd.xyzw vf20, (--vi04)
    nop                             lqd.xyzw vf21, (--vi04)
    nop                             lqd.xyzw vf22, (--vi04)
    nop                             lqd.xyzw vf23, (--vi04)
    nop                             lqd.xyzw vf24, (--vi04)
    nop                             lqd.xyzw vf25, (--vi04)
    nop                             sq.xyzw vf20, 1020(vi00)
    nop                             sq.xyzw vf21, 1019(vi00)
    nop                             sq.xyzw vf22, 1018(vi00)
    nop                             sq.xyzw vf23, 1023(vi00)
    nop                             sq.xyzw vf24, 1022(vi00)
    nop                             sq.xyzw vf25, 1021(vi00)
    nop                             xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             nop
    nop                             nop                               [E] ; end: the next MSCNT continues at rigid_cont
    nop                             nop

    ; the next MSCNT continues here
rigid_cont:
    nop                             b batch                              ; the next batch
    nop                             nop

    ; type 2: vertices of four bones (qword 3: the matrix addresses, qword 4: the weights)
blended:
    nop                             iaddiu vi08, vi08, 2                 ; NLOOP + 2: the delay line's last vertices go out first
    nop                             isw.x vi08, -1(vi04)
    nop                             lq.xyzw vf20, 1021(vi00)
    nop                             lq.xyzw vf21, 1022(vi00)
    nop                             lq.xyzw vf22, 1023(vi00)
    nop                             lq.xyzw vf23, 1018(vi00)
    nop                             lq.xyzw vf24, 1019(vi00)
    nop                             lq.xyzw vf25, 1020(vi00)
    nop                             sqi.xyzw vf20, (vi04++)
    nop                             sqi.xyzw vf21, (vi04++)
    nop                             sqi.xyzw vf22, (vi04++)
    nop                             sqi.xyzw vf23, (vi04++)
    nop                             sqi.xyzw vf24, (vi04++)
    nop                             sqi.xyzw vf25, (vi04++)
    ; one vertex per pass, software-pipelined through the delay line
blended_loop:
    nop                             ilw.w vi09, 0(vi05)                  ; vi09: the position's w word, XYZF2's w (F, ADC) as the model has it
    nop                             lq.xyzw vf28, 0(vi05)
    nop                             lq.xyzw vf29, 1(vi05)
    nop                             lq.xyzw vf30, 2(vi05)
    nop                             ilw.x vi10, 3(vi05)
    nop                             ilw.y vi11, 3(vi05)
    nop                             ilw.z vi12, 3(vi05)
    nop                             ilw.w vi13, 3(vi05)
    nop                             lq.xyzw vf31, 4(vi05)
    nop                             iaddiu vi05, vi05, 5
    nop                             lq.xyzw vf24, 0(vi10)
    nop                             lq.xyzw vf25, 0(vi11)
    nop                             lq.xyzw vf26, 0(vi12)
    nop                             lq.xyzw vf27, 0(vi13)
    mulax.xyzw ACC, vf24, vf31x     lq.xyzw vf24, 1(vi10)
    madday.xyzw ACC, vf25, vf31y    lq.xyzw vf25, 1(vi11)
    maddaz.xyzw ACC, vf26, vf31z    lq.xyzw vf26, 1(vi12)
    maddw.xyzw vf20, vf27, vf31w    lq.xyzw vf27, 1(vi13)
    mulax.xyzw ACC, vf24, vf31x     lq.xyzw vf24, 2(vi10)
    madday.xyzw ACC, vf25, vf31y    lq.xyzw vf25, 2(vi11)
    maddaz.xyzw ACC, vf26, vf31z    lq.xyzw vf26, 2(vi12)
    maddw.xyzw vf21, vf27, vf31w    lq.xyzw vf27, 2(vi13)
    mulax.xyzw ACC, vf24, vf31x     lq.xyzw vf24, 3(vi10)
    madday.xyzw ACC, vf25, vf31y    lq.xyzw vf25, 3(vi11)
    maddaz.xyzw ACC, vf26, vf31z    lq.xyzw vf26, 3(vi12)
    maddw.xyzw vf22, vf27, vf31w    lq.xyzw vf27, 3(vi13)
    mulax.xyzw ACC, vf24, vf31x     nop
    madday.xyzw ACC, vf25, vf31y    nop
    maddaz.xyzw ACC, vf26, vf31z    nop
    maddw.xyzw vf23, vf27, vf31w    nop
    mulax.xyz ACC, vf20, vf29x      nop
    madday.xyz ACC, vf21, vf29y     nop
    maddz.xyz vf27, vf22, vf29z     nop
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             erleng.xyz P, vf27                   ; P = 1 / |vf27.xyz|
    nop                             waitp
    nop                             mfp.w vf27, P
    nop                             nop
    nop                             nop
    nop                             nop
    mulw.xyz vf27, vf27, vf27w      nop
    nop                             lq.xyzw vf09, 9(vi00)
    nop                             lq.xyzw vf10, 10(vi00)
    nop                             lq.xyzw vf11, 11(vi00)
    nop                             nop
    nop                             nop
    nop                             nop
    mulax.xyz ACC, vf09, vf27x      nop
    madday.xyz ACC, vf10, vf27y     nop
    maddz.xyz vf27, vf11, vf27z     nop
    nop                             nop
    nop                             nop
    nop                             nop
    maxx.xyz vf27, vf27, vf00x      nop
    nop                             nop
    nop                             nop
    nop                             nop
    mulax.xyz ACC, vf12, vf27x      nop
    madday.xyz ACC, vf13, vf27y     nop
    maddaz.xyz ACC, vf14, vf27z     nop
    maddw.xyz vf27, vf15, vf00w     nop
    nop                             nop
    nop                             nop
    nop                             loi 128.0                            ; I = 128.0: the colour clamp (0x80 is 1.0 on the GS)
    minii.xyz vf27, vf27, I         nop
    nop                             nop
    nop                             nop
    nop                             nop
    ftoi0.xyz vf27, vf27            nop
    nop                             nop
    nop                             nop
    nop                             isw.w vi15, 1(vi04)
    nop                             sq.xyz vf27, 1(vi04)
    mulax.xyzw ACC, vf20, vf28x     nop
    madday.xyzw ACC, vf21, vf28y    nop
    maddaz.xyzw ACC, vf22, vf28z    nop
    maddw.xyzw vf28, vf23, vf00w    nop
    nop                             nop
    nop                             nop
    nop                             nop
    mulax.xyzw ACC, vf01, vf28x     nop
    madday.xyzw ACC, vf02, vf28y    nop
    maddaz.xyzw ACC, vf03, vf28z    nop
    maddw.xyzw vf26, vf04, vf00w    nop
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             div Q, vf00w, vf26w                  ; Q = 1 / vf26.w
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             nop
    mulq.xyz vf26, vf26, Q          nop
    mulq.xyz vf30, vf30, Q          nop
    nop                             move.xyz vf17, vf18
    nop                             move.xyz vf18, vf19
    nop                             move.xyz vf19, vf26
    ftoi4.xyz vf26, vf26            nop
    nop                             sq.xyzw vf30, 0(vi04)
    nop                             nop
    nop                             nop
    nop                             sq.xyz vf26, 2(vi04)
    nop                             lq.xyzw vf05, 5(vi00)
    nop                             lq.xyzw vf06, 6(vi00)
    nop                             lq.xyzw vf07, 7(vi00)
    nop                             lq.xyzw vf08, 8(vi00)
    mulax.xyzw ACC, vf05, vf28x     nop
    madday.xyzw ACC, vf06, vf28y    nop
    maddaz.xyzw ACC, vf07, vf28z    nop
    maddw.xyzw vf28, vf08, vf00w    nop
    nop                             nop
    nop                             nop
    nop                             nop
    clipw.xyz vf28, vf28w           nop                                  ; clip flags: vf28.xyz against +-vf28.w
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             fcand vi01, 0x03ffff                 ; vi01 = 1: one of the last three vertices is outside the clip volume
    nop                             ibne vi01, vi00, blended_skip
    nop                             nop
    sub.xyz vf23, vf18, vf17        nop
    sub.xyz vf24, vf19, vf17        nop
    nop                             nop
    nop                             nop
    nop                             nop
    opmula.xyz ACC, vf24, vf23      nop
    opmsub.xyz vf24, vf23, vf24     nop
    nop                             nop
    nop                             nop
    nop                             nop
    mulw.z vf24, vf24, vf29w        nop
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             iaddiu vi01, vi00, 32
    nop                             fmand vi01, vi01
    nop                             ibeq vi01, vi00, blended_skip2
    nop                             nop
blended_skip:
    nop                             iaddiu vi09, vi00, 32767
    nop                             iaddiu vi09, vi09, 1
blended_skip2:
    subw.x vf23, vf16, vf26w        nop
    nop                             nop
    nop                             nop
    nop                             nop
    muly.x vf23, vf23, vf16y        nop
    nop                             nop
    nop                             nop
    nop                             loi 255.0                            ; I = 255.0
    muli.x vf23, vf23, I            nop
    nop                             nop
    nop                             nop
    nop                             nop
    minii.x vf23, vf23, I           nop
    nop                             nop
    nop                             nop
    nop                             nop
    maxx.x vf23, vf23, vf00x        nop
    nop                             nop
    nop                             nop
    nop                             nop
    ftoi4.x vf23, vf23              nop
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             mtir vi13, vf23x
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             iadd vi09, vi09, vi13
    nop                             isw.w vi09, 2(vi04)
    nop                             iaddiu vi04, vi04, 3
    nop                             iaddi vi07, vi07, -1
    nop                             nop
    nop                             ibne vi07, vi00, blended_loop
    nop                             nop
    ; the epilogue: the vertices left in the delay line
    nop                             lqd.xyzw vf20, (--vi04)
    nop                             lqd.xyzw vf21, (--vi04)
    nop                             lqd.xyzw vf22, (--vi04)
    nop                             lqd.xyzw vf23, (--vi04)
    nop                             lqd.xyzw vf24, (--vi04)
    nop                             lqd.xyzw vf25, (--vi04)
    nop                             sq.xyzw vf20, 1020(vi00)
    nop                             sq.xyzw vf21, 1019(vi00)
    nop                             sq.xyzw vf22, 1018(vi00)
    nop                             sq.xyzw vf23, 1023(vi00)
    nop                             sq.xyzw vf24, 1022(vi00)
    nop                             sq.xyzw vf25, 1021(vi00)
    nop                             xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             nop
    nop                             nop                               [E] ; end: the next MSCNT continues at blended_cont
    nop                             nop

    ; the next MSCNT continues here
blended_cont:
    nop                             b batch                              ; the next batch
    nop                             nop
.endprogram

;=======================================================================================
; Vu1Prog16: three lights, normals (key bit 0x20), material colour, no vertex colours, clipped
;
; gVu1ProgInfo16 (bones.c): 497 pairs (3976 bytes), batches of up to 3040 bytes;
; Vu1_SelectProgram's key 0x2a2, rigid models (0x21035, 0x121035).
; Setup Vu1Pkt_LP: an UNPACK of 20 qwords to VU 0, then MSCALF 0:
;   0        colour: gGsColorF, RGB scaled by the model's brightness: vf28
;   1-4      gMtxSlots x gMtxView x gMtxProjClip: model to screen (XYZ after the divide by w): vf01-vf04
;   5-8      the matrix above x gViewportMtx: model to the clip test's space: vf05-vf08
;   9-11     light directions (model space, negated): vf09-vf11
;   12-15    light colours (three lights and the ambient): vf24-vf27
;   16-19    gMtxProj, the projection matrix: vf27-vf30
; Vertices: gVu1ProgLayouts[0], 3 qwords: position, normal, texture coordinates.
; Batches at VU 0x14 and 0x14 + 0x1ea (XTOP); the output follows each.
;=======================================================================================
.program Vu1Prog16
.base 0x14
.offset 0x1ea
.stcycl 4, 4
.unpack 0x3a6, 0x00008000, 0x302ec000, 0x00000412, 0x00000000   ; GIF tag template: EOP, PRIM 0x5d, REGS ST RGBAQ XYZF2

    ; MSCALF 0: the setup's constants into registers
init:
    nop                             lq.xyzw vf01, 1(vi00)
    nop                             lq.xyzw vf02, 2(vi00)
    nop                             lq.xyzw vf03, 3(vi00)
    nop                             lq.xyzw vf04, 4(vi00)
    nop                             lq.xyzw vf05, 5(vi00)
    nop                             lq.xyzw vf06, 6(vi00)
    nop                             lq.xyzw vf07, 7(vi00)
    nop                             lq.xyzw vf08, 8(vi00)
    nop                             lq.xyzw vf09, 9(vi00)
    nop                             lq.xyzw vf10, 10(vi00)
    nop                             lq.xyzw vf11, 11(vi00)
    nop                             nop                               [E] ; end: constants loaded
    nop                             nop

    ; MSCNT: one batch at XTOP; qword 0's x is its type, qword 1 a GIF tag
batch:
    nop                             xtop vi02                            ; vi02: the batch (BASE, or BASE + OFFSET: double buffer)
    nop                             iaddiu vi05, vi02, 0
    nop                             iaddiu vi03, vi02, 190               ; vi03: the output, 190 qwords after the batch
    nop                             iaddiu vi04, vi03, 0
    nop                             ilwr.x vi06, (vi05)                  ; the batch type (qword 0)
    nop                             iaddiu vi05, vi05, 1
    nop                             iaddiu vi11, vi00, 32767             ; 0x7FFF: the NLOOP mask
    nop                             lq.xyzw vf31, 0(vi05)
    nop                             ilwr.x vi08, (vi05)                  ; the GIF tag (qword 1): NLOOP, EOP
    nop                             iand vi07, vi11, vi08
    nop                             iaddiu vi05, vi05, 1
    nop                             sqi.xyzw vf31, (vi04++)
    nop                             iaddiu vi11, vi00, 1
    nop                             nop
    nop                             ibeq vi11, vi06, vertices
    nop                             nop

    ; a register block: the GIF tag and its NLOOP qwords (A+D) go through to the output
copy_regs:
    nop                             lq.xyzw vf31, 0(vi05)
    nop                             iaddi vi07, vi07, -1
    nop                             iaddiu vi05, vi05, 1
    nop                             iaddiu vi04, vi04, 1
    nop                             ibne vi07, vi00, copy_regs
    nop                             sq.xyzw vf31, -1(vi04)
    nop                             lqi.xyzw vf29, (vi05++)
    nop                             lqi.xyzw vf30, (vi05++)
    nop                             lq.xyzw vf24, 12(vi00)
    nop                             lq.xyzw vf25, 13(vi00)
    mul.xyzw vf24, vf29, vf24       lq.xyzw vf26, 14(vi00)
    mul.xyzw vf25, vf29, vf25       lq.xyzw vf27, 15(vi00)
    mul.xyzw vf26, vf29, vf26       lq.xyzw vf28, 0(vi00)
    add.xyzw vf23, vf27, vf28       loi 128.0                            ; I = 128.0: the colour clamp (0x80 is 1.0 on the GS)
    ftoi0.xyzw vf29, vf29           nop
    muli.xyzw vf12, vf24, I         nop
    muli.xyzw vf13, vf25, I         nop
    muli.xyzw vf14, vf26, I         nop
    mul.xyzw vf15, vf23, vf30       nop
    minii.xyzw vf12, vf12, I        mtir vi12, vf29w
    minii.xyzw vf13, vf13, I        nop
    minii.xyzw vf14, vf14, I        nop
    minii.xyzw vf15, vf15, I        nop
    nop                             xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             nop                               [E] ; end: the next MSCNT continues at copy_regs_cont
    nop                             nop

    ; the next MSCNT continues here
copy_regs_cont:
    nop                             b batch                              ; the next batch
    nop                             nop

    ; type 1: a strip of NLOOP vertices
vertices:
    nop                             iaddiu vi08, vi08, 2                 ; NLOOP + 2: the delay line's last vertices go out first
    nop                             isw.x vi08, -1(vi04)
    nop                             lq.xyzw vf19, 917(vi00)
    nop                             lq.xyzw vf20, 918(vi00)
    nop                             lq.xyzw vf21, 919(vi00)
    nop                             lq.xyzw vf22, 914(vi00)
    nop                             lq.xyzw vf23, 915(vi00)
    nop                             lq.xyzw vf24, 916(vi00)
    nop                             sqi.xyzw vf19, (vi04++)
    nop                             sqi.xyzw vf20, (vi04++)
    nop                             sqi.xyzw vf21, (vi04++)
    nop                             sqi.xyzw vf22, (vi04++)
    nop                             sqi.xyzw vf23, (vi04++)
    nop                             sqi.xyzw vf24, (vi04++)
    ; one vertex per pass, software-pipelined through the delay line
vertices_loop:
    nop                             ilw.w vi09, 0(vi05)                  ; vi09: the position's w word, XYZF2's w (F, ADC) as the model has it
    nop                             lq.xyzw vf29, 0(vi05)
    nop                             lq.xyzw vf30, 1(vi05)
    nop                             lq.xyzw vf31, 2(vi05)
    nop                             iaddiu vi05, vi05, 3
    mulax.xyzw ACC, vf09, vf30x     lq.xyzw vf19, 1020(vi00)
    madday.xyzw ACC, vf10, vf30y    lq.xyzw vf20, 1019(vi00)
    maddz.xyzw vf27, vf11, vf30z    lq.xyzw vf21, 1018(vi00)
    mulax.xyzw ACC, vf01, vf29x     lq.xyzw vf22, 1017(vi00)
    madday.xyzw ACC, vf02, vf29y    lq.xyzw vf23, 1016(vi00)
    maddaz.xyzw ACC, vf03, vf29z    lq.xyzw vf24, 1015(vi00)
    maddw.xyzw vf25, vf04, vf00w    sq.xyzw vf19, 1023(vi00)
    maxx.xyzw vf27, vf27, vf00x     sq.xyzw vf20, 1022(vi00)
    nop                             loi 128.0                            ; I = 128.0: the colour clamp (0x80 is 1.0 on the GS)
    nop                             sq.xyzw vf21, 1021(vi00)
    nop                             div Q, vf00w, vf25w                  ; Q = 1 / vf25.w
    mulax.xyz ACC, vf12, vf27x      sq.xyzw vf22, 1020(vi00)
    madday.xyz ACC, vf13, vf27y     sq.xyzw vf23, 1019(vi00)
    maddaz.xyz ACC, vf14, vf27z     sq.xyzw vf24, 1018(vi00)
    maddw.xyz vf27, vf15, vf00w     sq.xyzw vf31, 1015(vi00)
    nop                             move.xyz vf16, vf17
    nop                             move.xyz vf17, vf18
    mulq.xyzw vf25, vf25, Q         nop
    mulq.xyz vf26, vf31, Q          nop
    minii.xyzw vf27, vf27, I        nop
    nop                             move.xyz vf18, vf25
    ftoi4.xyzw vf25, vf25           nop                                  ; to 12.4 fixed point (GS XYZ)
    ftoi0.xyzw vf27, vf27           nop
    nop                             nop
    mulax.xyzw ACC, vf05, vf29x     sq.xyzw vf26, 0(vi04)
    madday.xyzw ACC, vf06, vf29y    nop
    maddaz.xyzw ACC, vf07, vf29z    sq.xyz vf25, 2(vi04)
    maddw.xyzw vf23, vf08, vf00w    isw.w vi12, 1(vi04)
    clipw.xyz vf19, vf19w           sq.xyz vf27, 1(vi04)                 ; clip flags: vf19.xyz against +-vf19.w
    clipw.xyz vf22, vf22w           isw.w vi12, 1016(vi00)
    clipw.xyz vf23, vf23w           sq.xyz vf27, 1016(vi00)
    nop                             sq.xyzw vf23, 1017(vi00)
    nop                             ibne vi09, vi00, vertices_skip
    nop                             nop
    nop                             fcand vi01, 0x03ffff                 ; vi01 = 1: one of the last three vertices is outside the clip volume
    nop                             ibeq vi01, vi00, vertices_in_view
    nop                             nop
    nop                             fcor vi01, 0xfdf7df
    nop                             ibne vi01, vi00, vertices_culled
    nop                             nop
    nop                             fcor vi01, 0xfefbef
    nop                             ibne vi01, vi00, vertices_culled
    nop                             nop
    nop                             fcor vi01, 0xff7df7
    nop                             ibne vi01, vi00, vertices_culled
    nop                             nop
    nop                             fcor vi01, 0xffbefb
    nop                             ibne vi01, vi00, vertices_culled
    nop                             nop
    nop                             fcor vi01, 0xffdf7d
    nop                             ibne vi01, vi00, vertices_culled
    nop                             nop
    nop                             fcor vi01, 0xffefbe
    nop                             ibne vi01, vi00, vertices_culled
    nop                             nop
    nop                             sq.xyzw vf30, 919(vi00)
    nop                             iaddiu vi15, vi00, 154
    nop                             nop
    nop                             b clip_triangle
    nop                             nop
    ; the last three vertices are all inside the clip volume
vertices_in_view:
    sub.xyz vf19, vf17, vf16        nop
    sub.xyz vf20, vf18, vf16        nop
    nop                             nop
    nop                             nop
    nop                             nop
    opmula.xyz ACC, vf20, vf19      nop
    opmsub.xyz vf20, vf19, vf20     nop
    nop                             nop
    nop                             nop
    nop                             nop
    mulw.z vf20, vf20, vf30w        nop
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             iaddiu vi01, vi00, 32
    nop                             fmand vi01, vi01
    nop                             ibeq vi01, vi00, vertices_skip
    nop                             nop
    ; the triangle is wholly outside one plane: culled
vertices_culled:
    nop                             iaddiu vi09, vi00, 32767
    nop                             iaddiu vi09, vi09, 1
vertices_skip:
    nop                             isw.w vi09, 2(vi04)
    nop                             iaddiu vi04, vi04, 3
    nop                             iaddi vi07, vi07, -1
    nop                             nop
    nop                             ibne vi07, vi00, vertices_loop
    nop                             nop
    ; the epilogue: the vertices left in the delay line
    nop                             lqd.xyzw vf19, (--vi04)
    nop                             lqd.xyzw vf20, (--vi04)
    nop                             lqd.xyzw vf21, (--vi04)
    nop                             lqd.xyzw vf22, (--vi04)
    nop                             lqd.xyzw vf23, (--vi04)
    nop                             lqd.xyzw vf24, (--vi04)
    nop                             sq.xyzw vf19, 916(vi00)
    nop                             sq.xyzw vf20, 915(vi00)
    nop                             sq.xyzw vf21, 914(vi00)
    nop                             sq.xyzw vf22, 919(vi00)
    nop                             sq.xyzw vf23, 918(vi00)
    nop                             sq.xyzw vf24, 917(vi00)
    nop                             xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             nop
    nop                             nop                               [E] ; end: the next MSCNT continues at vertices_cont
    nop                             nop

    ; the next MSCNT continues here
vertices_cont:
    nop                             b batch                              ; the next batch
    nop                             nop

    ; clip the last three vertices' triangle against the six planes of the clip volume and
    ; send what is left as a fan (the GIF tag template at VU 0x3A6)
clip_triangle:
    nop                             iaddiu vi14, vi00, 934
    nop                             sqd.xyzw vf21, (--vi14)
    nop                             sqd.xyzw vf22, (--vi14)
    nop                             sqd.xyzw vf23, (--vi14)
    nop                             sqd.xyzw vf24, (--vi14)
    nop                             sqd.xyzw vf25, (--vi14)
    nop                             sqd.xyzw vf26, (--vi14)
    nop                             sqd.xyzw vf27, (--vi14)
    nop                             sqd.xyzw vf28, (--vi14)
    nop                             sqd.xyzw vf29, (--vi14)
    nop                             sqd.xyzw vf30, (--vi14)
    nop                             sqd.xyzw vf31, (--vi14)
    nop                             isubiu vi14, vi14, 1
    nop                             iswr.x vi02, (vi14)
    nop                             iswr.y vi03, (vi14)
    nop                             iswr.z vi04, (vi14)
    nop                             iswr.w vi05, (vi14)
    nop                             isubiu vi14, vi14, 1
    nop                             iswr.x vi06, (vi14)
    nop                             iswr.y vi07, (vi14)
    nop                             iswr.z vi08, (vi14)
    nop                             iswr.w vi09, (vi14)
    nop                             isubiu vi14, vi14, 1
    nop                             iswr.x vi10, (vi14)
    nop                             iswr.y vi11, (vi14)
    nop                             iswr.z vi12, (vi14)
    nop                             iswr.w vi13, (vi14)
    nop                             iaddiu vi08, vi00, 0
    nop                             iaddiu vi09, vi00, 935
    nop                             iaddiu vi10, vi00, 975
    nop                             lq.xyzw vf23, 1022(vi00)
    nop                             lq.xyzw vf24, 1019(vi00)
    nop                             lq.xyzw vf25, 1016(vi00)
    nop                             lq.xyzw vf26, 1021(vi00)
    itof0.xyzw vf23, vf23           lq.xyzw vf27, 1018(vi00)
    itof0.xyzw vf24, vf24           lq.xyzw vf28, 1015(vi00)
    itof0.xyzw vf25, vf25           lq.xyzw vf29, 1023(vi00)
    nop                             lq.xyzw vf30, 1020(vi00)
    nop                             lq.xyzw vf31, 1017(vi00)
    nop                             sq.xyzw vf23, 1(vi09)
    nop                             sq.xyzw vf24, 4(vi09)
    nop                             sq.xyzw vf25, 7(vi09)
    nop                             sq.xyzw vf23, 10(vi09)
    nop                             sq.xyzw vf26, 2(vi09)
    nop                             sq.xyzw vf27, 5(vi09)
    nop                             sq.xyzw vf28, 8(vi09)
    nop                             sq.xyzw vf26, 11(vi09)
    nop                             sq.xyzw vf29, 0(vi09)
    nop                             sq.xyzw vf30, 3(vi09)
    nop                             sq.xyzw vf31, 6(vi09)
    nop                             sq.xyzw vf29, 9(vi09)
    nop                             iaddiu vi09, vi00, 935
    nop                             iaddiu vi10, vi00, 975
    nop                             iaddiu vi05, vi00, 2048
    nop                             iaddiu vi06, vi00, 32
    subw.x vf31, vf00, vf00w        bal vi13, first_vertex
    nop                             iaddiu vi07, vi00, 2
    nop                             iaddiu vi04, vi00, 3
    nop                             iaddiu vi11, vi00, 0
    nop                             bal vi13, clip_edges
    nop                             nop
    nop                             bal vi13, close_polygon
    nop                             iaddiu vi09, vi00, 975
    nop                             iaddiu vi09, vi00, 975
    nop                             iaddiu vi10, vi00, 935
    nop                             iaddiu vi05, vi00, 1024
    nop                             iaddiu vi06, vi00, 16
    addw.x vf31, vf00, vf00w        bal vi13, pass_start
    nop                             iaddiu vi07, vi00, 2
    nop                             bal vi13, clip_edges
    nop                             nop
    nop                             bal vi13, close_polygon
    nop                             iaddiu vi09, vi00, 935
    nop                             iaddiu vi05, vi00, 128
    nop                             iaddiu vi06, vi00, 2
    subw.x vf31, vf00, vf00w        bal vi13, pass_a_to_b
    nop                             iaddiu vi07, vi00, 0
    nop                             bal vi13, clip_edges
    nop                             nop
    nop                             bal vi13, close_polygon
    nop                             iaddiu vi09, vi00, 975
    nop                             iaddiu vi05, vi00, 64
    nop                             iaddiu vi06, vi00, 1
    addw.x vf31, vf00, vf00w        bal vi13, pass_b_to_a
    nop                             iaddiu vi07, vi00, 0
    nop                             bal vi13, clip_edges
    nop                             nop
    nop                             bal vi13, close_polygon
    nop                             iaddiu vi09, vi00, 935
    nop                             iaddiu vi05, vi00, 512
    nop                             iaddiu vi06, vi00, 8
    subw.x vf31, vf00, vf00w        bal vi13, pass_a_to_b
    nop                             iaddiu vi07, vi00, 1
    nop                             bal vi13, clip_edges
    nop                             nop
    nop                             bal vi13, close_polygon
    nop                             iaddiu vi09, vi00, 975
    nop                             iaddiu vi05, vi00, 256
    nop                             iaddiu vi06, vi00, 4
    addw.x vf31, vf00, vf00w        bal vi13, pass_b_to_a
    nop                             iaddiu vi07, vi00, 1
    nop                             bal vi13, clip_edges
    nop                             nop
    nop                             bal vi13, close_polygon
    nop                             iaddiu vi09, vi00, 935
    nop                             iaddiu vi09, vi00, 935
    nop                             iaddiu vi10, vi00, 975
    nop                             iadd vi04, vi00, vi11
    nop                             iaddiu vi11, vi00, 0
    nop                             ilwr.y vi06, (vi02)
    nop                             ilw.x vi12, 934(vi00)
    nop                             lq.xyzw vf31, 934(vi00)
    nop                             lq.xyzw vf27, 16(vi00)
    nop                             lq.xyzw vf28, 17(vi00)
    nop                             iadd vi12, vi12, vi04
    nop                             iadd vi06, vi06, vi03
    nop                             iaddiu vi02, vi06, 0
    nop                             sqi.xyzw vf31, (vi06++)
    nop                             lq.xyzw vf29, 18(vi00)
    nop                             lq.xyzw vf30, 19(vi00)
    nop                             lq.xyzw vf31, 919(vi00)
    nop                             xgkick vi02                          ; send the output to the GS (PATH1)
    nop                             nop
    nop                             nop
    nop                             iaddiu vi08, vi00, 2
    nop                             isw.x vi12, -1(vi06)
clip_triangle_loop:
    nop                             lqi.xyzw vf24, (vi09++)
    nop                             lqi.xyzw vf25, (vi09++)
    nop                             lqi.xyzw vf26, (vi09++)
    nop                             nop
    mulax.xyzw ACC, vf27, vf24x     nop
    madday.xyzw ACC, vf28, vf24y    nop
    maddaz.xyzw ACC, vf29, vf24z    nop
    maddw.xyzw vf23, vf30, vf24w    loi 128.0                            ; I = 128.0: the colour clamp (0x80 is 1.0 on the GS)
    minii.xyz vf25, vf25, I         nop
    nop                             nop
    nop                             nop
    nop                             div Q, vf00w, vf23w                  ; Q = 1 / vf23.w
    ftoi0.xyzw vf25, vf25           nop
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             sq.xyzw vf25, 1(vi06)
    nop                             iaddiu vi08, vi08, 32767             ; NLOOP + 32767: the delay line's last vertices go out first
    nop                             nop
    mulq.xyzw vf23, vf23, Q         nop
    mulq.xyz vf26, vf26, Q          iblez vi08, clip_triangle_skip
    nop                             nop
    sub.xyz vf24, vf22, vf21        nop
    sub.xyz vf25, vf23, vf21        nop
    nop                             nop
    nop                             nop
    nop                             nop
    opmula.xyz ACC, vf25, vf24      nop
    opmsub.xyz vf25, vf24, vf25     nop
    nop                             nop
    nop                             nop
    nop                             nop
    mulw.z vf25, vf25, vf31w        nop
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             iaddiu vi01, vi00, 32
    nop                             fmand vi01, vi01
    nop                             ibne vi01, vi00, clip_triangle_loop2
    nop                             nop
clip_triangle_skip:
    nop                             move.xyz vf21, vf22
    nop                             move.xyz vf22, vf23
    ftoi4.xyzw vf23, vf23           nop                                  ; to 12.4 fixed point (GS XYZ)
    nop                             nop
    nop                             sq.xyzw vf26, 0(vi06)
    nop                             iaddi vi04, vi04, -1
    nop                             sq.xyzw vf23, 2(vi06)
    nop                             ibne vi04, vi00, clip_triangle_loop
    nop                             iaddiu vi06, vi06, 3
    nop                             nop
    nop                             xgkick vi02                          ; send the output to the GS (PATH1)
    nop                             nop
clip_triangle_loop2:
    nop                             ilwr.x vi10, (vi14)
    nop                             ilwr.y vi11, (vi14)
    nop                             ilwr.z vi12, (vi14)
    nop                             ilwr.w vi13, (vi14)
    nop                             iaddiu vi14, vi14, 1
    nop                             ilwr.x vi06, (vi14)
    nop                             ilwr.y vi07, (vi14)
    nop                             ilwr.z vi08, (vi14)
    nop                             ilwr.w vi09, (vi14)
    nop                             iaddiu vi14, vi14, 1
    nop                             ilwr.x vi02, (vi14)
    nop                             ilwr.y vi03, (vi14)
    nop                             ilwr.z vi04, (vi14)
    nop                             ilwr.w vi05, (vi14)
    nop                             iaddiu vi14, vi14, 1
    nop                             lqi.xyzw vf31, (vi14++)
    nop                             lqi.xyzw vf30, (vi14++)
    nop                             lqi.xyzw vf29, (vi14++)
    nop                             lqi.xyzw vf28, (vi14++)
    nop                             lqi.xyzw vf27, (vi14++)
    nop                             lqi.xyzw vf26, (vi14++)
    nop                             lqi.xyzw vf25, (vi14++)
    nop                             lqi.xyzw vf24, (vi14++)
    nop                             lqi.xyzw vf23, (vi14++)
    nop                             lqi.xyzw vf22, (vi14++)
    nop                             lqi.xyzw vf21, (vi14++)
    nop                             jr vi15
    nop                             nop

    ; after a plane: repeat the first output vertex after the last; an empty polygon leaves
    ; (clip_triangle_exit)
close_polygon:
    nop                             lqi.xyzw vf29, (vi09++)
    nop                             lqi.xyzw vf30, (vi09++)
    nop                             lqi.xyzw vf31, (vi09++)
    nop                             nop
    nop                             sqi.xyzw vf29, (vi10++)
    nop                             sqi.xyzw vf30, (vi10++)
    nop                             ibeq vi11, vi00, clip_triangle_loop2
    nop                             sqi.xyzw vf31, (vi10++)
    nop                             jr vi13
    nop                             nop

    ; the next plane reads the polygon at VU 935.. and writes the one at 975.. (as set at
    ; clip_triangle)
pass_a_to_b:
    nop                             iaddiu vi09, vi00, 935
    nop                             b pass_start
    nop                             iaddiu vi10, vi00, 975

    ; the next plane reads the second polygon buffer and writes the first
pass_b_to_a:
    nop                             iaddiu vi09, vi00, 975
    nop                             iaddiu vi10, vi00, 935

    ; vi04: the vertices to clip; vi11: none written yet
pass_start:
    nop                             iadd vi04, vi00, vi11
    nop                             iaddiu vi11, vi00, 0

    ; load the polygon's first vertex (three qwords)
first_vertex:
    nop                             lqi.xyzw vf21, (vi09++)
    nop                             lqi.xyzw vf22, (vi09++)
    nop                             jr vi13
    nop                             lqi.xyzw vf23, (vi09++)

    ; clip the polygon's edges against one plane (vi05, vi06: its clip-flag bits; vf31.x its
    ; sign)
clip_edges:
    mulw.xyzw vf24, vf21, vf00w     lqi.xyzw vf21, (vi09++)
    mulw.xyzw vf25, vf22, vf00w     lqi.xyzw vf22, (vi09++)
    mulw.xyzw vf26, vf23, vf00w     lqi.xyzw vf23, (vi09++)
    nop                             nop
    clipw.xyz vf24, vf24w           nop                                  ; clip flags: vf24.xyz against +-vf24.w
    clipw.xyz vf21, vf21w           nop
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             fcget vi01
    nop                             nop
    nop                             iand vi12, vi01, vi05
    nop                             nop
    nop                             ibeq vi12, vi00, clip_edges_skip
    nop                             nop
    nop                             iand vi12, vi01, vi06
    nop                             nop
    nop                             ibne vi12, vi00, clip_edges_skip3
    nop                             nop
    nop                             bal vi01, intersect
    nop                             nop
    nop                             sqi.xyzw vf28, (vi10++)
    nop                             sqi.xyzw vf29, (vi10++)
    nop                             sqi.xyzw vf30, (vi10++)
    nop                             b clip_edges_skip3
    nop                             iaddiu vi11, vi11, 1
clip_edges_skip:
    nop                             iand vi12, vi01, vi06
    nop                             nop
    nop                             ibeq vi12, vi00, clip_edges_skip2
    nop                             nop
    nop                             bal vi01, intersect
    nop                             nop
    nop                             sqi.xyzw vf24, (vi10++)
    nop                             sqi.xyzw vf25, (vi10++)
    nop                             sqi.xyzw vf26, (vi10++)
    nop                             sqi.xyzw vf28, (vi10++)
    nop                             sqi.xyzw vf29, (vi10++)
    nop                             sqi.xyzw vf30, (vi10++)
    nop                             b clip_edges_skip3
    nop                             iaddiu vi11, vi11, 2
clip_edges_skip2:
    nop                             sqi.xyzw vf24, (vi10++)
    nop                             sqi.xyzw vf25, (vi10++)
    nop                             sqi.xyzw vf26, (vi10++)
    nop                             iaddiu vi11, vi11, 1
clip_edges_skip3:
    nop                             isubiu vi04, vi04, 1
    nop                             nop
    nop                             ibne vi04, vi00, clip_edges
    nop                             nop
    nop                             jr vi13
    nop                             nop

    ; an edge crosses the plane: write the intersection (position and attributes interpolated)
intersect:
    mulx.w vf28, vf24, vf31x        nop
    mulx.w vf29, vf21, vf31x        nop
    nop                             nop
    nop                             nop
    subw.xyzw vf28, vf24, vf28w     nop
    subw.xyzw vf29, vf21, vf29w     nop
    nop                             iadd vi12, vi00, vi07
    nop                             nop
intersect_loop:
    nop                             ibeq vi12, vi00, intersect_skip
    nop                             nop
    nop                             mr32.xyzw vf28, vf28
    nop                             mr32.xyzw vf29, vf29
    nop                             isubiu vi12, vi12, 1
    nop                             nop
    nop                             b intersect_loop
    nop                             nop
intersect_skip:
    sub.xyz vf30, vf29, vf28        nop
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             div Q, vf28x, vf30x
    nop                             waitq
    addq.x vf27, vf00, Q            nop
    sub.xyzw vf28, vf21, vf24       nop
    sub.xyzw vf29, vf22, vf25       nop
    sub.xyzw vf30, vf23, vf26       nop
    abs.x vf27, vf27                nop
    nop                             nop
    nop                             nop
    nop                             nop
    mulx.xyzw vf28, vf28, vf27x     nop
    mulx.xyzw vf29, vf29, vf27x     nop
    mulx.xyzw vf30, vf30, vf27x     nop
    nop                             nop
    add.xyzw vf28, vf28, vf24       nop
    add.xyzw vf29, vf29, vf25       nop
    add.xyzw vf30, vf30, vf26       nop
    nop                             nop
    nop                             jr vi01
    nop                             nop
.endprogram

;=======================================================================================
; Vu1Prog17: three lights, material colour, no vertex colours, clipped
;
; gVu1ProgInfo17 (bones.c): 438 pairs (3504 bytes), batches of up to 3040 bytes;
; Vu1_SelectProgram's key 0x282, rigid models (0x21035, 0x121035).
; Setup Vu1Pkt_LP: an UNPACK of 20 qwords to VU 0, then MSCALF 0:
;   0        colour: gGsColorF, RGB scaled by the model's brightness: vf28
;   1-4      gMtxSlots x gMtxView x gMtxProjClip: model to screen (XYZ after the divide by w): vf01-vf04
;   5-8      the matrix above x gViewportMtx: model to the clip test's space: vf05-vf08
;   9-11     light directions (model space, negated): vf09-vf11
;   12-15    light colours (three lights and the ambient): vf24-vf27
;   16-19    gMtxProj, the projection matrix: vf27-vf30
; Vertices: gVu1ProgLayouts[0], 3 qwords: position, normal, texture coordinates.
; Batches at VU 0x14 and 0x14 + 0x1ea (XTOP); the output follows each.
;=======================================================================================
.program Vu1Prog17
.base 0x14
.offset 0x1ea
.stcycl 4, 4
.unpack 0x3a6, 0x00008000, 0x302ec000, 0x00000412, 0x00000000   ; GIF tag template: EOP, PRIM 0x5d, REGS ST RGBAQ XYZF2

    ; MSCALF 0: the setup's constants into registers
init:
    nop                             lq.xyzw vf01, 1(vi00)
    nop                             lq.xyzw vf02, 2(vi00)
    nop                             lq.xyzw vf03, 3(vi00)
    nop                             lq.xyzw vf04, 4(vi00)
    nop                             lq.xyzw vf05, 5(vi00)
    nop                             lq.xyzw vf06, 6(vi00)
    nop                             lq.xyzw vf07, 7(vi00)
    nop                             lq.xyzw vf08, 8(vi00)
    nop                             lq.xyzw vf09, 9(vi00)
    nop                             lq.xyzw vf10, 10(vi00)
    nop                             lq.xyzw vf11, 11(vi00)
    nop                             nop                               [E] ; end: constants loaded
    nop                             nop

    ; MSCNT: one batch at XTOP; qword 0's x is its type, qword 1 a GIF tag
batch:
    nop                             xtop vi02                            ; vi02: the batch (BASE, or BASE + OFFSET: double buffer)
    nop                             iaddiu vi05, vi02, 0
    nop                             iaddiu vi03, vi02, 190               ; vi03: the output, 190 qwords after the batch
    nop                             ilwr.x vi06, (vi05)                  ; the batch type (qword 0)
    nop                             iaddiu vi05, vi05, 1
    nop                             ilwr.x vi08, (vi05)                  ; the GIF tag (qword 1): NLOOP, EOP
    nop                             iaddiu vi04, vi03, 0
    nop                             iaddiu vi11, vi00, 32767             ; 0x7FFF: the NLOOP mask
    nop                             lq.xyzw vf31, 0(vi05)
    nop                             iand vi07, vi11, vi08
    nop                             iaddiu vi11, vi00, 1
    nop                             iaddiu vi05, vi05, 1
    nop                             ibeq vi11, vi06, vertices
    nop                             sqi.xyzw vf31, (vi04++)

    ; a register block: the GIF tag and its NLOOP qwords (A+D) go through to the output
copy_regs:
    nop                             lq.xyzw vf31, 0(vi05)
    nop                             iaddi vi07, vi07, -1
    nop                             iaddiu vi05, vi05, 1
    nop                             iaddiu vi04, vi04, 1
    nop                             ibne vi07, vi00, copy_regs
    nop                             sq.xyzw vf31, -1(vi04)
    nop                             lq.xyzw vf24, 12(vi00)
    nop                             lq.xyzw vf25, 13(vi00)
    nop                             lq.xyzw vf26, 14(vi00)
    nop                             lq.xyzw vf27, 15(vi00)
    nop                             lq.xyzw vf28, 0(vi00)
    nop                             lqi.xyzw vf29, (vi05++)
    nop                             lqi.xyzw vf30, (vi05++)
    nop                             nop
    nop                             nop
    mul.xyzw vf24, vf29, vf24       nop
    mul.xyzw vf25, vf29, vf25       nop
    mul.xyzw vf26, vf29, vf26       nop
    add.xyzw vf23, vf27, vf28       nop
    ftoi0.xyzw vf29, vf29           nop
    nop                             loi 128.0                            ; I = 128.0: the colour clamp (0x80 is 1.0 on the GS)
    muli.xyzw vf12, vf24, I         nop
    muli.xyzw vf13, vf25, I         nop
    muli.xyzw vf14, vf26, I         nop
    mul.xyzw vf15, vf23, vf30       nop
    nop                             mtir vi12, vf29w
    minii.xyzw vf12, vf12, I        nop
    minii.xyzw vf13, vf13, I        nop
    minii.xyzw vf14, vf14, I        nop
    minii.xyzw vf15, vf15, I        nop
    nop                             xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             nop                               [E] ; end: the next MSCNT continues at copy_regs_cont
    nop                             nop

    ; the next MSCNT continues here
copy_regs_cont:
    nop                             b batch                              ; the next batch
    nop                             nop

    ; type 1: a strip of NLOOP vertices
vertices:
    nop                             iaddiu vi08, vi08, 2                 ; NLOOP + 2: the delay line's last vertices go out first
    nop                             isw.x vi08, -1(vi04)
    nop                             loi 128.0                            ; I = 128.0: the colour clamp (0x80 is 1.0 on the GS)
    nop                             lq.xyzw vf16, 917(vi00)
    nop                             lq.xyzw vf17, 918(vi00)
    nop                             lq.xyzw vf18, 919(vi00)
    nop                             lq.xyzw vf19, 914(vi00)
    nop                             lq.xyzw vf20, 915(vi00)
    nop                             lq.xyzw vf21, 916(vi00)
    nop                             sqi.xyzw vf16, (vi04++)
    nop                             lq.xyzw vf29, 0(vi05)
    nop                             sqi.xyzw vf17, (vi04++)
    nop                             sqi.xyzw vf18, (vi04++)
    nop                             sqi.xyzw vf19, (vi04++)
    mulax.xyzw ACC, vf01, vf29x     sqi.xyzw vf20, (vi04++)
    madday.xyzw ACC, vf02, vf29y    sqi.xyzw vf21, (vi04++)
    maddaz.xyzw ACC, vf03, vf29z    lq.xyzw vf30, 1(vi05)
    maddw.xyzw vf25, vf04, vf00w    ilw.w vi09, 0(vi05)                  ; vi09: the position's w word, XYZF2's w (F, ADC) as the model has it
    ; one vertex per pass, software-pipelined through the delay line
vertices_loop:
    nop                             iaddiu vi04, vi04, 3
    nop                             lq.xyzw vf21, 1015(vi00)
    mulax.xyz ACC, vf09, vf30x      iaddiu vi05, vi05, 3
    madday.xyz ACC, vf10, vf30y     iaddi vi07, vi07, -1
    maddz.xyz vf26, vf11, vf30z     iaddiu vi14, vi09, 0
    nop                             ilw.w vi09, 0(vi05)
    nop                             isw.w vi12, 1016(vi00)
    mulax.xyzw ACC, vf05, vf29x     lq.xyzw vf19, 1017(vi00)
    maxx.xyz vf26, vf26, vf00x      lq.xyzw vf16, 1020(vi00)
    madday.xyzw ACC, vf06, vf29y    div Q, vf00w, vf25w                  ; Q = 1 / vf25.w
    maddaz.xyzw ACC, vf07, vf29z    lq.xyzw vf20, 1016(vi00)
    maddw.xyzw vf23, vf08, vf00w    lq.xyzw vf17, 1019(vi00)
    mulax.xyz ACC, vf12, vf26x      lq.xyzw vf18, 1018(vi00)
    madday.xyz ACC, vf13, vf26y     lq.xyzw vf31, -1(vi05)
    maddaz.xyz ACC, vf14, vf26z     sq.xyzw vf20, 1019(vi00)
    maddw.xyz vf27, vf15, vf00w     sq.xyzw vf17, 1022(vi00)
    mulq.xyzw vf25, vf25, Q         sq.xyzw vf18, 1021(vi00)
    nop                             sq.xyzw vf31, 1015(vi00)
    nop                             lq.xyzw vf30, 1(vi05)
    minii.xyzw vf27, vf27, I        sq.xyzw vf16, 1023(vi00)
    ftoi4.xyzw vf25, vf25           sq.xyzw vf19, 1020(vi00)             ; to 12.4 fixed point (GS XYZ)
    mulq.xyz vf28, vf31, Q          sq.xyzw vf23, 1017(vi00)
    clipw.xyz vf16, vf16w           lq.xyzw vf29, 0(vi05)                ; clip flags: vf16.xyz against +-vf16.w
    ftoi0.xyz vf27, vf27            sq.xyzw vf21, 1018(vi00)
    clipw.xyz vf19, vf19w           sq.xyz vf25, -1(vi04)
    clipw.xyz vf23, vf23w           sq.xyzw vf28, -3(vi04)
    mulax.xyzw ACC, vf01, vf29x     isw.w vi12, -2(vi04)
    madday.xyzw ACC, vf02, vf29y    sq.xyz vf27, 1016(vi00)
    maddaz.xyzw ACC, vf03, vf29z    ibne vi14, vi00, vertices_in_view
    maddw.xyzw vf25, vf04, vf00w    sq.xyz vf27, -2(vi04)
    nop                             fcand vi01, 0x03ffff                 ; vi01 = 1: one of the last three vertices is outside the clip volume
    nop                             ibeq vi01, vi00, vertices_in_view
    nop                             nop
    nop                             ibne vi14, vi00, vertices_in_view
    nop                             fcor vi01, 0xfdf7df
    nop                             ibne vi01, vi00, vertices_culled
    nop                             fcor vi01, 0xfefbef
    nop                             ibne vi01, vi00, vertices_culled
    nop                             fcor vi01, 0xff7df7
    nop                             ibne vi01, vi00, vertices_culled
    nop                             fcor vi01, 0xffbefb
    nop                             ibne vi01, vi00, vertices_culled
    nop                             fcor vi01, 0xffdf7d
    nop                             ibne vi01, vi00, vertices_culled
    nop                             fcor vi01, 0xffefbe
    nop                             ibne vi01, vi00, vertices_culled
    nop                             nop
    nop                             bal vi15, clip_triangle
    nop                             nop
    ; the triangle is wholly outside one plane: culled
vertices_culled:
    nop                             iaddiu vi14, vi00, 32767             ; ADC: 0x7FFF + 1 = 0x8000, so the GS draws no triangle ending here
    nop                             iaddiu vi14, vi14, 1
    ; the last three vertices are all inside the clip volume
vertices_in_view:
    nop                             ibne vi07, vi00, vertices_loop
    nop                             isw.w vi14, -1(vi04)
    ; the epilogue: the vertices left in the delay line
    nop                             lqd.xyzw vf16, (--vi04)
    nop                             lqd.xyzw vf17, (--vi04)
    nop                             lqd.xyzw vf18, (--vi04)
    nop                             lqd.xyzw vf19, (--vi04)
    nop                             lqd.xyzw vf20, (--vi04)
    nop                             lqd.xyzw vf21, (--vi04)
    nop                             sq.xyzw vf16, 916(vi00)
    nop                             sq.xyzw vf17, 915(vi00)
    nop                             sq.xyzw vf18, 914(vi00)
    nop                             sq.xyzw vf19, 919(vi00)
    nop                             sq.xyzw vf20, 918(vi00)
    nop                             sq.xyzw vf21, 917(vi00)
    nop                             xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             nop                               [E] ; end: the next MSCNT continues at vertices_cont
    nop                             nop

    ; the next MSCNT continues here
vertices_cont:
    nop                             b batch                              ; the next batch
    nop                             nop

    ; clip the last three vertices' triangle against the six planes of the clip volume and
    ; send what is left as a fan (the GIF tag template at VU 0x3A6)
clip_triangle:
    nop                             iaddiu vi14, vi00, 934
    nop                             sqd.xyzw vf21, (--vi14)
    nop                             sqd.xyzw vf22, (--vi14)
    nop                             sqd.xyzw vf23, (--vi14)
    nop                             sqd.xyzw vf24, (--vi14)
    nop                             sqd.xyzw vf25, (--vi14)
    nop                             sqd.xyzw vf26, (--vi14)
    nop                             sqd.xyzw vf27, (--vi14)
    nop                             sqd.xyzw vf28, (--vi14)
    nop                             sqd.xyzw vf29, (--vi14)
    nop                             sqd.xyzw vf30, (--vi14)
    nop                             sqd.xyzw vf31, (--vi14)
    nop                             isubiu vi14, vi14, 1
    nop                             iswr.x vi02, (vi14)
    nop                             iswr.y vi03, (vi14)
    nop                             iswr.z vi04, (vi14)
    nop                             iswr.w vi05, (vi14)
    nop                             isubiu vi14, vi14, 1
    nop                             iswr.x vi06, (vi14)
    nop                             iswr.y vi07, (vi14)
    nop                             iswr.z vi08, (vi14)
    nop                             iswr.w vi09, (vi14)
    nop                             isubiu vi14, vi14, 1
    nop                             iswr.x vi10, (vi14)
    nop                             iswr.y vi11, (vi14)
    nop                             iswr.z vi12, (vi14)
    nop                             iswr.w vi13, (vi14)
    nop                             iaddiu vi08, vi00, 0
    nop                             iaddiu vi09, vi00, 935
    nop                             iaddiu vi10, vi00, 975
    nop                             lq.xyzw vf23, 1022(vi00)
    nop                             lq.xyzw vf24, 1019(vi00)
    nop                             lq.xyzw vf25, 1016(vi00)
    nop                             lq.xyzw vf26, 1021(vi00)
    itof0.xyzw vf23, vf23           lq.xyzw vf27, 1018(vi00)
    itof0.xyzw vf24, vf24           lq.xyzw vf28, 1015(vi00)
    itof0.xyzw vf25, vf25           lq.xyzw vf29, 1023(vi00)
    nop                             lq.xyzw vf30, 1020(vi00)
    nop                             lq.xyzw vf31, 1017(vi00)
    nop                             sq.xyzw vf23, 1(vi09)
    nop                             sq.xyzw vf24, 4(vi09)
    nop                             sq.xyzw vf25, 7(vi09)
    nop                             sq.xyzw vf23, 10(vi09)
    nop                             sq.xyzw vf26, 2(vi09)
    nop                             sq.xyzw vf27, 5(vi09)
    nop                             sq.xyzw vf28, 8(vi09)
    nop                             sq.xyzw vf26, 11(vi09)
    nop                             sq.xyzw vf29, 0(vi09)
    nop                             sq.xyzw vf30, 3(vi09)
    nop                             sq.xyzw vf31, 6(vi09)
    nop                             sq.xyzw vf29, 9(vi09)
    nop                             iaddiu vi09, vi00, 935
    nop                             iaddiu vi10, vi00, 975
    nop                             iaddiu vi05, vi00, 2048
    nop                             iaddiu vi06, vi00, 32
    subw.x vf31, vf00, vf00w        bal vi13, first_vertex
    nop                             iaddiu vi07, vi00, 2
    nop                             iaddiu vi04, vi00, 3
    nop                             iaddiu vi11, vi00, 0
    nop                             bal vi13, clip_edges
    nop                             nop
    nop                             bal vi13, close_polygon
    nop                             iaddiu vi09, vi00, 975
    nop                             iaddiu vi09, vi00, 975
    nop                             iaddiu vi10, vi00, 935
    nop                             iaddiu vi05, vi00, 1024
    nop                             iaddiu vi06, vi00, 16
    addw.x vf31, vf00, vf00w        bal vi13, pass_start
    nop                             iaddiu vi07, vi00, 2
    nop                             bal vi13, clip_edges
    nop                             nop
    nop                             bal vi13, close_polygon
    nop                             iaddiu vi09, vi00, 935
    nop                             iaddiu vi05, vi00, 128
    nop                             iaddiu vi06, vi00, 2
    subw.x vf31, vf00, vf00w        bal vi13, pass_a_to_b
    nop                             iaddiu vi07, vi00, 0
    nop                             bal vi13, clip_edges
    nop                             nop
    nop                             bal vi13, close_polygon
    nop                             iaddiu vi09, vi00, 975
    nop                             iaddiu vi05, vi00, 64
    nop                             iaddiu vi06, vi00, 1
    addw.x vf31, vf00, vf00w        bal vi13, pass_b_to_a
    nop                             iaddiu vi07, vi00, 0
    nop                             bal vi13, clip_edges
    nop                             nop
    nop                             bal vi13, close_polygon
    nop                             iaddiu vi09, vi00, 935
    nop                             iaddiu vi05, vi00, 512
    nop                             iaddiu vi06, vi00, 8
    subw.x vf31, vf00, vf00w        bal vi13, pass_a_to_b
    nop                             iaddiu vi07, vi00, 1
    nop                             bal vi13, clip_edges
    nop                             nop
    nop                             bal vi13, close_polygon
    nop                             iaddiu vi09, vi00, 975
    nop                             iaddiu vi05, vi00, 256
    nop                             iaddiu vi06, vi00, 4
    addw.x vf31, vf00, vf00w        bal vi13, pass_b_to_a
    nop                             iaddiu vi07, vi00, 1
    nop                             bal vi13, clip_edges
    nop                             nop
    nop                             bal vi13, close_polygon
    nop                             iaddiu vi09, vi00, 935
    nop                             iaddiu vi09, vi00, 935
    nop                             iaddiu vi10, vi00, 975
    nop                             iadd vi04, vi00, vi11
    nop                             iaddiu vi11, vi00, 0
    nop                             ilw.x vi12, 934(vi00)
    nop                             ilwr.y vi06, (vi02)
    nop                             lq.xyzw vf31, 934(vi00)
    nop                             lq.xyzw vf27, 16(vi00)
    nop                             lq.xyzw vf28, 17(vi00)
    nop                             iadd vi12, vi12, vi04
    nop                             iadd vi06, vi06, vi03
    nop                             iaddiu vi02, vi06, 0
    nop                             sqi.xyzw vf31, (vi06++)
    nop                             lq.xyzw vf29, 18(vi00)
    nop                             lq.xyzw vf30, 19(vi00)
    nop                             xgkick vi02                          ; send the output to the GS (PATH1)
    nop                             nop
    nop                             isw.x vi12, -1(vi06)
clip_triangle_loop:
    nop                             lqi.xyzw vf24, (vi09++)
    nop                             lqi.xyzw vf25, (vi09++)
    nop                             lqi.xyzw vf26, (vi09++)
    nop                             nop
    mulax.xyzw ACC, vf27, vf24x     nop
    madday.xyzw ACC, vf28, vf24y    nop
    maddaz.xyzw ACC, vf29, vf24z    nop
    maddw.xyzw vf23, vf30, vf24w    loi 128.0                            ; I = 128.0: the colour clamp (0x80 is 1.0 on the GS)
    minii.xyz vf25, vf25, I         nop
    nop                             nop
    nop                             nop
    nop                             div Q, vf00w, vf23w                  ; Q = 1 / vf23.w
    ftoi0.xyzw vf25, vf25           waitq
    mulq.xyzw vf23, vf23, Q         nop
    mulq.xyz vf26, vf26, Q          nop
    nop                             nop
    nop                             iaddi vi04, vi04, -1
    ftoi4.xyzw vf23, vf23           iaddiu vi06, vi06, 3                 ; to 12.4 fixed point (GS XYZ)
    nop                             sq.xyzw vf26, -3(vi06)
    nop                             sq.xyzw vf25, -2(vi06)
    nop                             ibne vi04, vi00, clip_triangle_loop
    nop                             sq.xyzw vf23, -1(vi06)
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             xgkick vi02                          ; send the output to the GS (PATH1)
clip_triangle_exit:
    nop                             ilwr.x vi10, (vi14)
    nop                             ilwr.y vi11, (vi14)
    nop                             ilwr.z vi12, (vi14)
    nop                             ilwr.w vi13, (vi14)
    nop                             iaddiu vi14, vi14, 1
    nop                             ilwr.x vi06, (vi14)
    nop                             ilwr.y vi07, (vi14)
    nop                             ilwr.z vi08, (vi14)
    nop                             ilwr.w vi09, (vi14)
    nop                             iaddiu vi14, vi14, 1
    nop                             ilwr.x vi02, (vi14)
    nop                             ilwr.y vi03, (vi14)
    nop                             ilwr.z vi04, (vi14)
    nop                             ilwr.w vi05, (vi14)
    nop                             iaddiu vi14, vi14, 1
    nop                             lqi.xyzw vf31, (vi14++)
    nop                             lqi.xyzw vf30, (vi14++)
    nop                             lqi.xyzw vf29, (vi14++)
    nop                             lqi.xyzw vf28, (vi14++)
    nop                             lqi.xyzw vf27, (vi14++)
    nop                             lqi.xyzw vf26, (vi14++)
    nop                             lqi.xyzw vf25, (vi14++)
    nop                             lqi.xyzw vf24, (vi14++)
    nop                             lqi.xyzw vf23, (vi14++)
    nop                             lqi.xyzw vf22, (vi14++)
    nop                             lqi.xyzw vf21, (vi14++)
    nop                             jr vi15
    nop                             nop

    ; after a plane: repeat the first output vertex after the last; an empty polygon leaves
    ; (clip_triangle_exit)
close_polygon:
    nop                             lqi.xyzw vf29, (vi09++)
    nop                             lqi.xyzw vf30, (vi09++)
    nop                             lqi.xyzw vf31, (vi09++)
    nop                             nop
    nop                             sqi.xyzw vf29, (vi10++)
    nop                             sqi.xyzw vf30, (vi10++)
    nop                             ibeq vi11, vi00, clip_triangle_exit
    nop                             sqi.xyzw vf31, (vi10++)
    nop                             jr vi13
    nop                             nop

    ; the next plane reads the polygon at VU 935.. and writes the one at 975.. (as set at
    ; clip_triangle)
pass_a_to_b:
    nop                             iaddiu vi09, vi00, 935
    nop                             b pass_start
    nop                             iaddiu vi10, vi00, 975

    ; the next plane reads the second polygon buffer and writes the first
pass_b_to_a:
    nop                             iaddiu vi09, vi00, 975
    nop                             iaddiu vi10, vi00, 935

    ; vi04: the vertices to clip; vi11: none written yet
pass_start:
    nop                             iadd vi04, vi00, vi11
    nop                             iaddiu vi11, vi00, 0

    ; load the polygon's first vertex (three qwords)
first_vertex:
    nop                             lqi.xyzw vf21, (vi09++)
    nop                             lqi.xyzw vf22, (vi09++)
    nop                             jr vi13
    nop                             lqi.xyzw vf23, (vi09++)

    ; clip the polygon's edges against one plane (vi05, vi06: its clip-flag bits; vf31.x its
    ; sign)
clip_edges:
    mulw.xyzw vf24, vf21, vf00w     lqi.xyzw vf21, (vi09++)
    mulw.xyzw vf25, vf22, vf00w     lqi.xyzw vf22, (vi09++)
    mulw.xyzw vf26, vf23, vf00w     lqi.xyzw vf23, (vi09++)
    nop                             nop
    clipw.xyz vf24, vf24w           nop                                  ; clip flags: vf24.xyz against +-vf24.w
    clipw.xyz vf21, vf21w           nop
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             fcget vi01
    nop                             nop
    nop                             iand vi12, vi01, vi05
    nop                             nop
    nop                             ibeq vi12, vi00, clip_edges_skip
    nop                             nop
    nop                             iand vi12, vi01, vi06
    nop                             nop
    nop                             ibne vi12, vi00, clip_edges_skip3
    nop                             nop
    nop                             bal vi01, intersect
    nop                             nop
    nop                             sqi.xyzw vf28, (vi10++)
    nop                             sqi.xyzw vf29, (vi10++)
    nop                             sqi.xyzw vf30, (vi10++)
    nop                             b clip_edges_skip3
    nop                             iaddiu vi11, vi11, 1
clip_edges_skip:
    nop                             iand vi12, vi01, vi06
    nop                             nop
    nop                             ibeq vi12, vi00, clip_edges_skip2
    nop                             nop
    nop                             bal vi01, intersect
    nop                             nop
    nop                             sqi.xyzw vf24, (vi10++)
    nop                             sqi.xyzw vf25, (vi10++)
    nop                             sqi.xyzw vf26, (vi10++)
    nop                             sqi.xyzw vf28, (vi10++)
    nop                             sqi.xyzw vf29, (vi10++)
    nop                             sqi.xyzw vf30, (vi10++)
    nop                             b clip_edges_skip3
    nop                             iaddiu vi11, vi11, 2
clip_edges_skip2:
    nop                             sqi.xyzw vf24, (vi10++)
    nop                             sqi.xyzw vf25, (vi10++)
    nop                             sqi.xyzw vf26, (vi10++)
    nop                             iaddiu vi11, vi11, 1
clip_edges_skip3:
    nop                             isubiu vi04, vi04, 1
    nop                             nop
    nop                             ibne vi04, vi00, clip_edges
    nop                             nop
    nop                             jr vi13
    nop                             nop

    ; an edge crosses the plane: write the intersection (position and attributes interpolated)
intersect:
    mulx.w vf28, vf24, vf31x        nop
    mulx.w vf29, vf21, vf31x        nop
    nop                             nop
    nop                             nop
    subw.xyzw vf28, vf24, vf28w     nop
    subw.xyzw vf29, vf21, vf29w     nop
    nop                             iadd vi12, vi00, vi07
    nop                             nop
intersect_loop:
    nop                             ibeq vi12, vi00, intersect_skip
    nop                             nop
    nop                             mr32.xyzw vf28, vf28
    nop                             mr32.xyzw vf29, vf29
    nop                             isubiu vi12, vi12, 1
    nop                             nop
    nop                             b intersect_loop
    nop                             nop
intersect_skip:
    sub.xyz vf30, vf29, vf28        nop
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             div Q, vf28x, vf30x
    nop                             waitq
    addq.x vf27, vf00, Q            nop
    sub.xyzw vf28, vf21, vf24       nop
    sub.xyzw vf29, vf22, vf25       nop
    sub.xyzw vf30, vf23, vf26       nop
    abs.x vf27, vf27                nop
    nop                             nop
    nop                             nop
    nop                             nop
    mulx.xyzw vf28, vf28, vf27x     nop
    mulx.xyzw vf29, vf29, vf27x     nop
    mulx.xyzw vf30, vf30, vf27x     nop
    nop                             nop
    add.xyzw vf28, vf28, vf24       nop
    add.xyzw vf29, vf29, vf25       nop
    add.xyzw vf30, vf30, vf26       nop
    nop                             nop
    nop                             jr vi01
    nop                             nop
.endprogram

;=======================================================================================
; Vu1Prog18: three lights, material colour, no vertex colours, fog
;
; gVu1ProgInfo18 (bones.c): 119 pairs (952 bytes), batches of up to 3968 bytes;
; Vu1_SelectProgram's key 0x8202, rigid models (0x21035, 0x121035).
; Setup Vu1Pkt_LD: an UNPACK of 17 qwords to VU 0, then MSCALF 0:
;   0        colour: gGsColorF, RGB scaled by the model's brightness: vf28
;   1-4      gMtxSlots x gMtxView x gMtxProjClip: model to screen (XYZ after the divide by w): vf01-vf04
;   5-8      the matrix above x gViewportMtx: model to the clip test's space: vf05-vf08
;   9-11     light directions (model space, negated): vf09-vf11
;   12-15    light colours (three lights and the ambient): vf24-vf27
;   16       fog range: gGsFogFar and the word after it: vf16
; Vertices: gVu1ProgLayouts[0], 3 qwords: position, normal, texture coordinates.
; Batches at VU 0x11 and 0x11 + 0x1f7 (XTOP); the output follows each.
;=======================================================================================
.program Vu1Prog18
.base 0x11
.offset 0x1f7

    ; MSCALF 0: the setup's constants into registers
init:
    nop                             lq.xyzw vf01, 1(vi00)
    nop                             lq.xyzw vf02, 2(vi00)
    nop                             lq.xyzw vf03, 3(vi00)
    nop                             lq.xyzw vf04, 4(vi00)
    nop                             lq.xyzw vf05, 5(vi00)
    nop                             lq.xyzw vf06, 6(vi00)
    nop                             lq.xyzw vf07, 7(vi00)
    nop                             lq.xyzw vf08, 8(vi00)
    nop                             lq.xyzw vf09, 9(vi00)
    nop                             lq.xyzw vf10, 10(vi00)
    nop                             lq.xyzw vf11, 11(vi00)
    nop                             lq.xyzw vf16, 16(vi00)
    nop                             nop                               [E] ; end: constants loaded
    nop                             nop

    ; MSCNT: one batch at XTOP; qword 0's x is its type, qword 1 a GIF tag
batch:
    nop                             xtop vi02                            ; vi02: the batch (BASE, or BASE + OFFSET: double buffer)
    nop                             iaddiu vi05, vi02, 0
    nop                             iaddiu vi03, vi02, 248               ; vi03: the output, 248 qwords after the batch
    nop                             ilwr.x vi06, (vi05)                  ; the batch type (qword 0)
    nop                             iaddiu vi05, vi05, 1
    nop                             ilwr.x vi08, (vi05)                  ; the GIF tag (qword 1): NLOOP, EOP
    nop                             iaddiu vi04, vi03, 0
    nop                             iaddiu vi11, vi00, 32767             ; 0x7FFF: the NLOOP mask
    nop                             lq.xyzw vf31, 0(vi05)
    nop                             iand vi07, vi11, vi08
    nop                             iaddiu vi11, vi00, 1
    nop                             iaddiu vi05, vi05, 1
    nop                             ibeq vi11, vi06, vertices
    nop                             sqi.xyzw vf31, (vi04++)

    ; a register block: the GIF tag and its NLOOP qwords (A+D) go through to the output
copy_regs:
    nop                             lqi.xyzw vf30, (vi05++)
    nop                             iaddi vi07, vi07, -1
    nop                             iaddiu vi04, vi04, 1
    nop                             ibne vi07, vi00, copy_regs
    nop                             sq.xyzw vf30, -1(vi04)
    nop                             lq.xyzw vf28, 0(vi00)
    nop                             lqi.xyzw vf29, (vi05++)
    nop                             lq.xyzw vf24, 12(vi00)
    nop                             lq.xyzw vf25, 13(vi00)
    nop                             lq.xyzw vf26, 14(vi00)
    nop                             lq.xyzw vf27, 15(vi00)
    mul.xyzw vf24, vf29, vf24       nop
    mul.xyzw vf25, vf29, vf25       lqi.xyzw vf30, (vi05++)
    mul.xyzw vf26, vf29, vf26       nop
    add.xyzw vf23, vf27, vf28       nop
    ftoi0.xyzw vf29, vf29           loi 128.0                            ; I = 128.0: the colour clamp (0x80 is 1.0 on the GS)
    muli.xyzw vf12, vf24, I         nop
    muli.xyzw vf13, vf25, I         nop
    muli.xyzw vf14, vf26, I         nop
    mul.xyzw vf15, vf23, vf30       mtir vi15, vf29w
    minii.xyzw vf12, vf12, I        nop
    minii.xyzw vf13, vf13, I        nop
    minii.xyzw vf14, vf14, I        nop
    minii.xyzw vf15, vf15, I        xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             nop                               [E] ; end: the next MSCNT continues at copy_regs_cont
    nop                             nop

    ; the next MSCNT continues here
copy_regs_cont:
    nop                             b batch                              ; the next batch
    nop                             nop

    ; type 1: a strip of NLOOP vertices
vertices:
    nop                             lq.xyzw vf29, 0(vi05)
    nop                             iaddiu vi08, vi08, 2                 ; NLOOP + 2: the delay line's last vertices go out first
    nop                             isw.x vi08, -1(vi04)
    nop                             ilw.w vi09, 0(vi05)                  ; vi09: the position's w word, XYZF2's w (F, ADC) as the model has it
    mulax.xyzw ACC, vf01, vf29x     lq.xyzw vf30, 1(vi05)
    madday.xyzw ACC, vf02, vf29y    lq.xyzw vf31, 2(vi05)
    maddaz.xyzw ACC, vf03, vf29z    iaddiu vi05, vi05, 3
    maddw.xyzw vf25, vf04, vf00w    nop
    mulax.xyzw ACC, vf09, vf30x     nop
    madday.xyzw ACC, vf10, vf30y    nop
    ; one vertex per pass, software-pipelined through the delay line
vertices_loop:
    maddz.xyzw vf26, vf11, vf30z    lq.xyzw vf17, 1021(vi00)
    subw.x vf23, vf16, vf25w        div Q, vf00w, vf25w                  ; Q = 1 / vf25.w
    mulax.xyzw ACC, vf05, vf29x     lq.xyzw vf18, 1022(vi00)
    madday.xyzw ACC, vf06, vf29y    lq.xyzw vf19, 1023(vi00)
    maxx.xyzw vf26, vf26, vf00x     lq.xyzw vf20, 1018(vi00)
    muly.x vf23, vf23, vf16y        lq.xyzw vf21, 1019(vi00)
    maddaz.xyzw ACC, vf07, vf29z    lq.xyzw vf22, 1020(vi00)
    maddw.xyzw vf27, vf08, vf00w    sqi.xyzw vf17, (vi04++)
    mulax.xyzw ACC, vf12, vf26x     loi 255.0                            ; I = 255.0
    muli.x vf23, vf23, I            sqi.xyzw vf18, (vi04++)
    madday.xyzw ACC, vf13, vf26y    sqi.xyzw vf19, (vi04++)
    maddz.xyzw vf26, vf14, vf26z    sq.xyzw vf20, 1021(vi00)
    clipw.xyz vf27, vf27w           sq.xyzw vf21, 1022(vi00)             ; clip flags: vf27.xyz against +-vf27.w
    minii.x vf23, vf23, I           sq.xyzw vf22, 1023(vi00)
    mulq.xyz vf25, vf25, Q          lq.xyzw vf29, 0(vi05)
    add.xyzw vf26, vf26, vf15       iaddiu vi14, vi09, 0
    mulq.xyz vf28, vf31, Q          fcand vi01, 0x03ffff                 ; vi01 = 1: one of the last three vertices is outside the clip volume
    maxx.x vf23, vf23, vf00x        ibeq vi01, vi00, vertices_in_view
    ftoi4.xyz vf25, vf25            loi 128.0                            ; I = 128.0: the colour clamp (0x80 is 1.0 on the GS)
    nop                             iaddiu vi14, vi00, 32767             ; ADC: 0x7FFF + 1 = 0x8000, so the GS draws no triangle ending here
    nop                             iaddiu vi14, vi14, 1
    ; the last three vertices are all inside the clip volume
vertices_in_view:
    minii.xyzw vf26, vf26, I        ilw.w vi09, 0(vi05)
    mulax.xyzw ACC, vf01, vf29x     sq.xyzw vf28, 1018(vi00)
    ftoi4.x vf23, vf23              lq.xyzw vf30, 1(vi05)
    madday.xyzw ACC, vf02, vf29y    sq.xyz vf25, 1020(vi00)
    ftoi0.xyzw vf26, vf26           isw.w vi15, 1019(vi00)
    maddaz.xyzw ACC, vf03, vf29z    iaddi vi07, vi07, -1
    maddw.xyzw vf25, vf04, vf00w    mtir vi13, vf23x
    mulax.xyzw ACC, vf09, vf30x     lq.xyzw vf31, 2(vi05)
    madday.xyzw ACC, vf10, vf30y    sq.xyz vf26, 1019(vi00)
    nop                             iaddiu vi05, vi05, 3
    nop                             iadd vi14, vi14, vi13
    nop                             ibne vi07, vi00, vertices_loop
    nop                             isw.w vi14, 1020(vi00)
    ; the epilogue: the vertices left in the delay line
    nop                             lq.xyzw vf17, 1021(vi00)
    nop                             lq.xyzw vf18, 1022(vi00)
    nop                             lq.xyzw vf19, 1023(vi00)
    nop                             lq.xyzw vf20, 1018(vi00)
    nop                             lq.xyzw vf21, 1019(vi00)
    nop                             lq.xyzw vf22, 1020(vi00)
    nop                             sqi.xyzw vf17, (vi04++)
    nop                             sqi.xyzw vf18, (vi04++)
    nop                             sqi.xyzw vf19, (vi04++)
    nop                             sqi.xyzw vf20, (vi04++)
    nop                             sqi.xyzw vf21, (vi04++)
    nop                             sqi.xyzw vf22, (vi04++)
    nop                             nop
    nop                             nop
    nop                             nop
    nop                             xgkick vi03                       [E] ; end: the next MSCNT continues at vertices_cont
    nop                             nop

    ; the next MSCNT continues here
vertices_cont:
    nop                             b batch                              ; the next batch
    nop                             nop
.endprogram

;=======================================================================================
; Vu1Prog19: skinned, three lights, material colour, no vertex colours, fog
;
; gVu1ProgInfo19 (bones.c): 372 pairs (2976 bytes), batches of up to 3200 bytes;
; Vu1_SelectProgram's key 0x8202, skinned models (0x321135, 0x221135).
; Setup Vu1Pkt_SLD: an UNPACK of 241 qwords to VU 0, then MSCALF 0:
;   0        colour: gGsColorF, RGB scaled by the model's brightness: vf28
;   1-4      gMtxView x gMtxProjClip: world to screen (XYZ after the divide by w): vf01-vf04
;   5-8      gMtxView x gViewportMtx: world to the clip test's space: vf05-vf08
;   9-11     light directions (world space, negated): vf01-vf03
;   12-15    light colours (three lights and the ambient): vf24-vf27
;   16       fog range: gGsFogFar and the word after it: vf16
;   17-144   bone matrices: the 32 gMtxSlots the model's mask (e+0x54) selects
; Vertices: gVu1ProgLayouts[8], 5 qwords: position, normal, texture coordinates, bone indices, bone weights.
; Batches at VU 0xf1 and 0xf1 + 0x184 (XTOP); the output follows each.
;=======================================================================================
.program Vu1Prog19
.base 0xf1
.offset 0x184

    ; MSCALF 0: the setup's constants into registers
init:
    nop                             iaddiu vi10, vi00, 17
    nop                             lq.xyzw vf07, 0(vi10)
    nop                             lq.xyzw vf08, 1(vi10)
    nop                             iaddiu vi07, vi00, 32
    nop                             iaddiu vi11, vi00, 145
    addx.x vf04, vf00, vf07x        nop
    addy.x vf05, vf00, vf07y        nop
    addz.x vf06, vf00, vf07z        lq.xyzw vf09, 2(vi10)
    addx.y vf04, vf00, vf08x        nop
    addy.y vf05, vf00, vf08y        nop
    addz.y vf06, vf00, vf08z        nop
    addx.z vf04, vf00, vf09x        lq.xyzw vf01, 9(vi00)
    addy.z vf05, vf00, vf09y        lq.xyzw vf02, 10(vi00)
    addz.z vf06, vf00, vf09z        lq.xyzw vf03, 11(vi00)
    nop                             nop
    mulax.xyz ACC, vf04, vf01x      nop
    madday.xyz ACC, vf05, vf01y     nop
    maddz.xyz vf27, vf06, vf01z     nop
    mulax.xyz ACC, vf04, vf02x      nop
    madday.xyz ACC, vf05, vf02y     nop
    maddz.xyz vf28, vf06, vf02z     nop
    mul.xyz vf10, vf27, vf27        nop
    mulax.xyz ACC, vf04, vf03x      nop
    madday.xyz ACC, vf05, vf03y     nop
    maddz.xyz vf29, vf06, vf03z     nop
    addy.x vf10, vf10, vf10y        move.xyzw vf21, vf27
init_loop:
    nop                             nop
    mul.xyz vf11, vf28, vf28        move.xyzw vf22, vf28
    mul.xyz vf12, vf29, vf29        move.xyzw vf23, vf29
    nop                             nop
    addz.x vf10, vf10, vf10z        nop
    addy.x vf11, vf11, vf11y        nop
    addy.x vf12, vf12, vf12y        nop
    nop                             nop
    nop                             rsqrt Q, vf00w, vf10x
    addz.x vf11, vf11, vf11z        iaddiu vi11, vi11, 3
    addz.x vf12, vf12, vf12z        iaddiu vi10, vi10, 4
    nop                             iaddi vi07, vi07, -1
    nop                             lq.xyzw vf07, 0(vi10)
    nop                             ersqrt P, vf11x
    nop                             lq.xyzw vf08, 1(vi10)
    nop                             lq.xyzw vf09, 2(vi10)
    addx.x vf04, vf00, vf07x        nop
    addy.x vf05, vf00, vf07y        nop
    addz.x vf06, vf00, vf07z        nop
    addx.y vf04, vf00, vf08x        nop
    addy.y vf05, vf00, vf08y        nop
    mulq.xyz vf21, vf21, Q          rsqrt Q, vf00w, vf12x
    addz.y vf06, vf00, vf08z        nop
    addx.z vf04, vf00, vf09x        nop
    addy.z vf05, vf00, vf09y        nop
    addz.z vf06, vf00, vf09z        nop
    addx.x vf24, vf00, vf21x        nop
    addy.x vf25, vf00, vf21y        nop
    addz.x vf26, vf00, vf21z        nop
    mulax.xyz ACC, vf04, vf01x      nop
    madday.xyz ACC, vf05, vf01y     nop
    maddz.xyz vf27, vf06, vf01z     mfp.x vf11, P
    mulax.xyz ACC, vf04, vf02x      nop
    madday.xyz ACC, vf05, vf02y     nop
    mulq.xyz vf23, vf23, Q          nop
    mulx.xyz vf22, vf22, vf11x      nop
    mul.xyz vf10, vf27, vf27        nop
    maddz.xyz vf28, vf06, vf02z     nop
    addx.z vf24, vf00, vf23x        nop
    addx.y vf24, vf00, vf22x        nop
    addy.z vf25, vf00, vf23y        nop
    addy.y vf25, vf00, vf22y        nop
    addz.z vf26, vf00, vf23z        nop
    addz.y vf26, vf00, vf22z        sq.xyzw vf24, -3(vi11)
    mulax.xyz ACC, vf04, vf03x      move.xyzw vf21, vf27
    madday.xyz ACC, vf05, vf03y     sq.xyzw vf25, -2(vi11)
    maddz.xyz vf29, vf06, vf03z     ibne vi07, vi00, init_loop
    addy.x vf10, vf10, vf10y        sq.xyzw vf26, -1(vi11)
    addx.x vf09, vf00, vf01x        lq.xyzw vf04, 4(vi00)
    addy.x vf10, vf00, vf01y        lq.xyzw vf05, 5(vi00)
    addz.x vf11, vf00, vf01z        lq.xyzw vf01, 1(vi00)
    addx.y vf09, vf00, vf02x        lq.xyzw vf06, 6(vi00)
    addy.y vf10, vf00, vf02y        lq.xyzw vf07, 7(vi00)
    addz.y vf11, vf00, vf02z        lq.xyzw vf02, 2(vi00)
    addx.z vf09, vf00, vf03x        lq.xyzw vf08, 8(vi00)
    addy.z vf10, vf00, vf03y        lq.xyzw vf16, 16(vi00)
    addz.z vf11, vf00, vf03z        lq.xyzw vf03, 3(vi00)
    nop                             nop
    nop                             sq.xyzw vf09, 9(vi00)
    nop                             sq.xyzw vf10, 10(vi00)
    nop                             sq.xyzw vf11, 11(vi00)
    nop                             nop                               [E] ; end: constants loaded
    nop                             nop

    ; MSCNT: one batch at XTOP; qword 0's x is its type, qword 1 a GIF tag
batch:
    nop                             xtop vi02                            ; vi02: the batch (BASE, or BASE + OFFSET: double buffer)
    nop                             iaddiu vi05, vi02, 0
    nop                             iaddiu vi03, vi02, 200               ; vi03: the output, 200 qwords after the batch
    nop                             ilwr.x vi06, (vi05)                  ; the batch type (qword 0)
    nop                             iaddiu vi05, vi05, 1
    nop                             ilwr.x vi08, (vi05)                  ; the GIF tag (qword 1): NLOOP, EOP
    nop                             iaddiu vi04, vi03, 0
    nop                             lq.xyzw vf31, 0(vi05)
    nop                             iaddiu vi11, vi00, 32767             ; 0x7FFF: the NLOOP mask
    nop                             iand vi07, vi11, vi08
    nop                             iaddiu vi11, vi00, 1
    nop                             iaddiu vi05, vi05, 1
    nop                             ibeq vi11, vi06, rigid
    nop                             sqi.xyzw vf31, (vi04++)
    nop                             iaddiu vi11, vi00, 2
    nop                             nop
    nop                             ibeq vi11, vi06, blended
    nop                             nop

    ; a register block: the GIF tag and its NLOOP qwords (A+D) go through to the output
copy_regs:
    nop                             lq.xyzw vf31, 0(vi05)
    nop                             iaddi vi07, vi07, -1
    nop                             iaddiu vi05, vi05, 1
    nop                             iaddiu vi04, vi04, 1
    nop                             ibne vi07, vi00, copy_regs
    nop                             sq.xyzw vf31, -1(vi04)
    nop                             lqi.xyzw vf29, (vi05++)
    nop                             lq.xyzw vf27, 15(vi00)
    nop                             lq.xyzw vf24, 12(vi00)
    nop                             lq.xyzw vf25, 13(vi00)
    nop                             lq.xyzw vf26, 14(vi00)
    ftoi0.xyzw vf20, vf29           lq.xyzw vf28, 0(vi00)
    mul.xyzw vf24, vf29, vf24       nop
    mul.xyzw vf25, vf29, vf25       lqi.xyzw vf30, (vi05++)
    mul.xyzw vf26, vf29, vf26       loi 128.0                            ; I = 128.0: the colour clamp (0x80 is 1.0 on the GS)
    add.xyzw vf23, vf27, vf28       mtir vi15, vf20w
    muli.xyzw vf12, vf24, I         nop
    muli.xyzw vf13, vf25, I         nop
    muli.xyzw vf14, vf26, I         nop
    mul.xyzw vf15, vf23, vf30       nop
    minii.xyzw vf12, vf12, I        nop
    minii.xyzw vf13, vf13, I        nop
    minii.xyzw vf14, vf14, I        nop
    minii.xyzw vf15, vf15, I        nop
    nop                             xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             nop                               [E] ; end: the next MSCNT continues at copy_regs_cont
    nop                             nop

    ; the next MSCNT continues here
copy_regs_cont:
    nop                             b batch                              ; the next batch
    nop                             nop

    ; type 1: vertices of one bone each (qword 3: the bone's matrix addresses)
rigid:
    nop                             iaddiu vi08, vi08, 2                 ; NLOOP + 2: the delay line's last vertices go out first
    nop                             isw.x vi08, -1(vi04)
    nop                             lq.xyzw vf20, 1021(vi00)
    nop                             lq.xyzw vf21, 1022(vi00)
    nop                             lq.xyzw vf22, 1023(vi00)
    nop                             lq.xyzw vf23, 1018(vi00)
    nop                             lq.xyzw vf24, 1019(vi00)
    nop                             lq.xyzw vf25, 1020(vi00)
    nop                             sqi.xyzw vf20, (vi04++)
    nop                             sqi.xyzw vf21, (vi04++)
    nop                             sqi.xyzw vf22, (vi04++)
    nop                             sqi.xyzw vf23, (vi04++)
    nop                             sqi.xyzw vf24, (vi04++)
    nop                             sqi.xyzw vf25, (vi04++)
    nop                             ilw.y vi11, 3(vi05)
    nop                             ilw.x vi10, 3(vi05)
    nop                             lq.xyzw vf29, 0(vi05)
    nop                             lq.xyzw vf30, 1(vi05)
    nop                             lq.xyzw vf21, 0(vi11)
    nop                             lq.xyzw vf22, 1(vi11)
    nop                             lq.xyzw vf23, 2(vi11)
    nop                             lq.xyzw vf20, 0(vi10)
    mulax.xyz ACC, vf21, vf30x      lq.xyzw vf21, 1(vi10)
    madday.xyz ACC, vf22, vf30y     lq.xyzw vf22, 2(vi10)
    maddz.xyz vf26, vf23, vf30z     lq.xyzw vf23, 3(vi10)
    mulax.xyzw ACC, vf20, vf29x     nop
    madday.xyzw ACC, vf21, vf29y    nop
    maddaz.xyzw ACC, vf22, vf29z    nop
    maxx.xyzw vf26, vf26, vf00x     nop
    maddw.xyzw vf29, vf23, vf00w    nop
    nop                             nop
    nop                             nop
    mulax.xyz ACC, vf12, vf26x      nop
    madday.xyz ACC, vf13, vf26y     nop
    maddaz.xyz ACC, vf14, vf26z     loi 128.0                            ; I = 128.0: the colour clamp (0x80 is 1.0 on the GS)
    maddw.xyz vf26, vf15, vf00w     nop
    mulax.xyzw ACC, vf01, vf29x     nop
    madday.xyzw ACC, vf02, vf29y    nop
    maddaz.xyzw ACC, vf03, vf29z    nop
    minii.xyzw vf26, vf26, I        nop
    ; one vertex per pass, software-pipelined through the delay line
rigid_loop:
    maddw.xyzw vf28, vf04, vf00w    nop
    mulax.xyzw ACC, vf05, vf29x     nop
    madday.xyzw ACC, vf06, vf29y    nop
    ftoi0.xyz vf26, vf26            nop
    maddaz.xyzw ACC, vf07, vf29z    div Q, vf00w, vf28w                  ; Q = 1 / vf28.w
    maddw.xyzw vf29, vf08, vf00w    ilw.w vi09, 0(vi05)                  ; vi09: the position's w word, XYZF2's w (F, ADC) as the model has it
    nop                             isw.w vi15, 1(vi04)
    nop                             sq.xyz vf26, 1(vi04)
    nop                             lq.xyzw vf31, 2(vi05)
    clipw.xyz vf29, vf29w           nop                                  ; clip flags: vf29.xyz against +-vf29.w
    nop                             nop
    mulq.xyz vf28, vf28, Q          nop
    mulq.xyz vf27, vf31, Q          move.xyz vf17, vf18
    nop                             fcand vi01, 0x03ffff                 ; vi01 = 1: one of the last three vertices is outside the clip volume
    nop                             move.xyz vf18, vf19
    nop                             move.xyz vf19, vf28
    ftoi4.xyz vf28, vf28            sq.xyzw vf27, 0(vi04)
    nop                             iaddiu vi04, vi04, 3
    nop                             iaddi vi07, vi07, -1
    nop                             iaddiu vi05, vi05, 5
    nop                             sq.xyz vf28, -1(vi04)
    subw.x vf31, vf16, vf28w        ilw.y vi11, 3(vi05)
    nop                             ilw.x vi10, 3(vi05)
    nop                             lq.xyzw vf29, 0(vi05)
    nop                             lq.xyzw vf30, 1(vi05)
    muly.x vf31, vf31, vf16y        lq.xyzw vf21, 0(vi11)
    nop                             lq.xyzw vf22, 1(vi11)
    nop                             lq.xyzw vf23, 2(vi11)
    nop                             loi 255.0                            ; I = 255.0
    muli.x vf31, vf31, I            lq.xyzw vf20, 0(vi10)
    mulax.xyz ACC, vf21, vf30x      lq.xyzw vf21, 1(vi10)
    madday.xyz ACC, vf22, vf30y     lq.xyzw vf22, 2(vi10)
    maddz.xyz vf26, vf23, vf30z     lq.xyzw vf23, 3(vi10)
    minii.x vf31, vf31, I           nop
    mulax.xyzw ACC, vf20, vf29x     nop
    madday.xyzw ACC, vf21, vf29y    nop
    maxx.xyzw vf26, vf26, vf00x     nop
    maxx.x vf31, vf31, vf00x        nop
    maddaz.xyzw ACC, vf22, vf29z    nop
    maddw.xyzw vf29, vf23, vf00w    nop
    mulax.xyz ACC, vf12, vf26x      nop
    ftoi4.x vf31, vf31              nop
    madday.xyz ACC, vf13, vf26y     nop
    maddaz.xyz ACC, vf14, vf26z     loi 128.0
    maddw.xyz vf26, vf15, vf00w     ibeq vi01, vi00, rigid_skip
    mulax.xyzw ACC, vf01, vf29x     mtir vi13, vf31x
    nop                             iaddiu vi09, vi00, 32767
    nop                             iaddiu vi09, vi09, 1
rigid_skip:
    madday.xyzw ACC, vf02, vf29y    iadd vi09, vi09, vi13
    maddaz.xyzw ACC, vf03, vf29z    ibne vi07, vi00, rigid_loop
    minii.xyzw vf26, vf26, I        isw.w vi09, -1(vi04)
    ; the epilogue: the vertices left in the delay line
    nop                             lqd.xyzw vf20, (--vi04)
    nop                             lqd.xyzw vf21, (--vi04)
    nop                             lqd.xyzw vf22, (--vi04)
    nop                             lqd.xyzw vf23, (--vi04)
    nop                             lqd.xyzw vf24, (--vi04)
    nop                             lqd.xyzw vf25, (--vi04)
    nop                             sq.xyzw vf20, 1020(vi00)
    nop                             sq.xyzw vf21, 1019(vi00)
    nop                             sq.xyzw vf22, 1018(vi00)
    nop                             sq.xyzw vf23, 1023(vi00)
    nop                             sq.xyzw vf24, 1022(vi00)
    nop                             sq.xyzw vf25, 1021(vi00)
    nop                             xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             nop
    nop                             nop                               [E] ; end: the next MSCNT continues at rigid_cont
    nop                             nop

    ; the next MSCNT continues here
rigid_cont:
    nop                             b batch                              ; the next batch
    nop                             nop

    ; type 2: vertices of four bones (qword 3: the matrix addresses, qword 4: the weights)
blended:
    nop                             iaddiu vi08, vi08, 2                 ; NLOOP + 2: the delay line's last vertices go out first
    nop                             isw.x vi08, -1(vi04)
    nop                             lq.xyzw vf20, 1021(vi00)
    nop                             lq.xyzw vf21, 1022(vi00)
    nop                             lq.xyzw vf22, 1023(vi00)
    nop                             lq.xyzw vf23, 1018(vi00)
    nop                             lq.xyzw vf24, 1019(vi00)
    nop                             lq.xyzw vf25, 1020(vi00)
    nop                             sqi.xyzw vf20, (vi04++)
    nop                             sqi.xyzw vf21, (vi04++)
    nop                             sqi.xyzw vf22, (vi04++)
    nop                             sqi.xyzw vf23, (vi04++)
    nop                             sqi.xyzw vf24, (vi04++)
    nop                             sqi.xyzw vf25, (vi04++)
    nop                             ilw.x vi10, 3(vi05)
    nop                             ilw.y vi11, 3(vi05)
    nop                             ilw.z vi12, 3(vi05)
    nop                             ilw.w vi13, 3(vi05)
    nop                             lq.xyzw vf31, 4(vi05)
    nop                             lq.xyzw vf24, 0(vi10)
    nop                             lq.xyzw vf25, 0(vi11)
    nop                             lq.xyzw vf26, 0(vi12)
    nop                             lq.xyzw vf27, 0(vi13)
    mulax.xyzw ACC, vf24, vf31x     lq.xyzw vf24, 1(vi10)
    madday.xyzw ACC, vf25, vf31y    lq.xyzw vf25, 1(vi11)
    maddaz.xyzw ACC, vf26, vf31z    lq.xyzw vf26, 1(vi12)
    maddw.xyzw vf20, vf27, vf31w    lq.xyzw vf27, 1(vi13)
    mulax.xyzw ACC, vf24, vf31x     lq.xyzw vf24, 2(vi10)
    madday.xyzw ACC, vf25, vf31y    lq.xyzw vf25, 2(vi11)
    maddaz.xyzw ACC, vf26, vf31z    lq.xyzw vf26, 2(vi12)
    maddw.xyzw vf21, vf27, vf31w    lq.xyzw vf27, 2(vi13)
    mulax.xyzw ACC, vf24, vf31x     lq.xyzw vf24, 3(vi10)
    madday.xyzw ACC, vf25, vf31y    lq.xyzw vf25, 3(vi11)
    ; one vertex per pass, software-pipelined through the delay line
blended_loop:
    maddaz.xyzw ACC, vf26, vf31z    lq.xyzw vf26, 3(vi12)
    maddw.xyzw vf22, vf27, vf31w    lq.xyzw vf27, 3(vi13)
    mulax.xyzw ACC, vf24, vf31x     lq.xyzw vf29, 1(vi05)
    madday.xyzw ACC, vf25, vf31y    nop
    maddaz.xyzw ACC, vf26, vf31z    nop
    maddw.xyzw vf23, vf27, vf31w    lq.xyzw vf28, 0(vi05)
    mulax.xyz ACC, vf20, vf29x      nop
    madday.xyz ACC, vf21, vf29y     nop
    maddz.xyz vf27, vf22, vf29z     nop
    mulax.xyzw ACC, vf20, vf28x     nop
    madday.xyzw ACC, vf21, vf28y    nop
    maddaz.xyzw ACC, vf22, vf28z    nop
    maddw.xyzw vf28, vf23, vf00w    erleng.xyz P, vf27                   ; P = 1 / |vf27.xyz|
    nop                             ilw.w vi09, 0(vi05)                  ; vi09: the position's w word, XYZF2's w (F, ADC) as the model has it
    nop                             nop
    nop                             nop
    mulax.xyzw ACC, vf01, vf28x     nop
    madday.xyzw ACC, vf02, vf28y    nop
    maddaz.xyzw ACC, vf03, vf28z    nop
    maddw.xyzw vf26, vf04, vf00w    nop
    mulax.xyzw ACC, vf05, vf28x     nop
    madday.xyzw ACC, vf06, vf28y    nop
    maddaz.xyzw ACC, vf07, vf28z    nop
    maddw.xyzw vf28, vf08, vf00w    div Q, vf00w, vf26w                  ; Q = 1 / vf26.w
    nop                             nop
    nop                             nop
    nop                             nop
    clipw.xyz vf28, vf28w           lq.xyzw vf30, 2(vi05)                ; clip flags: vf28.xyz against +-vf28.w
    nop                             iaddiu vi05, vi05, 5
    nop                             lq.xyzw vf31, 4(vi05)
    mulq.xyz vf26, vf26, Q          nop
    mulq.xyz vf30, vf30, Q          fcand vi01, 0x03ffff                 ; vi01 = 1: one of the last three vertices is outside the clip volume
    nop                             move.xyz vf17, vf18
    nop                             move.xyz vf18, vf19
    nop                             move.xyz vf19, vf26
    ftoi4.xyz vf26, vf26            sq.xyzw vf30, 0(vi04)
    nop                             mfp.w vf27, P
    nop                             ilw.x vi10, 3(vi05)
    nop                             ilw.y vi11, 3(vi05)
    nop                             sq.xyz vf26, 2(vi04)
    mulw.xyz vf29, vf27, vf27w      ilw.z vi12, 3(vi05)
    subw.x vf30, vf16, vf26w        ilw.w vi13, 3(vi05)
    nop                             lq.xyzw vf24, 0(vi10)
    nop                             lq.xyzw vf25, 0(vi11)
    mulax.xyz ACC, vf09, vf29x      lq.xyzw vf26, 0(vi12)
    madday.xyz ACC, vf10, vf29y     lq.xyzw vf27, 0(vi13)
    maddz.xyz vf29, vf11, vf29z     nop
    muly.x vf30, vf30, vf16y        nop
    mulax.xyzw ACC, vf24, vf31x     lq.xyzw vf24, 1(vi10)
    madday.xyzw ACC, vf25, vf31y    lq.xyzw vf25, 1(vi11)
    maxx.xyz vf29, vf29, vf00x      loi 255.0                            ; I = 255.0
    muli.x vf30, vf30, I            nop
    maddaz.xyzw ACC, vf26, vf31z    lq.xyzw vf26, 1(vi12)
    maddw.xyzw vf20, vf27, vf31w    lq.xyzw vf27, 1(vi13)
    mulax.xyz ACC, vf12, vf29x      nop
    madday.xyz ACC, vf13, vf29y     nop
    maddaz.xyz ACC, vf14, vf29z     nop
    maddw.xyz vf29, vf15, vf00w     nop
    minii.x vf30, vf30, I           loi 128.0                            ; I = 128.0: the colour clamp (0x80 is 1.0 on the GS)
    mulax.xyzw ACC, vf24, vf31x     lq.xyzw vf24, 2(vi10)
    madday.xyzw ACC, vf25, vf31y    lq.xyzw vf25, 2(vi11)
    minii.xyz vf29, vf29, I         iaddiu vi04, vi04, 3
    maxx.x vf30, vf30, vf00x        iaddi vi07, vi07, -1
    maddaz.xyzw ACC, vf26, vf31z    lq.xyzw vf26, 2(vi12)
    maddw.xyzw vf21, vf27, vf31w    lq.xyzw vf27, 2(vi13)
    ftoi0.xyz vf29, vf29            nop
    ftoi4.x vf30, vf30              isw.w vi15, -2(vi04)
    mulax.xyzw ACC, vf24, vf31x     lq.xyzw vf24, 3(vi10)
    madday.xyzw ACC, vf25, vf31y    lq.xyzw vf25, 3(vi11)
    nop                             sq.xyz vf29, -2(vi04)
    nop                             ibeq vi01, vi00, blended_skip
    nop                             mtir vi14, vf30x
    nop                             iaddiu vi09, vi00, 32767
    nop                             iaddiu vi09, vi09, 1
blended_skip:
    nop                             iadd vi09, vi09, vi14
    nop                             ibne vi07, vi00, blended_loop
    nop                             isw.w vi09, -1(vi04)
    ; the epilogue: the vertices left in the delay line
    nop                             lqd.xyzw vf20, (--vi04)
    nop                             lqd.xyzw vf21, (--vi04)
    nop                             lqd.xyzw vf22, (--vi04)
    nop                             lqd.xyzw vf23, (--vi04)
    nop                             lqd.xyzw vf24, (--vi04)
    nop                             lqd.xyzw vf25, (--vi04)
    nop                             sq.xyzw vf20, 1020(vi00)
    nop                             sq.xyzw vf21, 1019(vi00)
    nop                             sq.xyzw vf22, 1018(vi00)
    nop                             sq.xyzw vf23, 1023(vi00)
    nop                             sq.xyzw vf24, 1022(vi00)
    nop                             sq.xyzw vf25, 1021(vi00)
    nop                             xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             nop                               [E] ; end: the next MSCNT continues at blended_cont
    nop                             nop

    ; the next MSCNT continues here
blended_cont:
    nop                             b batch                              ; the next batch
    nop                             nop
.endprogram

;=======================================================================================
; Vu1Prog20: three lights, material colour, no vertex colours, fog, second colour
;
; gVu1ProgInfo20 (bones.c): 123 pairs (984 bytes), batches of up to 3968 bytes;
; Vu1_SelectProgram's key 0x28202, rigid models (0x21035, 0x121035).
; Setup Vu1Pkt_LDV: an UNPACK of 18 qwords to VU 0, then MSCALF 0:
;   0        colour: gGsColorF, RGB scaled by the model's brightness: vf28
;   1        second colour: gGsColor2F: vf17
;   2-5      gMtxSlots x gMtxView x gMtxProjClip: model to screen (XYZ after the divide by w): vf01-vf04
;   6-9      the matrix above x gViewportMtx: model to the clip test's space: vf05-vf08
;   10-12    light directions (model space, negated): vf09-vf11
;   13-16    light colours (three lights and the ambient): vf24-vf27
;   17       fog range: gGsFogFar and the word after it: vf16
; Vertices: gVu1ProgLayouts[0], 3 qwords: position, normal, texture coordinates.
; Batches at VU 0x12 and 0x12 + 0x1f4 (XTOP); the output follows each.
;=======================================================================================
.program Vu1Prog20
.base 0x12
.offset 0x1f4

    ; MSCALF 0: the setup's constants into registers
init:
    nop                             lq.xyzw vf01, 2(vi00)
    nop                             lq.xyzw vf02, 3(vi00)
    nop                             lq.xyzw vf03, 4(vi00)
    nop                             lq.xyzw vf04, 5(vi00)
    nop                             lq.xyzw vf05, 6(vi00)
    nop                             lq.xyzw vf06, 7(vi00)
    nop                             lq.xyzw vf07, 8(vi00)
    nop                             lq.xyzw vf08, 9(vi00)
    nop                             lq.xyzw vf09, 10(vi00)
    nop                             lq.xyzw vf10, 11(vi00)
    nop                             lq.xyzw vf11, 12(vi00)
    nop                             lq.xyzw vf16, 17(vi00)
    nop                             lq.xyzw vf17, 1(vi00)
    nop                             nop                               [E] ; end: constants loaded
    nop                             nop

    ; MSCNT: one batch at XTOP; qword 0's x is its type, qword 1 a GIF tag
batch:
    nop                             xtop vi02                            ; vi02: the batch (BASE, or BASE + OFFSET: double buffer)
    nop                             iaddiu vi05, vi02, 0
    nop                             iaddiu vi03, vi02, 248               ; vi03: the output, 248 qwords after the batch
    nop                             ilwr.x vi06, (vi05)                  ; the batch type (qword 0)
    nop                             iaddiu vi05, vi05, 1
    nop                             ilwr.x vi08, (vi05)                  ; the GIF tag (qword 1): NLOOP, EOP
    nop                             iaddiu vi04, vi03, 0
    nop                             iaddiu vi11, vi00, 32767             ; 0x7FFF: the NLOOP mask
    nop                             lq.xyzw vf31, 0(vi05)
    nop                             iand vi07, vi11, vi08
    nop                             iaddiu vi11, vi00, 1
    nop                             iaddiu vi05, vi05, 1
    nop                             ibeq vi11, vi06, vertices
    nop                             sqi.xyzw vf31, (vi04++)

    ; a register block: the GIF tag and its NLOOP qwords (A+D) go through to the output
copy_regs:
    nop                             lq.xyzw vf31, 0(vi05)
    nop                             iaddi vi07, vi07, -1
    nop                             iaddiu vi05, vi05, 1
    nop                             iaddiu vi04, vi04, 1
    nop                             ibne vi07, vi00, copy_regs
    nop                             sq.xyzw vf31, -1(vi04)
    nop                             lq.xyzw vf28, 0(vi00)
    nop                             lqi.xyzw vf29, (vi05++)
    nop                             lq.xyzw vf24, 13(vi00)
    nop                             lq.xyzw vf25, 14(vi00)
    nop                             lq.xyzw vf26, 15(vi00)
    nop                             lq.xyzw vf27, 16(vi00)
    mul.xyzw vf24, vf29, vf24       nop
    mul.xyzw vf25, vf29, vf25       lqi.xyzw vf30, (vi05++)
    mul.xyzw vf26, vf29, vf26       nop
    add.xyzw vf23, vf27, vf28       nop
    mul.xyzw vf29, vf29, vf17       loi 128.0                            ; I = 128.0: the colour clamp (0x80 is 1.0 on the GS)
    muli.xyzw vf12, vf24, I         nop
    muli.xyzw vf13, vf25, I         nop
    muli.xyzw vf14, vf26, I         nop
    ftoi0.xyzw vf29, vf29           nop
    mul.xyzw vf15, vf23, vf30       nop
    minii.xyzw vf12, vf12, I        nop
    minii.xyzw vf13, vf13, I        nop
    minii.xyzw vf14, vf14, I        mtir vi15, vf29w
    minii.xyzw vf15, vf15, I        xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             nop                               [E] ; end: the next MSCNT continues at copy_regs_cont
    nop                             nop

    ; the next MSCNT continues here
copy_regs_cont:
    nop                             b batch                              ; the next batch
    nop                             nop

    ; type 1: a strip of NLOOP vertices
vertices:
    nop                             lq.xyzw vf29, 0(vi05)
    nop                             lq.xyzw vf30, 1(vi05)
    nop                             iaddiu vi08, vi08, 2                 ; NLOOP + 2: the delay line's last vertices go out first
    nop                             isw.x vi08, -1(vi04)
    mulax.xyzw ACC, vf01, vf29x     ilw.w vi09, 0(vi05)                  ; vi09: the position's w word, XYZF2's w (F, ADC) as the model has it
    madday.xyzw ACC, vf02, vf29y    lq.xyzw vf31, 2(vi05)
    maddaz.xyzw ACC, vf03, vf29z    iaddiu vi05, vi05, 3
    maddw.xyzw vf25, vf04, vf00w    nop
    mulax.xyzw ACC, vf09, vf30x     nop
    madday.xyzw ACC, vf10, vf30y    nop
    maddz.xyzw vf26, vf11, vf30z    nop
    ; one vertex per pass, software-pipelined through the delay line
vertices_loop:
    subw.x vf23, vf16, vf25w        div Q, vf00w, vf25w                  ; Q = 1 / vf25.w
    mulax.xyzw ACC, vf05, vf29x     lq.xyzw vf18, 1021(vi00)
    madday.xyzw ACC, vf06, vf29y    lq.xyzw vf19, 1022(vi00)
    maxx.xyzw vf26, vf26, vf00x     lq.xyzw vf20, 1023(vi00)
    muly.x vf23, vf23, vf16y        loi 255.0                            ; I = 255.0
    maddaz.xyzw ACC, vf07, vf29z    sqi.xyzw vf18, (vi04++)
    maddw.xyzw vf27, vf08, vf00w    sqi.xyzw vf19, (vi04++)
    mulax.xyzw ACC, vf12, vf26x     sqi.xyzw vf20, (vi04++)
    muli.x vf23, vf23, I            iaddiu vi14, vi09, 0
    madday.xyzw ACC, vf13, vf26y    iaddi vi07, vi07, -1
    maddz.xyzw vf26, vf14, vf26z    lq.xyzw vf18, 1018(vi00)
    clipw.xyz vf27, vf27w           lq.xyzw vf19, 1019(vi00)             ; clip flags: vf27.xyz against +-vf27.w
    minii.x vf23, vf23, I           lq.xyzw vf20, 1020(vi00)
    mulq.xyzw vf24, vf25, Q         loi 128.0                            ; I = 128.0: the colour clamp (0x80 is 1.0 on the GS)
    add.xyzw vf26, vf26, vf15       sq.xyzw vf18, 1021(vi00)
    mulq.xyz vf28, vf31, Q          fcand vi01, 0x03ffff                 ; vi01 = 1: one of the last three vertices is outside the clip volume
    maxx.x vf23, vf23, vf00x        ibeq vi01, vi00, vertices_in_view
    ftoi4.xyzw vf24, vf24           sq.xyzw vf19, 1022(vi00)             ; to 12.4 fixed point (GS XYZ)
    nop                             iaddiu vi14, vi00, 32767             ; ADC: 0x7FFF + 1 = 0x8000, so the GS draws no triangle ending here
    nop                             iaddiu vi14, vi14, 1
    ; the last three vertices are all inside the clip volume
vertices_in_view:
    minii.xyzw vf26, vf26, I        sq.xyzw vf20, 1023(vi00)
    nop                             sq.xyzw vf28, 1018(vi00)
    ftoi4.x vf23, vf23              lq.xyzw vf29, 0(vi05)
    nop                             sq.xyz vf24, 1020(vi00)
    mul.xyzw vf26, vf26, vf17       ilw.w vi09, 0(vi05)
    nop                             lq.xyzw vf30, 1(vi05)
    mulax.xyzw ACC, vf01, vf29x     mtir vi13, vf23x
    madday.xyzw ACC, vf02, vf29y    lq.xyzw vf31, 2(vi05)
