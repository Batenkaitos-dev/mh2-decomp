    nop                             sq.xyzw vf17, 1023(vi00)
    nop                             iaddi vi07, vi07, -1
    mulq.xyzw vf28, vf28, Q         lq.xyzw vf30, 0(vi05)
    mulq.xyz vf26, vf31, Q          fcand vi01, 0x03ffff                 ; vi01 = 1: one of the last three vertices is outside the clip volume
    nop                             ibeq vi01, vi00, vertices_in_view
    nop                             sq.xyzw vf29, 1019(vi00)
    nop                             iaddiu vi09, vi00, 32767
    nop                             iaddiu vi09, vi09, 1
