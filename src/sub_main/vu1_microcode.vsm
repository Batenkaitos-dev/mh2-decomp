    clipw.xyz vf25, vf25w           iaddi vi07, vi07, -1                 ; clip flags: vf25.xyz against +-vf25.w
    ftoi4.xyz vf24, vf24            iaddiu vi04, vi04, 3
    minii.x vf26, vf26, I           lq.xyzw vf11, 0(vi10)
    mulax.xyzw ACC, vf01, vf23x     lq.xyzw vf12, 1(vi10)
    madday.xyzw ACC, vf02, vf23y    sq.xyzw vf27, -3(vi04)
    maddaz.xyzw ACC, vf03, vf23z    sq.xyz vf24, -1(vi04)
    maxx.x vf22, vf26, vf00x        lq.xyzw vf13, 2(vi10)
    maddw.xyzw vf28, vf04, vf00w    lq.xyzw vf14, 3(vi10)
    mulax.xyzw ACC, vf05, vf23x     lq.xyzw vf29, 4(vi05)
    madday.xyzw ACC, vf06, vf23y    lq.xyzw vf31, 1(vi05)
    ftoi4.x vf22, vf22              nop
    maddaz.xyzw ACC, vf07, vf23z    div Q, vf00w, vf28w
    subw.x vf26, vf10, vf28w        fcand vi01, 0x03ffff                 ; vi01 = 1: one of the last three vertices is outside the clip volume
    maddw.xyzw vf25, vf08, vf00w    ibeq vi01, vi00, rigid_in_view
    mulax.xyzw ACC, vf11, vf29x     mtir vi13, vf22x
    nop                             iaddiu vi09, vi00, 32767
    nop                             iaddiu vi09, vi09, 1
    ; the last three vertices are all inside the clip volume
rigid_in_view:
    madday.xyzw ACC, vf12, vf29y    iadd vi09, vi09, vi13
    muly.x vf26, vf26, vf10y        ibne vi07, vi00, rigid_loop
    maddaz.xyzw ACC, vf13, vf29z    isw.w vi09, -1(vi04)
    ; the epilogue: the vertices left in the delay line
    nop                             lqd.xyzw vf11, (--vi04)
    nop                             lqd.xyzw vf12, (--vi04)
    nop                             lqd.xyzw vf13, (--vi04)
    nop                             lqd.xyzw vf14, (--vi04)
    nop                             lqd.xyzw vf15, (--vi04)
    nop                             lqd.xyzw vf16, (--vi04)
    nop                             sq.xyzw vf11, 1020(vi00)
    nop                             sq.xyzw vf12, 1019(vi00)
    nop                             sq.xyzw vf13, 1018(vi00)
    nop                             sq.xyzw vf14, 1023(vi00)
    nop                             sq.xyzw vf15, 1022(vi00)
    nop                             sq.xyzw vf16, 1021(vi00)
    nop                             xgkick vi03                          ; send the output to the GS (PATH1)
    nop                             nop
    nop                             nop                               [E] ; end: the next MSCNT continues at rigid_cont
    nop                             nop

    ; the next MSCNT continues here
rigid_cont:
    nop                             b batch                              ; the next batch
    nop                             nop

    ; type 2: vertices of four bones (qword 3: the matrix addresses, qword 4: the weights)
blended:
    nop                             iaddiu vi08, vi08, 2                 ; NLOOP + 2: the delay line's last vertices go out first
    nop                             isw.x vi08, -1(vi04)
    nop                             lq.xyzw vf19, 1021(vi00)
    nop                             lq.xyzw vf20, 1022(vi00)
    nop                             lq.xyzw vf21, 1023(vi00)
    nop                             lq.xyzw vf22, 1018(vi00)
    nop                             ilw.x vi10, 2(vi05)
    nop                             ilw.y vi11, 2(vi05)
    nop                             ilw.z vi12, 2(vi05)
    nop                             ilw.w vi13, 2(vi05)
    nop                             lq.xyzw vf31, 3(vi05)
    nop                             lq.xyzw vf11, 0(vi10)
    nop                             lq.xyzw vf12, 0(vi11)
    nop                             lq.xyzw vf13, 0(vi12)
    nop                             lq.xyzw vf14, 0(vi13)
